build
obj
output
self-hosted
lux

# autotools
autom4te.cache

# Linux executables (files without extensions)
*
!*/
!*.*

# The one deliberate exception: the committed bootstrap seed binary used to
# break the self-hosting chicken-and-egg (see scripts/bootstrap-build.sh and
# .github/workflows/{ci,release}.yml). It has no extension, so the blanket
# rule above would otherwise ignore it.
!bootstrap/luma-seed

# Ignore Windows executables and their debug-info files (zig cc emits a
# .pdb alongside cross-compiled .exe binaries)
*.exe
*.pdb

# Ignore Doxygen output
docs/doxygen/
docs/html/
docs/latex/
docs/xml/

# Ignore output from llvm
*.bc
*.ll
*.o
*.s

# Ignore IDE directories
.vscode

# ignore the lsp-client server node modules
node_modules
package-lock.json
tsconfig.tsbuildinfo
src/lsp/language-support/client/out

# ignore macOS hidden files
.DS_Store
