@module "main"

@use "std_vector" as VEC
@use "std_args"   as ARGS

@use "parser_file"   as PFILE
@use "constants"    as CONST
@use "commands"     as COMD
@use "parser"       as PARS

@use "ast_print"    as PRINT
@use "ast_stmt"     as STMT
@use "ast"          as AST

@use "tc"           as TC
@use "codegen"      as CODEGEN
@use "lsp_main"     as LSP

pub const main -> fn (argc: int, argv: **byte) int {
  let args: ARGS::Args = ARGS::init_args(argc, argv);
  args = args.tail();

  let modules: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);
  let build_config: CONST::LumaBuildConfig = CONST::init_build_config(args.get(0));
  
  let args: int = COMD::parse_args(&args, &build_config);
  if (args != 0) {
    VEC::free_vector(&modules);
    return args;
  }

  if (build_config.lsp_mode) {
    VEC::free_vector(&modules);
    VEC::free_vector(&build_config.link_files);
    return LSP::lsp_run();
  }

  let main_module: *AST::AstNode = PFILE::parse_file(build_config.filepath);
  let program: *AST::AstNode;

  if (main_module == cast<*AST::AstNode>(0)) {
    VEC::free_vector(&modules);
    return 1;
  }
  modules.push_back(cast<*void>(&main_module));

  let it: VEC::VectorIter = build_config.link_files.iter();
  loop {
    let ptr: *void = it.next();
    if (ptr == cast<*void>(0)) break;

    let addr: *int = cast<*int>(ptr);
    let linked_module: *AST::AstNode = PFILE::parse_file(cast<*byte>(*addr));
    if (linked_module != cast<*AST::AstNode>(0))
      modules.push_back(cast<*void>(&linked_module));
  }

  program = STMT::make_program(
    PARS::vec_to_node_array(&modules),
    modules.size,
    1, 0
  );

  VEC::free_vector(&modules);
  VEC::free_vector(&build_config.link_files);

  // PRINT::print_node(program, 0);

  let tc: bool = TC::typecheck(program, build_config);

  let ok: bool = tc;
  if (tc) {
    ok = CODEGEN::codegen_generate(program, build_config);
    if (ok == false) {
      output("Codegen/compile step failed.", "\n");
    }
  }

  AST::free_node(program);

  // Exit non-zero on a typecheck or codegen failure, matching normal
  // compiler convention (and what a test harness checks exit code for).
  if (ok == false) return 1;
  return 0;
}
