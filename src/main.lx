//! Entry point of the Luma compiler driver.
//!
//! Parses command-line arguments, then drives the parse → typecheck →
//! codegen → compile pipeline (or the docs / LSP passes) and returns the
//! process exit status.

@module "main"

@use "std_vector" as VEC
@use "std_args"   as ARGS
@use "std_libc"   as LIBC

@use "parser_file"   as PFILE
@use "constants"    as CONST
@use "commands"     as COMD
@use "parser"       as PARS

@use "ast_stmt"     as STMT
@use "ast"          as AST

@use "tc"           as TC
@use "codegen"      as CODEGEN
@use "lsp_main"     as LSP
@use "auto_docs"    as DOCS

@use "progress_bar" as PBAR

// @use "ast_print" as PRINT

/// Program entry point: parses CLI arguments into a build config and runs
/// the requested pipeline — the Markdown docs pass, the LSP, or typecheck
/// plus transpile-to-C plus compile.
///
/// # Returns
/// `0` on success; `1` or a `LumaErrorCode` status on failure.
pub const main -> fn (argc: i64, argv: **byte) i64 {
  let args: ARGS::Args = ARGS::init_args(argc, argv);
  args = args.tail();

  let modules: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);
  let build_config: CONST::LumaBuildConfig = CONST::LumaBuildConfig::init_build_config(args.get(0));
  
  let args: i64 = COMD::parse_args(&args, &build_config);
  if (args != 0) {
    VEC::free_vector(&modules);
    return args;
  }

  if (build_config.lsp_mode) {
    VEC::free_vector(&modules);
    VEC::free_vector(&build_config.link_files);
    VEC::free_vector(&build_config.link_libraries);
    return LSP::lsp_run();
  }

  let bar: PBAR::ProgressBar = PBAR::ProgressBar::new(6);
  defer bar.free_bar();
  
  if (build_config.anim) {
    bar.update("Parsing", "|");
    bar.render();
  }

  let main_module: *AST::AstNode = PFILE::parse_file(build_config.filepath);
  let program: *AST::AstNode;

  if (main_module == cast<*AST::AstNode>(0)) {
    VEC::free_vector(&modules);
    return 1;
  }
  modules.push_back(cast<*void>(&main_module));
  
  if (build_config.anim) {
    bar.update("Parsing linked modules", "/");
    bar.render();
  }

  let it: VEC::VectorIter = build_config.link_files.iter();
  loop {
    let ptr: *void = it.next();
    if (ptr == cast<*void>(0)) break;

    let addr: *i64 = cast<*i64>(ptr);
    let linked_module: *AST::AstNode = PFILE::parse_file(cast<*byte>(*addr));
    // parse_file already reported the failure (and printed it); a missing
    // `-l` dependency can't be silently dropped from the program.
    if (linked_module == cast<*AST::AstNode>(0)) {
      VEC::free_vector(&modules);
      return 1;
    }
    modules.push_back(cast<*void>(&linked_module));
  }
  
  if (build_config.anim) {
    bar.update("Building AST", "-");
    bar.render();
  }

  program = STMT::make_program(
    PARS::vec_to_node_array(&modules),
    modules.size,
    1, 0
  );

  VEC::free_vector(&modules);
  VEC::free_vector(&build_config.link_files);

  // PRINT::print_node(program, 0);

  // `-docs` is a pure AST pass: it reads declarations and emits Markdown, so
  // it runs on the freshly parsed program without typechecking or codegen.
  if (build_config.docs) {
    let doc_config: DOCS::DocGenConfig =
      DOCS::create_doc_config(cast<*void>(0), build_config.docs_dir);

    // Root the module filter at the entry file's directory so modules under
    // std/, test/, or any other path are documented too. Left NULL when the
    // entry has no directory component (the docs pass falls back to `src/`).
    let project_root: *byte = cast<*byte>(0);
    let last_slash: *byte = LIBC::strrchr(build_config.filepath, cast<i64>('/'));
    if (last_slash != cast<*byte>(0)) {
      let root_len: i64 = cast<i64>(last_slash) - cast<i64>(build_config.filepath) + 1;
      project_root = LIBC::malloc(root_len + 1);
      LIBC::memcpy(cast<*void>(project_root), cast<*void>(build_config.filepath), root_len);
      project_root[root_len] = '\0';
    }
    doc_config.project_root = project_root;

    let docs_ok: bool = DOCS::generate_documentation(program, doc_config);
    AST::free_node(program);
    if (project_root != cast<*byte>(0)) free(project_root);
    if (docs_ok == false) {
      VEC::free_vector(&build_config.link_libraries);
      return CONST::LumaErrorCode::Runtime_Error;
    }
    VEC::free_vector(&build_config.link_libraries);
    return 0;
  }

  if (build_config.anim) {
    bar.update("Typechecking", "\\");
    bar.render();
  }

  let tc: bool = TC::typecheck(program, build_config);

  let ok: bool = tc;
  if (tc) {
    if (build_config.anim) {
      bar.update("Generating C", "|");
      bar.render();
    }

    let c_path: *byte = CODEGEN::codegen_transpile(program, build_config);

    if (c_path == cast<*byte>(0)) ok = false;
    elif (build_config.no_compile) {
      output("Saved generated C source to '", c_path, "'\n");
      free(c_path);
      ok = true;
    } else {
      CODEGEN::collect_link_libs(cast<*AST::ProgramNode>(program), build_config.os, &build_config.link_libraries);
      if (build_config.anim) {
        bar.update("Compiling", "|");
        let cg_tid: i64 = PBAR::start(&bar);
        ok = CODEGEN::codegen_compile(c_path, build_config);
        PBAR::stop(cg_tid, &bar);
      } else {
        ok = CODEGEN::codegen_compile(c_path, build_config);
      }
    }

    if (ok == false) {
      output("Codegen/compile step failed.", "\n");
    }
  }

  AST::free_node(program);
  VEC::free_vector(&build_config.link_libraries);
  
  if (build_config.anim) {
    if (ok) bar.finish();
  }

  if (ok == false) return CONST::LumaErrorCode::Runtime_Error;
  return 0;
}
