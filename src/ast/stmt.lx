#returns_ownership
pub const make_print_stmt -> fn (expressions: **AST::AstNode, expr_count: int, ln: int, line: int, col: int) *AST::AstNode {
  let n: *AST::PrintStmtNode = cast<*AST::PrintStmtNode>(alloc(sizeof<AST::PrintStmtNode>));

