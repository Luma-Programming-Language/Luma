  n.stmt_count = stmt_count;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_print_stmt -> fn (expressions: **AST::AstNode, expr_count: int, ln: int, line: int, col: int) *AST::AstNode {
  let n: *AST::PrintStmtNode = AST::AstNode::make<AST::PrintStmtNode>(
