  let n: *AST::CaseNode = cast<*AST::CaseNode>(alloc(sizeof<AST::CaseNode>));

  n.kind = AST::NodeType::STMT_CASE;
  n.category = AST::NodeCategory::Node_Category_STMT;
  n.line = line;
  n.col = col;

  n.values = values;
  n.value_count = value_count;
  n.body = body;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_default_stmt -> fn (body: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let n: *AST::DefaultNode = cast<*AST::DefaultNode>(alloc(sizeof<AST::DefaultNode>));

  n.kind = AST::NodeType::STMT_DEFAULT;
  n.category = AST::NodeCategory::Node_Category_STMT;
  n.line = line;
  n.col = col;

  n.body = body;
  
  return cast<*AST::AstNode>(n);
}
