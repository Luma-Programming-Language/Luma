pub const make_break_continue -> fn (is_continue: int, line: int, col: int) *AST::AstNode {
  let n: *AST::BreakContinueNode = AST::AstNode::make<AST::BreakContinueNode>(
    AST::NodeType::STMT_BREAK_CONTINUE,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.is_continue = is_continue;

