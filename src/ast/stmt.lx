@module "ast_stmt"

@use "ast" as AST

#returns_ownership
pub const make_program -> fn (modules: **AST::AstNode, module_count: int, line: int, col: int) *AST::AstNode {
  let n: *AST::ProgramNode = AST::AstNode::make<AST::ProgramNode>(
    AST::NodeType::PROGRAM, 
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.modules = modules;
  n.module_count = module_count;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_expr_stmt -> fn (expression: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let n: *AST::ExprStmtNode = AST::AstNode::make<AST::ExprStmtNode>(
    AST::NodeType::STMT_EXPRESSION, 
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.expression = expression;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_var_decl -> fn (name: *byte, doc_comment: *byte, var_type: *AST::AstNode,
                               initializer: *AST::AstNode, is_mutable: int, is_public: int, line: int, col: int) *AST::AstNode {
  let n: *AST::VarDeclNode = AST::AstNode::make<AST::VarDeclNode>(
    AST::NodeType::STMT_VAR_DECL, 
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.var_type = var_type;
  n.initializer = initializer;
  n.is_mutable = is_mutable;
  n.is_public = is_public;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_const_decl -> fn (name: *byte, doc_comment: *byte, var_type: *AST::AstNode,
                                 initializer: *AST::AstNode, is_public: int, line: int, col: int) *AST::AstNode {
  let n: *AST::VarDeclNode = AST::AstNode::make<AST::VarDeclNode>(
    AST::NodeType::STMT_CONST_DECL,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.var_type = var_type;
  n.initializer = initializer;
  n.is_mutable = 0;
  n.is_public = is_public;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_func_decl -> fn (name: *byte, doc_comment: *byte, param_names: **byte, param_types: **AST::AstNode,
                                param_count: int, return_type: *AST::AstNode, is_public: int, body: *AST::AstNode,
                                returns_ownership: int, takes_ownership: int,
                                forward_declared: int, line: int, col: int) *AST::AstNode {
  let n: *AST::FuncDeclNode = AST::AstNode::make<AST::FuncDeclNode>(
    AST::NodeType::STMT_FUNCTION,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.param_names = param_names;
  n.param_types = param_types;
  n.param_count = param_count;
  n.return_type = return_type;
  n.is_public = is_public;
  n.body = body;
  n.returns_ownership = returns_ownership;
  n.takes_ownership = takes_ownership;
  n.forward_declared = forward_declared;
  n.dll_import = 0;
  n.dll_name = cast<*byte>(0);
  n.dll_callconv = cast<*byte>(0);
  n.lib_import = 0;
  n.lib_name = cast<*byte>(0);
  n.type_params = cast<**byte>(0);
  n.type_param_count = 0;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_struct_decl -> fn (name: *byte, doc_comment: *byte, public_members: **AST::AstNode,
                                  public_count: int, private_members: **AST::AstNode, private_count: int,
                                  is_public: int, line: int, col: int) *AST::AstNode {
  let n: *AST::StructDeclNode = AST::AstNode::make<AST::StructDeclNode>(
    AST::NodeType::STMT_STRUCT,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.public_members = public_members;
  n.public_count = public_count;
  n.private_members = private_members;
  n.private_count = private_count;
  n.is_public = is_public;
  n.type_params = cast<**byte>(0);
  n.type_param_count = 0;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_field_decl -> fn (name: *byte, doc_comment: *byte, type_node: *AST::AstNode,
                                 function: *AST::AstNode, is_public: int, is_embedded: int,
                                 is_static: int, line: int, col: int) *AST::AstNode {
  let n: *AST::FieldDeclNode = AST::AstNode::make<AST::FieldDeclNode>(
    AST::NodeType::STMT_FIELD_DECL,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.type_node = type_node;
  n.function = function;
  n.is_public = is_public;
  n.is_embedded = is_embedded;
  n.is_static = is_static;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_enum_decl -> fn (name: *byte, doc_comment: *byte, members: **byte,
                                member_count: int, is_public: int, line: int, col: int) *AST::AstNode {
  let n: *AST::EnumDeclNode = AST::AstNode::make<AST::EnumDeclNode>(
    AST::NodeType::STMT_ENUM,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.members = members;
  n.member_count = member_count;
  n.is_public = is_public;
  n.type_params = cast<**byte>(0);
  n.type_param_count = 0;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_if_stmt -> fn (condition: *AST::AstNode, then_stmt: *AST::AstNode, elif_stmts: **AST::AstNode,
                              elif_count: int, else_stmt: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let n: *AST::IfStmtNode = AST::AstNode::make<AST::IfStmtNode>(
    AST::NodeType::STMT_IF,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.condition = condition;
  n.then_stmt = then_stmt;
  n.elif_stmts = elif_stmts;
  n.elif_count = elif_count;
  n.else_stmt = else_stmt;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_loop_stmt -> fn (condition: *AST::AstNode, optional: *AST::AstNode, body: *AST::AstNode,
                                initializer: **AST::AstNode, init_count: int, line: int, col: int) *AST::AstNode {
  let n: *AST::LoopStmtNode = AST::AstNode::make<AST::LoopStmtNode>(
    AST::NodeType::STMT_LOOP,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.condition = condition;
  n.optional = optional;
  n.body = body;
  n.initializer = initializer;
  n.init_count = init_count;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_return_stmt -> fn (value: *AST::AstNode, line: int, col: int) *AST::AstNode {
