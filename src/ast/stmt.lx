//! Constructors for the statement AST nodes: the program root, declarations
//! (var, const, function, struct, enum, field), and all control-flow
//! statements. Each returns a freshly allocated node boxed as an
//! `*AST::AstNode`.
@module "ast_stmt"

@use "ast" as AST

/// Builds a `PROGRAM` node holding the compilation unit's list of modules.
#returns_ownership
pub const make_program -> fn (modules: **AST::AstNode, module_count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::ProgramNode = AST::AstNode::make<AST::ProgramNode>(
    AST::NodeType::PROGRAM, 
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.modules = modules;
  n.module_count = module_count;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_EXPRESSION` node wrapping a single expression statement.
#returns_ownership
pub const make_expr_stmt -> fn (expression: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::ExprStmtNode = AST::AstNode::make<AST::ExprStmtNode>(
    AST::NodeType::STMT_EXPRESSION, 
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.expression = expression;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_VAR_DECL` node for a mutable or immutable `let`/`var`
/// declaration: name, doc comment, optional type and initializer, and the
/// `is_mutable`/`is_public` flags.
#returns_ownership
pub const make_var_decl -> fn (name: *byte, doc_comment: *byte, var_type: *AST::AstNode,
                               initializer: *AST::AstNode, is_mutable: i64, is_public: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::VarDeclNode = AST::AstNode::make<AST::VarDeclNode>(
    AST::NodeType::STMT_VAR_DECL, 
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.var_type = var_type;
  n.initializer = initializer;
  n.is_mutable = is_mutable;
  n.is_public = is_public;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_CONST_DECL` node for an immutable `const` declaration
/// (`is_mutable` is forced to 0).
#returns_ownership
pub const make_const_decl -> fn (name: *byte, doc_comment: *byte, var_type: *AST::AstNode,
                                 initializer: *AST::AstNode, is_public: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::VarDeclNode = AST::AstNode::make<AST::VarDeclNode>(
    AST::NodeType::STMT_CONST_DECL,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.var_type = var_type;
  n.initializer = initializer;
  n.is_mutable = 0;
  n.is_public = is_public;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_FUNCTION` node describing a function declaration: name, doc
/// comment, parameter names/types (`param_count` entries), return type,
/// visibility, ownership flags, body, and whether it is forward declared.
#returns_ownership
pub const make_func_decl -> fn (name: *byte, doc_comment: *byte, param_names: **byte, param_types: **AST::AstNode,
                                param_count: i64, return_type: *AST::AstNode, is_public: i64, body: *AST::AstNode,
                                returns_ownership: i64, takes_ownership: i64,
                                forward_declared: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::FuncDeclNode = AST::AstNode::make<AST::FuncDeclNode>(
    AST::NodeType::STMT_FUNCTION,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.param_names = param_names;
  n.param_types = param_types;
  n.param_count = param_count;
  n.return_type = return_type;
  n.is_public = is_public;
  n.body = body;
  n.returns_ownership = returns_ownership;
  n.takes_ownership = takes_ownership;
  n.forward_declared = forward_declared;
  n.dll_import = 0;
  n.dll_name = cast<*byte>(0);
  n.dll_callconv = cast<*byte>(0);
  n.lib_import = 0;
  n.lib_name = cast<*byte>(0);
  n.type_params = cast<**byte>(0);
  n.type_param_count = 0;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_STRUCT` node holding the struct's name, doc comment,
/// separate public/private member lists, and `is_public` visibility.
#returns_ownership
pub const make_struct_decl -> fn (name: *byte, doc_comment: *byte, public_members: **AST::AstNode,
                                  public_count: i64, private_members: **AST::AstNode, private_count: i64,
                                  is_public: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::StructDeclNode = AST::AstNode::make<AST::StructDeclNode>(
    AST::NodeType::STMT_STRUCT,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.public_members = public_members;
  n.public_count = public_count;
  n.private_members = private_members;
  n.private_count = private_count;
  n.is_public = is_public;
  n.type_params = cast<**byte>(0);
  n.type_param_count = 0;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_FIELD_DECL` node for one struct member: a data field with
/// `type_node`, a method with a `function` node, or an embedded type.
#returns_ownership
pub const make_field_decl -> fn (name: *byte, doc_comment: *byte, type_node: *AST::AstNode,
                                 function: *AST::AstNode, is_public: i64, is_embedded: i64,
                                 is_static: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::FieldDeclNode = AST::AstNode::make<AST::FieldDeclNode>(
    AST::NodeType::STMT_FIELD_DECL,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.type_node = type_node;
  n.function = function;
  n.is_public = is_public;
  n.is_embedded = is_embedded;
  n.is_static = is_static;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_ENUM` node with the enum's name, doc comment, member name
/// list (`member_count` entries), and `is_public` visibility.
#returns_ownership
pub const make_enum_decl -> fn (name: *byte, doc_comment: *byte, members: **byte,
                                member_count: i64, is_public: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::EnumDeclNode = AST::AstNode::make<AST::EnumDeclNode>(
    AST::NodeType::STMT_ENUM,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.name = name;
  n.doc_comment = doc_comment;
  n.members = members;
  n.member_count = member_count;
  n.is_public = is_public;
  n.type_params = cast<**byte>(0);
  n.type_param_count = 0;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_IF` node from the `condition`, `then_stmt`, an `elif_stmts`
/// list (`elif_count` entries), and an optional `else_stmt`.
#returns_ownership
pub const make_if_stmt -> fn (condition: *AST::AstNode, then_stmt: *AST::AstNode, elif_stmts: **AST::AstNode,
                              elif_count: i64, else_stmt: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::IfStmtNode = AST::AstNode::make<AST::IfStmtNode>(
    AST::NodeType::STMT_IF,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.condition = condition;
  n.then_stmt = then_stmt;
  n.elif_stmts = elif_stmts;
  n.elif_count = elif_count;
  n.else_stmt = else_stmt;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_LOOP` node from the `condition`, optional step clause,
/// loop `body`, and an `initializer` list (`init_count` entries).
#returns_ownership
pub const make_loop_stmt -> fn (condition: *AST::AstNode, optional: *AST::AstNode, body: *AST::AstNode,
                                initializer: **AST::AstNode, init_count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::LoopStmtNode = AST::AstNode::make<AST::LoopStmtNode>(
    AST::NodeType::STMT_LOOP,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.condition = condition;
  n.optional = optional;
  n.body = body;
  n.initializer = initializer;
  n.init_count = init_count;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_RETURN` node wrapping the returned expression `value`.
#returns_ownership
pub const make_return_stmt -> fn (value: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::ReturnStmtNode = AST::AstNode::make<AST::ReturnStmtNode>(
    AST::NodeType::STMT_RETURN,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.value = value;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_BLOCK` node from a list of `statements` (`stmt_count`).
#returns_ownership
pub const make_block -> fn (statements: **AST::AstNode, stmt_count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::BlockNode = AST::AstNode::make<AST::BlockNode>(
    AST::NodeType::STMT_BLOCK,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.statements = statements;
  n.stmt_count = stmt_count;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_PRINT` node for `print(...)`: a list of `expressions`
/// (`expr_count`), with `ln` selecting the newline-emitting form.
#returns_ownership
pub const make_print_stmt -> fn (expressions: **AST::AstNode, expr_count: i64, ln: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::PrintStmtNode = AST::AstNode::make<AST::PrintStmtNode>(
    AST::NodeType::STMT_PRINT,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.expressions = expressions;
  n.expr_count = expr_count;
  n.ln = ln;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_BREAK_CONTINUE` node; `is_continue` selects `continue`
/// (1) over `break` (0).
#returns_ownership
pub const make_break_continue -> fn (is_continue: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::BreakContinueNode = AST::AstNode::make<AST::BreakContinueNode>(
    AST::NodeType::STMT_BREAK_CONTINUE,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.is_continue = is_continue;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_DEFER` node wrapping the deferred `statement`.
#returns_ownership
pub const make_defer_stmt -> fn (statement: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::DeferNode = AST::AstNode::make<AST::DeferNode>(
    AST::NodeType::STMT_DEFER,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.statement = statement;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_SWITCH` node from the `condition`, a `cases` list
/// (`case_count`), and an optional `default_case`.
#returns_ownership
pub const make_switch_stmt -> fn (condition: *AST::AstNode, cases: **AST::AstNode, case_count: i64,
                                  default_case: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::SwitchNode = AST::AstNode::make<AST::SwitchNode>(
    AST::NodeType::STMT_SWITCH,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.condition = condition;
  n.cases = cases;
  n.case_count = case_count;
  n.default_case = default_case;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_IMPL` node connecting function names/types to struct names
/// with a body: `impl fn1, fn2 for Struct1, Struct2 { ... }`.
#returns_ownership
pub const make_impl_stmt -> fn (function_name_list: **byte, function_type_list: **AST::AstNode, struct_name_list: **byte,
                                function_name_count: i64, struct_name_count: i64, body: *AST::AstNode,
                                line: i64, col: i64) *AST::AstNode {
  let n: *AST::ImplNode = AST::AstNode::make<AST::ImplNode>(
    AST::NodeType::STMT_IMPL,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.function_name_list = function_name_list;
  n.function_type_list = function_type_list;
  n.struct_name_list = struct_name_list;
  n.function_name_count = function_name_count;
  n.struct_name_count = struct_name_count;
  n.body = body;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_CASE` node for one switch case: the match `values` list
/// (`value_count`) and its `body`.
#returns_ownership
pub const make_case_stmt -> fn (values: **AST::AstNode, value_count: i64, body: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::CaseNode = AST::AstNode::make<AST::CaseNode>(
    AST::NodeType::STMT_CASE,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.values = values;
  n.value_count = value_count;
  n.body = body;

  return cast<*AST::AstNode>(n);
}

/// Builds a `STMT_DEFAULT` node holding a switch default case's `body`.
#returns_ownership
pub const make_default_stmt -> fn (body: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::DefaultNode = AST::AstNode::make<AST::DefaultNode>(
    AST::NodeType::STMT_DEFAULT,
    AST::NodeCategory::Node_Category_STMT,
    line,
    col
  );

  n.body = body;
  
  return cast<*AST::AstNode>(n);
}
