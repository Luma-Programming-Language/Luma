#returns_ownership
pub const make_switch_stmt -> fn (condition: *AST::AstNode, cases: **AST::AstNode, case_count: int,
                                  default_case: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let n: *AST::SwitchNode = cast<*AST::SwitchNode>(alloc(sizeof<AST::SwitchNode>));

  n.kind = AST::NodeType::STMT_SWITCH;
  n.category = AST::NodeCategory::Node_Category_STMT;
  n.line = line;
  n.col = col;

  n.condition = condition;
  n.cases = cases;
  n.case_count = case_count;
  n.default_case = default_case;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_impl_stmt -> fn (function_name_list: **byte, function_type_list: **AST::AstNode, struct_name_list: **byte,
                                function_name_count: int, struct_name_count: int, body: *AST::AstNode,
                                line: int, col: int) *AST::AstNode {
  let n: *AST::ImplNode = cast<*AST::ImplNode>(alloc(sizeof<AST::ImplNode>));

  n.kind = AST::NodeType::STMT_IMPL;
  n.category = AST::NodeCategory::Node_Category_STMT;
  n.line = line;
  n.col = col;

  n.function_name_list = function_name_list;
  n.function_type_list = function_type_list;
  n.struct_name_list = struct_name_list;
  n.function_name_count = function_name_count;
  n.struct_name_count = struct_name_count;
  n.body = body;

  return cast<*AST::AstNode>(n);
}

