@module "ast_type"

@use "ast" as AST

#returns_ownership
pub const make_basic_type -> fn (name: *byte, line: i64, col: i64) *AST::AstNode {
  let n: *AST::BasicTypeNode = AST::AstNode::make<AST::BasicTypeNode>(
    AST::NodeType::TYPE_BASIC,
    AST::NodeCategory::Node_Category_TYPE,
    line,
    col
  );

  n.name = name;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;
  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_pointer_type -> fn (pointee_type: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::PointerTypeNode = AST::AstNode::make<AST::PointerTypeNode>(
    AST::NodeType::TYPE_POINTER,
    AST::NodeCategory::Node_Category_TYPE,
    line,
    col
  );
  n.pointee_type = pointee_type;
  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_array_type -> fn (element_type: *AST::AstNode, size: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::ArrayTypeNode = AST::AstNode::make<AST::ArrayTypeNode>(
    AST::NodeType::TYPE_ARRAY,
    AST::NodeCategory::Node_Category_TYPE,
    line,
    col
  );
  n.element_type = element_type;
  n.size = size;
  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_func_type -> fn (param_types: **AST::AstNode, param_count: i64, return_type: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::FuncTypeNode = AST::AstNode::make<AST::FuncTypeNode>(
    AST::NodeType::TYPE_FUNCTION,
    AST::NodeCategory::Node_Category_TYPE,
    line,
    col
  );
  n.param_types = param_types;
  n.param_count = param_count;
  n.return_type = return_type;
  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_resolution_type -> fn (parts: **byte, part_count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::ResolutionNode = AST::AstNode::make<AST::ResolutionNode>(
    AST::NodeType::TYPE_RESOLUTION,
    AST::NodeCategory::Node_Category_TYPE,
    line,
    col
  );
  n.parts = parts;
  n.part_count = part_count;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;
  return cast<*AST::AstNode>(n);
}
