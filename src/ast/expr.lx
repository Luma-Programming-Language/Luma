  n.name = name;
  n.alias = alias;
  n.field_names = field_names;
  n.field_vals = field_vals;
  n.field_count = field_count;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;

  return cast<*AST::AstNode>(n);
}

