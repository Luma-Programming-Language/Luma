#returns_ownership
pub const make_binary -> fn (op: int, left: *AST::AstNode, right: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let n: *AST::BinaryNode = AST::AstNode::make<AST::BinaryNode>(
    AST::NodeType::EXPR_BINARY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.op = op;
  n.left = left;
  n.right = right;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_unary -> fn (op: int, operand: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let n: *AST::UnaryNode = AST::AstNode::make<AST::UnaryNode>(
    AST::NodeType::EXPR_UNARY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.op = op;
  n.operand = operand;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_call -> fn (callee: *AST::AstNode, args: **AST::AstNode, arg_count: int, line: int, col: int) *AST::AstNode {
  let n: *AST::CallNode = AST::AstNode::make<AST::CallNode>(
    AST::NodeType::EXPR_CALL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.callee = callee;
  n.args = args;
  n.arg_count = arg_count;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;

  return cast<*AST::AstNode>(n);
}

