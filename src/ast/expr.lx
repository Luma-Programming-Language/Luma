#returns_ownership
pub const make_call -> fn (callee: *AST::AstNode, args: **AST::AstNode, arg_count: int, line: int, col: int) *AST::AstNode {
  let n: *AST::CallNode = cast<*AST::CallNode>(alloc(sizeof<AST::CallNode>));
  
  n.kind = AST::NodeType::EXPR_CALL;
  n.category = AST::NodeCategory::Node_Category_EXPR;
  n.line = line;
  n.col = col;

  n.callee = callee;
  n.args = args;
  n.arg_count = arg_count;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;

  return cast<*AST::AstNode>(n);
}

