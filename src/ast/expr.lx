//! Expression AST node constructors.
//!
//! Factory functions that allocate each kind of expression node used by the
//! parser and return it as a generic `*AST::AstNode`.

@module "ast_expr"

@use "ast" as AST

/// Creates an integer literal expression node.
#returns_ownership
pub const make_literal_int -> fn (int_val: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_INT;
  n.int_val = int_val;

  return cast<*AST::AstNode>(n);
}

/// Creates a float literal expression node.
#returns_ownership
pub const make_literal_float -> fn (float_src: *byte, float_val: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_FLOAT;
  n.float_val = float_val;
  n.float_src = float_src;

  return cast<*AST::AstNode>(n);
}

