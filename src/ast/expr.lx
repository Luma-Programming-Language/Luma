#returns_ownership
pub const make_literal_string -> fn (string_val: *byte, line: i64, col: i64) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_STRING;
  n.string_val = string_val;

  return cast<*AST::AstNode>(n);
}

