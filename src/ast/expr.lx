    col
  );

  n.condition = condition;
  n.then_expr = then_expr;
  n.else_expr = else_expr;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_member -> fn (object: *AST::AstNode, member: *byte, is_compiletime: int, line: int, col: int) *AST::AstNode {
