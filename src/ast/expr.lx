@module "ast_expr"

@use "ast" as AST

#returns_ownership
pub const make_literal_int -> fn (int_val: int, line: int, col: int) *AST::AstNode {
  let n: *AST::LiteralNode = cast<*AST::LiteralNode>(alloc(sizeof<AST::LiteralNode>));  

  n.kind = AST::NodeType::EXPR_LITERAL;
  n.category = AST::NodeCategory::Node_Category_EXPR;
  n.line = line;
  n.col = col;

  n.lit_type = AST::LiteralType::LITERAL_INT;
  n.int_val = int_val;

  return cast<*AST::AstNode>(n);
}

