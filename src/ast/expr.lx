#returns_ownership
pub const make_struct_expr -> fn (name: *byte, alias: *byte, field_names: **byte, field_vals: **AST::AstNode, field_count: int, line: int, col: int) *AST::AstNode {
  let n: *AST::StructExprNode = cast<*AST::StructExprNode>(alloc(sizeof<AST::StructExprNode>));

