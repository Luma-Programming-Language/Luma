@module "ast_expr"

@use "ast" as AST

#returns_ownership
pub const make_literal_int -> fn (int_val: int, line: int, col: int) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_INT;
  n.int_val = int_val;

  return cast<*AST::AstNode>(n);
}

#returns_ownership
pub const make_literal_float -> fn (float_val: int, line: int, col: int) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
