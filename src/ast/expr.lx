#returns_ownership
pub const make_literal_char -> fn (char_val: byte, line: i64, col: i64) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_CHAR;
  n.char_val = char_val;

  return cast<*AST::AstNode>(n);
}

/// Creates a boolean literal expression node.
#returns_ownership
pub const make_literal_bool -> fn (bool_val: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_BOOL;
  n.bool_val = bool_val;

  return cast<*AST::AstNode>(n);
}

/// Creates a null literal expression node.
#returns_ownership
pub const make_literal_null -> fn (line: i64, col: i64) *AST::AstNode {
  let n: *AST::LiteralNode = AST::AstNode::make<AST::LiteralNode>(
    AST::NodeType::EXPR_LITERAL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.lit_type = AST::LiteralType::LITERAL_NULL;

  return cast<*AST::AstNode>(n);
}

/// Creates an identifier expression node.
#returns_ownership
pub const make_identifier -> fn (name: *byte, line: i64, col: i64) *AST::AstNode {
  let n: *AST::IdentifierNode = AST::AstNode::make<AST::IdentifierNode>(
    AST::NodeType::EXPR_IDENTIFIER,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.name = name;

  return cast<*AST::AstNode>(n);
}

/// Creates a binary expression node from an operator and two operands.
#returns_ownership
pub const make_binary -> fn (op: i64, left: *AST::AstNode, right: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::BinaryNode = AST::AstNode::make<AST::BinaryNode>(
    AST::NodeType::EXPR_BINARY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.op = op;
  n.left = left;
  n.right = right;

  return cast<*AST::AstNode>(n);
}

/// Creates a unary expression node from an operator and one operand.
#returns_ownership
pub const make_unary -> fn (op: i64, operand: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::UnaryNode = AST::AstNode::make<AST::UnaryNode>(
    AST::NodeType::EXPR_UNARY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.op = op;
  n.operand = operand;

  return cast<*AST::AstNode>(n);
}

/// Creates a function-call expression node.
#returns_ownership
pub const make_call -> fn (callee: *AST::AstNode, args: **AST::AstNode, arg_count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::CallNode = AST::AstNode::make<AST::CallNode>(
    AST::NodeType::EXPR_CALL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.callee = callee;
  n.args = args;
  n.arg_count = arg_count;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;

  return cast<*AST::AstNode>(n);
}

/// Creates an assignment expression node.
#returns_ownership
pub const make_assign -> fn (target: *AST::AstNode, value: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::AssignNode = AST::AstNode::make<AST::AssignNode>(
    AST::NodeType::EXPR_ASSIGNMENT,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.target = target;
  n.value = value;

  return cast<*AST::AstNode>(n);
}

/// Creates a ternary (`condition ? then_expr : else_expr`) expression node.
#returns_ownership
pub const make_ternary -> fn (condition: *AST::AstNode, then_expr: *AST::AstNode, else_expr: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::TernaryNode = AST::AstNode::make<AST::TernaryNode>(
    AST::NodeType::EXPR_TERNARY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.condition = condition;
  n.then_expr = then_expr;
  n.else_expr = else_expr;

  return cast<*AST::AstNode>(n);
}

/// Creates a member-access expression node (`object.member`).
#returns_ownership
pub const make_member -> fn (object: *AST::AstNode, member: *byte, is_compiletime: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::MemberNode = AST::AstNode::make<AST::MemberNode>(
    AST::NodeType::EXPR_MEMBER,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.is_compiletime = is_compiletime;
  n.object = object;
  n.member = member;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;

  return cast<*AST::AstNode>(n);
}

/// Creates an index expression node (`object[index]`).
#returns_ownership
pub const make_index -> fn (object: *AST::AstNode, index: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::IndexNode = AST::AstNode::make<AST::IndexNode>(
    AST::NodeType::EXPR_INDEX,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.object = object;
  n.index = index;

  return cast<*AST::AstNode>(n);
}

/// Creates an array-literal expression node.
#returns_ownership
pub const make_array -> fn (elements: **AST::AstNode, element_count: i64, target_size: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::ArrayNode = AST::AstNode::make<AST::ArrayNode>(
    AST::NodeType::EXPR_ARRAY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.elements = elements;
  n.element_count = element_count;
  n.target_size = target_size;

  return cast<*AST::AstNode>(n);
}

/// Creates a cast expression node.
#returns_ownership
pub const make_cast -> fn (type_node: *AST::AstNode, castee: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::CastNode = AST::AstNode::make<AST::CastNode>(
    AST::NodeType::EXPR_CAST,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.type_node = type_node;
  n.castee = castee;

  return cast<*AST::AstNode>(n);
}

/// Creates a memory-allocation (`alloc`) expression node.
#returns_ownership
pub const make_alloc -> fn (size: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::AllocNode = AST::AstNode::make<AST::AllocNode>(
    AST::NodeType::EXPR_ALLOC,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.size = size;

  return cast<*AST::AstNode>(n);
}

/// Creates a memory-free (`free`) expression node.
#returns_ownership
pub const make_free -> fn (ptr: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::FreeNode = AST::AstNode::make<AST::FreeNode>(
    AST::NodeType::EXPR_FREE,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.ptr = ptr;

  return cast<*AST::AstNode>(n);
}

/// Creates a `memcpy` expression node (`to`, `from`, `size`).
#returns_ownership
pub const make_memcpy -> fn (to: *AST::AstNode, from: *AST::AstNode, size: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::MemcpyNode = AST::AstNode::make<AST::MemcpyNode>(
    AST::NodeType::EXPR_MEMCPY,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.to = to;
  n.from = from;
  n.size = size;

  return cast<*AST::AstNode>(n);
}

/// Creates a `sizeof` expression node; `is_type` selects a type operand
/// over a value operand.
#returns_ownership
pub const make_sizeof -> fn (object: *AST::AstNode, is_type: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::SizeofNode = AST::AstNode::make<AST::SizeofNode>(
    AST::NodeType::EXPR_SIZEOF,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.object = object;
  n.is_type = is_type;

  return cast<*AST::AstNode>(n);
}

/// Creates a `syscall` expression node.
#returns_ownership
pub const make_syscall -> fn (args: **AST::AstNode, count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::SyscallNode = AST::AstNode::make<AST::SyscallNode>(
    AST::NodeType::EXPR_SYSCALL,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.args = args;
  n.count = count;

  return cast<*AST::AstNode>(n);
}

/// Creates a struct-literal expression node.
#returns_ownership
pub const make_struct_expr -> fn (name: *byte, alias: *byte, field_names: **byte, field_vals: **AST::AstNode, field_count: i64, line: i64, col: i64) *AST::AstNode {
  let n: *AST::StructExprNode = AST::AstNode::make<AST::StructExprNode>(
    AST::NodeType::EXPR_STRUCT,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.name = name;
  n.alias = alias;
  n.field_names = field_names;
  n.field_vals = field_vals;
  n.field_count = field_count;
  n.type_args = cast<**AST::AstNode>(0);
  n.type_arg_count = 0;

  return cast<*AST::AstNode>(n);
}

/// Creates a pointer-dereference expression node.
#returns_ownership
pub const make_deref -> fn (operand: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::UnaryNode = AST::AstNode::make<AST::UnaryNode>(
    AST::NodeType::EXPR_DEREF,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.op = AST::UnaryType::UNOP_DEREF;
  n.operand = operand;

  return cast<*AST::AstNode>(n);
}

/// Creates an address-of expression node.
#returns_ownership
pub const make_addr -> fn (operand: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::UnaryNode = AST::AstNode::make<AST::UnaryNode>(
    AST::NodeType::EXPR_ADDR,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.op = AST::UnaryType::UNOP_ADDR;
  n.operand = operand;

  return cast<*AST::AstNode>(n);
}

/// Creates a parenthesized grouping expression node.
#returns_ownership
pub const make_grouping -> fn (expr: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::UnaryNode = AST::AstNode::make<AST::UnaryNode>(
    AST::NodeType::EXPR_GROUPING,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.operand = expr;

  return cast<*AST::AstNode>(n);
}

/// Creates an input expression node that reads a value of `type_node`,
/// optionally prompting with `msg`.
#returns_ownership
pub const make_input -> fn (type_node: *AST::AstNode, msg: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::CastNode = AST::AstNode::make<AST::CastNode>(
    AST::NodeType::EXPR_INPUT,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.type_node = type_node;
  n.castee = msg;

  return cast<*AST::AstNode>(n);
}

/// Creates a `system` command-execution expression node.
#returns_ownership
pub const make_system -> fn (command: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let n: *AST::UnaryNode = AST::AstNode::make<AST::UnaryNode>(
    AST::NodeType::EXPR_SYSTEM,
    AST::NodeCategory::Node_Category_EXPR,
    line,
    col
  );

  n.operand = command;

  return cast<*AST::AstNode>(n);
}
