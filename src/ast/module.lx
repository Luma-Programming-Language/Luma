@module "ast_module"

@use "ast" as AST
@use "lexer_tokens" as TOK

#returns_ownership
pub const make_module -> fn (name: *byte, doc_comment: *byte, file_path: *byte,
                            body: **AST::AstNode, body_count: int, line: int, col: int,
                            source: *byte, tokens: *TOK::Token, token_count: int) *AST::AstNode {
  let node: *AST::ModuleNode = cast<*AST::ModuleNode>(alloc(sizeof<AST::ModuleNode>));

  node.kind = AST::NodeType::PREPROCESSOR_MODULE;
  node.category = AST::NodeCategory::Node_Category_PREPROCESSOR;
  node.line = line;
  node.col = col;

  node.name = name;
  node.doc_comment = doc_comment;
  node.file_path = file_path;
  node.body = body;
  node.body_count = body_count;

  node.source = source;
  node.tokens = tokens;
  node.token_count = token_count;

  return cast<*AST::AstNode>(node);
}

#returns_ownership
pub const make_use -> fn (module_name: *byte, alias: *byte, line: int, col: int) *AST::AstNode {
  let node: *AST::UseNode = cast<*AST::UseNode>(alloc(sizeof<AST::UseNode>));

  node.kind = AST::NodeType::PREPROCESSOR_USE;
  node.category = AST::NodeCategory::Node_Category_PREPROCESSOR;
  node.line = line;
  node.col = col;

  node.module_name=  module_name;
  node.alias = alias;

  return cast<*AST::AstNode>(node);
}

#returns_ownership
pub const make_os -> fn (platforms: **byte, bodies: **AST::AstNode, has_default: int, 
                         default_body: *AST::AstNode, line: int, col: int) *AST::AstNode {
  let node: *AST::OsNode = cast<*AST::OsNode>(alloc(sizeof<AST::OsNode>));

  node.kind = AST::NodeType::PREPROCESSOR_OS;
  node.category = AST::NodeCategory::Node_Category_PREPROCESSOR;
  node.line = line;
  node.col = col;

  node.platforms = platforms;
  node.bodies = bodies;
  node.has_default = has_default;
  node.default_body = default_body;

  return cast<*AST::AstNode>(node);
}

#returns_ownership
pub const make_link -> fn (lib_name: *byte, line: int, col: int) *AST::AstNode {
  let node: *AST::LinkNode = cast<*AST::LinkNode>(alloc(sizeof<AST::LinkNode>));

  node.kind = AST::NodeType::PREPROCESSOR_LINK;
  node.category = AST::NodeCategory::Node_Category_PREPROCESSOR;
  node.line = line;
  node.col = col;

  node.lib_name = lib_name;

  return cast<*AST::AstNode>(node);
}