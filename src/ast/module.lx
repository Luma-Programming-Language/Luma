@module "ast_module"

@use "ast" as AST
@use "lexer_tokens" as TOK

#returns_ownership
pub const make_module -> fn (name: *byte, doc_comment: *byte, file_path: *byte,
                            body: **AST::AstNode, body_count: i64, line: i64, col: i64,
                            source: *byte, tokens: *TOK::Token, token_count: i64) *AST::AstNode {
  let node: *AST::ModuleNode = AST::AstNode::make<AST::ModuleNode>(
    AST::NodeType::PREPROCESSOR_MODULE,
    AST::NodeCategory::Node_Category_PREPROCESSOR,
    line,
    col
  );

  node.name = name;
  node.doc_comment = doc_comment;
  node.file_path = file_path;
  node.body = body;
  node.body_count = body_count;

  node.source = source;
  node.tokens = tokens;
  node.token_count = token_count;

  return cast<*AST::AstNode>(node);
}

#returns_ownership
pub const make_use -> fn (module_name: *byte, alias: *byte, line: i64, col: i64) *AST::AstNode {
  let node: *AST::UseNode = AST::AstNode::make<AST::UseNode>(
    AST::NodeType::PREPROCESSOR_USE,
    AST::NodeCategory::Node_Category_PREPROCESSOR,
    line,
    col
  );

  node.module_name=  module_name;
  node.alias = alias;

  return cast<*AST::AstNode>(node);
}

#returns_ownership
pub const make_os -> fn (platforms: **byte, bodies: **AST::AstNode, has_default: i64, 
                         default_body: *AST::AstNode, line: i64, col: i64) *AST::AstNode {
  let node: *AST::OsNode = AST::AstNode::make<AST::OsNode>(
    AST::NodeType::PREPROCESSOR_OS,
    AST::NodeCategory::Node_Category_PREPROCESSOR,
    line,
    col
  );

  node.platforms = platforms;
  node.bodies = bodies;
  node.has_default = has_default;
  node.default_body = default_body;

  return cast<*AST::AstNode>(node);
}

#returns_ownership
pub const make_link -> fn (lib_name: *byte, line: i64, col: i64) *AST::AstNode {
  let node: *AST::LinkNode = AST::AstNode::make<AST::LinkNode>(
    AST::NodeType::PREPROCESSOR_LINK,
    AST::NodeCategory::Node_Category_PREPROCESSOR,
    line,
    col
  );

  node.lib_name = lib_name;

  return cast<*AST::AstNode>(node);
}