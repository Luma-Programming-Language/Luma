@module "ast"

@use "lexer_tokens" as TOK
@use "std_cstring"  as STR
@use "std_memory"   as MEM

pub const NodeType -> enum {
  PREPROCESSOR_MODULE,
  PREPROCESSOR_USE,
  PREPROCESSOR_OS,
  PREPROCESSOR_LINK,

  EXPR_LITERAL,
  EXPR_IDENTIFIER,
  EXPR_BINARY,
  EXPR_UNARY,
  EXPR_CALL,
  EXPR_ASSIGNMENT,
  EXPR_TERNARY,
  EXPR_MEMBER,
  EXPR_INDEX,
  EXPR_GROUPING,
  EXPR_RANGE,
  EXPR_ARRAY,
  EXPR_DEREF,
  EXPR_ADDR,
  EXPR_ALLOC,
  EXPR_MEMCPY,
  EXPR_FREE,
  EXPR_CAST,
  EXPR_INPUT,
  EXPR_SIZEOF,
  EXPR_SYSTEM,
  EXPR_SYSCALL,
  EXPR_STRUCT,

  PROGRAM,
  STMT_EXPRESSION,
  STMT_VAR_DECL,
  STMT_CONST_DECL,
  STMT_FUNCTION,
  STMT_IF,
  STMT_LOOP,
  STMT_BREAK_CONTINUE,
  STMT_RETURN,
  STMT_BLOCK,
  STMT_PRINT,
  STMT_MODULE,
  STMT_ENUM,
  STMT_STRUCT,
  STMT_FIELD_DECL,
  STMT_DEFER,
  STMT_SWITCH,
  STMT_IMPL,
  STMT_CASE,
  STMT_DEFAULT,

  TYPE_RESOLUTION,
  TYPE_BASIC,
  TYPE_POINTER,
  TYPE_ARRAY,
  TYPE_FUNCTION,
  TYPE_STRUCT,
  TYPE_ENUM,
};

pub const LiteralType -> enum {
  LITERAL_IDENT,
  LITERAL_INT,
  LITERAL_FLOAT,
  LITERAL_DOUBLE,
  LITERAL_STRING,
  LITERAL_CHAR,
  LITERAL_BOOL,
  LITERAL_NULL
};

pub const BinaryOp -> enum {
  BINOP_ADD,
  BINOP_SUB,
  BINOP_MUL,
  BINOP_DIV,
  BINOP_MOD,
  BINOP_POW,
  BINOP_EQ,
  BINOP_NE,
  BINOP_LT,
  BINOP_LE,
  BINOP_GT,
  BINOP_GE,
  BINOP_AND,
  BINOP_OR,
  BINOP_BIT_AND,
  BINOP_BIT_OR,
  BINOP_BIT_XOR,
  BINOP_SHL,
  BINOP_SHR,
  BINOP_RANGE,
};

pub const UnaryType -> enum {
  UNOP_NOT,
  UNOP_NEG,
  UNOP_POS,
  UNOP_BIT_NOT,
  UNOP_PRE_INC,
  UNOP_PRE_DEC,
  UNOP_POST_INC,
  UNOP_POST_DEC,
  UNOP_DEREF,
  UNOP_ADDR,
};

pub const NodeCategory -> enum {
  Node_Category_EXPR,
  Node_Category_STMT,
  Node_Category_TYPE,
  Node_Category_PREPROCESSOR
};

// ─── Base Node ───────────────────────────────────────────────────────────────

pub const AstNode -> struct {
  kind:     int,
  category: int,
  line:     int,
  col:      int,

  // Filled in by the typechecker (tc_expr's `typecheck_expression` wrapper)
  // for every expression node it successfully checks. Not owned — points at
  // a type node living in some scope's symbol table or a `TAST::make_*`
  // allocation; never freed via this field. Lets codegen read an already
  // -computed static type straight off the AST instead of re-inferring it.
  resolved_type: *AstNode,
};

#returns_ownership
pub const make_node -> fn<T> (kind: int, cat: int, line: int, col: int) *AstNode {
  let n: *T = cast<*T>(alloc(sizeof<T>));

  n.kind = kind;
  n.category = cat;
  n.line = line;
  n.col = col;

  return cast<*AstNode>(n);
}

// ─── Preprocessor Nodes ──────────────────────────────────────────────────────

pub const ModuleNode -> struct {
  ...AstNode,
  name:        *byte,
  doc_comment: *byte,
  file_path:   *byte,
  body:        **AstNode,
  body_count:  int,

  // Owned for the lifetime of the module so the typechecker can regenerate
  // source lines for diagnostics (see tc_error_init / generate_line).
  source:      *byte,
  tokens:      *TOK::Token,
  token_count: int,
};

pub const UseNode -> struct {
  ...AstNode,
  module_name: *byte,
  alias:       *byte,
};

pub const OsNode -> struct {
  ...AstNode,
  platforms: **byte,
  bodies: **AstNode,
  has_default: int,
  default_body: *AstNode,
};

pub const LinkNode -> struct {
  ...AstNode,
  lib_name: *byte,
};

// ─── Expression Nodes ────────────────────────────────────────────────────────

pub const LiteralNode -> struct {
  ...AstNode,
  lit_type:   int,
  int_val:    int,
  float_val:  int,
  string_val: *byte,
  char_val:   byte,
  bool_val:   int,
};

pub const IdentifierNode -> struct {
  ...AstNode,
  name: *byte,
};

pub const BinaryNode -> struct {
  ...AstNode,
  op:    int,
  left:  *AstNode,
  right: *AstNode,
};

pub const UnaryNode -> struct {
  ...AstNode,
  op:      int,
  operand: *AstNode,
};

pub const CallNode -> struct {
  ...AstNode,
  callee:    *AstNode,
  args:      **AstNode,
  arg_count: int,

  // Generics: explicit `<int>` in `add<int>(1, 2)` — empty/0 for an
  // ordinary call.
  type_args:      **AstNode,
  type_arg_count: int,
};

pub const AssignNode -> struct {
  ...AstNode,
  target: *AstNode,
  value:  *AstNode,
};

pub const TernaryNode -> struct {
  ...AstNode,
  condition: *AstNode,
  then_expr: *AstNode,
  else_expr: *AstNode,
};

pub const MemberNode -> struct {
  ...AstNode,
  is_compiletime: int,
  object:         *AstNode,
  member:         *byte,
};

pub const IndexNode -> struct {
  ...AstNode,
  object: *AstNode,
  index:  *AstNode,
};

pub const ArrayNode -> struct {
  ...AstNode,
  elements:      **AstNode,
  element_count: int,
  target_size:   int,
};

pub const CastNode -> struct {
  ...AstNode,
  type_node: *AstNode,
  castee:    *AstNode,
};

pub const AllocNode -> struct {
  ...AstNode,
  size: *AstNode,
};

pub const FreeNode -> struct {
  ...AstNode,
  ptr:  *AstNode,
};

pub const MemcpyNode -> struct {
  ...AstNode,
  to:   *AstNode,
  from: *AstNode,
  size: *AstNode,
};

pub const SizeofNode -> struct {
  ...AstNode,
  object:  *AstNode,
  is_type: int,
};

pub const SyscallNode -> struct {
  ...AstNode,
  args:  **AstNode,
  count: int,
};

pub const StructExprNode -> struct {
  ...AstNode,
  name:        *byte,
  // Set only when written as `ALIAS::Name { ... }` — null for a bare
  // `Name { ... }`. See tc_expr.lx's tc_struct_expr: a bare reference to an
  // imported (non-local) struct is now an error.
  alias:       *byte,
  field_names: **byte,
  field_vals:  **AstNode,
  field_count: int,

  // Generics: the optional explicit form `Box<int> { value: 42 }` — empty/0
  // when omitted, which is the common case (T is inferred from context
  // instead; see tc_expr.lx's tc_struct_expr).
  type_args:      **AstNode,
  type_arg_count: int,
};

// ─── Statement Nodes ─────────────────────────────────────────────────────────

pub const ProgramNode -> struct {
  ...AstNode,
  modules:      **AstNode,
  module_count: int,
};

pub const ExprStmtNode -> struct {
  ...AstNode,
  expression: *AstNode,
};

pub const VarDeclNode -> struct {
  ...AstNode,
  name:        *byte,
  doc_comment: *byte,
  var_type:    *AstNode,
  initializer: *AstNode,
  is_mutable:  int,
  is_public:   int,
};

pub const FuncDeclNode -> struct {
  ...AstNode,
  name:              *byte,
  doc_comment:       *byte,
  param_names:       **byte,
  param_types:       **AstNode,
  param_count:       int,
  return_type:       *AstNode,
  is_public:         int,
  body:              *AstNode,
  returns_ownership: int,
  takes_ownership:   int,
  forward_declared:  int,
  dll_import:        int,
  dll_name:          *byte,
  dll_callconv:      *byte,

  lib_import:        int,
  lib_name:          *byte,

  // Generics: names only (`T`, `U`, ...), no bounds. Empty/0 for an
  // ordinary, non-generic function. A generic FuncDeclNode is never
  // codegen'd directly — see tc_generics' instantiation cache, which
  // clones this node per concrete call-site type argument list.
  type_params:       **byte,
  type_param_count:  int,
};

pub const StructDeclNode -> struct {
  ...AstNode,
  name:            *byte,
  doc_comment:     *byte,
  public_members:  **AstNode,
  public_count:    int,
  private_members: **AstNode,
  private_count:   int,
  is_public:       int,

  // Generics — see FuncDeclNode.type_params above; same rules.
  type_params:       **byte,
  type_param_count:  int,
};

pub const FieldDeclNode -> struct {
  ...AstNode,
  name:        *byte,
  doc_comment: *byte,
  type_node:   *AstNode,
  function:    *AstNode,
  is_public:   int,
  // `...Type,` struct embedding (e.g. `...AstNode,`) — `name`/`type_node` are
  // still the embedded type's name, so existing consumers that don't care
  // about embedding keep working; is_embedded distinguishes it from a
  // same-named regular data field.
  is_embedded: int,
  // `static name -> fn (...) T { ... }` — a method with no implicit `self`,
  // called as `Type::name(...)` instead of `instance.name(...)`.
  is_static: int,
};

pub const EnumDeclNode -> struct {
  ...AstNode,
  name:         *byte,
  doc_comment:  *byte,
  members:      **byte,
  member_count: int,
  is_public:    int,
};

pub const IfStmtNode -> struct {
  ...AstNode,
  condition:  *AstNode,
  then_stmt:  *AstNode,
  elif_stmts: **AstNode,
  elif_count: int,
  else_stmt:  *AstNode,
};

pub const LoopStmtNode -> struct {
  ...AstNode,
  condition:   *AstNode,
  optional:    *AstNode,
  body:        *AstNode,
  initializer: **AstNode,
  init_count:  int,
};

pub const ReturnStmtNode -> struct {
  ...AstNode,
  value: *AstNode,
};

pub const BlockNode -> struct {
  ...AstNode,
  statements: **AstNode,
  stmt_count: int,
};

pub const PrintStmtNode -> struct {
  ...AstNode,
  expressions: **AstNode,
  expr_count:  int,
  ln:          int,
};

pub const BreakContinueNode -> struct {
  ...AstNode,
  is_continue: int,
};

pub const DeferNode -> struct {
  ...AstNode,
  statement: *AstNode,
};

pub const SwitchNode -> struct {
  ...AstNode,
  condition:    *AstNode,
  cases:        **AstNode,
  case_count:   int,
  default_case: *AstNode,
};

pub const ImplNode -> struct {
  ...AstNode,
  function_name_list:  **byte,
  function_type_list:  **AstNode,
  struct_name_list:    **byte,
  function_name_count: int,
  struct_name_count:   int,
  body:                *AstNode,
};

pub const CaseNode -> struct {
  ...AstNode,
  values:      **AstNode,
  value_count: int,
  body:        *AstNode,
};

pub const DefaultNode -> struct {
  ...AstNode,
  body: *AstNode,
};

// ─── Type Nodes ──────────────────────────────────────────────────────────────

pub const BasicTypeNode -> struct {
  ...AstNode,
  name: *byte,

  // Generics: `Box<int>`'s `<int>` — empty/0 for every ordinary type name,
  // which is the overwhelming majority of BasicTypeNodes; every existing
  // switch on TYPE_BASIC keeps working unchanged.
  type_args:       **AstNode,
  type_arg_count:  int,
};

pub const PointerTypeNode -> struct {
  ...AstNode,
  pointee_type: *AstNode,
};

pub const ArrayTypeNode -> struct {
  ...AstNode,
  element_type: *AstNode,
  size:         *AstNode,
};

pub const FuncTypeNode -> struct {
  ...AstNode,
  param_types: **AstNode,
  param_count: int,
  return_type: *AstNode,
};

pub const ResolutionNode -> struct {
  ...AstNode,
  parts:      **byte,
  part_count: int,
};

#takes_ownership
pub const free_node -> fn (node: *AstNode) void {
  if (node == cast<*AstNode>(0)) return;

  let kind: int = node.kind;

  // ── Preprocessor ──────────────────────────────────────────────────────────

  if (kind == NodeType::PREPROCESSOR_MODULE) {
    let n: *ModuleNode = cast<*ModuleNode>(node);
    let i: int = 0;
    loop (i < n.body_count) {
      free_node(n.body[i]);
      i = i + 1;
    }
    free(n.body);
    free(n.name);
    free(n.tokens);
    free(n.source);
    free(node);
    return;
  }

  if (kind == NodeType::PREPROCESSOR_USE) {
    let n: *UseNode = cast<*UseNode>(node);
    free(n.module_name);
    free(n.alias);
    free(node);
    return;
  }

  if (kind == NodeType::PREPROCESSOR_OS) {
    let n: *OsNode = cast<*OsNode>(node);
    let i: int = 0;
    loop (n.platforms[i] != cast<*byte>(0)) {
      free(n.platforms[i]);
      free_node(n.bodies[i]);
      i = i + 1;
    }
    free(n.platforms);
    free(n.bodies);
    free_node(n.default_body);
    free(node);
    return;
  }

  if (kind == NodeType::PREPROCESSOR_LINK) {
    let n: *LinkNode = cast<*LinkNode>(node);
    free(n.lib_name);
    free(node);
    return;
  }

  // ── Expressions ───────────────────────────────────────────────────────────

  if (kind == NodeType::EXPR_LITERAL) {
    let n: *LiteralNode = cast<*LiteralNode>(node);
    if (n.lit_type == LiteralType::LITERAL_STRING) {
      free(n.string_val);
    }
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_IDENTIFIER) {
      let n: *IdentifierNode = cast<*IdentifierNode>(node);
      free(n.name);
      free(node);
      return;
  }

  if (kind == NodeType::EXPR_BINARY || kind == NodeType::EXPR_RANGE) {
    let n: *BinaryNode = cast<*BinaryNode>(node);
    free_node(n.left);
    free_node(n.right);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_UNARY   ||
      kind == NodeType::EXPR_DEREF   ||
      kind == NodeType::EXPR_ADDR    ||
      kind == NodeType::EXPR_GROUPING ||
      kind == NodeType::EXPR_SYSTEM) {
    let n: *UnaryNode = cast<*UnaryNode>(node);
    free_node(n.operand);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_CALL) {
    let n: *CallNode = cast<*CallNode>(node);
    free_node(n.callee);
    let i: int = 0;
    loop (i < n.arg_count) {
      free_node(n.args[i]);
      i = i + 1;
    }
    free(n.args);
    let j: int = 0;
    loop (j < n.type_arg_count) {
      free_node(n.type_args[j]);
      j = j + 1;
    }
    free(n.type_args);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_ASSIGNMENT) {
    let n: *AssignNode = cast<*AssignNode>(node);
    free_node(n.target);
    free_node(n.value);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_TERNARY) {
    let n: *TernaryNode = cast<*TernaryNode>(node);
    free_node(n.condition);
    free_node(n.then_expr);
    free_node(n.else_expr);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_MEMBER) {
    let n: *MemberNode = cast<*MemberNode>(node);
    free_node(n.object);
    free(n.member);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_INDEX) {
    let n: *IndexNode = cast<*IndexNode>(node);
    free_node(n.object);
    free_node(n.index);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_ARRAY) {
    let n: *ArrayNode = cast<*ArrayNode>(node);
    let i: int = 0;
    loop (i < n.element_count) {
      free_node(n.elements[i]);
      i = i + 1;
    }
    free(n.elements);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_CAST || kind == NodeType::EXPR_INPUT) {
    let n: *CastNode = cast<*CastNode>(node);
    free_node(n.type_node);
    free_node(n.castee);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_ALLOC) {
    let n: *AllocNode = cast<*AllocNode>(node);
    free_node(n.size);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_FREE) {
    let n: *FreeNode = cast<*FreeNode>(node);
    free_node(n.ptr);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_MEMCPY) {
    let n: *MemcpyNode = cast<*MemcpyNode>(node);
    free_node(n.to);
    free_node(n.from);
    free_node(n.size);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_SIZEOF) {
    let n: *SizeofNode = cast<*SizeofNode>(node);
    free_node(n.object);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_SYSCALL) {
    let n: *SyscallNode = cast<*SyscallNode>(node);
    let i: int = 0;
    loop (i < n.count) {
      free_node(n.args[i]);
      i = i + 1;
    }
    free(n.args);
    free(node);
    return;
  }

  if (kind == NodeType::EXPR_STRUCT) {
    let n: *StructExprNode = cast<*StructExprNode>(node);
    let i: int = 0;
    loop (i < n.field_count) {
      free(n.field_names[i]);
      free_node(n.field_vals[i]);
      i = i + 1;
    }
    free(n.field_names);
    free(n.field_vals);
    let j: int = 0;
    loop (j < n.type_arg_count) {
      free_node(n.type_args[j]);
      j = j + 1;
    }
    free(n.type_args);
    free(n.name);
    free(n.alias);
    free(node);
    return;
  }

  // ── Statements ────────────────────────────────────────────────────────────

  if (kind == NodeType::PROGRAM) {
    let n: *ProgramNode = cast<*ProgramNode>(node);
    let i: int = 0;
    loop (i < n.module_count) {
      free_node(n.modules[i]);
      i = i + 1;
    }
    free(n.modules);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_EXPRESSION) {
    let n: *ExprStmtNode = cast<*ExprStmtNode>(node);
    free_node(n.expression);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_VAR_DECL || kind == NodeType::STMT_CONST_DECL) {
    let n: *VarDeclNode = cast<*VarDeclNode>(node);
    free(n.name);
    free_node(n.var_type);
    free_node(n.initializer);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_FUNCTION) {
    let n: *FuncDeclNode = cast<*FuncDeclNode>(node);
    let i: int = 0;
    loop (i < n.param_count) {
      free(n.param_names[i]);
      free_node(n.param_types[i]);
      i = i + 1;
    }
    free(n.param_names);
    free(n.param_types);
    free(n.name);
    free_node(n.return_type);
    free_node(n.body);
    let ti: int = 0;
    loop (ti < n.type_param_count) {
      free(n.type_params[ti]);
      ti = ti + 1;
    }
    free(n.type_params);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_STRUCT) {
    let n: *StructDeclNode = cast<*StructDeclNode>(node);
    let i: int = 0;
    loop (i < n.public_count) {
      free_node(n.public_members[i]);
      i = i + 1;
    }
    free(n.public_members);
    let j: int = 0;
    loop (j < n.private_count) {
      free_node(n.private_members[j]);
      j = j + 1;
    }
    free(n.private_members);
    free(n.name);
    let tk: int = 0;
    loop (tk < n.type_param_count) {
      free(n.type_params[tk]);
      tk = tk + 1;
    }
    free(n.type_params);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_FIELD_DECL) {
    let n: *FieldDeclNode = cast<*FieldDeclNode>(node);
    free(n.name);
    free_node(n.type_node);
    free_node(n.function);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_ENUM) {
    let n: *EnumDeclNode = cast<*EnumDeclNode>(node);
    let i: int = 0;
    loop (i < n.member_count) {
      free(n.members[i]);
      i = i + 1;
    }
    free(n.members);
    free(n.name);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_IF) {
    let n: *IfStmtNode = cast<*IfStmtNode>(node);
    free_node(n.condition);
    free_node(n.then_stmt);
    let i: int = 0;
    loop (i < n.elif_count) {
      free_node(n.elif_stmts[i]);
      i = i + 1;
    }
    free(n.elif_stmts);
    free_node(n.else_stmt);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_LOOP) {
    let n: *LoopStmtNode = cast<*LoopStmtNode>(node);
    free_node(n.condition);
    free_node(n.optional);
    free_node(n.body);
    let i: int = 0;
    loop (i < n.init_count) {
      free_node(n.initializer[i]);
      i = i + 1;
    }
    free(n.initializer);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_RETURN) {
    let n: *ReturnStmtNode = cast<*ReturnStmtNode>(node);
    free_node(n.value);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_BLOCK) {
    let n: *BlockNode = cast<*BlockNode>(node);
    let i: int = 0;
    loop (i < n.stmt_count) {
      free_node(n.statements[i]);
      i = i + 1;
    }
    free(n.statements);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_PRINT) {
    let n: *PrintStmtNode = cast<*PrintStmtNode>(node);
    let i: int = 0;
    loop (i < n.expr_count) {
      free_node(n.expressions[i]);
      i = i + 1;
    }
    free(n.expressions);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_BREAK_CONTINUE) {
    free(node);
    return;
  }

  if (kind == NodeType::STMT_DEFER) {
    let n: *DeferNode = cast<*DeferNode>(node);
    free_node(n.statement);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_SWITCH) {
    let n: *SwitchNode = cast<*SwitchNode>(node);
    free_node(n.condition);
    let i: int = 0;
    loop (i < n.case_count) {
      free_node(n.cases[i]);
      i = i + 1;
    }
    free(n.cases);
    free_node(n.default_case);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_IMPL) {
    let n: *ImplNode = cast<*ImplNode>(node);
    let i: int = 0;
    loop (i < n.function_name_count) {
      free(n.function_name_list[i]);
      free_node(n.function_type_list[i]);
      i = i + 1;
    }
    free(n.function_name_list);
    free(n.function_type_list);
    let j: int = 0;
    loop (j < n.struct_name_count) {
      free(n.struct_name_list[j]);
      j = j + 1;
    }
    free(n.struct_name_list);
    free_node(n.body);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_CASE) {
    let n: *CaseNode = cast<*CaseNode>(node);
    let i: int = 0;
    loop (i < n.value_count) {
      free_node(n.values[i]);
      i = i + 1;
    }
    free(n.values);
    free_node(n.body);
    free(node);
    return;
  }

  if (kind == NodeType::STMT_DEFAULT) {
    let n: *DefaultNode = cast<*DefaultNode>(node);
    free_node(n.body);
    free(node);
    return;
  }

  // ── Types ─────────────────────────────────────────────────────────────────

  if (kind == NodeType::TYPE_BASIC) {
    let n: *BasicTypeNode = cast<*BasicTypeNode>(node);
    free(n.name);
    let i: int = 0;
    loop (i < n.type_arg_count) {
      free_node(n.type_args[i]);
      i = i + 1;
    }
    free(n.type_args);
    free(node);
    return;
  }

  if (kind == NodeType::TYPE_POINTER) {
    let n: *PointerTypeNode = cast<*PointerTypeNode>(node);
    free_node(n.pointee_type);
    free(node);
    return;
  }

  if (kind == NodeType::TYPE_ARRAY) {
    let n: *ArrayTypeNode = cast<*ArrayTypeNode>(node);
    free_node(n.element_type);
    free_node(n.size);
    free(node);
    return;
  }

  if (kind == NodeType::TYPE_FUNCTION) {
    let n: *FuncTypeNode = cast<*FuncTypeNode>(node);
    let i: int = 0;
    loop (i < n.param_count) {
      free_node(n.param_types[i]);
      i = i + 1;
    }
    free(n.param_types);
    free_node(n.return_type);
    free(node);
    return;
  }

  if (kind == NodeType::TYPE_RESOLUTION) {
    let n: *ResolutionNode = cast<*ResolutionNode>(node);
    let i: int = 0;
    loop (i < n.part_count) {
      free(n.parts[i]);
      i = i + 1;
    }
    free(n.parts);
    free(node);
    return;
  }

  // Fallback
  free(node);
}

// ─── clone_node — deep copy, for generic instantiation ──────────────────────
//
// Monomorphization (see tc_generics) works by cloning a generic function's
// or struct's *entire* template AST once per distinct concrete type-argument
// list, then walking the clone substituting every type-parameter name for
// the concrete type — never mutating the template itself, and never sharing
// nodes between two instantiations (this compiler's typecheck pass mutates
// type nodes in place — e.g. tc_type's resolve_type_ref rewrites
// TYPE_RESOLUTION into TYPE_BASIC as it goes — so two instantiations
// typechecked against the *same* shared nodes would corrupt each other).
//
// Covers every node kind that can plausibly appear in a function body or a
// struct's fields/methods. Deliberately does NOT cover preprocessor nodes,
// nested struct/enum declarations, or STMT_IMPL — none of those are valid
// inside a function body or a struct's member list today, so a generic
// template containing one was already invalid before generics existed.
// Returns NULL for any node kind it doesn't handle; callers (tc_generics)
// turn that into a proper user-facing error rather than miscompiling.
#returns_ownership
pub const clone_node -> fn (node: *AstNode) *AstNode;

// Active generics substitution table for the duration of one
// clone_node_substituting call — see the TYPE_BASIC case in clone_node
// below. Empty (count 0) for a plain clone_node call, so nothing here
// changes clone_node's behavior for any non-generics caller.
let g_subst_names: **byte    = cast<**byte>(0);
let g_subst_types: **AstNode = cast<**AstNode>(0);
let g_subst_count: int       = 0;

// Deep-clones `node`, substituting every bare type name in `names[i]` for
// a clone of `types[i]` wherever clone_node's traversal reaches it (see
// the TYPE_BASIC case below) — this is how tc_generics instantiates a
// generic function/struct template for one concrete call site's type
// arguments. Reentrant: an inner clone_node_substituting call (e.g. one
// generic template's body calling another generic function) saves and
// restores the outer table around its own, narrower one.
#returns_ownership
pub const clone_node_substituting -> fn (node: *AstNode, names: **byte, types: **AstNode, count: int) *AstNode {
  let save_names: **byte    = g_subst_names;
  let save_types: **AstNode = g_subst_types;
  let save_count: int       = g_subst_count;

  g_subst_names = names;
  g_subst_types = types;
  g_subst_count = count;

  let result: *AstNode = clone_node(node);

  g_subst_names = save_names;
  g_subst_types = save_types;
  g_subst_count = save_count;

  return result;
}

#returns_ownership
const dup_str -> fn (s: *byte) *byte {
  if (s == cast<*byte>(0)) return cast<*byte>(0);
  let len: int = STR::strlen(s);
  let out: *byte = cast<*byte>(alloc(len + 1));
  MEM::memcpy(cast<*void>(out), cast<*void>(s), len + 1);
  return out;
}

#returns_ownership
const clone_node_array -> fn (arr: **AstNode, count: int) **AstNode {
  if (count == 0) return cast<**AstNode>(0);
  let out: **AstNode = cast<**AstNode>(alloc(sizeof<*AstNode> * count));
  let i: int = 0;
  loop (i < count) {
    out[i] = clone_node(arr[i]);
    i = i + 1;
  }
  return out;
}

#returns_ownership
const dup_str_array -> fn (arr: **byte, count: int) **byte {
  if (count == 0) return cast<**byte>(0);
  let out: **byte = cast<**byte>(alloc(sizeof<*byte> * count));
  let i: int = 0;
  loop (i < count) {
    out[i] = dup_str(arr[i]);
    i = i + 1;
  }
  return out;
}

#returns_ownership
pub const clone_node -> fn (node: *AstNode) *AstNode {
  if (node == cast<*AstNode>(0)) return cast<*AstNode>(0);
  let kind: int = node.kind;

  if (kind == NodeType::EXPR_LITERAL) {
    let n: *LiteralNode = cast<*LiteralNode>(node);
    let c: *LiteralNode = cast<*LiteralNode>(alloc(sizeof<LiteralNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.lit_type = n.lit_type;
    c.int_val = n.int_val;
    c.float_val = n.float_val;
    c.string_val = cast<*byte>(0);
    if (n.lit_type == LiteralType::LITERAL_STRING) { c.string_val = dup_str(n.string_val); }
    c.char_val = n.char_val;
    c.bool_val = n.bool_val;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_IDENTIFIER) {
    let n: *IdentifierNode = cast<*IdentifierNode>(node);
    let c: *IdentifierNode = cast<*IdentifierNode>(alloc(sizeof<IdentifierNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.name = dup_str(n.name);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_BINARY || kind == NodeType::EXPR_RANGE) {
    let n: *BinaryNode = cast<*BinaryNode>(node);
    let c: *BinaryNode = cast<*BinaryNode>(alloc(sizeof<BinaryNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.op = n.op;
    c.left = clone_node(n.left);
    c.right = clone_node(n.right);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_UNARY || kind == NodeType::EXPR_DEREF ||
      kind == NodeType::EXPR_ADDR  || kind == NodeType::EXPR_GROUPING ||
      kind == NodeType::EXPR_SYSTEM) {
    let n: *UnaryNode = cast<*UnaryNode>(node);
    let c: *UnaryNode = cast<*UnaryNode>(alloc(sizeof<UnaryNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.op = n.op;
    c.operand = clone_node(n.operand);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_CALL) {
    let n: *CallNode = cast<*CallNode>(node);
    let c: *CallNode = cast<*CallNode>(alloc(sizeof<CallNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.callee = clone_node(n.callee);
    c.args = clone_node_array(n.args, n.arg_count);
    c.arg_count = n.arg_count;
    c.type_args = clone_node_array(n.type_args, n.type_arg_count);
    c.type_arg_count = n.type_arg_count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_ASSIGNMENT) {
    let n: *AssignNode = cast<*AssignNode>(node);
    let c: *AssignNode = cast<*AssignNode>(alloc(sizeof<AssignNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.target = clone_node(n.target);
    c.value = clone_node(n.value);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_TERNARY) {
    let n: *TernaryNode = cast<*TernaryNode>(node);
    let c: *TernaryNode = cast<*TernaryNode>(alloc(sizeof<TernaryNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.condition = clone_node(n.condition);
    c.then_expr = clone_node(n.then_expr);
    c.else_expr = clone_node(n.else_expr);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_MEMBER) {
    let n: *MemberNode = cast<*MemberNode>(node);
    let c: *MemberNode = cast<*MemberNode>(alloc(sizeof<MemberNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.is_compiletime = n.is_compiletime;
    c.object = clone_node(n.object);
    c.member = dup_str(n.member);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_INDEX) {
    let n: *IndexNode = cast<*IndexNode>(node);
    let c: *IndexNode = cast<*IndexNode>(alloc(sizeof<IndexNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.object = clone_node(n.object);
    c.index = clone_node(n.index);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_ARRAY) {
    let n: *ArrayNode = cast<*ArrayNode>(node);
    let c: *ArrayNode = cast<*ArrayNode>(alloc(sizeof<ArrayNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.elements = clone_node_array(n.elements, n.element_count);
    c.element_count = n.element_count;
    c.target_size = n.target_size;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_CAST || kind == NodeType::EXPR_INPUT) {
    let n: *CastNode = cast<*CastNode>(node);
    let c: *CastNode = cast<*CastNode>(alloc(sizeof<CastNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.type_node = clone_node(n.type_node);
    c.castee = clone_node(n.castee);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_ALLOC) {
    let n: *AllocNode = cast<*AllocNode>(node);
    let c: *AllocNode = cast<*AllocNode>(alloc(sizeof<AllocNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.size = clone_node(n.size);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_FREE) {
    let n: *FreeNode = cast<*FreeNode>(node);
    let c: *FreeNode = cast<*FreeNode>(alloc(sizeof<FreeNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.ptr = clone_node(n.ptr);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_MEMCPY) {
    let n: *MemcpyNode = cast<*MemcpyNode>(node);
    let c: *MemcpyNode = cast<*MemcpyNode>(alloc(sizeof<MemcpyNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.to = clone_node(n.to);
    c.from = clone_node(n.from);
    c.size = clone_node(n.size);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_SIZEOF) {
    let n: *SizeofNode = cast<*SizeofNode>(node);
    let c: *SizeofNode = cast<*SizeofNode>(alloc(sizeof<SizeofNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.object = clone_node(n.object);
    c.is_type = n.is_type;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_SYSCALL) {
    let n: *SyscallNode = cast<*SyscallNode>(node);
    let c: *SyscallNode = cast<*SyscallNode>(alloc(sizeof<SyscallNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.args = clone_node_array(n.args, n.count);
    c.count = n.count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::EXPR_STRUCT) {
    let n: *StructExprNode = cast<*StructExprNode>(node);
    let c: *StructExprNode = cast<*StructExprNode>(alloc(sizeof<StructExprNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.name = dup_str(n.name);
    c.alias = dup_str(n.alias);
    c.field_names = dup_str_array(n.field_names, n.field_count);
    c.field_vals = clone_node_array(n.field_vals, n.field_count);
    c.field_count = n.field_count;
    c.type_args = clone_node_array(n.type_args, n.type_arg_count);
    c.type_arg_count = n.type_arg_count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_EXPRESSION) {
    let n: *ExprStmtNode = cast<*ExprStmtNode>(node);
    let c: *ExprStmtNode = cast<*ExprStmtNode>(alloc(sizeof<ExprStmtNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.expression = clone_node(n.expression);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_VAR_DECL || kind == NodeType::STMT_CONST_DECL) {
    let n: *VarDeclNode = cast<*VarDeclNode>(node);
    let c: *VarDeclNode = cast<*VarDeclNode>(alloc(sizeof<VarDeclNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.name = dup_str(n.name);
    c.doc_comment = dup_str(n.doc_comment);
    c.var_type = clone_node(n.var_type);
    c.initializer = clone_node(n.initializer);
    c.is_mutable = n.is_mutable;
    c.is_public = n.is_public;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_FUNCTION) {
    let n: *FuncDeclNode = cast<*FuncDeclNode>(node);
    let c: *FuncDeclNode = cast<*FuncDeclNode>(alloc(sizeof<FuncDeclNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.name = dup_str(n.name);
    c.doc_comment = dup_str(n.doc_comment);
    c.param_names = dup_str_array(n.param_names, n.param_count);
    c.param_types = clone_node_array(n.param_types, n.param_count);
    c.param_count = n.param_count;
    c.return_type = clone_node(n.return_type);
    c.is_public = n.is_public;
    c.body = clone_node(n.body);
    c.returns_ownership = n.returns_ownership;
    c.takes_ownership = n.takes_ownership;
    c.forward_declared = n.forward_declared;
    c.dll_import = n.dll_import;
    c.dll_name = dup_str(n.dll_name);
    c.dll_callconv = dup_str(n.dll_callconv);
    c.lib_import = n.lib_import;
    c.lib_name = dup_str(n.lib_name);
    // A method inside a generic struct has no type params of its own — it
    // just uses the enclosing struct's (T, U, ...), already substituted by
    // the caller before/after cloning. A directly-generic function is never
    // cloned via this path with its own params still unsubstituted — see
    // tc_generics, which substitutes as it clones.
    c.type_params = dup_str_array(n.type_params, n.type_param_count);
    c.type_param_count = n.type_param_count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_FIELD_DECL) {
    let n: *FieldDeclNode = cast<*FieldDeclNode>(node);
    let c: *FieldDeclNode = cast<*FieldDeclNode>(alloc(sizeof<FieldDeclNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.name = dup_str(n.name);
    c.doc_comment = dup_str(n.doc_comment);
    c.type_node = clone_node(n.type_node);
    c.function = clone_node(n.function);
    c.is_public = n.is_public;
    c.is_embedded = n.is_embedded;
    c.is_static = n.is_static;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_IF) {
    let n: *IfStmtNode = cast<*IfStmtNode>(node);
    let c: *IfStmtNode = cast<*IfStmtNode>(alloc(sizeof<IfStmtNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.condition = clone_node(n.condition);
    c.then_stmt = clone_node(n.then_stmt);
    c.elif_stmts = clone_node_array(n.elif_stmts, n.elif_count);
    c.elif_count = n.elif_count;
    c.else_stmt = clone_node(n.else_stmt);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_LOOP) {
    let n: *LoopStmtNode = cast<*LoopStmtNode>(node);
    let c: *LoopStmtNode = cast<*LoopStmtNode>(alloc(sizeof<LoopStmtNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.condition = clone_node(n.condition);
    c.optional = clone_node(n.optional);
    c.body = clone_node(n.body);
    c.initializer = clone_node_array(n.initializer, n.init_count);
    c.init_count = n.init_count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_RETURN) {
    let n: *ReturnStmtNode = cast<*ReturnStmtNode>(node);
    let c: *ReturnStmtNode = cast<*ReturnStmtNode>(alloc(sizeof<ReturnStmtNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.value = clone_node(n.value);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_BLOCK) {
    let n: *BlockNode = cast<*BlockNode>(node);
    let c: *BlockNode = cast<*BlockNode>(alloc(sizeof<BlockNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.statements = clone_node_array(n.statements, n.stmt_count);
    c.stmt_count = n.stmt_count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_BREAK_CONTINUE) {
    let n: *BreakContinueNode = cast<*BreakContinueNode>(node);
    let c: *BreakContinueNode = cast<*BreakContinueNode>(alloc(sizeof<BreakContinueNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.is_continue = n.is_continue;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_DEFER) {
    let n: *DeferNode = cast<*DeferNode>(node);
    let c: *DeferNode = cast<*DeferNode>(alloc(sizeof<DeferNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.statement = clone_node(n.statement);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_SWITCH) {
    let n: *SwitchNode = cast<*SwitchNode>(node);
    let c: *SwitchNode = cast<*SwitchNode>(alloc(sizeof<SwitchNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.condition = clone_node(n.condition);
    c.cases = clone_node_array(n.cases, n.case_count);
    c.case_count = n.case_count;
    c.default_case = clone_node(n.default_case);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_CASE) {
    let n: *CaseNode = cast<*CaseNode>(node);
    let c: *CaseNode = cast<*CaseNode>(alloc(sizeof<CaseNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.values = clone_node_array(n.values, n.value_count);
    c.value_count = n.value_count;
    c.body = clone_node(n.body);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::STMT_DEFAULT) {
    let n: *DefaultNode = cast<*DefaultNode>(node);
    let c: *DefaultNode = cast<*DefaultNode>(alloc(sizeof<DefaultNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.body = clone_node(n.body);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::TYPE_BASIC) {
    let n: *BasicTypeNode = cast<*BasicTypeNode>(node);

    // Generics substitution piggybacks on this existing traversal instead
    // of a second whole-tree walk: clone_node_substituting (below) sets
    // g_subst_* for the duration of one clone_node call, and every bare
    // type name clone_node reaches — a param type, a return type, a var
    // decl's type, a nested pointer/array element type, anything — passes
    // through here. A name matching one of the active generic's type
    // parameters (`T`, `U`, ...) clones the caller's concrete type instead
    // of the placeholder.
    let i: int = 0;
    loop (i < g_subst_count) {
      if (STR::strcmp(n.name, g_subst_names[i]) == 0) {
        return clone_node(g_subst_types[i]);
      }
      i = i + 1;
    }

    let c: *BasicTypeNode = cast<*BasicTypeNode>(alloc(sizeof<BasicTypeNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.name = dup_str(n.name);
    c.type_args = clone_node_array(n.type_args, n.type_arg_count);
    c.type_arg_count = n.type_arg_count;
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::TYPE_POINTER) {
    let n: *PointerTypeNode = cast<*PointerTypeNode>(node);
    let c: *PointerTypeNode = cast<*PointerTypeNode>(alloc(sizeof<PointerTypeNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.pointee_type = clone_node(n.pointee_type);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::TYPE_ARRAY) {
    let n: *ArrayTypeNode = cast<*ArrayTypeNode>(node);
    let c: *ArrayTypeNode = cast<*ArrayTypeNode>(alloc(sizeof<ArrayTypeNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.element_type = clone_node(n.element_type);
    c.size = clone_node(n.size);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::TYPE_FUNCTION) {
    let n: *FuncTypeNode = cast<*FuncTypeNode>(node);
    let c: *FuncTypeNode = cast<*FuncTypeNode>(alloc(sizeof<FuncTypeNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.param_types = clone_node_array(n.param_types, n.param_count);
    c.param_count = n.param_count;
    c.return_type = clone_node(n.return_type);
    return cast<*AstNode>(c);
  }

  if (kind == NodeType::TYPE_RESOLUTION) {
    let n: *ResolutionNode = cast<*ResolutionNode>(node);
    let c: *ResolutionNode = cast<*ResolutionNode>(alloc(sizeof<ResolutionNode>));
    c.kind = n.kind; c.category = n.category; c.line = n.line; c.col = n.col;
    c.parts = dup_str_array(n.parts, n.part_count);
    c.part_count = n.part_count;
    return cast<*AstNode>(c);
  }

  // Not supported inside a generic function/struct template — see comment
  // above clone_node's forward declaration. Caller reports this properly.
  return cast<*AstNode>(0);
}
