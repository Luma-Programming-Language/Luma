@module "lexer_tokens"

pub const LumaTokenType -> enum {
  TOK_EOF,          /**< End of file/input */
  TOK_ERROR,        /**< Error token */
  TOK_IDENTIFIER,   /**< Identifier (variable/function names) */
  TOK_KEYWORD,      /**< Reserved keyword */
  TOK_NUMBER,       /**< Numeric literal */
  TOK_NUM_FLOAT,    /**< Floating point numeric literal */
  TOK_STRING,       /**< String literal */
  TOK_CHAR_LITERAL, /**< Character literal */

  // Primitive Types
  TOK_I8,      /**< i8  - 8-bit signed integer */
  TOK_I16,     /**< i16 - 16-bit signed integer */
  TOK_I32,     /**< i32 - 32-bit signed integer */
  TOK_I64,     /**< i64 - 64-bit signed integer */
  TOK_U8,      /**< u8  - 8-bit unsigned integer */
  TOK_U16,     /**< u16 - 16-bit unsigned integer */
  TOK_U32,     /**< u32 - 32-bit unsigned integer */
  TOK_U64,     /**< u64 - 64-bit unsigned integer */
  TOK_F32,     /**< f32 - 32-bit f32 */
  TOK_F64,     /**< f64 - 64-bit f32 */
  TOK_BOOL,    /**< bool */
  TOK_VOID,    /**< void */
  TOK_CHAR,    /**< byte (8-bit unsigned char) */

  // Keywords
  TOK_IF,       /**< if keyword */
  TOK_ELIF,     /**< elif keyword */
  TOK_ELSE,     /**< else keyword */
  TOK_LOOP,     /**< loop keyword */
  TOK_RETURN,   /**< return keyword */
  TOK_BREAK,    /**< break keyword */
  TOK_CONTINUE, /**< continue keyword */
  TOK_STRUCT,   /**< struct keyword */
  TOK_ENUM,     /**< enum keyword */
  TOK_MOD,      /**< mod keyword */
  TOK_IMPORT,   /**< import keyword */
  TOK_TRUE,     /**< true keyword */
  TOK_FALSE,    /**< false keyword */
  TOK_PUBLIC,   /**< pub keyword */
  TOK_PRIVATE,  /**< private keyword */
  TOK_VAR,      /**< let keyword */
  TOK_CONST,    /**< const keyword */
  TOK_FN,       /**< fn keyword */
  TOK_INPUT,    /**< input keyword */
  TOK_ALLOC,    /**< alloc(size_t size) */
  TOK_FREE,     /**< free(void *ptr, size_t size) */
  TOK_CAST,     /**< cast<Type>(value you want to cast too) */
  TOK_SIZE_OF,  /**< size_of<TYPE> */
  TOK_AS,       /**< as keyword (for use in modules) */
  TOK_DEFER,    /**< defer keyword */
  TOK_IN,       /**< in keyword */
  TOK_SWITCH,   /**< switch keyword */
  TOK_USING,    /**< using keyword (scoped enum access in switch) */
  TOK_STATIC,   /**< static keyword (struct methods with no implicit self) */
  TOK_SYSTEM,   /**< system keyword */
  TOK_IMPL,     /**< implement keyword */
  TOK_SYSCALL,

  // prepocessor directives
  TOK_MODULE, /**< @module */
  TOK_USE,    /**< @use    */
  TOK_OS,     /**< @os     */
  TOK_LINK,   /**< @link   */

  // function attibutes
  TOK_RETURNS_OWNERSHIP, /** #returns_ownership */
  TOK_TAKES_OWNERSHIP,   /** #takes_ownership   */
  TOK_DLL_IMPORT,        /** #dll_import        */
  TOK_LIB_IMPORT,        /** #lib_import        */

  // Symbols
  TOK_SYMBOL,      /**< Fallback symbol */
  TOK_LPAREN,      /**< ( */
  TOK_RPAREN,      /**< ) */
  TOK_LBRACE,      /**< { */
  TOK_RBRACE,      /**< } */
  TOK_LBRACKET,    /**< [ */
  TOK_RBRACKET,    /**< ] */
  TOK_SEMI,        /**< ; */
  TOK_COMMA,       /**< , */
  TOK_DOT,         /**< . */
  TOK_AT,          /**< @ */
  TOK_EQUAL,       /**< = */
  TOK_PLUS,        /**< + */
  TOK_MINUS,       /**< - */
  TOK_STAR,        /**< * */
  TOK_SLASH,       /**< / */
  TOK_LT,          /**< < */
  TOK_GT,          /**< > */
  TOK_LE,          /**< <= */
  TOK_GE,          /**< >= */
  TOK_EQEQ,        /**< == */
  TOK_NEQ,         /**< != */
  TOK_AMP,         /**< & */
  TOK_PIPE,        /**< | */
  TOK_CARET,       /**< ^ */
  TOK_TILDE,       /**< ~ */
  TOK_AND,         /**< && */
  TOK_OR,          /**< || */
  TOK_RESOLVE,     /**< :: */
  TOK_COLON,       /**< : */
  TOK_BANG,        /**< ! */
  TOK_QUESTION,    /**< ? */
  TOK_PLUSPLUS,    /**< ++ */
  TOK_MINUSMINUS,  /**< -- */
  TOK_SHIFT_LEFT,  /**< << */
  TOK_SHIFT_RIGHT, /**< >> */
  TOK_RANGE,       /**< .. */
  TOK_ELLIPSIS,    /**< ... */
  TOK_RIGHT_ARROW, /**< -> */
  TOK_LEFT_ARROW,  /**< <- */
  TOK_MODL,        /**< % */
  TOK_WHITESPACE,  /**< whitespace */
  TOK_COMMENT,     /**< comment */
  TOK_DOC_COMMENT, 
  TOK_MODULE_DOC,  
  TOK_DOCUMENT     
};

pub const LexError -> struct {
  kind: i64,
  line: i64,
  col:  i64,
  len:  i64,
  bad:  byte,
};

pub const MAX_LEX_ERRORS: i64 = 32;

pub const LEX_ERR_UNKNOWN_DIRECTIVE:   i64 = 0; /**< an @word or #word that isn't a keyword */
pub const LEX_ERR_UNTERMINATED_STRING: i64 = 1; /**< string literal hitting \n or EOF without a closing " */
pub const LEX_ERR_EMPTY_CHAR:          i64 = 2; /**< '' or an opening ' run into EOF */
pub const LEX_ERR_BAD_CHAR:            i64 = 3; /**< 'a' missing its closing ', or 'ab' multi-char */
pub const LEX_ERR_INVALID_CHARACTER:   i64 = 4; /**< a character Luma has no token for (silently skipped before) */

pub const Lexer -> struct {
  current: *byte,
  src: *byte,
  line: i64, 
  col: i64,

  errors:      [LexError; 32],
  error_count: i64,
  had_error: i64,

  static make -> fn (src: *byte) Lexer {
    let lx: Lexer = Lexer {
      current: src,
      src: src,
      line: 1,
      col:  0,
      had_error: 0,
      error_count: 0,
    };

    loop [i: i64 = 0](i < MAX_LEX_ERRORS) : (++i) {
      lx.errors[i].kind = 0;
      lx.errors[i].line = 0;
      lx.errors[i].col  = 0;
      lx.errors[i].len  = 0;
      lx.errors[i].bad  = cast<byte>(0);
    }

    return lx;
  },
  
  is_end  -> fn () i64 { if(self.current[0] == '\0') return 1; return 0; },
  peek    -> fn (offset: i64) byte { return self.current[offset]; },
  advance -> fn () byte {
    let c: byte = self.peek(0);
    self.current = cast<*byte>(cast<i64>(self.current) + 1);

    switch(c) {
      '\n' -> { 
        self.line = self.line + 1;
        self.col  = 0;
      }
      _ -> {
        if (c != '\0') self.col = self.col + 1;
      }
    }

    return c;
  },
};

pub const Token -> struct {
  val:            *byte,
  kind:           i64,
  len:            i64,
  line:           i64,
  col:            i64,
  whitespace_len: i64,

  static make -> fn (
    val: *byte, 
    kind: i64, 
    len: i64, 
    line: i64, 
    col: i64, 
    whitespace_len: i64
  ) Token {
    return Token {
      val: val,
      kind: kind,
      len: len,
      line: line,
      col: col,
      whitespace_len: whitespace_len
    };
  },

  #returns_ownership
  token_value_string -> fn () *byte {
    let s: *byte = cast<*byte>(alloc((self.len + 1) * sizeof<byte>));
    loop [i: i64 = 0](i < self.len) : (++i) {
      s[i] = self.val[i];
    }  
    s[self.len] = '\0';
    return s;
  },
};

pub const lookup_single -> fn (c: byte) i64 {
  switch (c) {
    '(' -> return LumaTokenType::TOK_LPAREN;
    ')' -> return LumaTokenType::TOK_RPAREN;
    ';' -> return LumaTokenType::TOK_SEMI;
    ':' -> return LumaTokenType::TOK_COLON;
    '@' -> return LumaTokenType::TOK_AT;
    '+' -> return LumaTokenType::TOK_PLUS;
    '-' -> return LumaTokenType::TOK_MINUS;
    '*' -> return LumaTokenType::TOK_STAR;
    '/' -> return LumaTokenType::TOK_SLASH;
    '^' -> return LumaTokenType::TOK_CARET;
    '%' -> return LumaTokenType::TOK_MODL;
    '<' -> return LumaTokenType::TOK_LT;
    '>' -> return LumaTokenType::TOK_GT;
    '{' -> return LumaTokenType::TOK_LBRACE;
    '}' -> return LumaTokenType::TOK_RBRACE;
    '[' -> return LumaTokenType::TOK_LBRACKET;
    ']' -> return LumaTokenType::TOK_RBRACKET;
    ',' -> return LumaTokenType::TOK_COMMA;
    '.' -> return LumaTokenType::TOK_DOT;
    '=' -> return LumaTokenType::TOK_EQUAL;
    '&' -> return LumaTokenType::TOK_AMP;
    '|' -> return LumaTokenType::TOK_PIPE;
    '~' -> return LumaTokenType::TOK_TILDE;
    '!' -> return LumaTokenType::TOK_BANG;
    _   -> return -1;
  }
  return -1;
}

pub const lookup_double -> fn (c: byte, c2: byte) i64 {
  switch (c) {
    '=' -> { if (c2 == '=') return LumaTokenType::TOK_EQEQ;    }
    '!' -> { if (c2 == '=') return LumaTokenType::TOK_NEQ;     }
    '<' -> {
      if (c2 == '=') return LumaTokenType::TOK_LE;
      if (c2 == '<') return LumaTokenType::TOK_SHIFT_LEFT;
      if (c2 == '-') return LumaTokenType::TOK_LEFT_ARROW;
    }
    '>' -> { if (c2 == '=') return LumaTokenType::TOK_GE;      }
    '&' -> { if (c2 == '&') return LumaTokenType::TOK_AND;     }
    '|' -> { if (c2 == '|') return LumaTokenType::TOK_OR;      }
    ':' -> { if (c2 == ':') return LumaTokenType::TOK_RESOLVE; }
    '+' -> { if (c2 == '+') return LumaTokenType::TOK_PLUSPLUS; }
    '-' -> {
      if (c2 == '-') return LumaTokenType::TOK_MINUSMINUS;
      if (c2 == '>') return LumaTokenType::TOK_RIGHT_ARROW;
    }
    '.' -> { if (c2 == '.') return LumaTokenType::TOK_RANGE;   }
  }
  return -1;
}

const KEYWORD_COUNT: i64 = 52;
const Keyword -> struct { val: *byte, kind: i64 };

pub const keyword_map: [Keyword; 52] = [
  // Function attributes
  Keyword { val: "#dll_import",        kind: LumaTokenType::TOK_DLL_IMPORT },
  Keyword { val: "#lib_import",        kind: LumaTokenType::TOK_LIB_IMPORT },
  Keyword { val: "#returns_ownership", kind: LumaTokenType::TOK_RETURNS_OWNERSHIP },
  Keyword { val: "#takes_ownership",   kind: LumaTokenType::TOK_TAKES_OWNERSHIP },

  // Preprocessor directives
  Keyword { val: "@link",   kind: LumaTokenType::TOK_LINK },
  Keyword { val: "@module", kind: LumaTokenType::TOK_MODULE },
  Keyword { val: "@os",     kind: LumaTokenType::TOK_OS },
  Keyword { val: "@use",    kind: LumaTokenType::TOK_USE },

  // Built-in functions
  Keyword { val: "__syscall__", kind: LumaTokenType::TOK_SYSCALL },

  // Keywords (control flow, declarations, literals, types, builtins)
  Keyword { val: "alloc",   kind: LumaTokenType::TOK_ALLOC },
  Keyword { val: "as",      kind: LumaTokenType::TOK_AS },
  Keyword { val: "bool",    kind: LumaTokenType::TOK_BOOL },
  Keyword { val: "break",   kind: LumaTokenType::TOK_BREAK },
  Keyword { val: "byte",    kind: LumaTokenType::TOK_CHAR },
  Keyword { val: "cast",    kind: LumaTokenType::TOK_CAST },
  Keyword { val: "const",   kind: LumaTokenType::TOK_CONST },
  Keyword { val: "continue", kind: LumaTokenType::TOK_CONTINUE },
  Keyword { val: "defer",   kind: LumaTokenType::TOK_DEFER },
  Keyword { val: "elif",    kind: LumaTokenType::TOK_ELIF },
  Keyword { val: "else",    kind: LumaTokenType::TOK_ELSE },
  Keyword { val: "enum",    kind: LumaTokenType::TOK_ENUM },
  Keyword { val: "f32",     kind: LumaTokenType::TOK_F32 },
  Keyword { val: "f64",     kind: LumaTokenType::TOK_F64 },
  Keyword { val: "false",   kind: LumaTokenType::TOK_FALSE },
  Keyword { val: "fn",      kind: LumaTokenType::TOK_FN },
  Keyword { val: "free",    kind: LumaTokenType::TOK_FREE },
  Keyword { val: "i8",      kind: LumaTokenType::TOK_I8 },
  Keyword { val: "i16",     kind: LumaTokenType::TOK_I16 },
  Keyword { val: "i32",     kind: LumaTokenType::TOK_I32 },
  Keyword { val: "i64",     kind: LumaTokenType::TOK_I64 },
  Keyword { val: "if",      kind: LumaTokenType::TOK_IF },
  Keyword { val: "impl",    kind: LumaTokenType::TOK_IMPL },
  Keyword { val: "import",  kind: LumaTokenType::TOK_IMPORT },
  Keyword { val: "in",      kind: LumaTokenType::TOK_IN },
  Keyword { val: "input",   kind: LumaTokenType::TOK_INPUT },
  Keyword { val: "let",     kind: LumaTokenType::TOK_VAR },
  Keyword { val: "loop",    kind: LumaTokenType::TOK_LOOP },
  Keyword { val: "priv",    kind: LumaTokenType::TOK_PRIVATE },
  Keyword { val: "pub",     kind: LumaTokenType::TOK_PUBLIC },
  Keyword { val: "return",  kind: LumaTokenType::TOK_RETURN },
  Keyword { val: "sizeof",  kind: LumaTokenType::TOK_SIZE_OF },
  Keyword { val: "static",  kind: LumaTokenType::TOK_STATIC },
  Keyword { val: "struct",  kind: LumaTokenType::TOK_STRUCT },
  Keyword { val: "switch",  kind: LumaTokenType::TOK_SWITCH },
  Keyword { val: "system",  kind: LumaTokenType::TOK_SYSTEM },
  Keyword { val: "true",    kind: LumaTokenType::TOK_TRUE },
  Keyword { val: "u8",      kind: LumaTokenType::TOK_U8 },
  Keyword { val: "u16",     kind: LumaTokenType::TOK_U16 },
  Keyword { val: "u32",     kind: LumaTokenType::TOK_U32 },
  Keyword { val: "u64",     kind: LumaTokenType::TOK_U64 },
  Keyword { val: "using",   kind: LumaTokenType::TOK_USING },
  Keyword { val: "void",    kind: LumaTokenType::TOK_VOID },
];

const compare_word -> fn (val: *byte, len: i64, kw: *byte) i64 {
  loop [i: i64 = 0](i < len) : (++i) {
    let kc: byte = kw[i];
    if (kc == '\0')  return 1;   // kw shorter -> val is greater
    if (val[i] < kc) return -1;
    if (val[i] > kc) return 1;
  }
  if (kw[len] != '\0') return -1;   // kw longer -> val is less
  return 0;
}

pub const lookup_keyword -> fn (val: *byte, len: i64) i64 {
  let lo: i64 = 0;
  let hi: i64 = KEYWORD_COUNT - 1;
  loop (lo <= hi) {
    let mid: i64 = (lo + hi) / 2;
    let cmp: i64 = compare_word(val, len, keyword_map[mid].val);
    if (cmp == 0) return keyword_map[mid].kind;
    if (cmp < 0) { hi = mid - 1; }
    else         { lo = mid + 1; }
  }
  return -1;
}
