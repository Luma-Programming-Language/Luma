@module "lexer_tokens"

pub const LumaTokenType -> enum {
  TOK_EOF,          /**< End of file/input */
  TOK_ERROR,        /**< Error token */
  TOK_IDENTIFIER,   /**< Identifier (variable/function names) */
  TOK_KEYWORD,      /**< Reserved keyword */
  TOK_NUMBER,       /**< Numeric literal */
  TOK_NUM_FLOAT,    /**< Floating point numeric literal */
  TOK_STRING,       /**< String literal */
  TOK_CHAR_LITERAL, /**< Character literal */

  // Primitive Types
  TOK_INT,     /**< int */
  TOK_DOUBLE,  /**< double */
  TOK_UINT,    /**< unsigned int */
  TOK_FLOAT,   /**< float */
  TOK_BOOL,    /**< bool */
  TOK_VOID,    /**< void */
  TOK_CHAR,    /**< char */

  // Keywords
  TOK_IF,       /**< if keyword */
  TOK_ELIF,     /**< elif keyword */
  TOK_ELSE,     /**< else keyword */
  TOK_LOOP,     /**< loop keyword */
  TOK_RETURN,   /**< return keyword */
  TOK_BREAK,    /**< break keyword */
  TOK_CONTINUE, /**< continue keyword */
  TOK_STRUCT,   /**< struct keyword */
  TOK_ENUM,     /**< enum keyword */
  TOK_MOD,      /**< mod keyword */
  TOK_IMPORT,   /**< import keyword */
  TOK_TRUE,     /**< true keyword */
  TOK_FALSE,    /**< false keyword */
  TOK_PUBLIC,   /**< pub keyword */
  TOK_PRIVATE,  /**< private keyword */
  TOK_VAR,      /**< let keyword */
  TOK_CONST,    /**< const keyword */
  TOK_FN,       /**< fn keyword */
  TOK_INPUT,    /**< input keyword */
  TOK_ALLOC,    /**< alloc(size_t size) */
  TOK_FREE,     /**< free(void *ptr, size_t size) */
  TOK_CAST,     /**< cast<Type>(value you want to cast too) */
  TOK_SIZE_OF,  /**< size_of<TYPE> */
  TOK_AS,       /**< as keyword (for use in modules) */
  TOK_DEFER,    /**< defer keyword */
  TOK_IN,       /**< in keyword */
  TOK_SWITCH,   /**< switch keyword */
  TOK_USING,    /**< using keyword (scoped enum access in switch) */
  TOK_STATIC,   /**< static keyword (struct methods with no implicit self) */
  TOK_SYSTEM,   /**< system keyword */
  TOK_IMPL,     /**< implement keyword */
  TOK_SYSCALL,

  // prepocessor directives
  TOK_MODULE, /**< @module */
  TOK_USE,    /**< @use    */
  TOK_OS,     /**< @os     */
  TOK_LINK,   /**< @link   */

  // function attibutes
  TOK_RETURNS_OWNERSHIP, /** #returns_ownership */
  TOK_TAKES_OWNERSHIP,   /** #takes_ownership   */
  TOK_DLL_IMPORT,        /** #dll_import        */
  TOK_LIB_IMPORT,        /** #lib_import        */

  // Symbols
  TOK_SYMBOL,      /**< Fallback symbol */
  TOK_LPAREN,      /**< ( */
  TOK_RPAREN,      /**< ) */
  TOK_LBRACE,      /**< { */
  TOK_RBRACE,      /**< } */
  TOK_LBRACKET,    /**< [ */
  TOK_RBRACKET,    /**< ] */
  TOK_SEMI,        /**< ; */
  TOK_COMMA,       /**< , */
  TOK_DOT,         /**< . */
  TOK_AT,          /**< @ */
  TOK_EQUAL,       /**< = */
  TOK_PLUS,        /**< + */
  TOK_MINUS,       /**< - */
  TOK_STAR,        /**< * */
  TOK_SLASH,       /**< / */
  TOK_LT,          /**< < */
  TOK_GT,          /**< > */
  TOK_LE,          /**< <= */
  TOK_GE,          /**< >= */
  TOK_EQEQ,        /**< == */
  TOK_NEQ,         /**< != */
  TOK_AMP,         /**< & */
  TOK_PIPE,        /**< | */
  TOK_CARET,       /**< ^ */
  TOK_TILDE,       /**< ~ */
  TOK_AND,         /**< && */
  TOK_OR,          /**< || */
  TOK_RESOLVE,     /**< :: */
  TOK_COLON,       /**< : */
  TOK_BANG,        /**< ! */
  TOK_QUESTION,    /**< ? */
  TOK_PLUSPLUS,    /**< ++ */
  TOK_MINUSMINUS,  /**< -- */
  TOK_SHIFT_LEFT,  /**< << */
  TOK_SHIFT_RIGHT, /**< >> */
  TOK_RANGE,       /**< .. */
  TOK_ELLIPSIS,    /**< ... */
  TOK_RIGHT_ARROW, /**< -> */
  TOK_LEFT_ARROW,  /**< <- */
  TOK_MODL,        /**< % */
  TOK_WHITESPACE,  /**< whitespace */
  TOK_COMMENT,     /**< comment */
  TOK_DOC_COMMENT, 
  TOK_MODULE_DOC,  
  TOK_DOCUMENT     
};

// A lexical error the lexer noticed while scanning. The lexer only records
// these (plus their source location): it can't render a line_text for the
// error system (that needs the finished token table) and it doesn't know
// the file path either — parse_file re-issues each one through error.lx
// after the token scan, once both are available.
pub const LexError -> struct {
  kind: int,
  line: int,
  col:  int,
  len:  int,
  // The offending character, for LEX_ERR_INVALID_CHARACTER (0 otherwise)
  // — lets the report name it.
  bad:  byte,
};

pub const MAX_LEX_ERRORS: int = 32;

pub const LEX_ERR_UNKNOWN_DIRECTIVE:   int = 0; /**< an @word or #word that isn't a keyword */
pub const LEX_ERR_UNTERMINATED_STRING: int = 1; /**< string literal hitting \n or EOF without a closing " */
pub const LEX_ERR_EMPTY_CHAR:          int = 2; /**< '' or an opening ' run into EOF */
pub const LEX_ERR_BAD_CHAR:            int = 3; /**< 'a' missing its closing ', or 'ab' multi-char */
pub const LEX_ERR_INVALID_CHARACTER:   int = 4; /**< a character Luma has no token for (silently skipped before) */

pub const Lexer -> struct {
  current: *byte,
  src: *byte,
  line: int, 
  col: int,

  errors:      [LexError; 32],
  error_count: int,

  // Set the moment any of the above is recorded, so parse_file can fail the
  // parse even when the offending characters never became tokens (an
  // unrecognized character is skipped, not tokenized).
  had_error: int,

  static make -> fn (src: *byte) Lexer {
    let lx: Lexer = Lexer {
      current: src,
      src: src,
      line: 1,
      col:  0,
      had_error: 0,
      error_count: 0,
    };

    loop [i: int = 0](i < MAX_LEX_ERRORS) : (++i) {
      lx.errors[i].kind = 0;
      lx.errors[i].line = 0;
      lx.errors[i].col  = 0;
      lx.errors[i].len  = 0;
      lx.errors[i].bad  = cast<byte>(0);
    }

    return lx;
  },
  
  is_end  -> fn () int { if(self.current[0] == '\0') return 1; return 0; },
  peek    -> fn (offset: int) byte { return self.current[offset]; },
  advance -> fn () byte {
    let c: byte = self.peek(0);
    self.current = cast<*byte>(cast<int>(self.current) + 1);

    switch(c) {
      '\n' -> { 
        self.line = self.line + 1;
        self.col  = 0;
      }
      _ -> {
        if (c != '\0') self.col = self.col + 1;
      }
    }

    return c;
  },
};

pub const Token -> struct {
  val:            *byte,
  kind:           int,
  len:            int,
  line:           int,
  col:            int,
  whitespace_len: int,

  #returns_ownership
  token_value_string -> fn () *byte {
    let s: *byte = cast<*byte>(alloc((self.len + 1) * sizeof<byte>));
    loop [i: int = 0](i < self.len) : (++i) {
      s[i] = self.val[i];
    }  
    s[self.len] = '\0';
    return s;
  },
};

// Single-character symbols, resolved with a switch (a constant-time jump
// table in the generated C) instead of the previous linear scan over a
// lookup table. The `@`/`#` prefixed words never reach this — the lexer
// handles those before falling through to symbol lookup.
pub const lookup_single -> fn (c: byte) int {
  switch (c) {
    '(' -> return LumaTokenType::TOK_LPAREN;
    ')' -> return LumaTokenType::TOK_RPAREN;
    ';' -> return LumaTokenType::TOK_SEMI;
    ':' -> return LumaTokenType::TOK_COLON;
    '@' -> return LumaTokenType::TOK_AT;
    '+' -> return LumaTokenType::TOK_PLUS;
    '-' -> return LumaTokenType::TOK_MINUS;
    '*' -> return LumaTokenType::TOK_STAR;
    '/' -> return LumaTokenType::TOK_SLASH;
    '^' -> return LumaTokenType::TOK_CARET;
    '%' -> return LumaTokenType::TOK_MODL;
    '<' -> return LumaTokenType::TOK_LT;
    '>' -> return LumaTokenType::TOK_GT;
    '{' -> return LumaTokenType::TOK_LBRACE;
    '}' -> return LumaTokenType::TOK_RBRACE;
    '[' -> return LumaTokenType::TOK_LBRACKET;
    ']' -> return LumaTokenType::TOK_RBRACKET;
    ',' -> return LumaTokenType::TOK_COMMA;
    '.' -> return LumaTokenType::TOK_DOT;
    '=' -> return LumaTokenType::TOK_EQUAL;
    '&' -> return LumaTokenType::TOK_AMP;
    '|' -> return LumaTokenType::TOK_PIPE;
    '~' -> return LumaTokenType::TOK_TILDE;
    '!' -> return LumaTokenType::TOK_BANG;
    _   -> return -1;
  }
  return -1;
}

// Two-character operators, resolved by a first-char switch (again replacing
// a linear scan). NOTE: there is deliberately no `>>` arm — `>>` lexes as
// two `>` tokens so nested generic closes like `cast<Box<int>>` split
// cleanly, and the parser reassembles adjacent `>` `>` into a right shift in
// an expression (see is_shift_right in src/parser/expr.lx). `...` is caught
// before this in the lexer, so `.` `.` here always means TOK_RANGE.
pub const lookup_double -> fn (c: byte, c2: byte) int {
  switch (c) {
    '=' -> { if (c2 == '=') return LumaTokenType::TOK_EQEQ;    }
    '!' -> { if (c2 == '=') return LumaTokenType::TOK_NEQ;     }
    '<' -> {
      if (c2 == '=') return LumaTokenType::TOK_LE;
      if (c2 == '<') return LumaTokenType::TOK_SHIFT_LEFT;
      if (c2 == '-') return LumaTokenType::TOK_LEFT_ARROW;
    }
    '>' -> { if (c2 == '=') return LumaTokenType::TOK_GE;      }
    '&' -> { if (c2 == '&') return LumaTokenType::TOK_AND;     }
    '|' -> { if (c2 == '|') return LumaTokenType::TOK_OR;      }
    ':' -> { if (c2 == ':') return LumaTokenType::TOK_RESOLVE; }
    '+' -> { if (c2 == '+') return LumaTokenType::TOK_PLUSPLUS; }
    '-' -> {
      if (c2 == '-') return LumaTokenType::TOK_MINUSMINUS;
      if (c2 == '>') return LumaTokenType::TOK_RIGHT_ARROW;
    }
    '.' -> { if (c2 == '.') return LumaTokenType::TOK_RANGE;   }
  }
  return -1;
}

const KEYWORD_COUNT: int = 46;
const Keyword -> struct { val: *byte, kind: int };
// Sorted ascending for lookup_keyword's binary search (compare_word defines
// the ordering: byte-lexicographic, shorter-prefix-first). Do NOT reorder
// for readability — an unsorted map silently breaks the lookup.
pub const keyword_map: [Keyword; 46] = [
  // Function attributes
  Keyword { val: "#dll_import",        kind: LumaTokenType::TOK_DLL_IMPORT },
  Keyword { val: "#lib_import",        kind: LumaTokenType::TOK_LIB_IMPORT },
  Keyword { val: "#returns_ownership", kind: LumaTokenType::TOK_RETURNS_OWNERSHIP },
  Keyword { val: "#takes_ownership",   kind: LumaTokenType::TOK_TAKES_OWNERSHIP },

  // Preprocessor directives
  Keyword { val: "@link",   kind: LumaTokenType::TOK_LINK },
  Keyword { val: "@module", kind: LumaTokenType::TOK_MODULE },
  Keyword { val: "@os",     kind: LumaTokenType::TOK_OS },
  Keyword { val: "@use",    kind: LumaTokenType::TOK_USE },

  // Built-in functions
  Keyword { val: "__syscall__", kind: LumaTokenType::TOK_SYSCALL },

  // Keywords (control flow, declarations, literals, types, builtins)
  Keyword { val: "alloc",   kind: LumaTokenType::TOK_ALLOC },
  Keyword { val: "as",      kind: LumaTokenType::TOK_AS },
  Keyword { val: "bool",    kind: LumaTokenType::TOK_BOOL },
  Keyword { val: "break",   kind: LumaTokenType::TOK_BREAK },
  Keyword { val: "byte",    kind: LumaTokenType::TOK_CHAR },
  Keyword { val: "cast",    kind: LumaTokenType::TOK_CAST },
  Keyword { val: "const",   kind: LumaTokenType::TOK_CONST },
  Keyword { val: "continue", kind: LumaTokenType::TOK_CONTINUE },
  Keyword { val: "defer",   kind: LumaTokenType::TOK_DEFER },
  Keyword { val: "double",  kind: LumaTokenType::TOK_DOUBLE },
  Keyword { val: "elif",    kind: LumaTokenType::TOK_ELIF },
  Keyword { val: "else",    kind: LumaTokenType::TOK_ELSE },
  Keyword { val: "enum",    kind: LumaTokenType::TOK_ENUM },
  Keyword { val: "false",   kind: LumaTokenType::TOK_FALSE },
  Keyword { val: "float",   kind: LumaTokenType::TOK_FLOAT },
  Keyword { val: "fn",      kind: LumaTokenType::TOK_FN },
  Keyword { val: "free",    kind: LumaTokenType::TOK_FREE },
  Keyword { val: "if",      kind: LumaTokenType::TOK_IF },
  Keyword { val: "impl",    kind: LumaTokenType::TOK_IMPL },
  Keyword { val: "import",  kind: LumaTokenType::TOK_IMPORT },
  Keyword { val: "in",      kind: LumaTokenType::TOK_IN },
  Keyword { val: "input",   kind: LumaTokenType::TOK_INPUT },
  Keyword { val: "int",     kind: LumaTokenType::TOK_INT },
  Keyword { val: "let",     kind: LumaTokenType::TOK_VAR },
  Keyword { val: "loop",    kind: LumaTokenType::TOK_LOOP },
  Keyword { val: "priv",    kind: LumaTokenType::TOK_PRIVATE },
  Keyword { val: "pub",     kind: LumaTokenType::TOK_PUBLIC },
  Keyword { val: "return",  kind: LumaTokenType::TOK_RETURN },
  Keyword { val: "sizeof",  kind: LumaTokenType::TOK_SIZE_OF },
  Keyword { val: "static",  kind: LumaTokenType::TOK_STATIC },
  Keyword { val: "struct",  kind: LumaTokenType::TOK_STRUCT },
  Keyword { val: "switch",  kind: LumaTokenType::TOK_SWITCH },
  Keyword { val: "system",  kind: LumaTokenType::TOK_SYSTEM },
  Keyword { val: "true",    kind: LumaTokenType::TOK_TRUE },
  Keyword { val: "uint",    kind: LumaTokenType::TOK_UINT },
  Keyword { val: "using",   kind: LumaTokenType::TOK_USING },
  Keyword { val: "void",    kind: LumaTokenType::TOK_VOID },
  // NOTE: no "mod" keyword entry — TOK_MOD is unused by the parser
  // (the real modulo operator is the `%` symbol, tokenized separately as
  // TOK_MODL), and `mod` is an extremely common local variable name
  // throughout this codebase (e.g. `let mod: *ModuleNode = ...`). Reserving
  // it as a keyword made the self-hosted lexer misparse most of its own
  // source — see the "unknown type Token" / cascading parser-error
  // investigation this fixed.
];

// Byte-lexicographic compare between a length-delimited candidate (val, len)
// and a NUL-terminated keyword literal, returning -1 / 0 / 1 for
// val < kw / equal / val > kw. Reads at most len + 1 bytes of kw, so a
// keyword sharing no prefix with the candidate (the common case — most
// identifiers are not keywords) fails on its first byte. No allocation, no
// strlen. Shorter-prefix-sorts-first: a candidate that runs out before kw is
// "less" (e.g. "in" < "input").
const compare_word -> fn (val: *byte, len: int, kw: *byte) int {
  loop [i: int = 0](i < len) : (++i) {
    let kc: byte = kw[i];
    if (kc == '\0')  return 1;   // kw shorter -> val is greater
    if (val[i] < kc) return -1;
    if (val[i] > kc) return 1;
  }
  if (kw[len] != '\0') return -1;   // kw longer -> val is less
  return 0;
}

// Keyword/directive lookup — the hot path for every identifier in the
// source, so it's a binary search over the sorted map above with an
// allocation-free in-place compare. (Previously this heap-allocated a word
// copy via create_word and linearly strcmp'd all 46 entries, once per
// identifier.)
pub const lookup_keyword -> fn (val: *byte, len: int) int {
  let lo: int = 0;
  let hi: int = KEYWORD_COUNT - 1;
  loop (lo <= hi) {
    let mid: int = (lo + hi) / 2;
    let cmp: int = compare_word(val, len, keyword_map[mid].val);
    if (cmp == 0) return keyword_map[mid].kind;
    if (cmp < 0) { hi = mid - 1; }
    else         { lo = mid + 1; }
  }
  return -1;
}
