@module "tc_scope"

@use "std_vector" as VEC
@use "std_cstring" as STR

@use "tc_core" as CORE
@use "ast"     as AST

const SCOPE_VEC_CAPACITY: int = 64;

#returns_ownership
const new_vector -> fn (elem_size: int) *Vector {
  let v: *Vector = cast<*Vector>(alloc(sizeof<Vector>));
  v.data         = cast<*void>(alloc(SCOPE_VEC_CAPACITY * elem_size));
  v.capacity     = SCOPE_VEC_CAPACITY;
  v.size         = 0;
  v.element_size = elem_size;
  return v;
}

#returns_ownership
pub const scope_init -> fn (name: *byte, check_mem: bool, os: *byte) *Scope {
  let s: *Scope = cast<*Scope>(alloc(sizeof<Scope>));

  s.parent            = cast<*Scope>(0);
  s.symbols           = new_vector(sizeof<Symbol>);
  s.scope_name        = name;
  s.depth             = 0;
  s.is_function_scope = false;
  s.associated_node   = cast<*AstNode>(0);
  s.is_module_scope   = false;
  s.module_name       = cast<*byte>(0);
  s.imported_modules  = new_vector(sizeof<ModuleImport>);
  s.returns_ownership = false;
  s.takes_ownership   = false;
  s.deferred_frees    = new_vector(sizeof<*byte>);
  s.check_mem         = check_mem;
  s.os                = os;

  let analyzer: *StaticMemoryAnalyzer = cast<*StaticMemoryAnalyzer>(alloc(sizeof<StaticMemoryAnalyzer>));
  analyzer.allocations          = new_vector(sizeof<StaticAllocation>);
  analyzer.skip_memory_tracking = false;
  s.memory_analyzer = analyzer;

  return s;
}

#returns_ownership
pub const scope_create_child -> fn (parent: *Scope, name: *byte) *Scope {
  let s: *Scope = cast<*Scope>(alloc(sizeof<Scope>));

  s.parent            = parent;
  s.symbols           = new_vector(sizeof<Symbol>);
  s.scope_name        = name;
  s.depth             = parent.depth + 1;
  s.is_function_scope = false;
  s.associated_node   = cast<*AstNode>(0);
  s.is_module_scope   = false;
  s.module_name       = cast<*byte>(0);
  s.imported_modules  = new_vector(sizeof<ModuleImport>);
  s.returns_ownership = parent.returns_ownership;
  s.takes_ownership   = parent.takes_ownership;
  s.deferred_frees    = new_vector(sizeof<*byte>);
  s.check_mem         = parent.check_mem;
  s.os                = parent.os;
  s.memory_analyzer   = parent.memory_analyzer;  // shared across the module

  return s;
}

pub const find_containing_module -> fn (scope: *Scope) *Scope {
  let s: *Scope = scope;
  loop (s != cast<*Scope>(0)) {
    if (s.is_module_scope) return s;
    s = s.parent;
  }
  return cast<*Scope>(0);
}

pub const get_enclosing_function -> fn (scope: *Scope) *Scope {
  let s: *Scope = scope;
  loop (s != cast<*Scope>(0)) {
    if (s.is_function_scope) return s;
    s = s.parent;
  }
  return cast<*Scope>(0);
}

pub const scope_is_conditional -> fn (scope: *Scope, fscope: *Scope) bool {
  let s: *Scope = scope;
  loop (s != cast<*Scope>(0) && s != fscope) {
    let name: *byte = s.scope_name;
    if (STR::strcmp(name, "then_branch") == 0) return true;
    if (STR::strcmp(name, "elif_branch") == 0) return true;
    if (STR::strcmp(name, "else_branch") == 0) return true;
    if (STR::strcmp(name, "loop") == 0) return true;
    if (STR::strcmp(name, "case") == 0) return true;
    if (STR::strcmp(name, "default") == 0) return true;
    s = s.parent;
  }
  return false;
}

pub const add_module_import -> fn (scope: *Scope, module_name: *byte, alias: *byte, module_scope: *Scope) void {
  let imp: ModuleImport = ModuleImport {
    module_name:  module_name,
    alias:        alias,
    module_scope: module_scope,
  };
  let v: *Vector = scope.imported_modules;
  v.push_back(cast<*void>(&imp));
}

pub const find_module_import -> fn (scope: *Scope, alias: *byte) *ModuleImport {
  let s: *Scope = scope;
  loop (s != cast<*Scope>(0)) {
    let v: *Vector = s.imported_modules;
    let count: int = v.size;
    loop [i: int = 0](i < count) : (++i) {
      let imp: *ModuleImport = cast<*ModuleImport>(v.get(i));
      if (STR::strcmp(imp.alias, alias) == 0) return imp;
    }
    s = s.parent;
  }
  return cast<*ModuleImport>(0);
}

pub const scope_lookup_current -> fn (scope: *Scope, name: *byte) *Symbol {
  let v: *Vector = scope.symbols;
  let count: int = v.size;
  loop [i: int = 0](i < count) : (++i) {
    let sym: *Symbol = cast<*Symbol>(v.get(i));
    if (STR::strcmp(sym.name, name) == 0) return sym;
  }
  return cast<*Symbol>(0);
}

pub const scope_add_symbol_full -> fn (scope: *Scope, name: *byte, type: *AstNode,
                                       is_public: bool, is_mutable: bool,
                                       returns_ownership: bool, takes_ownership: bool) bool {
  if (scope_lookup_current(scope, name) != cast<*Symbol>(0)) return false;

  let sym: Symbol = Symbol {
    name:              name,
    type:              type,
    is_public:         is_public,
    is_mutable:        is_mutable,
    scope_depth:       scope.depth,
    returns_ownership: returns_ownership,
    takes_ownership:   takes_ownership,
  };
  let v: *Vector = scope.symbols;
  v.push_back(cast<*void>(&sym));
  return true;
}

pub const scope_add_symbol -> fn (scope: *Scope, name: *byte, type: *AstNode,
                                  is_public: bool, is_mutable: bool) bool {
  return scope_add_symbol_full(scope, name, type, is_public, is_mutable, false, false);
}

// Walks the scope chain, then searches imported modules (public symbols only).
pub const scope_lookup -> fn (scope: *Scope, name: *byte) *Symbol {
  let own_module: *Scope = find_containing_module(scope);

  let s: *Scope = scope;
  loop (s != cast<*Scope>(0)) {
    let found: *Symbol = scope_lookup_current(s, name);
    if (found != cast<*Symbol>(0)) return found;

    // Search modules imported at this scope level.
    let v: *Vector = s.imported_modules;
    let count: int = v.size;
    loop [i: int = 0](i < count) : (++i) {
      let imp: *ModuleImport = cast<*ModuleImport>(v.get(i));
      let mscope: *Scope = imp.module_scope;
      if (mscope != cast<*Scope>(0)) {
        let m: *Symbol = scope_lookup_current(mscope, name);
        if (m != cast<*Symbol>(0)) {
          if (m.is_public || mscope == own_module) return m;
        }
      }
    }
    s = s.parent;
  }
  return cast<*Symbol>(0);
}

// Look a symbol up directly inside a specific module scope (for ALIAS::name).
pub const scope_lookup_in_module -> fn (module_scope: *Scope, name: *byte) *Symbol {
  if (module_scope == cast<*Scope>(0)) return cast<*Symbol>(0);
  return scope_lookup_current(module_scope, name);
}

pub const get_enclosing_function_name -> fn (scope: *Scope) *byte {
  let fscope: *Scope = get_enclosing_function(scope);
  if (fscope == cast<*Scope>(0)) return "";
  let assoc: *AstNode = fscope.associated_node;
  if (assoc == cast<*AstNode>(0)) return "";
  let fd: *FuncDeclNode = cast<*FuncDeclNode>(assoc);
  return fd.name;
}

pub const analyzer_find -> fn (analyzer: *StaticMemoryAnalyzer, name: *byte, func_name: *byte) *StaticAllocation {
  let v: *Vector = analyzer.allocations;
  let count: int = v.size;
  loop [i: int = 0](i < count) : (++i) {
    let a: *StaticAllocation = cast<*StaticAllocation>(v.get(i));
    if (STR::strcmp(a.variable_name, name) == 0 && STR::strcmp(a.function_name, func_name) == 0) return a;
  }

  // Not tracked under its own name — check whether `name` is a known alias of
  // some other tracked allocation (`let b = a; free(b);` must satisfy a's
  // has_matching_free, not leave `a` looking un-freed).
  loop [i: int = 0](i < count) : (++i) {
    let a: *StaticAllocation = cast<*StaticAllocation>(v.get(i));
    if (STR::strcmp(a.function_name, func_name) != 0) continue;
    if (a.aliases == cast<*Vector>(0)) continue;

    let av: *Vector = a.aliases;
    let ac: int = av.size;
    loop [j: int = 0](j < ac) : (++j) {
      let alias_name: *byte = cast<**byte>(av.data)[j];
      if (STR::strcmp(alias_name, name) == 0) return a;
    }
  }

  return cast<*StaticAllocation>(0);
}

pub const analyzer_track_alloc -> fn (analyzer: *StaticMemoryAnalyzer, name: *byte, func_name: *byte,
                                      file_path: *byte, line: int, col: int) void {
  if (analyzer.skip_memory_tracking) return;

  let a: StaticAllocation = StaticAllocation {
    line:                 line,
    col:                  col,
    variable_name:        name,
    original_variable:    name,
    has_matching_free:    false,
    free_count:           0,
    conditional_free:     0,
    use_after_free_count: 0,
    aliases:              cast<*Vector>(0),
    reported:             false,
    address_taken:        false,
    function_name:        func_name,
    file_path:            file_path,
  };
  let v: *Vector = analyzer.allocations;
  v.push_back(cast<*void>(&a));
}

pub const analyzer_track_free -> fn (analyzer: *StaticMemoryAnalyzer, name: *byte, func_name: *byte,
                                     is_conditional: bool) void {
  if (analyzer.skip_memory_tracking) return;

  let a: *StaticAllocation = analyzer_find(analyzer, name, func_name);
  if (a == cast<*StaticAllocation>(0)) return;

  a.has_matching_free = true;
  if (is_conditional) {
    a.conditional_free = a.conditional_free + 1;
  } else {
    a.free_count = a.free_count + 1;
  }
}

pub const analyzer_track_alias -> fn (analyzer: *StaticMemoryAnalyzer, target_name: *byte,
                                      source_name: *byte, func_name: *byte) void {
  if (analyzer.skip_memory_tracking) return;

  let src: *StaticAllocation = analyzer_find(analyzer, source_name, func_name);
  if (src == cast<*StaticAllocation>(0)) return;

  if (src.aliases == cast<*Vector>(0)) {
    src.aliases = new_vector(sizeof<*byte>);
  }
  let v: *Vector = src.aliases;
  v.push_back(cast<*void>(&target_name));
}

pub const analyzer_mark_address_taken -> fn (analyzer: *StaticMemoryAnalyzer, name: *byte, func_name: *byte) void {
  let a: *StaticAllocation = analyzer_find(analyzer, name, func_name);
  if (a != cast<*StaticAllocation>(0)) { a.address_taken = true; }
}

pub const analyzer_check_use_after_free -> fn (analyzer: *StaticMemoryAnalyzer, name: *byte, func_name: *byte) bool {
  let a: *StaticAllocation = analyzer_find(analyzer, name, func_name);
  if (a == cast<*StaticAllocation>(0)) return false;
  if (a.has_matching_free == false) return false;

  a.use_after_free_count = a.use_after_free_count + 1;
  return a.use_after_free_count == 1;
}

#returns_ownership
pub const find_enum_members -> fn (scope: *Scope, enum_name: *byte) Vector {
  let result: Vector = VEC::create_vector(sizeof<*byte>);

  let mscope: *Scope = find_containing_module(scope);
  if (mscope == cast<*Scope>(0)) return result;

  let elen: int = STR::strlen(enum_name);
  let v: *Vector = mscope.symbols;
  let count: int = v.size;
  loop [i: int = 0](i < count) : (++i) {
    let sym: *Symbol = cast<*Symbol>(v.get(i));

    let namelen: int = STR::strlen(sym.name);
    if (namelen > elen) {
      if (STR::strncmp(sym.name, enum_name, elen) == 0) {
        if (sym.name[elen] == '.') {
          let member: *byte = sym.name;
          result.push_back(cast<*void>(&member));
        }
      }
    }
  }
  return result;
}
