@module "tc_expr"

@use "std_cstring" as STR
@use "std_memory"  as MEM
@use "std_vector"  as VEC

@use "tc_core"     as CORE
@use "tc_type"     as TYPE
@use "tc_scope"    as SCOPE
@use "tc_generics" as GEN
@use "tc_error"    as ERR
@use "ast"         as AST
@use "error" as ERR

#returns_ownership pub const typecheck_expression -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode;
#returns_ownership const typecheck_expression_inner -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode;

#returns_ownership const tc_literal     -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_identifier  -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_binary      -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_unary       -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_call        -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_assign      -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_ternary     -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_member      -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_index       -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_array       -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode;
#returns_ownership const tc_cast        -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_deref       -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_addr        -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;
#returns_ownership const tc_struct_expr -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode;

const check_uaf                 -> fn (node: *AST::AstNode, scope: *CORE::Scope) void;
const track_free                -> fn (ptr_expr: *AST::AstNode, scope: *CORE::Scope) void;
const call_is_returns_ownership -> fn (call_expr: *AST::AstNode, scope: *CORE::Scope) bool;
pub const track_pointer_source  -> fn (name: *byte, value_expr: *AST::AstNode, scope: *CORE::Scope) void;

#returns_ownership
pub const qualify -> fn (a: *byte, b: *byte) *byte {
  let la: int = STR::strlen(a);
  let lb: int = STR::strlen(b);
  let s: *byte = cast<*byte>(alloc(la + lb + 2));
  MEM::memcpy(cast<*void>(s), cast<*void>(a), la);
  s[la] = '.';
  MEM::memcpy(cast<*void>(cast<int>(s) + la + 1), cast<*void>(b), lb);
  s[la + lb + 1] = '\0';
  return s;
}

const strip_pointer -> fn (t: *AST::AstNode) *AST::AstNode {
  if (TYPE::is_pointer_type(t)) {
    let p: *AST::PointerTypeNode = cast<*AST::PointerTypeNode>(t);
    return p.pointee_type;
  }
  return t;
}

const check_uaf -> fn (node: *AST::AstNode, scope: *CORE::Scope) void {
  if (node == cast<*AST::AstNode>(0)) return;
  if (node.kind != AST::NodeType::EXPR_IDENTIFIER) return;

  let analyzer: *CORE::StaticMemoryAnalyzer = scope.memory_analyzer;
  if (analyzer == cast<*CORE::StaticMemoryAnalyzer>(0)) return;

  let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(node);
  let fname: *byte = SCOPE::get_enclosing_function_name(scope);
  if (SCOPE::analyzer_check_use_after_free(analyzer, id.name, fname)) {
    ERR::tc_error_id(node, id.name, "Use After Free", "value used after being freed", "used after being freed");
  }
}

const track_free -> fn (ptr_expr: *AST::AstNode, scope: *CORE::Scope) void {
  if (ptr_expr == cast<*AST::AstNode>(0)) return;
  if (ptr_expr.kind != AST::NodeType::EXPR_IDENTIFIER) return;

  let analyzer: *CORE::StaticMemoryAnalyzer = scope.memory_analyzer;
  if (analyzer == cast<*CORE::StaticMemoryAnalyzer>(0)) return;

  let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(ptr_expr);
  let fscope: *CORE::Scope = SCOPE::get_enclosing_function(scope);

  if (analyzer.skip_memory_tracking) {
    if (fscope != cast<*CORE::Scope>(0)) {
      let v: *VEC::Vector = fscope.deferred_frees;
      let name: *byte = id.name;
      v.push_back(cast<*void>(&name));
    }
    return;
  }

  let fname: *byte = SCOPE::get_enclosing_function_name(scope);
  let is_conditional: bool = (fscope == cast<*CORE::Scope>(0)) || SCOPE::scope_is_conditional(scope, fscope);
  SCOPE::analyzer_track_free(analyzer, id.name, fname, is_conditional);
}

const call_is_returns_ownership -> fn (call_expr: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::CallNode = cast<*AST::CallNode>(call_expr);
  let callee: *AST::AstNode = n.callee;

  if (callee.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(callee);
    let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, id.name);
    if (sym == cast<*CORE::Symbol>(0)) return false;
    return sym.returns_ownership;
  }

  return false;
}

const call_is_takes_ownership -> fn (callee: *AST::AstNode, scope: *CORE::Scope) bool {
  if (callee.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(callee);
    let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, id.name);
    if (sym == cast<*CORE::Symbol>(0)) return false;
    return sym.takes_ownership;
  }

  // `Module::func(...)` — a qualified call into another module. Unlike
  // `resolve_callee_type` (which only needs the function's *type*), this
  // needs the Symbol itself to read its ownership flag.
  if (callee.kind == AST::NodeType::EXPR_MEMBER) {
    let mn: *AST::MemberNode = cast<*AST::MemberNode>(callee);
    if (mn.is_compiletime == 1 && mn.object.kind == AST::NodeType::EXPR_IDENTIFIER) {
      let obj: *AST::IdentifierNode = cast<*AST::IdentifierNode>(mn.object);
      let imp: *CORE::ModuleImport = SCOPE::find_module_import(scope, obj.name);
      if (imp != cast<*CORE::ModuleImport>(0)) {
        let msym: *CORE::Symbol = SCOPE::scope_lookup_in_module(imp.module_scope, mn.member);
        if (msym != cast<*CORE::Symbol>(0)) return msym.takes_ownership;
      }
    }
  }

  return false;
}

pub const track_pointer_source -> fn (name: *byte, value_expr: *AST::AstNode, scope: *CORE::Scope) void {
  if (value_expr == cast<*AST::AstNode>(0)) return;

  let src_expr: *AST::AstNode = value_expr;
  loop (true) {
    if (src_expr == cast<*AST::AstNode>(0)) break;
    if (src_expr.kind != AST::NodeType::EXPR_CAST) break;
    let cn: *AST::CastNode = cast<*AST::CastNode>(src_expr);
    src_expr = cn.castee;
  }
  if (src_expr == cast<*AST::AstNode>(0)) return;

  let analyzer: *CORE::StaticMemoryAnalyzer = scope.memory_analyzer;
  if (analyzer == cast<*CORE::StaticMemoryAnalyzer>(0)) return;

  let fscope: *CORE::Scope = SCOPE::get_enclosing_function(scope);
  if (fscope != cast<*CORE::Scope>(0)) {
    if (fscope.returns_ownership) return;
  }

  let fname: *byte = SCOPE::get_enclosing_function_name(scope);

  if (src_expr.kind == AST::NodeType::EXPR_ALLOC) {
    SCOPE::analyzer_track_alloc(analyzer, name, fname, ERR::g_file_path, src_expr.line, src_expr.col);
    return;
  }

  if (src_expr.kind == AST::NodeType::EXPR_CALL) {
    if (call_is_returns_ownership(src_expr, scope)) {
      SCOPE::analyzer_track_alloc(analyzer, name, fname, ERR::g_file_path, src_expr.line, src_expr.col);
    }
    return;
  }

  if (src_expr.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let idn: *AST::IdentifierNode = cast<*AST::IdentifierNode>(src_expr);
    SCOPE::analyzer_track_alias(analyzer, name, idn.name, fname);
  }
}

// Public entry point: delegates to the real dispatcher, then stashes the
// resolved type onto the node itself (`AstNode.resolved_type`, see ast.lx)
// so codegen can later read a static type straight off the AST without
// re-running inference or rebuilding a scope tree.
#returns_ownership
pub const typecheck_expression -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode {
  let result: *AST::AstNode = typecheck_expression_inner(expr, scope, expected);
  if (expr != cast<*AST::AstNode>(0)) expr.resolved_type = result;
  return result;
}

#returns_ownership
const typecheck_expression_inner -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode {
  if (expr == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  let k: int = expr.kind;

  if (k == AST::NodeType::EXPR_LITERAL)    return tc_literal(expr, scope);
  if (k == AST::NodeType::EXPR_IDENTIFIER) return tc_identifier(expr, scope);
  if (k == AST::NodeType::EXPR_BINARY)     return tc_binary(expr, scope);
  if (k == AST::NodeType::EXPR_RANGE)      return tc_binary(expr, scope);
  if (k == AST::NodeType::EXPR_UNARY)      return tc_unary(expr, scope);
  if (k == AST::NodeType::EXPR_CALL)       return tc_call(expr, scope);
  if (k == AST::NodeType::EXPR_ASSIGNMENT) return tc_assign(expr, scope);
  if (k == AST::NodeType::EXPR_TERNARY)    return tc_ternary(expr, scope);
  if (k == AST::NodeType::EXPR_MEMBER)     return tc_member(expr, scope);
  if (k == AST::NodeType::EXPR_INDEX)      return tc_index(expr, scope);
  if (k == AST::NodeType::EXPR_ARRAY)      return tc_array(expr, scope, expected);
  if (k == AST::NodeType::EXPR_CAST)       return tc_cast(expr, scope);
  if (k == AST::NodeType::EXPR_DEREF)      return tc_deref(expr, scope);
  if (k == AST::NodeType::EXPR_ADDR)       return tc_addr(expr, scope);
  if (k == AST::NodeType::EXPR_STRUCT)     return tc_struct_expr(expr, scope, expected);

  // Grouping / system wrap a single operand.
  if (k == AST::NodeType::EXPR_GROUPING) {
    let n: *AST::UnaryNode = cast<*AST::UnaryNode>(expr);
    return typecheck_expression(n.operand, scope, expected);
  }
  if (k == AST::NodeType::EXPR_SYSTEM) {
    let n: *AST::UnaryNode = cast<*AST::UnaryNode>(expr);
    typecheck_expression(n.operand, scope, cast<*AST::AstNode>(0));
    return TYPE::make_int_type();
  }

  // Built-in memory / introspection forms.
  if (k == AST::NodeType::EXPR_ALLOC) {
    let n: *AST::AllocNode = cast<*AST::AllocNode>(expr);
    typecheck_expression(n.size, scope, cast<*AST::AstNode>(0));
    return TYPE::make_voidptr_type();
  }
  if (k == AST::NodeType::EXPR_FREE) {
    let n: *AST::FreeNode = cast<*AST::FreeNode>(expr);
    let ptr: *AST::AstNode = n.ptr;

    let ptr_is_ident: bool = false;
    if (ptr != cast<*AST::AstNode>(0)) {
      if (ptr.kind == AST::NodeType::EXPR_IDENTIFIER) { ptr_is_ident = true; }
    }

    if (ptr_is_ident) {
      let idn: *AST::IdentifierNode = cast<*AST::IdentifierNode>(ptr);
      let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, idn.name);
      if (sym == cast<*CORE::Symbol>(0)) {
        ERR::tc_error_id(ptr, idn.name, "Undefined Identifier", "use of undeclared identifier", "not found in this scope");
      }
    } else {
      typecheck_expression(ptr, scope, cast<*AST::AstNode>(0));
    }

    track_free(ptr, scope);
    return TYPE::make_void_type();
  }
  if (k == AST::NodeType::EXPR_SIZEOF) {
    let n: *AST::SizeofNode = cast<*AST::SizeofNode>(expr);
    if (n.is_type == 0) { typecheck_expression(n.object, scope, cast<*AST::AstNode>(0)); }
    else { n.object = TYPE::resolve_type_ref(n.object, scope); }
    return TYPE::make_int_type();
  }
  if (k == AST::NodeType::EXPR_INPUT) {
    let n: *AST::CastNode = cast<*AST::CastNode>(expr);
    if (n.castee != cast<*AST::AstNode>(0))
      typecheck_expression(n.castee, scope, cast<*AST::AstNode>(0));
    return n.type_node;
  }
  if (k == AST::NodeType::EXPR_SYSCALL) {
    let n: *AST::SyscallNode = cast<*AST::SyscallNode>(expr);
    loop [i: int = 0](i < n.count) : (++i) {
      typecheck_expression(n.args[i], scope, cast<*AST::AstNode>(0));
    }
    return TYPE::make_int_type();
  }
  if (k == AST::NodeType::EXPR_MEMCPY) {
    let n: *AST::MemcpyNode = cast<*AST::MemcpyNode>(expr);
    typecheck_expression(n.to, scope, cast<*AST::AstNode>(0));
    typecheck_expression(n.from, scope, cast<*AST::AstNode>(0));
    typecheck_expression(n.size, scope, cast<*AST::AstNode>(0));
    return TYPE::make_void_type();
  }

  return cast<*AST::AstNode>(0);
}

#returns_ownership
const tc_literal -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::LiteralNode = cast<*AST::LiteralNode>(expr);
  let lt: int = n.lit_type;

  if (lt == AST::LiteralType::LITERAL_INT)    return TYPE::make_int_type();
  if (lt == AST::LiteralType::LITERAL_FLOAT)  return TYPE::make_named_type("float");
  if (lt == AST::LiteralType::LITERAL_DOUBLE) return TYPE::make_named_type("double");
  if (lt == AST::LiteralType::LITERAL_STRING) return TYPE::make_string_type();
  if (lt == AST::LiteralType::LITERAL_CHAR)   return TYPE::make_byte_type();
  if (lt == AST::LiteralType::LITERAL_BOOL)   return TYPE::make_bool_type();
  if (lt == AST::LiteralType::LITERAL_NULL)   return TYPE::make_voidptr_type();

  if (lt == AST::LiteralType::LITERAL_IDENT) {
    let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, n.string_val);
    if (sym != cast<*CORE::Symbol>(0)) return sym.type;
    return cast<*AST::AstNode>(0);
  }
  return cast<*AST::AstNode>(0);
}

#returns_ownership
const tc_identifier -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::IdentifierNode = cast<*AST::IdentifierNode>(expr);
  let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, n.name);
  if (sym == cast<*CORE::Symbol>(0)) {
    ERR::tc_error_id(expr, n.name, "Undefined Identifier", "use of undeclared identifier", "not found in this scope");
    return cast<*AST::AstNode>(0);
  }
  check_uaf(expr, scope);
  return sym.type;
}

#returns_ownership
const tc_binary -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::BinaryNode = cast<*AST::BinaryNode>(expr);
  let lt: *AST::AstNode = typecheck_expression(n.left,  scope, cast<*AST::AstNode>(0));
  let rt: *AST::AstNode = typecheck_expression(n.right, scope, cast<*AST::AstNode>(0));
  if (lt == cast<*AST::AstNode>(0) || rt == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  let op: int = n.op;

  // Comparisons -> bool
  if (op == AST::BinaryOp::BINOP_EQ || op == AST::BinaryOp::BINOP_NE ||
      op == AST::BinaryOp::BINOP_LT || op == AST::BinaryOp::BINOP_LE ||
      op == AST::BinaryOp::BINOP_GT || op == AST::BinaryOp::BINOP_GE) {
    return TYPE::make_bool_type();
  }

  // Logical -> bool (operands should be bool)
  if (op == AST::BinaryOp::BINOP_AND || op == AST::BinaryOp::BINOP_OR) {
    return TYPE::make_bool_type();
  }

  // Bitwise / shift -> int
  if (op == AST::BinaryOp::BINOP_BIT_AND || op == AST::BinaryOp::BINOP_BIT_OR ||
      op == AST::BinaryOp::BINOP_BIT_XOR || op == AST::BinaryOp::BINOP_SHL ||
      op == AST::BinaryOp::BINOP_SHR) {
    return TYPE::make_int_type();
  }

  // Range -> array of element type
  if (op == AST::BinaryOp::BINOP_RANGE) {
    return TYPE::make_pointer_to(TYPE::make_int_type());
  }

  // Arithmetic. Allow pointer arithmetic (ptr +/- int).
  if (TYPE::is_pointer_type(lt) && TYPE::is_integer_type(rt)) return lt;
  if (TYPE::is_integer_type(lt) && TYPE::is_pointer_type(rt)) return rt;

  let lr: int = TYPE::numeric_rank(lt);
  let rr: int = TYPE::numeric_rank(rt);
  if (lr < 0 || rr < 0) {
    ERR::tc_error(expr, "Type Error", "arithmetic operands must be numeric", "not a numeric type");
    return cast<*AST::AstNode>(0);
  }

  // Modulo requires integers.
  if (op == AST::BinaryOp::BINOP_MOD) {
    if (TYPE::is_integer_type(lt) == false || TYPE::is_integer_type(rt) == false) {
      ERR::tc_error(expr, "Type Error", "modulo requires integer operands", "not an integer type");
      return cast<*AST::AstNode>(0);
    }
    return TYPE::make_int_type();
  }

  if (lr >= rr) return lt;
  return rt;
}

#returns_ownership
const tc_unary -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::UnaryNode = cast<*AST::UnaryNode>(expr);
  let ot: *AST::AstNode = typecheck_expression(n.operand, scope, cast<*AST::AstNode>(0));
  if (ot == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  let op: int = n.op;
  if (op == AST::UnaryType::UNOP_NOT) return TYPE::make_bool_type();

  return ot;
}

#returns_ownership
const tc_deref -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::UnaryNode = cast<*AST::UnaryNode>(expr);
  let ot: *AST::AstNode = typecheck_expression(n.operand, scope, cast<*AST::AstNode>(0));
  if (ot == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);
  check_uaf(n.operand, scope);
  if (TYPE::is_pointer_type(ot) == false) {
    ERR::tc_error(expr, "Type Error", "cannot dereference a non-pointer value", "not a pointer");
    return cast<*AST::AstNode>(0);
  }
  let p: *AST::PointerTypeNode = cast<*AST::PointerTypeNode>(ot);
  return p.pointee_type;
}

#returns_ownership
const tc_addr -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::UnaryNode = cast<*AST::UnaryNode>(expr);
  let operand: *AST::AstNode = n.operand;
  let ot: *AST::AstNode = typecheck_expression(operand, scope, cast<*AST::AstNode>(0));
  if (ot == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  if (operand.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(operand);
    let analyzer: *CORE::StaticMemoryAnalyzer = scope.memory_analyzer;
    if (analyzer != cast<*CORE::StaticMemoryAnalyzer>(0)) {
      let fname: *byte = SCOPE::get_enclosing_function_name(scope);
      SCOPE::analyzer_mark_address_taken(analyzer, id.name, fname);
    }
  }

  return TYPE::make_pointer_to(ot);
}

#returns_ownership
const tc_index -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::IndexNode = cast<*AST::IndexNode>(expr);
  let ot: *AST::AstNode = typecheck_expression(n.object, scope, cast<*AST::AstNode>(0));
  let it: *AST::AstNode = typecheck_expression(n.index, scope, cast<*AST::AstNode>(0));
  check_uaf(n.object, scope);
  if (ot == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  if (it != cast<*AST::AstNode>(0)) {
    if (TYPE::is_integer_type(it) == false) {
      ERR::tc_error(expr, "Type Error", "array index must be an integer", "not an integer");
    }
  }

  if (TYPE::is_array_type(ot)) {
    let a: *AST::ArrayTypeNode = cast<*AST::ArrayTypeNode>(ot);
    return a.element_type;
  }
  if (TYPE::is_pointer_type(ot)) {
    let p: *AST::PointerTypeNode = cast<*AST::PointerTypeNode>(ot);
    return p.pointee_type;
  }

  ERR::tc_error(expr, "Type Error", "cannot index a non-array, non-pointer value", "not indexable");
  return cast<*AST::AstNode>(0);
}

#returns_ownership
const tc_member -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::MemberNode = cast<*AST::MemberNode>(expr);

  let object: *AST::AstNode = n.object;

  // Compile-time resolution: EnumName::MEMBER or Alias::symbol
  if (n.is_compiletime == 1) {
    if (object.kind == AST::NodeType::EXPR_IDENTIFIER) {
      let obj: *AST::IdentifierNode = cast<*AST::IdentifierNode>(object);

      // Module alias?
      let imp: *CORE::ModuleImport = SCOPE::find_module_import(scope, obj.name);
      if (imp != cast<*CORE::ModuleImport>(0)) {
        let msym: *CORE::Symbol = SCOPE::scope_lookup_in_module(imp.module_scope, n.member);
        if (msym != cast<*CORE::Symbol>(0)) return msym.type;
        // `obj.name` is unambiguously a module alias (found via
        // find_module_import), so a missing `n.member` in that module's
        // scope isn't a "maybe it's an enum" ambiguity — it's a genuine
        // unresolved reference. Left unreported, this fell through as a
        // silently-untyped expression that codegen would later paper over
        // with a placeholder `0` (see codegen_expr.lx's "unresolved
        // qualified call/name" fallbacks) — i.e. `Mod::nonexistent(...)`
        // compiled clean and quietly ran as if it were the literal 0.
        ERR::tc_error_id(expr, n.member, "Module Error", "no such symbol in this module", "not found");
        return cast<*AST::AstNode>(0);
      }

      // Enum / namespaced symbol: look up "Name.member".
      let qname: *byte = qualify(obj.name, n.member);
      let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, qname);
      if (sym != cast<*CORE::Symbol>(0)) return sym.type;

      // Unknown qualified name — treat as enum-like int to stay permissive.
      return TYPE::make_named_type(obj.name);
    }

    // `Alias::EnumName::Member` — nested MemberNodes (this node's `object`
    // is itself the compiletime member `Alias::EnumName`), not a single
    // identifier. Unwrap one level: resolve the alias to its module, then
    // look up "EnumName.Member" in that module's own scope.
    if (object.kind == AST::NodeType::EXPR_MEMBER) {
      let inner: *AST::MemberNode = cast<*AST::MemberNode>(object);
      if (inner.is_compiletime == 1) {
        let inner_object: *AST::AstNode = inner.object;
        if (inner_object.kind == AST::NodeType::EXPR_IDENTIFIER) {
          let iobj: *AST::IdentifierNode = cast<*AST::IdentifierNode>(inner_object);
          let imp2: *CORE::ModuleImport = SCOPE::find_module_import(scope, iobj.name);
          if (imp2 != cast<*CORE::ModuleImport>(0)) {
            let qname2: *byte = qualify(inner.member, n.member);
            let msym2: *CORE::Symbol = SCOPE::scope_lookup_in_module(imp2.module_scope, qname2);
            if (msym2 != cast<*CORE::Symbol>(0)) return msym2.type;
            // Same reasoning as the single-level alias case above: `iobj.name`
            // is a confirmed module alias, so `EnumName::Member` not existing
            // in that module is a real error, not something to stay
            // permissive about.
            ERR::tc_error_id(expr, n.member, "Module Error", "no such symbol in this module", "not found");
            return cast<*AST::AstNode>(0);
          }
        }
      }
    }

    return cast<*AST::AstNode>(0);
  }

  // Runtime member access: obj.field
  let ot: *AST::AstNode = typecheck_expression(n.object, scope, cast<*AST::AstNode>(0));
  check_uaf(n.object, scope);
  if (ot == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  let base: *AST::AstNode = strip_pointer(ot);
  if (TYPE::is_nominal_type(base) == false) {
    return cast<*AST::AstNode>(0);
  }

  let sname: *byte = TYPE::basic_name(base);
  let qname2: *byte = qualify(sname, n.member);
  let fsym: *CORE::Symbol = SCOPE::scope_lookup(scope, qname2);
  if (fsym != cast<*CORE::Symbol>(0)) return fsym.type;

  // Field/method not found in registry — stay permissive (don't reject).
  return cast<*AST::AstNode>(0);
}

#returns_ownership
const resolve_callee_type -> fn (callee: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  if (callee.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(callee);
    // Builtin output()/outputln() — accept anything (handled by caller).
    if (STR::strcmp(id.name, "output") == 0 || STR::strcmp(id.name, "outputln") == 0)
      return cast<*AST::AstNode>(0);
    let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, id.name);
    if (sym != cast<*CORE::Symbol>(0)) return sym.type;
    return cast<*AST::AstNode>(0);
  }
  return typecheck_expression(callee, scope, cast<*AST::AstNode>(0));
}

#returns_ownership
const tc_call -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::CallNode = cast<*AST::CallNode>(expr);
  let callee: *AST::AstNode = n.callee;

  // output() builtin: variadic, returns void.
  if (callee.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(callee);
    if (STR::strcmp(id.name, "output") == 0 || STR::strcmp(id.name, "outputln") == 0) {
      loop [i: int = 0](i < n.arg_count) : (++i) {
        typecheck_expression(n.args[i], scope, cast<*AST::AstNode>(0));
      }
      return TYPE::make_void_type();
    }
  }

  // Explicit generic call — `add<int>(1, 2)`. Only a bare identifier
  // naming a template registered in the caller's own module triggers
  // this (cross-module generics aren't supported yet); anything else,
  // including an ordinary call (type_arg_count == 0), falls through to
  // the normal resolve_callee_type path below unchanged.
  let ct: *AST::AstNode = cast<*AST::AstNode>(0);
  let is_generic_call: bool = false;
  if (n.type_arg_count > 0 && callee.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(callee);
    let mscope: *CORE::Scope = SCOPE::find_containing_module(scope);
    if (mscope != cast<*CORE::Scope>(0)) {
      let tmpl: *GEN::GenericTemplate = GEN::find_template(mscope.module_name, id.name);
      if (tmpl != cast<*GEN::GenericTemplate>(0)) {
        is_generic_call = true;
        ct = GEN::instantiate_function_call(n, tmpl, scope);
      }
    }
  }
  if (is_generic_call == false) {
    ct = resolve_callee_type(n.callee, scope);
  }

  let ftype: *AST::AstNode = ct;
  if (TYPE::is_pointer_to_function_type(ftype)) {
    ftype = strip_pointer(ftype);
  }

  if (ftype != cast<*AST::AstNode>(0) && TYPE::is_function_type(ftype)) {
    let ft: *AST::FuncTypeNode = cast<*AST::FuncTypeNode>(ftype);
    let pcount: int = ft.param_count;
    if (n.arg_count != pcount) {
      ERR::tc_error(expr, "Call Error", "wrong number of arguments in function call", "wrong argument count");
    }

    // A `#takes_ownership` callee is responsible for whatever pointers it's
    // handed — an identifier argument naming a locally tracked allocation
    // is satisfied here the same way passing it to `free()` would be,
    // rather than reported as never freed in this function.
    let consumes: bool = call_is_takes_ownership(n.callee, scope);

    loop [i: int = 0](i < n.arg_count) : (++i) {
      let pexp: *AST::AstNode = cast<*AST::AstNode>(0);
      if (i < pcount) pexp = ft.param_types[i];
      let at: *AST::AstNode = typecheck_expression(n.args[i], scope, pexp);
      if (at != cast<*AST::AstNode>(0) && pexp != cast<*AST::AstNode>(0)) {
        if (TYPE::types_match(at, pexp) == CORE::TypeMatchResult::TYPE_MATCH_NONE) {
          ERR::tc_error(expr, "Type Error", "argument type does not match parameter type", "type mismatch");
        }
      }
      if (consumes) { track_free(n.args[i], scope); }
    }
    let rett: *AST::AstNode = ft.return_type;
    return rett;
  }

  loop [i: int = 0](i < n.arg_count) : (++i) {
    typecheck_expression(n.args[i], scope, cast<*AST::AstNode>(0));
  }
  return cast<*AST::AstNode>(0);
}

#returns_ownership
const tc_assign -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::AssignNode = cast<*AST::AssignNode>(expr);
  let target: *AST::AstNode = n.target;
  let tt: *AST::AstNode = typecheck_expression(target, scope, cast<*AST::AstNode>(0));
  let vt: *AST::AstNode = typecheck_expression(n.value, scope, tt);

  if (target.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(target);
    let sym: *CORE::Symbol = SCOPE::scope_lookup(scope, id.name);
    if (sym != cast<*CORE::Symbol>(0)) {
      if (sym.is_mutable == false) {
        ERR::tc_error_id(n.target, id.name, "Type Error", "cannot assign to immutable binding", "immutable");
      }
    }

    // A global/module-level binding outlives any one function — reassigning
    // it isn't a local allocation site the leak-checker can reason about
    // (its real lifetime is "the rest of the program"), so don't track it
    // as one. Without this, `g_x = alloc(...)` at module scope was reported
    // as a leak inside whichever function happened to run the assignment.
    let fscope: *CORE::Scope = SCOPE::get_enclosing_function(scope);
    let is_local: bool = true;
    if (fscope != cast<*CORE::Scope>(0) && sym != cast<*CORE::Symbol>(0)) {
      if (sym.scope_depth < fscope.depth) { is_local = false; }
    }
    if (is_local) { track_pointer_source(id.name, n.value, scope); }
  } elif (target.kind == AST::NodeType::EXPR_MEMBER) {
    // `obj.field = value` — if `value` is a tracked local allocation, it
    // now escapes into the target's own storage (e.g. `b.data = alloc(...)`
    // in a buffer-growing helper, where `b` is owned by the caller) and is
    // no longer this function's responsibility to free. Treat it the same
    // as an explicit free rather than reporting it never freed.
    let escaped: *AST::AstNode = n.value;
    loop (true) {
      if (escaped == cast<*AST::AstNode>(0)) break;
      if (escaped.kind != AST::NodeType::EXPR_CAST) break;
      let cn: *AST::CastNode = cast<*AST::CastNode>(escaped);
      escaped = cn.castee;
    }
    track_free(escaped, scope);
  }

  if (tt != cast<*AST::AstNode>(0) && vt != cast<*AST::AstNode>(0)) {
    if (TYPE::types_match(vt, tt) == CORE::TypeMatchResult::TYPE_MATCH_NONE) {
      ERR::tc_error(expr, "Type Error", "assigned value type does not match target type", "type mismatch");
    }
  }
  return tt;
}

#returns_ownership
const tc_ternary -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::TernaryNode = cast<*AST::TernaryNode>(expr);
  typecheck_expression(n.condition, scope, cast<*AST::AstNode>(0));
  let a: *AST::AstNode = typecheck_expression(n.then_expr, scope, cast<*AST::AstNode>(0));
  let b: *AST::AstNode = typecheck_expression(n.else_expr, scope, cast<*AST::AstNode>(0));
  if (a != cast<*AST::AstNode>(0)) return a;
  return b;
}

#returns_ownership
const tc_cast -> fn (expr: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let n: *AST::CastNode = cast<*AST::CastNode>(expr);
  n.type_node = TYPE::resolve_type_ref(n.type_node, scope);
  let from: *AST::AstNode = typecheck_expression(n.castee, scope, cast<*AST::AstNode>(0));
  if (from != cast<*AST::AstNode>(0)) {
    if (TYPE::is_cast_valid(from, n.type_node) == false) {
      ERR::tc_error(expr, "Type Error", "invalid cast between incompatible types", "invalid cast");
    }
  }
  return n.type_node;
}

#returns_ownership
const tc_array -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode {
  let n: *AST::ArrayNode = cast<*AST::ArrayNode>(expr);
  if (n.element_count == 0) {
    if (expected != cast<*AST::AstNode>(0)) return expected;
    ERR::tc_error(expr, "Type Error", "cannot infer type of empty array literal", "type cannot be inferred");
    return cast<*AST::AstNode>(0);
  }

  let elem_expected: *AST::AstNode = cast<*AST::AstNode>(0);
  if (expected != cast<*AST::AstNode>(0) && TYPE::is_array_type(expected)) {
    let ea: *AST::ArrayTypeNode = cast<*AST::ArrayTypeNode>(expected);
    elem_expected = ea.element_type;
  }

  let first: *AST::AstNode = typecheck_expression(n.elements[0], scope, elem_expected);

  loop [i: int = 1](i < n.element_count) : (++i) {
    let et: *AST::AstNode = typecheck_expression(n.elements[i], scope, elem_expected);
    if (first != cast<*AST::AstNode>(0) && et != cast<*AST::AstNode>(0)) {
      if (TYPE::types_match(et, first) == CORE::TypeMatchResult::TYPE_MATCH_NONE) {
        ERR::tc_error(n.elements[i], "Type Error", "array elements must share a common type", "type mismatch");
      }
    }
  }

  if (first == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);
  return TYPE::make_pointer_to(first);
}

#returns_ownership
const tc_struct_expr -> fn (expr: *AST::AstNode, scope: *CORE::Scope, expected: *AST::AstNode) *AST::AstNode {
  let n: *AST::StructExprNode = cast<*AST::StructExprNode>(expr);

  loop [i: int = 0](i < n.field_count) : (++i) {
    typecheck_expression(n.field_vals[i], scope, cast<*AST::AstNode>(0));
  }

  if (n.name != cast<*byte>(0)) {
    // `ALIAS::Name { ... }` vs bare `Name { ... }` — same rule as a type
    // annotation: bare is only valid when Name is declared in this module.
    if (n.alias == cast<*byte>(0)) {
      TYPE::check_nominal_bare(n.name, scope, expr);
    } elif (SCOPE::find_module_import(scope, n.alias) == cast<*CORE::ModuleImport>(0)) {
      ERR::tc_error_id(expr, n.alias, "Module Error", "unknown module alias", "not found");
    }
    return TYPE::make_named_type(n.name);
  }
  if (expected != cast<*AST::AstNode>(0)) return expected;
  return cast<*AST::AstNode>(0);
}
