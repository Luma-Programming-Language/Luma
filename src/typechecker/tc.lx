@module "tc"

@use "std_vector"   as VEC
@use "std_cstring"   as STR

@use "constants"    as CONST
@use "ast"          as AST
@use "error"        as ERO

@use "tc_core"      as CORE
@use "tc_scope"     as SCOPE
@use "tc_stmt"      as STMT
@use "tc_generics"  as GEN
@use "tc_error"     as ERR

const find_module_scope -> fn (registry: *VEC::Vector, name: *byte) *CORE::Scope {
  let c: int = registry.size;
  loop [i: int = 0](i < c) : (++i) {
    let imp: *CORE::ModuleImport = cast<*CORE::ModuleImport>(registry.get(i));
    if (STR::strcmp(imp.module_name, name) == 0) return imp.module_scope;
  }
  return cast<*CORE::Scope>(0);
}

const resolve_uses -> fn (mnode: *AST::AstNode, ms: *CORE::Scope, registry: *VEC::Vector) void {
  let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
  let body: **AST::AstNode = mod.body;
  let bc: int = mod.body_count;

  loop [i: int = 0](i < bc) : (++i) {
    let bn: *AST::AstNode = body[i];
    if (bn.kind == AST::NodeType::PREPROCESSOR_USE) {
      let u: *AST::UseNode = cast<*AST::UseNode>(bn);
      let target: *CORE::Scope = find_module_scope(registry, u.module_name);
      SCOPE::add_module_import(ms, u.module_name, u.alias, target);
    }
  }
}

const check_module_uses -> fn (mnode: *AST::AstNode, registry: *VEC::Vector) void {
  let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
  let bc: int = mod.body_count;
  loop [i: int = 0](i < bc) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::PREPROCESSOR_USE) {
      let u: *AST::UseNode = cast<*AST::UseNode>(bn);
      let target: *CORE::Scope = find_module_scope(registry, u.module_name);
      if (target == cast<*CORE::Scope>(0)) {
        // +2 for the quotes around the module name in the source text.
        let token_len: int = STR::strlen(u.module_name) + 2;
        ERR::tc_error_len(bn, "Module Error",
          "module not found — was its file passed with -l?", token_len, "not found");
      }
    }
  }
}

const register_module_body -> fn (mnode: *AST::AstNode, ms: *CORE::Scope) void {
  let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
  let body: **AST::AstNode = mod.body;
  let bc: int = mod.body_count;
  loop [i: int = 0](i < bc) : (++i) {
    STMT::register_declaration(body[i], ms);
  }
}

const check_module_body -> fn (mnode: *AST::AstNode, ms: *CORE::Scope) bool {
  let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
  let bc: int = mod.body_count;

  let ok: bool = true;
  loop [i: int = 0](i < bc) : (++i) {
    let bn: *AST::AstNode = mod.body[i];

    if (bn.kind == AST::NodeType::PREPROCESSOR_OS) {
      let body: *AST::AstNode = STMT::resolve_os_body(bn, ms);
      if (body != cast<*AST::AstNode>(0)) {
        if (body.kind == AST::NodeType::STMT_BLOCK) {
          let blk: *AST::BlockNode = cast<*AST::BlockNode>(body);
          let sc: int = blk.stmt_count;
          loop [j: int = 0](j < sc) : (++j) {
            if (STMT::typecheck_statement(blk.statements[j], ms) == false) ok = false;
          }
        }
      }
    } elif (bn.category != AST::NodeCategory::Node_Category_PREPROCESSOR) {
      if (STMT::typecheck_statement(bn, ms) == false) ok = false;
    }
  }
  return ok;
}

const report_module_allocations -> fn (analyzer: *CORE::StaticMemoryAnalyzer, file_path: *byte) void {
  if (analyzer == cast<*CORE::StaticMemoryAnalyzer>(0)) return;

  let v: *VEC::Vector = analyzer.allocations;
  let count: int = v.size;
  loop [i: int = 0](i < count) : (++i) {
    let a: *CORE::StaticAllocation = cast<*CORE::StaticAllocation>(v.get(i));
    if (a.reported) continue;
    if (STR::strcmp(a.file_path, file_path) != 0) continue;

    if (a.free_count > 1) {
      let err: ERO::ErrorInformation = ERO::ErrorInformation {
        error_type:   "Double Free",
        file_path:    a.file_path,
        message:      "this pointer is freed more than once",
        line:         a.line,
        col:          a.col,
        line_text:    ERR::generate_line_for_current_module(a.line),
        token_length: 1,
        label:        "freed again here",
        note:         cast<*byte>(0),
        help:         cast<*byte>(0),
      };
      ERO::error_add(err);
      a.reported = true;
      continue;
    }

    if (a.has_matching_free == false && a.address_taken == false) {
      let err2: ERO::ErrorInformation = ERO::ErrorInformation {
        error_type:   "Memory Leak",
        file_path:    a.file_path,
        message:      "this allocation is never freed",
        line:         a.line,
        col:          a.col,
        line_text:    ERR::generate_line_for_current_module(a.line),
        token_length: 1,
        label:        "never freed",
        note:         cast<*byte>(0),
        help:         cast<*byte>(0),
      };
      ERO::error_add(err2);
      a.reported = true;
    }
  }
}

pub const typecheck -> fn (node: *AST::AstNode, config: CONST::LumaBuildConfig) bool {
  if (node == cast<*AST::AstNode>(0)) return true;

  SCOPE::scope_arena_init();
  let root: *CORE::Scope = SCOPE::scope_init("global", config.check_mem, config.os);

  if (node.kind != AST::NodeType::PROGRAM) {
    STMT::typecheck_statement(node, root);
    SCOPE::scope_arena_teardown();
    if (ERO::error_has_errors() != 0) { ERO::error_report(); return false; }
    return true;
  }

  let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(node);
  let mc: int = prog.module_count;
  let modules: **AST::AstNode = prog.modules;

  let registry: VEC::Vector = VEC::create_vector(sizeof<CORE::ModuleImport>);

  // ── Pass 1: register a scope for every module ───────────────────────────────
  loop [i: int = 0](i < mc) : (++i) {
    let mnode: *AST::AstNode = modules[i];
    if (mnode.kind == AST::NodeType::PREPROCESSOR_MODULE) {
      let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
      let ms: *CORE::Scope = SCOPE::scope_create_child(root, "module");
      ms.is_module_scope = true;
      ms.module_name     = mod.name;

      let imp: CORE::ModuleImport = CORE::ModuleImport {
        module_name:  mod.name,
        alias:        mod.name,
        module_scope: ms,
      };
      registry.push_back(cast<*void>(&imp));
    }
  }

  // ── Pass 2: resolve @use imports ────────────────────────────────────────────
  loop [i: int = 0](i < mc) : (++i) {
    let mnode: *AST::AstNode = modules[i];
    if (mnode.kind == AST::NodeType::PREPROCESSOR_MODULE) {
      let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
      let ms: *CORE::Scope = find_module_scope(&registry, mod.name);
      resolve_uses(mnode, ms, &registry);
    }
  }

  // ── Pass 3a: forward-register declarations ──────────────────────────────────
  loop [i: int = 0](i < mc) : (++i) {
    let mnode: *AST::AstNode = modules[i];
    if (mnode.kind == AST::NodeType::PREPROCESSOR_MODULE) {
      let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
      let ms: *CORE::Scope = find_module_scope(&registry, mod.name);
      // Forward-registration can itself raise errors (e.g. resolve_type_ref
      // on a param/return type) — set the error context for *this* module
      // now, not just in Pass 3b, or those errors report a null file/line.
      ERR::tc_error_init(mod);
      register_module_body(mnode, ms);
    }
  }

  // ── Pass 3b: typecheck bodies ───────────────────────────────────────────────
  let ok: bool = true;
  loop [i: int = 0](i < mc) : (++i) {
    let mnode: *AST::AstNode = modules[i];
    if (mnode.kind == AST::NodeType::PREPROCESSOR_MODULE) {
      let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
      let ms: *CORE::Scope = find_module_scope(&registry, mod.name);

      ERR::tc_error_init(mod);
      check_module_uses(mnode, &registry);
      if (check_module_body(mnode, ms) == false) ok = false;

      if (config.check_mem) {
        report_module_allocations(ms.memory_analyzer, mod.file_path);
      }
    }
  }

  // ── Drain generic instantiations ─────────────────────────────────────────
  // A call site's first use of `add<int>(...)` (tc_expr's tc_call, via
  // tc_generics) only clones + gives the concrete function a signature —
  // enough to typecheck that one call — and queues the body itself here,
  // since tc_generics can't reach register_declaration/typecheck_statement
  // without a circular dependency (see its module doc comment). Loop until
  // empty: a generic instantiation's body can itself call another generic
  // for the first time.
  loop (GEN::pending_count() > 0) {
    let job: GEN::Pending = GEN::pending_pop();
    STMT::register_declaration(job.decl, job.def_scope);
    if (STMT::typecheck_statement(job.decl, job.def_scope) == false) ok = false;
    CORE::record_generated_decl(job.module_name, job.decl);
  }

  VEC::free_vector(&registry);
  SCOPE::scope_arena_teardown();

  if (ERO::error_has_errors() != 0) {
    ERO::error_report();
    return false;
  }
  return ok;
}
