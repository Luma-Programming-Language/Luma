@module "tc_generics"

//! Monomorphization for `fn<T>`/`struct<T>`/`enum<T>` (see docs/docs.md's
//! Generics section). An instantiation is just an ordinary, concrete
//! FuncDeclNode / StructDeclNode / EnumDeclNode
//! with a mangled name and every type-parameter occurrence substituted for
//! the caller's concrete type — synthesized once per unique
//! (module, template name, concrete types) combination, then run through
//! the same register_declaration -> typecheck_statement path any ordinary
//! declaration already uses. Nothing in codegen needs to know generics
//! exist; see tc_core's generated-decl registry, which codegen's Pass A
//! reads in addition to each module's normal body.
//!
//! Deliberately does NOT depend on tc_stmt (register_declaration /
//! typecheck_statement live there): tc_stmt already depends on tc_expr,
//! and tc_call (tc_expr) is this module's main caller, so tc_generics ->
//! tc_stmt -> tc_expr -> tc_generics would be circular. Instead, a newly
//! discovered instantiation is only cloned + given a concrete signature
//! here (enough to typecheck its call site immediately) and queued in
//! g_pending; tc.lx drains that queue (register_declaration +
//! typecheck_statement, which it can already reach) after each module's
//! normal pass, looping until empty so a generic calling another generic
//! is handled too.

@use "std_vector"  as VEC
@use "std_cstring" as STR
@use "std_memory"  as MEM

@use "ast"      as AST
@use "ast_type" as TAST
@use "tc_core"  as CORE
@use "tc_scope" as SCOPE
@use "tc_type"  as TYPE
@use "tc_error" as ERR

// ─── small string helpers ────────────────────────────────────────────────
// Mirror cg_core's mangle2 — kept local rather than shared, since the
// typechecker shouldn't depend on codegen.

#returns_ownership
const dup_str -> fn (s: *byte) *byte {
  let len: i64 = STR::strlen(s);
  let out: *byte = cast<*byte>(alloc(len + 1));
  MEM::memcpy(cast<*void>(out), cast<*void>(s), len + 1);
  return out;
}

#returns_ownership
const join2 -> fn (a: *byte, b: *byte) *byte {
  let la: i64 = STR::strlen(a);
  let lb: i64 = STR::strlen(b);
  let s: *byte = cast<*byte>(alloc(la + lb + 3));
  MEM::memcpy(cast<*void>(s), cast<*void>(a), la);
  s[la] = '_'; s[la + 1] = '_';
  MEM::memcpy(cast<*void>(cast<i64>(s) + la + 2), cast<*void>(b), lb);
  s[la + lb + 2] = '\0';
  return s;
}

// tc_generics can't import tc_expr (tc_expr imports tc_generics), so a
// local copy of EXPR::qualify — identical `a.b` splice as the one in
// tc_expr's module scope.
#returns_ownership
const qualify_member -> fn (a: *byte, b: *byte) *byte {
  let la: i64 = STR::strlen(a);
  let lb: i64 = STR::strlen(b);
  let s: *byte = cast<*byte>(alloc(la + lb + 2));
  MEM::memcpy(cast<*void>(s), cast<*void>(a), la);
  s[la] = '.';
  MEM::memcpy(cast<*void>(cast<i64>(s) + la + 1), cast<*void>(b), lb);
  s[la + lb + 1] = '\0';
  return s;
}

// A concrete type's own type_to_string (e.g. "*byte") isn't a valid C
// identifier fragment — replace anything but [A-Za-z0-9_] with '_'.
#returns_ownership
const sanitize -> fn (s: *byte) *byte {
  let len: i64 = STR::strlen(s);
  let out: *byte = cast<*byte>(alloc(len + 1));
  let i: i64 = 0;
  loop (i < len) {
    let c: byte = s[i];
    let ok: bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
    if (ok) { out[i] = c; } else { out[i] = '_'; }
    i = i + 1;
  }
  out[len] = '\0';
  return out;
}

#returns_ownership
const build_mangled_name -> fn (base_name: *byte, concretes: **AST::AstNode, count: i64) *byte {
  let mangled: *byte = dup_str(base_name);
  let i: i64 = 0;
  loop (i < count) {
    let ts: *byte = TYPE::type_to_string(concretes[i]);
    let clean: *byte = sanitize(ts);
    free(ts);
    let next: *byte = join2(mangled, clean);
    free(mangled);
    free(clean);
    mangled = next;
    i = i + 1;
  }
  return mangled;
}

// ─── one entry per `fn<T,...>`/`struct<T,...>` template ───────────────────

pub const GenericTemplate -> struct {
  module_name: *byte,
  name:        *byte,
  decl:        *AST::AstNode,  // raw FuncDeclNode/StructDeclNode/EnumDeclNode, type params unresolved
  def_scope:   *CORE::Scope,   // where it was declared — NOT the caller's scope
  // For method templates (`Thing::make<T>` on a non-generic struct): the
  // owning struct's name and whether the method is `static`. NULL / 0 for
  // module-level fn / struct / enum templates.
  owner:       *byte,
  method_is_static: i64,
};

let g_templates: VEC::Vector;
let g_templates_ready: bool = false;

const templates_init -> fn () void {
  if (g_templates_ready) return;
  g_templates_ready = true;
  g_templates = VEC::create_vector(sizeof<GenericTemplate>);
}

pub const register_template -> fn (module_name: *byte, name: *byte, decl: *AST::AstNode, def_scope: *CORE::Scope) void {
  templates_init();
  let t: GenericTemplate = GenericTemplate { module_name: module_name, name: name, decl: decl, def_scope: def_scope, owner: cast<*byte>(0), method_is_static: 0 };
  g_templates.push_back(cast<*void>(&t));
}

// A generic *method* (`Thing::make<T>`) on a non-generic struct is a
// template whose name is qualified with its owning struct (`Thing.make`),
// so it can't collide with anything a module-level fn/struct/enum template
// is registered under. The owner struct name + static flag ride along so
// tc.lx's drain can hand codegen enough to register the concrete method as
// a method of `Thing` (not a standalone function).
#returns_ownership
pub const register_method_template -> fn (module_name: *byte, owner: *byte, decl: *AST::AstNode, is_static: i64, def_scope: *CORE::Scope) void {
  templates_init();
  let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(decl);
  let qname: *byte = qualify_member(owner, fd.name);
  let t: GenericTemplate = GenericTemplate { module_name: module_name, name: qname, decl: decl, def_scope: def_scope, owner: owner, method_is_static: is_static };
  g_templates.push_back(cast<*void>(&t));
}

pub const find_template -> fn (module_name: *byte, name: *byte) *GenericTemplate {
  templates_init();
  let n: i64 = g_templates.size;
  loop [i: i64 = 0](i < n) : (++i) {
    let t: *GenericTemplate = cast<*GenericTemplate>(g_templates.get(i));
    if (STR::strcmp(t.module_name, module_name) == 0 && STR::strcmp(t.name, name) == 0) return t;
  }
  return cast<*GenericTemplate>(0);
}

// ─── instantiation cache — one entry per concrete (module, name, types) ──

pub const Instantiation -> struct {
  key:          *byte,
  ftype:        *AST::AstNode,
  mangled_name: *byte,
};

let g_insts: VEC::Vector;
let g_insts_ready: bool = false;

const insts_init -> fn () void {
  if (g_insts_ready) return;
  g_insts_ready = true;
  g_insts = VEC::create_vector(sizeof<Instantiation>);
}

const find_instantiation -> fn (key: *byte) *Instantiation {
  insts_init();
  let n: i64 = g_insts.size;
  loop [i: i64 = 0](i < n) : (++i) {
    let inst: *Instantiation = cast<*Instantiation>(g_insts.get(i));
    if (STR::strcmp(inst.key, key) == 0) return inst;
  }
  return cast<*Instantiation>(0);
}

const add_instantiation -> fn (key: *byte, ftype: *AST::AstNode, mangled_name: *byte) void {
  insts_init();
  let inst: Instantiation = Instantiation { key: key, ftype: ftype, mangled_name: mangled_name };
  g_insts.push_back(cast<*void>(&inst));
}

// ─── pending queue — drained by tc.lx, see module doc comment above ──────

pub const Pending -> struct {
  decl:        *AST::AstNode,
  def_scope:   *CORE::Scope,
  module_name: *byte,
  // For method instantiations: owner struct name + static flag (see
  // GenericTemplate), so codegen can register the concrete method with the
  // right ownership instead of as a standalone function. NULL / 0 for
  // fn/struct/enum instantiations.
  owner:       *byte,
  is_static:   i64,
};

let g_pending: VEC::Vector;
let g_pending_ready: bool = false;

const pending_init -> fn () void {
  if (g_pending_ready) return;
  g_pending_ready = true;
  g_pending = VEC::create_vector(sizeof<Pending>);
}

const pending_push -> fn (decl: *AST::AstNode, def_scope: *CORE::Scope, module_name: *byte, owner: *byte, is_static: i64) void {
  pending_init();
  let p: Pending = Pending { decl: decl, def_scope: def_scope, module_name: module_name, owner: owner, is_static: is_static };
  g_pending.push_back(cast<*void>(&p));
}

pub const pending_count -> fn () i64 {
  pending_init();
  return g_pending.size;
}

// Pops the last entry (order doesn't matter — every entry is independent).
// Only call when pending_count() > 0.
pub const pending_pop -> fn () Pending {
  pending_init();
  let idx: i64 = g_pending.size - 1;
  let last: *Pending = cast<*Pending>(g_pending.get(idx));
  let copy: Pending = Pending { decl: last.decl, def_scope: last.def_scope, module_name: last.module_name, owner: last.owner, is_static: last.is_static };
  g_pending.size = idx;
  return copy;
}

// ─── the entry point — called from tc_expr's tc_call ─────────────────────

const rename_callee -> fn (call_node: *AST::CallNode, new_name: *byte) void {
  let callee: *AST::AstNode = call_node.callee;
  if (callee.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(callee);
    free(id.name);
    id.name = dup_str(new_name);
    return;
  }
  // `ALIAS::func<T>(...)` — keep the member shape (codegen's member-call
  // path still needs the alias to resolve the target module) but point it
  // at the mangled concrete name so codegen emits the instantiation.
  if (callee.kind == AST::NodeType::EXPR_MEMBER) {
    let mn: *AST::MemberNode = cast<*AST::MemberNode>(callee);
    free(mn.member);
    mn.member = dup_str(new_name);
    return;
  }
}

// Returns the concrete FuncType to typecheck the call's arguments/result
// against, or NULL (with a tc_error already reported) on failure. Also
// rewrites call_node's callee to the mangled concrete name, so codegen —
// completely unaware generics exist — just emits an ordinary call.
#returns_ownership
pub const instantiate_function_call -> fn (call_node: *AST::CallNode, tmpl: *GenericTemplate, caller_scope: *CORE::Scope) *AST::AstNode {
  let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(tmpl.decl);

  if (call_node.type_arg_count != fd.type_param_count) {
    ERR::tc_error(cast<*AST::AstNode>(call_node), "Generics Error",
      "wrong number of explicit type arguments for this generic function", "type argument count mismatch");
    return cast<*AST::AstNode>(0);
  }

  let count: i64 = fd.type_param_count;
  let concretes: **AST::AstNode = cast<**AST::AstNode>(alloc(sizeof<*AST::AstNode> * count));
  let i: i64 = 0;
  loop (i < count) {
    concretes[i] = TYPE::resolve_type_ref(call_node.type_args[i], caller_scope);
    i = i + 1;
  }

  let mangled: *byte = build_mangled_name(fd.name, concretes, count);
  let key: *byte = join2(tmpl.module_name, mangled);

  let existing: *Instantiation = find_instantiation(key);
  if (existing != cast<*Instantiation>(0)) {
    free(mangled);
    free(key);
    free(concretes);
    rename_callee(call_node, existing.mangled_name);
    return existing.ftype;
  }

  // First time for this concrete instantiation: clone the whole template,
  // substituting every T/U/... occurrence for the caller's concrete
  // types (see clone_node_substituting), give it the mangled name, and
  // strip its own generic markers — from here on it's just an ordinary
  // concrete function to every other part of the compiler.
  let cloned: *AST::AstNode = AST::clone_node_substituting(tmpl.decl, fd.type_params, concretes, count);
  let cfd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(cloned);

  free(cfd.name);
  cfd.name = mangled; // ownership transferred to the node

  let tpi: i64 = 0;
  loop (tpi < cfd.type_param_count) { free(cfd.type_params[tpi]); tpi = tpi + 1; }
  free(cfd.type_params);
  cfd.type_params = cast<**byte>(0);
  cfd.type_param_count = 0;

  // The concrete signature is enough to typecheck THIS call site right
  // now, without waiting for the body itself to be checked (queued below
  // — see tc.lx's drain, which mirrors what register_declaration already
  // does for an ordinary function).
  let ftype: *AST::AstNode = TAST::make_func_type(cfd.param_types, cfd.param_count, cfd.return_type, cloned.line, cloned.col);
  SCOPE::scope_add_symbol_full(tmpl.def_scope, cfd.name, ftype,
    fd.is_public == 1, false, cfd.returns_ownership == 1, cfd.takes_ownership == 1);

  add_instantiation(key, ftype, cfd.name);
  pending_push(cloned, tmpl.def_scope, tmpl.module_name, cast<*byte>(0), 0);

  free(concretes);
  rename_callee(call_node, cfd.name);
  return ftype;
}

// ─── generic methods on non-generic structs ─────────────────────────────────
// `Thing::make<i64>(...)` where `Thing` is an ordinary (non-generic) struct
// and `make` is a *method-level* generic (`static make -> fn<T> (...) T`).
// Methods aren't part of any module-level symbol table and there's no
// struct-level clone to ride on — the method template itself is cloned and
// substituted exactly like a module-level generic function, but the owner +
// static flag ride through the pending queue so codegen registers the
// concrete method as a method of `Thing` (see tc.lx's drain and codegen's
// generated-decl handling).

#returns_ownership
pub const instantiate_method_call -> fn (call_node: *AST::CallNode, owner: *byte, tmpl: *GenericTemplate, caller_scope: *CORE::Scope) *AST::AstNode {
  let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(tmpl.decl);

  if (call_node.type_arg_count != fd.type_param_count) {
    ERR::tc_error(cast<*AST::AstNode>(call_node), "Generics Error",
      "wrong number of explicit type arguments for this generic method", "type argument count mismatch");
    return cast<*AST::AstNode>(0);
  }

  let count: i64 = fd.type_param_count;
  let concretes: **AST::AstNode = cast<**AST::AstNode>(alloc(sizeof<*AST::AstNode> * count));
  let i: i64 = 0;
  loop (i < count) {
    concretes[i] = TYPE::resolve_type_ref(call_node.type_args[i], caller_scope);
    i = i + 1;
  }

  let mangled: *byte = build_mangled_name(fd.name, concretes, count);
  let qkey: *byte = join2(tmpl.module_name, tmpl.name);
  let key: *byte = join2(qkey, mangled);
  free(qkey);

  let existing: *Instantiation = find_instantiation(key);
  if (existing != cast<*Instantiation>(0)) {
    free(mangled);
    free(key);
    free(concretes);
    rename_callee(call_node, existing.mangled_name);
    return existing.ftype;
  }

  // First time for this concrete instantiation: clone the method template
  // with T/U/... substituted, mangle it, and strip its generic markers —
  // from here on it's an ordinary concrete function to every other part of
  // the compiler (typechecked by the drain, codegen'd as a method of owner).
  let cloned: *AST::AstNode = AST::clone_node_substituting(tmpl.decl, fd.type_params, concretes, count);
  let cfd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(cloned);

  free(cfd.name);
  cfd.name = mangled; // ownership transferred to the node

  let tpi: i64 = 0;
  loop (tpi < cfd.type_param_count) { free(cfd.type_params[tpi]); tpi = tpi + 1; }
  free(cfd.type_params);
  cfd.type_params = cast<**byte>(0);
  cfd.type_param_count = 0;

  let ftype: *AST::AstNode = TAST::make_func_type(cfd.param_types, cfd.param_count, cfd.return_type, cloned.line, cloned.col);

  // `key` is retained (ownership passes to the Instantiation entry) so
  // later calls to the same concrete method hit the cache — same
  // convention as instantiate_function_call.
  add_instantiation(key, ftype, cfd.name);
  pending_push(cloned, tmpl.def_scope, tmpl.module_name, dup_str(tmpl.owner), tmpl.method_is_static);

  free(concretes);
  rename_callee(call_node, cfd.name);
  return ftype;
}

// ─── struct/enum generics ──────────────────────────────────────────────────
// `Box<i64>` in type position, `Box<i64> { ... }` struct-literal position, or
// `State<i64>::Idle` enum-member position. The enum case mirrors the struct
// case exactly: the trigger is a TYPE_BASIC leaf carrying a
// `<i64, ...>` type-argument list (tc_type.resolve_type_leaf,
// tc_expr.tc_struct_expr, and tc_member's generic handling all route such
// leaves through the shared core below). The leaf is rewritten in place to a
// plain named type (e.g. `Box__int` / `State__int`), so every downstream
// consumer — codegen included — just sees an ordinary concrete struct/enum;
// the concrete decl itself is queued through the same pending queue and
// drained by tc.lx like a function instantiation.

// Both StructDeclNode and EnumDeclNode carry the identical
// `type_params: **byte` / `type_param_count: i64` pair that literal
// initialization can't see statically, so branch to pull the right field.
const decl_tp_count -> fn (decl: *AST::AstNode) i64 {
  if (decl.kind == AST::NodeType::STMT_STRUCT) return cast<*AST::StructDeclNode>(decl).type_param_count;
  if (decl.kind == AST::NodeType::STMT_ENUM)   return cast<*AST::EnumDeclNode>(decl).type_param_count;
  return 0;
}

const decl_tp_names -> fn (decl: *AST::AstNode) **byte {
  if (decl.kind == AST::NodeType::STMT_STRUCT) return cast<*AST::StructDeclNode>(decl).type_params;
  if (decl.kind == AST::NodeType::STMT_ENUM)   return cast<*AST::EnumDeclNode>(decl).type_params;
  return cast<**byte>(0);
}

const decl_base_name -> fn (decl: *AST::AstNode) *byte {
  if (decl.kind == AST::NodeType::STMT_STRUCT) return cast<*AST::StructDeclNode>(decl).name;
  if (decl.kind == AST::NodeType::STMT_ENUM)   return cast<*AST::EnumDeclNode>(decl).name;
  return cast<*byte>(0);
}

// Frees + zeroes the `type_params`/`type_param_count` pair on the given
// generic decl — called on a clone after substitution, turning it into an
// ordinary concrete decl. (The commented code is the struct/enum-specific
// reopen block that strips method type params / anything else kind-specific.)
const degenericize_decl -> fn (cloned: *AST::AstNode) void {
  if (cloned.kind == AST::NodeType::STMT_STRUCT) {
    let csd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(cloned);
    let tpi: i64 = 0;
    loop (tpi < csd.type_param_count) { free(csd.type_params[tpi]); tpi = tpi + 1; }
    free(csd.type_params);
    csd.type_params = cast<**byte>(0);
    csd.type_param_count = 0;
    return;
  }
  if (cloned.kind == AST::NodeType::STMT_ENUM) {
    let ced: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(cloned);
    let tpi: i64 = 0;
    loop (tpi < ced.type_param_count) { free(ced.type_params[tpi]); tpi = tpi + 1; }
    free(ced.type_params);
    ced.type_params = cast<**byte>(0);
    ced.type_param_count = 0;
  }
}
// A method inside a generic struct template inherits the struct's type params
// (e.g. `fn<K, V> new(...)`). clone_node_substituting clones the body with
// K/V substituted but leaves `FuncDeclNode.type_param_count` intact —
// handle_func_decl then skips the body as still-generic. This strips those
// cloned-away params from each method so the pending drain can check them.
const strip_method_type_params -> fn (members: **AST::AstNode, count: i64) void {
  let mi: i64 = 0;
  loop (mi < count) {
    if (members[mi] != cast<*AST::AstNode>(0) && members[mi].kind == AST::NodeType::STMT_FIELD_DECL) {
      let fdn: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(members[mi]);
      if (fdn.function != cast<*AST::AstNode>(0) && fdn.function.kind == AST::NodeType::STMT_FUNCTION) {
        let fnd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(fdn.function);
        if (fnd.type_param_count > 0) {
          let j: i64 = 0;
          loop (j < fnd.type_param_count) { free(fnd.type_params[j]); j = j + 1; }
          free(fnd.type_params);
          fnd.type_params = cast<**byte>(0);
          fnd.type_param_count = 0;
        }
      }
    }
    mi = mi + 1;
  }
}

#returns_ownership
const scope_module_name -> fn (scope: *CORE::Scope) *byte {
  let s: *CORE::Scope = scope;
  loop (s != cast<*CORE::Scope>(0)) {
    if (s.is_module_scope) return s.module_name;
    s = s.parent;
  }
  return cast<*byte>(0);
}

#returns_ownership
pub const resolve_nominal_type_ref -> fn (leaf: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  let mod_name: *byte = scope_module_name(scope);
  return resolve_nominal_type_ref_in(leaf, scope, mod_name);
}

// Same-module `Box<i64>` handling (above) generalized to an explicitly
// named defining module, so a qualified reference such as `G::Box<i64>` in
// an `@use "gen" as G` module resolves the template in *gen*'s registry
// instead of the caller's own — the one thing that made generic structs /
// enums same-module-only (see docs/docs.md's Generics section). A mismatch
// between the mangled procedures of both entry points is impossible: the
// concrete instantiation is keyed on `(tmpl.module_name, mangled)`, and the
// template's module_name is the module the caller passes in, so two modules
// referencing the same concrete type yield the identical cached clone.
#returns_ownership
pub const resolve_nominal_type_ref_in -> fn (leaf: *AST::AstNode, scope: *CORE::Scope, def_module_name: *byte) *AST::AstNode {
  if (leaf == cast<*AST::AstNode>(0)) return leaf;
  if (leaf.kind != AST::NodeType::TYPE_BASIC) return leaf;

  let bn: *AST::BasicTypeNode = cast<*AST::BasicTypeNode>(leaf);
  if (bn.type_arg_count == 0) return leaf;

  if (def_module_name == cast<*byte>(0)) {
    ERR::tc_error_id(leaf, bn.name, "Generics Error", "cannot determine declaring module", "missing module scope");
    return leaf;
  }

  let tmpl: *GenericTemplate = find_template(def_module_name, bn.name);
  if (tmpl == cast<*GenericTemplate>(0)) {
    ERR::tc_error_id(leaf, bn.name, "Generics Error", "generic type not found", "not found");
    return leaf;
  }
  if (tmpl.decl.kind != AST::NodeType::STMT_STRUCT && tmpl.decl.kind != AST::NodeType::STMT_ENUM) {
    ERR::tc_error_id(leaf, bn.name, "Generics Error", "not a generic struct or enum", "expected struct or enum template");
    return leaf;
  }

  let tp_count: i64 = decl_tp_count(tmpl.decl);
  if (bn.type_arg_count != tp_count) {
    ERR::tc_error(leaf, "Generics Error",
      "wrong number of explicit type arguments for this generic struct or enum", "type argument count mismatch");
    return leaf;
  }

  let count: i64 = tp_count;
  let concretes: **AST::AstNode = cast<**AST::AstNode>(alloc(sizeof<*AST::AstNode> * count));
  let i: i64 = 0;
  loop (i < count) {
    concretes[i] = TYPE::resolve_type_ref(bn.type_args[i], scope);
    i = i + 1;
  }

  let mangled: *byte = build_mangled_name(decl_base_name(tmpl.decl), concretes, count);
  let key: *byte = join2(tmpl.module_name, mangled);

  let existing: *Instantiation = find_instantiation(key);
  if (existing == cast<*Instantiation>(0)) {
    // First time for this concrete instantiation: clone the whole template
    // with every T/U/... substituted, give it the mangled name, and strip
    // its own generic markers — from here on it's an ordinary concrete
    // struct/enum (registered + typechecked by tc.lx's drain).
    let cloned: *AST::AstNode = AST::clone_node_substituting(tmpl.decl, decl_tp_names(tmpl.decl), concretes, count);
    if (cloned.kind == AST::NodeType::STMT_STRUCT) {
      let csd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(cloned);
      free(csd.name);
      csd.name = dup_str(mangled); // ownership transferred to the node
      degenericize_decl(cloned);
      strip_method_type_params(csd.public_members,  csd.public_count);
      strip_method_type_params(csd.private_members, csd.private_count);
    } else {
      let ced: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(cloned);
      free(ced.name);
      ced.name = dup_str(mangled); // ownership transferred to the node
      degenericize_decl(cloned);
    }

    // `key` is retained (ownership passes to the Instantiation entry) so
    // later references to the same concrete type hit the cache — same
    // convention as instantiate_function_call.
    add_instantiation(key, TYPE::make_named_type(mangled), dup_str(mangled));
    pending_push(cloned, tmpl.def_scope, tmpl.module_name, cast<*byte>(0), 0);
  } else {
    free(key);
  }
  free(concretes);

  // Rewrite the leaf in place to the plain concrete name.
  free(bn.name);
  bn.name = mangled; // ownership transferred to the node
  bn.type_arg_count = 0;
  return leaf;
}

// A struct template's method set is the same for every instantiation
// (bodies clone with type params substituted, the member list doesn't
// change), so checking a static-call name against the raw template proves
// whether *any* concrete instantiation could have it — tc_call uses this to
// report `Foo::missing()` before letting the call fall through to codegen's
// placeholder.
pub const struct_template_has_method -> fn (sd: *AST::StructDeclNode, method_name: *byte) bool {
  let groups: i64 = 0;
  loop (groups < 2) {
    let members: **AST::AstNode = sd.public_members;
    let count: i64 = sd.public_count;
    if (groups == 1) { members = sd.private_members; count = sd.private_count; }

    let i: i64 = 0;
    loop (i < count) {
      let m: *AST::AstNode = members[i];
      if (m != cast<*AST::AstNode>(0) && m.kind == AST::NodeType::STMT_FIELD_DECL) {
        let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(m);
        if (f.function != cast<*AST::AstNode>(0) &&
            f.function.kind == AST::NodeType::STMT_FUNCTION &&
            STR::strcmp(f.name, method_name) == 0) {
          return true;
        }
      }
      i = i + 1;
    }
    groups = groups + 1;
  }
  return false;
}
