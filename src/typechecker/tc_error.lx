@module "tc_error"

@use "std_cstring" as STR
@use "error"      as ERR 
@use "ast"        as AST
@use "lexer_tokens" as TOK

pub let g_tokens:      *TOK::Token = cast<*TOK::Token>(0);
pub let g_token_count: int    = 0;
pub let g_file_path:   *byte  = cast<*byte>(0);

pub const tc_error_init -> fn (mod: *AST::ModuleNode) void {
  g_tokens      = mod.tokens;
  g_token_count = mod.token_count;
  g_file_path   = mod.file_path;
}

#returns_ownership
pub const generate_line_for_current_module -> fn (line: int) *byte {
  return ERR::generate_line(g_tokens, g_token_count, line);
}

// `label` is the short caption printed right after the caret underline
// (e.g. `^^^^ not a numeric type`) — a few words, distinct from the full
// sentence in `message`.
const do_error -> fn (node: *AST::AstNode, error_type: *byte, message: *byte, help: *byte, token_len: int, label: *byte) void {
  let err: ERR::ErrorInformation = ERR::ErrorInformation {
    error_type:   error_type,
    file_path:    g_file_path,
    message:      message,
    line:         node.line,
    col:          node.col,
    line_text:    ERR::generate_line(g_tokens, g_token_count, node.line),
    token_length: token_len,
    label:        label,
    help:         help,
    note:         cast<*byte>(0),
  };

  ERR::error_add(err);
}

// `message` is handed to `error_add`, which stashes it on the queued
// ErrorInformation for `error_report()` to print later — it outlives this
// call, so the caller doesn't (and can't) free it itself. Marking these
// #takes_ownership lets the static analyzer treat passing an allocated
// `message` here the same as an explicit `free()`, instead of reporting it
// as a leak (the message is never freed explicitly, since the compiler
// exits shortly after printing — the same accepted "process-lifetime
// allocation" pattern #returns_ownership already covers for callers).
#takes_ownership
pub const tc_error -> fn (node: *AST::AstNode, error_type: *byte, message: *byte, label: *byte) void {
  do_error(node, error_type, message, cast<*byte>(0), 1, label);
}

#takes_ownership
pub const tc_error_help -> fn (node: *AST::AstNode, error_type: *byte, help: *byte, message: *byte, label: *byte) void {
  do_error(node, error_type, message, help, 1, label);
}

#takes_ownership
pub const tc_error_id -> fn (node: *AST::AstNode, identifier: *byte, error_type: *byte, message: *byte, label: *byte) void {
  let len: int = 1;
  if (identifier != cast<*byte>(0)) {
    len = STR::strlen(identifier);
  }
  do_error(node, error_type, message, cast<*byte>(0), len, label);
}

// Like tc_error, but with an explicit caret width instead of the default 1
// — for pointing at something wider than a single token, e.g. a quoted
// string literal (whose reconstructed line text includes the quotes).
#takes_ownership
pub const tc_error_len -> fn (node: *AST::AstNode, error_type: *byte, message: *byte, token_len: int, label: *byte) void {
  do_error(node, error_type, message, cast<*byte>(0), token_len, label);
}
