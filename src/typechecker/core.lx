@module "tc_core"

@use "std_vector" as VEC
@use "ast"        as AST

pub const TypeMatchResult -> enum {
  TYPE_MATCH_NONE,
  TYPE_MATCH_COMPATIBLE,
  TYPE_MATCH_EXACT,
};

pub const TypeError -> struct {
  message: *byte,
  line:    int,
  col:     int,
  context: *byte,
};

pub const StaticAllocation -> struct {
  line:                 int,
  col:                  int,
  variable_name:        *byte,
  original_variable:    *byte,
  has_matching_free:    bool,
  free_count:           int,
  conditional_free:     int,
  use_after_free_count: int,
  aliases:              *VEC::Vector,
  reported:             bool,
  address_taken:        bool,
  function_name:        *byte,
  file_path:            *byte,
};

pub const StaticMemoryAnalyzer -> struct {
  allocations:          *VEC::Vector,
  skip_memory_tracking: bool,
};

pub const Symbol -> struct {
  name:              *byte,
  type:              *AST::AstNode,
  is_public:         bool,
  is_mutable:        bool,
  scope_depth:       int,
  returns_ownership: bool,
  takes_ownership:   bool,
};

pub const Scope -> struct {
  parent:            *Scope,
  symbols:           *VEC::Vector,
  scope_name:        *byte,
  depth:             int,
  is_function_scope: bool,
  associated_node:   *AST::AstNode,

  is_module_scope:   bool,
  module_name:       *byte,
  imported_modules:  *VEC::Vector,

  returns_ownership: bool,
  takes_ownership:   bool,

  memory_analyzer:   *StaticMemoryAnalyzer,
  deferred_frees:    *VEC::Vector,

  check_mem:         bool,
  os:                *byte,
};

pub const ModuleImport -> struct {
  module_name:  *byte,
  alias:        *byte,
  module_scope: *Scope,
};

pub const ModuleDependency -> struct {
  module_name:  *byte,
  dependencies: VEC::Vector,
  processed:    bool,
};

// ─── generics: synthesized declarations, for codegen's Pass A ───────────
// Each concrete generic instantiation (see tc_generics) is an ordinary
// FuncDeclNode by the time typecheck is done with it, but it isn't part of
// any ModuleNode.body (that array is fixed-size from parse time) — codegen
// reads this list in addition to each module's normal body so it emits a
// prototype/definition for every instantiation actually used.
pub const GeneratedDecl -> struct {
  module_name: *byte,
  decl:        *AST::AstNode,
};

let g_generated_decls: VEC::Vector;
let g_generated_decls_ready: bool = false;

const generated_decls_init -> fn () void {
  if (g_generated_decls_ready) return;
  g_generated_decls_ready = true;
  g_generated_decls = VEC::create_vector(sizeof<GeneratedDecl>);
}

pub const record_generated_decl -> fn (module_name: *byte, decl: *AST::AstNode) void {
  generated_decls_init();
  let gd: GeneratedDecl = GeneratedDecl { module_name: module_name, decl: decl };
  g_generated_decls.push_back(cast<*void>(&gd));
}

pub const generated_decl_count -> fn () int {
  generated_decls_init();
  return g_generated_decls.size;
}

pub const generated_decl_at -> fn (i: int) *GeneratedDecl {
  generated_decls_init();
  return cast<*GeneratedDecl>(g_generated_decls.get(i));
}
