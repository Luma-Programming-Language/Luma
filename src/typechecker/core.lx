//! Core shared data types for the type checker.
//!
//! Defines the enumerations and records used throughout type checking —
//! match results, scopes, symbols, static-memory analysis state, module
//! imports/dependencies — plus module-level registries for synthesized
//! (instantiated generic) declarations, deferred unresolved type names, and
//! nominal (struct/enum) declarations.

@module "tc_core"

@use "std_vector" as VEC
@use "std_cstring" as STR
@use "ast"        as AST

/// Result of comparing two types: none, compatible, or exact.
pub const TypeMatchResult -> enum {
  TYPE_MATCH_NONE,
  TYPE_MATCH_COMPATIBLE,
  TYPE_MATCH_EXACT,
};

/// One typecheck error: message text, source position, and context.
pub const TypeError -> struct {
  message: *byte,
  line:    i64,
  col:     i64,
  context: *byte,
};

/// Tracks a single allocation site for the static memory checker.
///
/// Records the variable, its matching free/alias/address-taken state, and the
/// counts used to report use-after-free and un-freed allocations.
pub const StaticAllocation -> struct {
  line:                 i64,
  col:                  i64,
  variable_name:        *byte,
  original_variable:    *byte,
  has_matching_free:    bool,
  free_count:           i64,
  conditional_free:     i64,
  use_after_free_count: i64,
  aliases:              *VEC::Vector,
  reported:             bool,
  address_taken:        bool,
  function_name:        *byte,
  file_path:            *byte,
};

/// Per-module scratch state for the static memory checker. One analyzer is
/// shared (via pointer) across every scope in a module.
pub const StaticMemoryAnalyzer -> struct {
  allocations:          *VEC::Vector,
  skip_memory_tracking: bool,
};

/// A name bound in a scope: its type, visibility, mutability, ownership
/// attributes, and declaring scope depth.
pub const Symbol -> struct {
  name:              *byte,
  type:              *AST::AstNode,
  is_public:         bool,
  is_mutable:        bool,
  scope_depth:       i64,
  returns_ownership: bool,
  takes_ownership:   bool,
};

/// A lexical scope or, for the root of each module, the module scope itself.
///
/// Links to its parent, its symbols and imported modules, the enclosing
/// function/module, ownership attributes, and the shared memory analyzer.
pub const Scope -> struct {
  parent:            *Scope,
  symbols:           *VEC::Vector,
  scope_name:        *byte,
  depth:             i64,
  is_function_scope: bool,
  associated_node:   *AST::AstNode,

  is_module_scope:   bool,
  module_name:       *byte,
  imported_modules:  *VEC::Vector,

  returns_ownership: bool,
  takes_ownership:   bool,

  memory_analyzer:   *StaticMemoryAnalyzer,
  deferred_frees:    *VEC::Vector,

  check_mem:         bool,
  os:                *byte,
};

/// A resolved `@use "module" as alias` import, bound to the imported module's
/// scope.
pub const ModuleImport -> struct {
  module_name:  *byte,
  alias:        *byte,
  module_scope: *Scope,
};

/// Records one module's dependency set for topological ordering of typecheck.
pub const ModuleDependency -> struct {
  module_name:  *byte,
  dependencies: VEC::Vector,
  processed:    bool,
};

// ─── generics: synthesized declarations, for codegen's Pass A ───────────
// Each concrete generic instantiation (see tc_generics) is an ordinary
// FuncDeclNode by the time typecheck is done with it, but it isn't part of
// any ModuleNode.body (that array is fixed-size from parse time) — codegen
// reads this list in addition to each module's normal body so it emits a
// prototype/definition for every instantiation actually used.
/// A concrete generic instantiation synthesized during typechecking.
///
/// Instantiated declarations are appended here (in addition to any module
/// body) so codegen's Pass A can emit a prototype/definition for each. For an
/// instantiated generic method, `owner` names the owning struct and `is_static`
/// records whether it is a static method.
pub const GeneratedDecl -> struct {
  module_name: *byte,
  decl:        *AST::AstNode,
  // For instantiated generic *methods* (Thing::make<T>): the owning struct
  // and static flag, so codegen registers the concrete method as a method
  // of the struct rather than a standalone function. NULL / 0 otherwise.
  owner:       *byte,
  is_static:   i64,
};

/// Module-level registry of synthesized generic instantiations.
let g_generated_decls: VEC::Vector;
/// Whether the generated-decls registry has been initialized.
let g_generated_decls_ready: bool = false;

/// Lazily initializes the generated-decls registry exactly once.
const generated_decls_init -> fn () void {
  if (g_generated_decls_ready) return;
  g_generated_decls_ready = true;
  g_generated_decls = VEC::create_vector(sizeof<GeneratedDecl>);
}

/// Appends a synthesized generic instantiation to the registry, initializing
/// it if needed.
pub const record_generated_decl -> fn (module_name: *byte, decl: *AST::AstNode, owner: *byte, is_static: i64) void {
  generated_decls_init();
  let gd: GeneratedDecl = GeneratedDecl { module_name: module_name, decl: decl, owner: owner, is_static: is_static };
  g_generated_decls.push_back(cast<*void>(&gd));
}

/// Returns how many generated declarations have been recorded.
pub const generated_decl_count -> fn () i64 {
  generated_decls_init();
  return g_generated_decls.size;
}

/// Returns the generated declaration at index `i`.
pub const generated_decl_at -> fn (i: i64) *GeneratedDecl {
  generated_decls_init();
  return cast<*GeneratedDecl>(g_generated_decls.get(i));
}

// Names referenced bare in type position (`let x: Token`) that matched
// nothing when first examined. Type resolution runs in two passes (Pass 3a
// forwards a module's declarations statement-by-statement, Pass 3b checks
// bodies), so a name used before its struct is declared later in the same
// module is *supposed* to resolve by the time typecheck is done — defer
// the "unknown type" report until every declaration is registered. Left
// unreported, an unknown type name silently falls through to codegen, which
// emits it verbatim and lets cc produce a confusing "unknown type name".
/// A name referenced in bare type position that matched nothing when first
/// examined.
///
/// Type resolution runs in multiple passes, so a name used before its
/// declaration appears later in a module is expected to resolve by the end of
/// typecheck; reporting is deferred until then.
pub const UnresolvedTypeName -> struct {
  module_scope: *Scope,
  name:         *byte,
  err_node:     *AST::AstNode,
};

/// Whether the unresolved-type registry has been initialized.
let g_unresolved_types_ready: bool = false;
/// Module-level registry of deferred, still-unresolved type names.
let g_unresolved_types: VEC::Vector;

/// Lazily initializes the unresolved-type registry exactly once.
const unresolved_types_init -> fn () void {
  if (g_unresolved_types_ready) return;
  g_unresolved_types_ready = true;
  g_unresolved_types = VEC::create_vector(sizeof<UnresolvedTypeName>);
}

/// Records a deferred unresolved type name, skipping duplicates for the same
/// error node.
pub const record_unresolved_type_name -> fn (module_scope: *Scope, name: *byte, err_node: *AST::AstNode) void {
  unresolved_types_init();
  let c: i64 = g_unresolved_types.size;
  loop [i: i64 = 0](i < c) : (++i) {
    let e: *UnresolvedTypeName = cast<*UnresolvedTypeName>(g_unresolved_types.get(i));
    if (e.err_node == err_node) return;
  }
  let u: UnresolvedTypeName = UnresolvedTypeName { module_scope: module_scope, name: name, err_node: err_node };
  g_unresolved_types.push_back(cast<*void>(&u));
}

/// Returns how many unresolved type names are pending.
pub const unresolved_type_name_count -> fn () i64 {
  unresolved_types_init();
  return g_unresolved_types.size;
}

/// Returns the unresolved type name at index `i`.
pub const unresolved_type_name_at -> fn (i: i64) *UnresolvedTypeName {
  unresolved_types_init();
  return cast<*UnresolvedTypeName>(g_unresolved_types.get(i));
}

// ─── nominal decl registry, for struct/enum literal member validation ───
// Pass 3b needs the *declaration* (not just the scope symbols) of a struct to
// distinguish real fields from promoted embedded ones when validating struct
// -literal field names: promoted fields never get their own scope symbols
// (register_field skips `...Embedded` members), only the embedding base's do.
// Concrete generic instantiations register their concrete decls here too
// (during the drain), and the origin templates stay reachable via
// tc_generics.find_template, so literals in generic bodies validate against
// the right member set regardless of drain order.
/// One struct/enum declaration registered by raw name.
///
/// The declaration (not just the scope symbol) is needed to tell real fields
/// apart from promoted embedded ones when validating struct-literal field
/// names.
pub const NominalDecl -> struct {
  name: *byte,
  decl: *AST::AstNode,
};

/// Whether the nominal registry has been initialized.
let g_nominals_ready: bool = false;
/// Module-level registry of struct/enum declarations, keyed by name.
let g_nominals: VEC::Vector;

/// Lazily initializes the nominal registry exactly once.
const nominals_init -> fn () void {
  if (g_nominals_ready) return;
  g_nominals_ready = true;
  g_nominals = VEC::create_vector(sizeof<NominalDecl>);
}

// Reset per typecheck run (pairs with scope_arena_teardown): registered decl
// pointers are only valid while the current run's AST is alive.
/// Clears the nominal registry. Called once per typecheck run, since the
/// registered declaration pointers are only valid while the current AST is
/// alive.
pub const nominal_registry_clear -> fn () void {
  if (g_nominals.data != cast<*void>(0)) {
    VEC::free_vector(&g_nominals);
  }
  g_nominals_ready = true;
  g_nominals = VEC::create_vector(sizeof<NominalDecl>);
}

/// Registers a struct/enum declaration under `name`, initializing the registry
/// if needed.
pub const record_nominal_decl -> fn (name: *byte, decl: *AST::AstNode) void {
  nominals_init();
  let nd: NominalDecl = NominalDecl { name: name, decl: decl };
  g_nominals.push_back(cast<*void>(&nd));
}

/// Looks up a registered struct/enum declaration by name, or null.
pub const find_nominal_decl -> fn (name: *byte) *AST::AstNode {
  nominals_init();
  let c: i64 = g_nominals.size;
  loop [i: i64 = 0](i < c) : (++i) {
    let nd: *NominalDecl = cast<*NominalDecl>(g_nominals.get(i));
    if (STR::strcmp(nd.name, name) == 0) return nd.decl;
  }
  return cast<*AST::AstNode>(0);
}
