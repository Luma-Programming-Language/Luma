@module "tc_stmt"

@use "std_memory" as MEM
@use "std_cstring" as STR
@use "std_vector" as VEC

@use "tc_core"     as CORE
@use "tc_type"     as TYPE
@use "tc_scope"    as SCOPE
@use "tc_expr"     as EXPR
@use "tc_generics" as GEN
@use "tc_error"    as ERR
@use "ast"      as AST
@use "ast_type" as TAST
@use "error" as ERR

pub const typecheck_statement -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
pub const register_declaration -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
pub const resolve_os_body -> fn (node: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode;

const handle_var_decl      -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_func_decl     -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const register_struct_decl -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_struct_decl   -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_enum_decl     -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_if          -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_loop        -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_switch      -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_return      -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_block       -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;
const handle_defer       -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool;

pub const typecheck_statement -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  if (stmt == cast<*AST::AstNode>(0)) return true;

  let k: int = stmt.kind;

  if (k == AST::NodeType::STMT_VAR_DECL)   return handle_var_decl(stmt, scope);
  if (k == AST::NodeType::STMT_CONST_DECL) return handle_var_decl(stmt, scope);
  if (k == AST::NodeType::STMT_FUNCTION)   return handle_func_decl(stmt, scope);
  if (k == AST::NodeType::STMT_STRUCT)     return handle_struct_decl(stmt, scope);
  if (k == AST::NodeType::STMT_ENUM)       return handle_enum_decl(stmt, scope);
  if (k == AST::NodeType::STMT_IF)         return handle_if(stmt, scope);
  if (k == AST::NodeType::STMT_LOOP)       return handle_loop(stmt, scope);
  if (k == AST::NodeType::STMT_SWITCH)     return handle_switch(stmt, scope);
  if (k == AST::NodeType::STMT_RETURN)     return handle_return(stmt, scope);
  if (k == AST::NodeType::STMT_BLOCK)      return handle_block(stmt, scope);
  if (k == AST::NodeType::STMT_DEFER)      return handle_defer(stmt, scope);

  if (k == AST::NodeType::STMT_BREAK_CONTINUE) return true;

  if (k == AST::NodeType::STMT_EXPRESSION) {
    let n: *AST::ExprStmtNode = cast<*AST::ExprStmtNode>(stmt);
    EXPR::typecheck_expression(n.expression, scope, cast<*AST::AstNode>(0));
    return true;
  }

  // `@os {}` used as a statement inside a function body (not just at module
  // top level) — e.g. std/io.lx's syscall wrappers. Transparent like the
  // module-level handling in tc.lx's check_module_body: the matched arm's
  // statements are checked directly in `scope`, not a nested child scope,
  // so a `let`/`const` inside it stays visible to code after the block.
  if (k == AST::NodeType::PREPROCESSOR_OS) {
    let body: *AST::AstNode = resolve_os_body(stmt, scope);
    if (body == cast<*AST::AstNode>(0)) return true;
    if (body.kind != AST::NodeType::STMT_BLOCK) return typecheck_statement(body, scope);

    let blk: *AST::BlockNode = cast<*AST::BlockNode>(body);
    let ok: bool = true;
    loop [i: int = 0](i < blk.stmt_count) : (++i) {
      if (typecheck_statement(blk.statements[i], scope) == false) ok = false;
    }
    return ok;
  }

  return true;
}

pub const resolve_os_body -> fn (node: *AST::AstNode, scope: *CORE::Scope) *AST::AstNode {
  if (node == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);
  if (node.kind != AST::NodeType::PREPROCESSOR_OS) return cast<*AST::AstNode>(0);

  let n: *AST::OsNode = cast<*AST::OsNode>(node);
  let target: *byte = scope.os;

  if (target != cast<*byte>(0)) {
    let i: int = 0;
    loop (n.platforms[i] != cast<*byte>(0)) {
      if (STR::strcmp(n.platforms[i], target) == 0) { return n.bodies[i]; }
      i = i + 1;
    }
  }

  if (n.has_default == 1) return n.default_body;
  return cast<*AST::AstNode>(0);
}

pub const register_declaration -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  if (stmt == cast<*AST::AstNode>(0)) return true;
  let k: int = stmt.kind;

  if (k == AST::NodeType::STMT_FUNCTION) {
    let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(stmt);

    if (fd.type_param_count > 0) {
      // Generic function — its param/return types name placeholders (T,
      // U, ...), not real types, so resolve_type_ref must not touch them
      // yet, and it gets no ordinary callable symbol. Concrete
      // instantiations are cloned + substituted on demand at each call
      // site — see tc_generics.
      GEN::register_template(scope.module_name, fd.name, stmt, scope);
      return true;
    }

    loop [i: int = 0](i < fd.param_count) : (++i) {
      fd.param_types[i] = TYPE::resolve_type_ref(fd.param_types[i], scope);
    }
    fd.return_type = TYPE::resolve_type_ref(fd.return_type, scope);
    let ftype: *AST::AstNode = TAST::make_func_type(fd.param_types, fd.param_count,
                                               fd.return_type, stmt.line, stmt.col);
    SCOPE::scope_add_symbol_full(scope, fd.name, ftype,
                                 fd.is_public == 1, false,
                                 fd.returns_ownership == 1, fd.takes_ownership == 1);
    return true;
  }

  if (k == AST::NodeType::STMT_ENUM)   return handle_enum_decl(stmt, scope);
  if (k == AST::NodeType::STMT_STRUCT) return register_struct_decl(stmt, scope);

  // Forward-register module-level globals that have an explicit declared
  // type, so a *different* module processed earlier in Pass 3b can resolve
  // `ALIAS::global` regardless of module processing order (mirrors the
  // STMT_FUNCTION case above). Type-inferred globals (no `var_type`) can't
  // be forward-registered without evaluating the initializer, so they keep
  // the pre-existing in-order-only visibility — handle_var_decl (Pass 3b)
  // still registers them normally when their own module is checked.
  if (k == AST::NodeType::STMT_VAR_DECL || k == AST::NodeType::STMT_CONST_DECL) {
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(stmt);
    if (vd.var_type != cast<*AST::AstNode>(0)) {
      vd.var_type = TYPE::resolve_type_ref(vd.var_type, scope);
      let mutable: bool = (vd.is_mutable == 1);
      if (k == AST::NodeType::STMT_CONST_DECL) mutable = false;
      SCOPE::scope_add_symbol(scope, vd.name, vd.var_type, vd.is_public == 1, mutable);
    }
    return true;
  }

  if (k == AST::NodeType::PREPROCESSOR_OS) {
    let body: *AST::AstNode = resolve_os_body(stmt, scope);
    if (body != cast<*AST::AstNode>(0)) {
      if (body.kind == AST::NodeType::STMT_BLOCK) {
        let blk: *AST::BlockNode = cast<*AST::BlockNode>(body);
        let sc: int = blk.stmt_count;
        loop [i: int = 0](i < sc) : (++i) {
          register_declaration(blk.statements[i], scope);
        }
      }
    }
    return true;
  }

  return true;
}

const handle_var_decl -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::VarDeclNode = cast<*AST::VarDeclNode>(stmt);
  n.var_type = TYPE::resolve_type_ref(n.var_type, scope);
  let declared: *AST::AstNode = n.var_type;
  let init: *AST::AstNode = n.initializer;

  let inferred: *AST::AstNode = cast<*AST::AstNode>(0);
  if (init != cast<*AST::AstNode>(0)) {
    inferred = EXPR::typecheck_expression(init, scope, declared);
  }

  if (declared == cast<*AST::AstNode>(0) && init == cast<*AST::AstNode>(0)) {
    ERR::tc_error(stmt, "Type Error", "variable declaration needs a type or an initializer", "missing type or initializer");
    return false;
  }

  let final_type: *AST::AstNode = declared;
  if (final_type == cast<*AST::AstNode>(0)) final_type = inferred;

  let ok: bool = true;
  if (declared != cast<*AST::AstNode>(0) && inferred != cast<*AST::AstNode>(0)) {
    if (TYPE::types_match(inferred, declared) == CORE::TypeMatchResult::TYPE_MATCH_NONE) {
      let inferred_str: *byte = TYPE::type_to_string(inferred);
      let declared_str: *byte = TYPE::type_to_string(declared);

      let nlen: int = STR::strlen(n.name);
      let ilen: int = STR::strlen(inferred_str);
      let dlen: int = STR::strlen(declared_str);

      let msg: *byte = cast<*byte>(alloc(256));
      let pos: int = 0;

      let s: *byte = "Cannot assign '";
      MEM::memcpy(cast<*void>(cast<int>(msg) + pos), cast<*void>(s), STR::strlen(s));
      pos = pos + STR::strlen(s);

      MEM::memcpy(cast<*void>(cast<int>(msg) + pos), cast<*void>(inferred_str), ilen);
      pos = pos + ilen;

      s = "' to variable '";
      MEM::memcpy(cast<*void>(cast<int>(msg) + pos), cast<*void>(s), STR::strlen(s));
      pos = pos + STR::strlen(s);

      MEM::memcpy(cast<*void>(cast<int>(msg) + pos), cast<*void>(n.name), nlen);
      pos = pos + nlen;

      s = "' of type '";
      MEM::memcpy(cast<*void>(cast<int>(msg) + pos), cast<*void>(s), STR::strlen(s));
      pos = pos + STR::strlen(s);

      MEM::memcpy(cast<*void>(cast<int>(msg) + pos), cast<*void>(declared_str), dlen);
      pos = pos + dlen;

      // Their contents are already copied into msg — nothing else references
      // these two strings themselves (unlike msg, which tc_error_help stores
      // for later reporting).
      free(inferred_str);
      free(declared_str);

      msg[pos] = '\'';
      pos = pos + 1;
      msg[pos] = '\0';

      // `tc_error_help` is #takes_ownership on `message` — it stashes `msg`
      // in the queued ErrorInformation for error_report() to print later,
      // so it outlives this call. Freeing it here was a use-after-free:
      // error_report() would read `msg` after it had already been freed
      // (usually silently "worked" by luck of heap layout — whatever
      // reused that block hadn't landed yet — until it didn't).
      ERR::tc_error_help(init, "Type Mismatch", "Check that the initializer type matches the declared type", msg, "type mismatch");
      ok = false;
    }
  }

  let mutable: bool = (n.is_mutable == 1);
  if (stmt.kind == AST::NodeType::STMT_CONST_DECL) mutable = false;

  EXPR::track_pointer_source(n.name, init, scope);

  SCOPE::scope_add_symbol(scope, n.name, final_type, n.is_public == 1, mutable);
  return ok;
}

const handle_func_decl -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(stmt);

  // Already handled as a template by register_declaration above — its
  // body is only ever checked per concrete instantiation (tc_generics'
  // pending queue, drained by tc.lx), never directly like this.
  if (fd.type_param_count > 0) return true;

  loop [i: int = 0](i < fd.param_count) : (++i) {
    fd.param_types[i] = TYPE::resolve_type_ref(fd.param_types[i], scope);
  }
  fd.return_type = TYPE::resolve_type_ref(fd.return_type, scope);

  let ftype: *AST::AstNode = TAST::make_func_type(fd.param_types, fd.param_count,
                                             fd.return_type, stmt.line, stmt.col);
  SCOPE::scope_add_symbol_full(scope, fd.name, ftype,
                               fd.is_public == 1, false,
                               fd.returns_ownership == 1, fd.takes_ownership == 1);

  if (fd.forward_declared == 1) return true;
  if (fd.dll_import == 1)       return true;
  if (fd.lib_import == 1)       return true;
  if (fd.body == cast<*AST::AstNode>(0)) return true;

  // Create the function scope and register parameters as mutable locals.
  let fscope: *CORE::Scope = SCOPE::scope_create_child(scope, "function");
  fscope.is_function_scope = true;
  fscope.associated_node   = stmt;
  fscope.returns_ownership = (fd.returns_ownership == 1);
  fscope.takes_ownership   = (fd.takes_ownership == 1);

  let pc: int = fd.param_count;
  loop [i: int = 0](i < pc) : (++i) {
    SCOPE::scope_add_symbol(fscope, fd.param_names[i], fd.param_types[i], false, true);
  }

  let ok: bool = typecheck_statement(fd.body, fscope);

  let analyzer: *CORE::StaticMemoryAnalyzer = fscope.memory_analyzer;
  if (analyzer != cast<*CORE::StaticMemoryAnalyzer>(0)) {
    let fname: *byte = fd.name;
    let dv: *VEC::Vector = fscope.deferred_frees;
    let dc: int = dv.size;
    loop [i: int = 0](i < dc) : (++i) {
      let namep: *byte = cast<**byte>(dv.data)[i];
      SCOPE::analyzer_track_free(analyzer, namep, fname, false);
    }
  }

  return ok;
}

const register_field -> fn (struct_name: *byte, member: *AST::AstNode, scope: *CORE::Scope) void {
  if (member == cast<*AST::AstNode>(0)) return;
  if (member.kind != AST::NodeType::STMT_FIELD_DECL) return;

  let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(member);
  if (f.is_embedded == 1) return;

  let qname: *byte = EXPR::qualify(struct_name, f.name);

  if (f.function != cast<*AST::AstNode>(0)) {
    let fn_node: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(f.function);
    loop [i: int = 0](i < fn_node.param_count) : (++i) {
      fn_node.param_types[i] = TYPE::resolve_type_ref(fn_node.param_types[i], scope);
    }
    fn_node.return_type = TYPE::resolve_type_ref(fn_node.return_type, scope);
    let mtype: *AST::AstNode = TAST::make_func_type(fn_node.param_types, fn_node.param_count,
                                               fn_node.return_type, member.line, member.col);
    SCOPE::scope_add_symbol_full(scope, qname, mtype, f.is_public == 1, false,
                                 fn_node.returns_ownership == 1, fn_node.takes_ownership == 1);
    return;
  }

  f.type_node = TYPE::resolve_type_ref(f.type_node, scope);
  SCOPE::scope_add_symbol(scope, qname, f.type_node, f.is_public == 1, true);
}

const register_struct_decl -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(stmt);

  let stype: *AST::AstNode = TYPE::make_named_type(sd.name);
  SCOPE::scope_add_symbol(scope, sd.name, stype, sd.is_public == 1, false);

  let pubc: int = sd.public_count;
  loop [i: int = 0](i < pubc) : (++i) {
    register_field(sd.name, sd.public_members[i], scope);
  }
  let privc: int = sd.private_count;
  loop [i: int = 0](i < privc) : (++i) {
    register_field(sd.name, sd.private_members[i], scope);
  }
  return true;
}

const handle_struct_decl -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(stmt);

  register_struct_decl(stmt, scope);

  let stype: *AST::AstNode = TYPE::make_named_type(sd.name);
  let pubc: int = sd.public_count;
  loop [i: int = 0](i < pubc) : (++i) {
    let m: *AST::AstNode = sd.public_members[i];
    let is_field_decl: bool = false;
    if (m != cast<*AST::AstNode>(0)) {
      if (m.kind == AST::NodeType::STMT_FIELD_DECL) { is_field_decl = true; }
    }
    if (is_field_decl) {
      let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(m);
      if (f.function != cast<*AST::AstNode>(0)) {
        let mscope: *CORE::Scope = SCOPE::scope_create_child(scope, "method");
        if (f.is_static == 0) {
          SCOPE::scope_add_symbol(mscope, "self", TYPE::make_pointer_to(stype), false, true);
        }
        handle_func_decl(f.function, mscope);
      }
    }
  }
  return true;
}

const handle_enum_decl -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(stmt);

  let etype: *AST::AstNode = TYPE::make_named_type(ed.name);
  SCOPE::scope_add_symbol(scope, ed.name, etype, ed.is_public == 1, false);

  let mc: int = ed.member_count;
  loop [i: int = 0](i < mc) : (++i) {
    let qname: *byte = EXPR::qualify(ed.name, ed.members[i]);
    let mtype: *AST::AstNode = TYPE::make_named_type(ed.name);
    SCOPE::scope_add_symbol(scope, qname, mtype, ed.is_public == 1, false);
  }
  return true;
}

const check_condition -> fn (cond: *AST::AstNode, scope: *CORE::Scope) void {
  if (cond == cast<*AST::AstNode>(0)) return;
  let ct: *AST::AstNode = EXPR::typecheck_expression(cond, scope, cast<*AST::AstNode>(0));
  if (ct != cast<*AST::AstNode>(0)) {
    if (TYPE::is_bool_type(ct) == false && TYPE::is_numeric_type(ct) == false) {
      ERR::tc_error(cond, "Type Error", "condition must be a boolean expression", "not a boolean");
    }
  }
}

const handle_if -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::IfStmtNode = cast<*AST::IfStmtNode>(stmt);

  check_condition(n.condition, scope);

  let then_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "then_branch");
  typecheck_statement(n.then_stmt, then_scope);

  let ec: int = n.elif_count;
  loop [i: int = 0](i < ec) : (++i) {
    let elif_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "elif_branch");
    typecheck_statement(n.elif_stmts[i], elif_scope);
  }

  if (n.else_stmt != cast<*AST::AstNode>(0)) {
    let else_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "else_branch");
    typecheck_statement(n.else_stmt, else_scope);
  }
  return true;
}

const handle_loop -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::LoopStmtNode = cast<*AST::LoopStmtNode>(stmt);
  let loop_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "loop");

  // For-loop initializers live in the loop scope.
  let ic: int = n.init_count;
  loop [i: int = 0](i < ic) : (++i) {
    typecheck_statement(n.initializer[i], loop_scope);
  }

  if (n.condition != cast<*AST::AstNode>(0))
    check_condition(n.condition, loop_scope);

  if (n.optional != cast<*AST::AstNode>(0))
    EXPR::typecheck_expression(n.optional, loop_scope, cast<*AST::AstNode>(0));

  return typecheck_statement(n.body, loop_scope);
}

const handle_switch -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::SwitchNode = cast<*AST::SwitchNode>(stmt);
  let cond_type: *AST::AstNode = EXPR::typecheck_expression(n.condition, scope, cast<*AST::AstNode>(0));

  let is_enum: bool = (cond_type != cast<*AST::AstNode>(0) && TYPE::is_nominal_type(cond_type));
  let enum_name: *byte = cast<*byte>(0);
  let members: VEC::Vector = VEC::create_vector(sizeof<*byte>);
  let covered: VEC::Vector = VEC::create_vector(sizeof<*byte>);
  if (is_enum) {
    enum_name = TYPE::basic_name(cond_type);
    members = SCOPE::find_enum_members(scope, enum_name);
  }

  let cc: int = n.case_count;
  loop [i: int = 0](i < cc) : (++i) {
    let case_node: *AST::AstNode = n.cases[i];
    if (case_node != cast<*AST::AstNode>(0)) {
      let cn: *AST::CaseNode = cast<*AST::CaseNode>(case_node);
      let vc: int = cn.value_count;
      loop [j: int = 0](j < vc) : (++j) {
        let cv: *AST::AstNode = cn.values[j];
        EXPR::typecheck_expression(cv, scope, cond_type);

        let cv_is_member: bool = false;
        if (is_enum) {
          if (cv != cast<*AST::AstNode>(0)) {
            if (cv.kind == AST::NodeType::EXPR_MEMBER) { cv_is_member = true; }
          }
        }
        if (cv_is_member) {
          let mn: *AST::MemberNode = cast<*AST::MemberNode>(cv);
          let mobj: *AST::AstNode = mn.object;
          if (mn.is_compiletime == 1 && mobj.kind == AST::NodeType::EXPR_IDENTIFIER) {
            let obj: *AST::IdentifierNode = cast<*AST::IdentifierNode>(mobj);
            if (STR::strcmp(obj.name, enum_name) == 0) {
              let qname: *byte = EXPR::qualify(obj.name, mn.member);

              let already: bool = false;
              let cvc: int = covered.size;
              loop [k: int = 0](k < cvc) : (++k) {
                let seen: *byte = cast<**byte>(covered.data)[k];
                if (STR::strcmp(seen, qname) == 0) { already = true; }
              }

              if (already) {
                ERR::tc_error_id(cv, mn.member, "Duplicate Case", "this enum member is already covered by another case", "duplicate case");
              } else {
                covered.push_back(cast<*void>(&qname));
              }
            }
          }
        }
      }
      let case_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "case");
      typecheck_statement(cn.body, case_scope);
    }
  }

  let has_default: bool = (n.default_case != cast<*AST::AstNode>(0));
  if (n.default_case != cast<*AST::AstNode>(0)) {
    let dn: *AST::DefaultNode = cast<*AST::DefaultNode>(n.default_case);
    let def_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "default");
    typecheck_statement(dn.body, def_scope);
  }

  if (is_enum && covered.size < members.size && has_default == false) {
    ERR::tc_error(stmt, "Non-Exhaustive Switch",
      "not every enum member is covered by this switch — add the missing cases or a default", "missing cases");
  }

  VEC::free_vector(&members);
  VEC::free_vector(&covered);
  return true;
}

const handle_return -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::ReturnStmtNode = cast<*AST::ReturnStmtNode>(stmt);

  let fscope: *CORE::Scope = SCOPE::get_enclosing_function(scope);
  let expected: *AST::AstNode = cast<*AST::AstNode>(0);
  if (fscope != cast<*CORE::Scope>(0)) {
    let assoc: *AST::AstNode = fscope.associated_node;
    if (assoc != cast<*AST::AstNode>(0)) {
      let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(assoc);
      expected = fd.return_type;
    }
  }

  if (n.value == cast<*AST::AstNode>(0)) {
    if (expected != cast<*AST::AstNode>(0) && TYPE::is_void_type(expected) == false) {
      ERR::tc_error(stmt, "Type Error", "non-void function must return a value", "missing return value");
      return false;
    }
    return true;
  }

  let vt: *AST::AstNode = EXPR::typecheck_expression(n.value, scope, expected);
  if (expected != cast<*AST::AstNode>(0) && vt != cast<*AST::AstNode>(0)) {
    if (TYPE::is_void_type(expected)) {
      ERR::tc_error(stmt, "Type Error", "void function cannot return a value", "unexpected return value");
      return false;
    }
    if (TYPE::types_match(vt, expected) == CORE::TypeMatchResult::TYPE_MATCH_NONE) {
      ERR::tc_error(stmt, "Type Error", "returned value does not match the function return type", "type mismatch");
      return false;
    }
  }
  return true;
}

const handle_block -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::BlockNode = cast<*AST::BlockNode>(stmt);
  let block_scope: *CORE::Scope = SCOPE::scope_create_child(scope, "block");

  let ok: bool = true;
  let sc: int = n.stmt_count;
  loop [i: int = 0](i < sc) : (++i) {
    let r: bool = typecheck_statement(n.statements[i], block_scope);
    if (r == false) ok = false;
  }
  return ok;
}

const handle_defer -> fn (stmt: *AST::AstNode, scope: *CORE::Scope) bool {
  let n: *AST::DeferNode = cast<*AST::DeferNode>(stmt);

  let analyzer: *CORE::StaticMemoryAnalyzer = scope.memory_analyzer;
  let was_skipping: bool = false;
  if (analyzer != cast<*CORE::StaticMemoryAnalyzer>(0)) {
    was_skipping = analyzer.skip_memory_tracking;
    analyzer.skip_memory_tracking = true;
  }

  let ok: bool = typecheck_statement(n.statement, scope);

  if (analyzer != cast<*CORE::StaticMemoryAnalyzer>(0)) {
    analyzer.skip_memory_tracking = was_skipping;
  }
  return ok;
}
