@module "constants"

@use "std_vector" as VEC

pub const Luma_Compiler_version: *byte = "v0.3.8";

pub const LumaErrorCode -> enum {
  Argc_Error,
  File_Error,
  Memory_Error,
  Lexer_Error,
  Parser_Error,
  Runtime_Error,
  NO_FILES_ERROR,
  Unknown_Error,
};

pub const LumaErrorMessage -> struct {
  message: *byte,
  code: i64,
};

pub const LumaBuildConfig -> struct {
  filepath: *byte,
  name: *byte,
  os: *byte,
  target_explicit: bool,
  no_compile: bool,
  save: bool,
  clean: bool,
  check_mem: bool,
  lsp_mode: bool,
  debug: bool,
  anim: bool,
  docs: bool,
  docs_dir: *byte,
  file_count: i64,
  opt_level: i64,
  link_files: VEC::Vector,

  static init_build_config -> fn (filepath: *byte) LumaBuildConfig {
    return LumaBuildConfig {
      filepath: filepath,
      name: "a.out",
      os: "unknown",
      target_explicit: false,
      no_compile: false,
      save: false,
      clean: false,
      check_mem: true,
      lsp_mode: false,
      debug: false,
      anim: true,
      docs: false,
      docs_dir: "docs/api",
      file_count: 0,
      opt_level: 2,
      link_files: VEC::create_vector(sizeof<*byte>),
    };
  },
};
