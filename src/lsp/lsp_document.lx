//! Document tracking + single-file analysis for the Luma language server.
//!
//! Each open document is analyzed as its own scratch file, run through the
//! normal parse/typecheck pipeline exactly as the CLI compiler would — but
//! its `@use` imports are resolved transitively against a workspace/std
//! registry first (see the Module Resolution section), so this isn't
//! limited to single-file programs in practice.

@module "lsp_document"

@use "std_vector"  as VEC
@use "std_cstring" as STR
@use "std_memory"  as MEM
@use "std_io"      as IO

@use "ast"          as AST
@use "ast_stmt"     as STMT
@use "constants"    as CONST
@use "parser_file"  as PFILE
@use "parser"       as PARS
@use "tc"           as TC
@use "tc_type"      as TYPE
@use "error"        as ERO
@use "lexer_tokens" as TOK

@use "json"          as J
@use "lsp_transport" as T

pub const LSPDocument -> struct {
  uri:     *byte,        // owned
  text:    *byte,        // owned, latest full content from didOpen/didChange
  version: int,
  ast:     *AST::AstNode, // cached ProgramNode from the last successful parse
                          // (null if the current text doesn't even parse) —
                          // used by position/structure queries (document
                          // symbols, and future hover/go-to-definition) so
                          // they don't need to re-parse on every request.
};

pub let g_documents: VEC::Vector;

pub const lsp_document_init -> fn () void {
  g_documents = VEC::create_vector(sizeof<LSPDocument>);
}

const find_index -> fn (uri: *byte) int {
  let n: int = g_documents.size;
  loop [i: int = 0](i < n) : (++i) {
    let d: *LSPDocument = cast<*LSPDocument>(g_documents.get(i));
    if (STR::strcmp(d.uri, uri) == 0) return i;
  }
  return -1;
}

#returns_ownership
const dup_str -> fn (s: *byte) *byte {
  if (s == cast<*byte>(0)) return cast<*byte>(0);
  let len: int = STR::strlen(s);
  let out: *byte = cast<*byte>(alloc(len + 1));
  MEM::memcpy(cast<*void>(out), cast<*void>(s), len + 1);
  return out;
}

pub const lsp_document_find -> fn (uri: *byte) *LSPDocument {
  let idx: int = find_index(uri);
  if (idx < 0) return cast<*LSPDocument>(0);
  return cast<*LSPDocument>(g_documents.get(idx));
}

pub const lsp_document_open -> fn (uri: *byte, text: *byte, version: int) void {
  let idx: int = find_index(uri);
  if (idx >= 0) {
    let d: *LSPDocument = cast<*LSPDocument>(g_documents.get(idx));
    free(d.text);
    d.text = dup_str(text);
    d.version = version;
    return;
  }

  let doc: LSPDocument = LSPDocument {
    uri: dup_str(uri), text: dup_str(text), version: version,
    ast: cast<*AST::AstNode>(0),
  };
  g_documents.push_back(cast<*void>(&doc));
}

pub const lsp_document_update -> fn (uri: *byte, text: *byte, version: int) void {
  let idx: int = find_index(uri);
  if (idx < 0) { lsp_document_open(uri, text, version); return; }

  let d: *LSPDocument = cast<*LSPDocument>(g_documents.get(idx));
  free(d.text);
  d.text = dup_str(text);
  d.version = version;
}

pub const lsp_document_close -> fn (uri: *byte) void {
  let idx: int = find_index(uri);
  if (idx < 0) return;

  let d: *LSPDocument = cast<*LSPDocument>(g_documents.get(idx));
  free(d.uri);
  free(d.text);
  if (d.ast != cast<*AST::AstNode>(0)) AST::free_node(d.ast);
  g_documents.remove_at(idx);
}

// ============================================================================
// Module Resolution (workspace + std library)
// ============================================================================
//
// Each open document is still analyzed as its own scratch file (see below),
// but its `@use` imports are now resolved against a registry of every
// `@module "name"` declaration found under the std library and the
// workspace root, recursively pulling in whatever transitive imports those
// need too — matching what `-l` does for the CLI compiler, just automated.
//
// There's no directory-listing primitive in std/ yet, so the scan shells
// out to `find` (via the `system()` builtin) and reads its output back from
// a scratch file — simplest thing that works without adding a new FFI
// surface just for this.

const ModuleRegistryEntry -> struct {
  name: *byte, // owned — the @module name
  path: *byte, // owned — absolute file path
};

let g_registry: VEC::Vector;
let g_registry_built: bool = false;
let g_workspace_root: *byte = cast<*byte>(0); // owned; set via lsp_set_workspace_root

@os {
  "linux"     -> { const STD_DIR: *byte = "/usr/local/lib/luma/std"; }
  "macos"     -> { const STD_DIR: *byte = "/usr/local/lib/luma/std"; }
  "windows64" -> { const STD_DIR: *byte = "C:\\Program Files\\luma\\std"; }
  _ -> { const STD_DIR: *byte = "/usr/local/lib/luma/std"; }
}

// Same platform string lsp_analyze feeds into build_config.os, which is
// what the typechecker matches `@os {}` arms against (see resolve_os_body_
// for_tokens's note on why semantic tokens needs this too).
@os {
  "linux"     -> { const CURRENT_OS: *byte = "linux";     }
  "macos"     -> { const CURRENT_OS: *byte = "macos";     }
  "windows64" -> { const CURRENT_OS: *byte = "windows64"; }
  _ -> { const CURRENT_OS: *byte = "unknown"; }
}

const REGISTRY_LISTING_PATH: *byte = "/tmp/.luma-lsp-registry-listing.txt";

// Call once at startup (from the `initialize` handler) with the client's
// rootUri/workspaceFolder, if any — strips a leading "file://" if present.
pub const lsp_set_workspace_root -> fn (uri: *byte) void {
  if (uri == cast<*byte>(0)) return;
  if (g_workspace_root != cast<*byte>(0)) { free(g_workspace_root); g_workspace_root = cast<*byte>(0); }

  let prefix: *byte = "file://";
  let plen: int = STR::strlen(prefix);
  let ulen: int = STR::strlen(uri);
  if (ulen >= plen) {
    let matches: bool = true;
    loop [i: int = 0](i < plen) : (++i) {
      if (uri[i] != prefix[i]) { matches = false; break; }
    }
    if (matches) {
      g_workspace_root = dup_str(cast<*byte>(cast<int>(uri) + plen));
      return;
    }
  }
  g_workspace_root = dup_str(uri);
}

// Returns the index of the first occurrence of `needle` in `haystack`, or
// -1. std_cstring doesn't have a strstr equivalent yet.
const find_substr -> fn (haystack: *byte, needle: *byte) int {
  let hlen: int = STR::strlen(haystack);
  let nlen: int = STR::strlen(needle);
  if (nlen == 0 || nlen > hlen) return -1;

  loop [i: int = 0](i <= hlen - nlen) : (++i) {
    let matched: bool = true;
    loop [j: int = 0](j < nlen) : (++j) {
      if (haystack[i + j] != needle[j]) { matched = false; break; }
    }
    if (matched) return i;
  }
  return -1;
}

// `@module` is always the very first statement in a valid Luma file, so a
// left-to-right scan for the first "@module" followed by a quoted string
// is safe even if that same text also shows up later (e.g. inside a
// keyword table's string literals, as lexer/tokens.lx's own does).
#returns_ownership
const extract_module_name -> fn (content: *byte) *byte {
  let idx: int = find_substr(content, "@module");
  if (idx < 0) return cast<*byte>(0);

  let len: int = STR::strlen(content);
  let i: int = idx + STR::strlen("@module");

  loop (i < len && content[i] != '"') {
    if (content[i] == '\n') return cast<*byte>(0);
    i = i + 1;
  }
  if (i >= len) return cast<*byte>(0);
  i = i + 1; // skip opening quote
  let start: int = i;
  loop (i < len && content[i] != '"') { i = i + 1; }
  if (i >= len) return cast<*byte>(0);

  let name_len: int = i - start;
  let name: *byte = cast<*byte>(alloc(name_len + 1));
  MEM::memcpy(cast<*void>(name), cast<*void>(cast<int>(content) + start), name_len);
  name[name_len] = cast<byte>(0);
  return name;
}

const registry_lookup -> fn (name: *byte) *byte {
  let n: int = g_registry.size;
  loop [i: int = 0](i < n) : (++i) {
    let e: *ModuleRegistryEntry = cast<*ModuleRegistryEntry>(g_registry.get(i));
    if (STR::strcmp(e.name, name) == 0) return e.path;
  }
  return cast<*byte>(0);
}

// Doesn't dedup by name here — registry_lookup/registry_has already scan
// from index 0, so if two files declare the same @module name the first
// one registered simply wins there instead. Keeping this free of any
// "conditionally free, conditionally use" branching sidesteps a static
// analyzer limitation (a free() in one arm of an if/else was incorrectly
// treated as applying to a later use of the same variable in the other
// arm — a control-flow-merge bug, not a real double-free).
const register_file -> fn (path: *byte) void {
  let content: *byte = IO::read_file(path);
  if (content == cast<*byte>(0)) return;

  let name: *byte = extract_module_name(content);
  free(content);

  if (name != cast<*byte>(0)) {
    // `name` assigned as its own statement (not inline in the struct
    // literal) so the analyzer's field-assignment escape tracking sees it
    // hand off into `entry.name` — it's about to be pushed by value into
    // the global registry and live for the rest of the process.
    let entry: ModuleRegistryEntry = ModuleRegistryEntry { name: cast<*byte>(0), path: dup_str(path) };
    entry.name = name;
    g_registry.push_back(cast<*void>(&entry));
  }
}

const append_dir_listing -> fn (dir: *byte) void {
  let mid: *byte = "' -name '*.lx' >> '";
  let tail: *byte = "' 2>/dev/null";
  let total: int = STR::strlen("find '") + STR::strlen(dir) + STR::strlen(mid)
                  + STR::strlen(REGISTRY_LISTING_PATH) + STR::strlen(tail) + 1;
  let cmd: *byte = cast<*byte>(alloc(total));
  STR::cat(cmd, "find '", dir);
  STR::cat(cmd, cmd, mid);
  STR::cat(cmd, cmd, REGISTRY_LISTING_PATH);
  STR::cat(cmd, cmd, tail);
  system(cmd);
  free(cmd);
}

const build_registry -> fn () void {
  if (g_registry_built) return;
  g_registry_built = true;
  g_registry = VEC::create_vector(sizeof<ModuleRegistryEntry>);

  let rm_cmd: *byte = cast<*byte>(alloc(STR::strlen(REGISTRY_LISTING_PATH) + 8));
  STR::cat(rm_cmd, "rm -f '", REGISTRY_LISTING_PATH);
  STR::cat(rm_cmd, rm_cmd, "'");
  system(rm_cmd);
  free(rm_cmd);

  append_dir_listing(STD_DIR);
  if (g_workspace_root != cast<*byte>(0)) { append_dir_listing(g_workspace_root); }

  let listing: *byte = IO::read_file(REGISTRY_LISTING_PATH);
  if (listing == cast<*byte>(0)) return;

  let len: int = STR::strlen(listing);
  let start: int = 0;
  loop [i: int = 0](i <= len) : (++i) {
    if (i == len || listing[i] == '\n') {
      if (i > start) {
        let path_len: int = i - start;
        let path: *byte = cast<*byte>(alloc(path_len + 1));
        MEM::memcpy(cast<*void>(path), cast<*void>(cast<int>(listing) + start), path_len);
        path[path_len] = cast<byte>(0);
        register_file(path);
        free(path);
      }
      start = i + 1;
    }
  }

  free(listing);
}

const name_seen -> fn (seen: *VEC::Vector, name: *byte) bool {
  let n: int = seen.size;
  loop [i: int = 0](i < n) : (++i) {
    let s: *byte = cast<**byte>(seen.data)[i];
    if (STR::strcmp(s, name) == 0) return true;
  }
  return false;
}

// Parses `main_module`'s `@use` imports and, transitively, whatever those
// import in turn, resolving each through the registry — the same closure
// `-l` builds by hand for the CLI compiler. Modules the registry doesn't
// know about are left alone; typecheck's own existing "module not found"
// diagnostic still covers those.
const collect_modules -> fn (main_module: *AST::AstNode) VEC::Vector {
  build_registry();

  let modules: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);
  modules.push_back(cast<*void>(&main_module));

  let seen: VEC::Vector = VEC::create_vector(sizeof<*byte>);
  let main_mod: *AST::ModuleNode = cast<*AST::ModuleNode>(main_module);
  seen.push_back(cast<*void>(&main_mod.name));

  let work_idx: int = 0;
  loop (work_idx < modules.size) {
    let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(cast<**AST::AstNode>(modules.data)[work_idx]);
    let bc: int = mod.body_count;

    loop [i: int = 0](i < bc) : (++i) {
      let bn: *AST::AstNode = mod.body[i];
      if (bn.kind == AST::NodeType::PREPROCESSOR_USE) {
        let u: *AST::UseNode = cast<*AST::UseNode>(bn);
        if (name_seen(&seen, u.module_name) == false) {
          seen.push_back(cast<*void>(&u.module_name));

          let path: *byte = registry_lookup(u.module_name);
          if (path != cast<*byte>(0)) {
            let dep: *AST::AstNode = PFILE::parse_file(path);
            if (dep != cast<*AST::AstNode>(0)) {
              modules.push_back(cast<*void>(&dep));
            }
          }
        }
      }
    }

    work_idx = work_idx + 1;
  }

  VEC::free_vector(&seen);
  return modules;
}

// ============================================================================
// Analysis
// ============================================================================

const SCRATCH_PATH: *byte = "/tmp/.luma-lsp-scratch.lx";

// std_io's write_buffer_to_file opens with local_open_write, which uses a
// plain O_RDWR with no O_CREAT — it only ever writes to a file that already
// exists. The scratch file needs to be created on first use, so write it
// out ourselves via the create-capable primitive instead.
const write_scratch_file -> fn (path: *byte, content: *byte) void {
  let fd: int = IO::local_open_create(path);
  if (IO::local_is_error(fd)) return;
  let len: int = STR::strlen(content);
  IO::local_write(fd, cast<*void>(content), len);
  IO::local_close(fd);
}

pub const lsp_analyze -> fn (doc: *LSPDocument) void {
  ERO::error_clear();

  // The previous parse (if any) is about to be superseded — either by a
  // fresh one below, or by nothing at all if this text fails to parse, in
  // which case stale cached symbols would be worse than none.
  if (doc.ast != cast<*AST::AstNode>(0)) {
    AST::free_node(doc.ast);
    doc.ast = cast<*AST::AstNode>(0);
  }

  write_scratch_file(SCRATCH_PATH, doc.text);

  // error.lx's error_report (called internally by both parse_file and
  // TC::typecheck on failure) writes straight to stdout — our JSON-RPC
  // channel — so analysis has to run with stdout muted. See
  // lsp_transport.lx's suppress_stdout_begin for why.
  let saved_stdout: int = T::suppress_stdout_begin();

  let build_config: CONST::LumaBuildConfig = CONST::init_build_config(SCRATCH_PATH);
  // The static memory analyzer has known false-positive edge cases (see
  // build_registry's comment on register_file) and live-as-you-type
  // feedback is far more sensitive to that noise than a one-shot CLI
  // build — matches --no-sanitize's effect on the compiled binary.
  build_config.check_mem = false;
  @os {
    "linux"     -> { build_config.os = "linux";     }
    "macos"     -> { build_config.os = "macos";     }
    "windows64" -> { build_config.os = "windows64"; }
    _ -> { build_config.os = "unknown"; }
  }

  let main_module: *AST::AstNode = PFILE::parse_file(SCRATCH_PATH);
  if (main_module != cast<*AST::AstNode>(0)) {
    let modules: VEC::Vector = collect_modules(main_module);

    let program: *AST::AstNode = STMT::make_program(
      PARS::vec_to_node_array(&modules), modules.size, 1, 0
    );
    VEC::free_vector(&modules);

    TC::typecheck(program, build_config);

    doc.ast = program;
  }

  VEC::free_vector(&build_config.link_files);

  T::suppress_stdout_end(saved_stdout);
}

// ============================================================================
// Diagnostics
// ============================================================================

#returns_ownership
const build_message_with_help -> fn (message: *byte, help: *byte) *byte {
  let sep: *byte = "\n\nHelp: ";
  let total: int = STR::strlen(message) + STR::strlen(sep) + STR::strlen(help) + 1;
  let out: *byte = cast<*byte>(alloc(total));
  STR::cat(out, message, sep);
  STR::cat(out, out, help);
  return out;
}

#returns_ownership
const diagnostics_array -> fn () *J::JsonValue {
  let arr: *J::JsonValue = J::json_array();
  let count: int = ERO::error_get_count();

  loop [i: int = 0](i < count) : (++i) {
    let e: *ERO::ErrorInformation = ERO::error_get_at_index(i);
    if (e == cast<*ERO::ErrorInformation>(0)) continue;

    // Now that imports get resolved and parsed/typechecked alongside the
    // scratch file, error.lx's (global, shared) list can contain entries
    // that belong to a *dependency* file, not the document being edited —
    // don't surface those as if they were errors in the user's own buffer.
    if (STR::strcmp(e.file_path, SCRATCH_PATH) != 0) continue;

    // node.line is 1-indexed; node.col is already 0-indexed (confirmed
    // against error.lx's own print_indicator, which pads with exactly
    // `col` spaces before the caret with no adjustment) — only line needs
    // the -1 here.
    let start_line: int = 0;
    if (e.line > 0) { start_line = e.line - 1; }
    let start_col: int = e.col;
    if (start_col < 0) { start_col = 0; }
    let tlen: int = 1;
    if (e.token_length > 0) { tlen = e.token_length; }

    let start: *J::JsonValue = J::json_object();
    J::json_object_set(start, "line", J::json_int(start_line));
    J::json_object_set(start, "character", J::json_int(start_col));

    let end: *J::JsonValue = J::json_object();
    J::json_object_set(end, "line", J::json_int(start_line));
    J::json_object_set(end, "character", J::json_int(start_col + tlen));

    let range: *J::JsonValue = J::json_object();
    J::json_object_set(range, "start", start);
    J::json_object_set(range, "end", end);

    let diag: *J::JsonValue = J::json_object();
    J::json_object_set(diag, "range", range);
    J::json_object_set(diag, "severity", J::json_int(1)); // Error — this checker doesn't emit warnings yet
    J::json_object_set(diag, "source", J::json_string("luma-lsp"));

    if (e.help != cast<*byte>(0)) {
      let msg: *byte = build_message_with_help(e.message, e.help);
      J::json_object_set(diag, "message", J::json_string(msg));
      free(msg);
    } else {
      J::json_object_set(diag, "message", J::json_string(e.message));
    }

    J::json_array_push(arr, diag);
  }

  return arr;
}

pub const lsp_publish_diagnostics -> fn (uri: *byte) void {
  let params: *J::JsonValue = J::json_object();
  J::json_object_set(params, "uri", J::json_string(uri));
  J::json_object_set(params, "diagnostics", diagnostics_array());

  // send_notification takes ownership of `params` — it wraps it into its
  // own envelope object and frees *that* (recursively freeing `params`
  // along with it). Freeing `params` again here would double-free it.
  T::send_notification("textDocument/publishDiagnostics", params);
}

// Analyzes `uri`'s current buffer and publishes fresh diagnostics for it.
pub const lsp_analyze_and_publish -> fn (uri: *byte) void {
  let doc: *LSPDocument = lsp_document_find(uri);
  if (doc == cast<*LSPDocument>(0)) return;
  lsp_analyze(doc);
  lsp_publish_diagnostics(uri);
}

// ============================================================================
// Document Symbols
// ============================================================================

const SK_FUNCTION: int = 12;
const SK_STRUCT:   int = 23;
const SK_ENUM:     int = 10;
const SK_VARIABLE: int = 13;
const SK_CONSTANT: int = 14;

// `doc.ast` is the ProgramNode built for the single scratch file this
// document was last analyzed as (see lsp_analyze) — unwrap to its one
// ModuleNode, or null if the current text doesn't parse at all.
const doc_module -> fn (doc: *LSPDocument) *AST::ModuleNode {
  if (doc == cast<*LSPDocument>(0)) return cast<*AST::ModuleNode>(0);
  if (doc.ast == cast<*AST::AstNode>(0)) return cast<*AST::ModuleNode>(0);
  let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(doc.ast);
  if (prog.module_count <= 0) return cast<*AST::ModuleNode>(0);
  return cast<*AST::ModuleNode>(prog.modules[0]);
}

#returns_ownership
const make_position -> fn (line: int, character: int) *J::JsonValue {
  let pos: *J::JsonValue = J::json_object();
  J::json_object_set(pos, "line", J::json_int(line));
  J::json_object_set(pos, "character", J::json_int(character));
  return pos;
}

// Declaration nodes only carry a single (line, col) — where the declaration
// itself starts (e.g. at `pub`/`const`), not a separate position for the
// name token — so `range`/`selectionRange` here are an approximation: a
// span the length of the name, anchored at the declaration's start. Good
// enough to navigate to; not pixel-accurate around the identifier.
#returns_ownership
const make_symbol -> fn (name: *byte, kind: int, line: int, col: int) *J::JsonValue {
  // line is 1-indexed; col is already 0-indexed (see diagnostics_array's note).
  let start_line: int = 0;
  if (line > 0) { start_line = line - 1; }
  let start_col: int = col;
  if (start_col < 0) { start_col = 0; }
  let end_col: int = start_col + STR::strlen(name);

  let range: *J::JsonValue = J::json_object();
  J::json_object_set(range, "start", make_position(start_line, start_col));
  J::json_object_set(range, "end", make_position(start_line, end_col));

  // A JSON tree node can only ever have one parent (json_free recurses
  // unconditionally) — selectionRange needs its own, separately-built copy
  // rather than reusing `range`.
  let selection_range: *J::JsonValue = J::json_object();
  J::json_object_set(selection_range, "start", make_position(start_line, start_col));
  J::json_object_set(selection_range, "end", make_position(start_line, end_col));

  let sym: *J::JsonValue = J::json_object();
  J::json_object_set(sym, "name", J::json_string(name));
  J::json_object_set(sym, "kind", J::json_int(kind));
  J::json_object_set(sym, "range", range);
  J::json_object_set(sym, "selectionRange", selection_range);
  return sym;
}

// Flat (non-nested) list of the document's top-level declarations — enough
// for an editor outline/breadcrumb view. Struct fields, enum members, and
// nested scopes aren't walked yet.
#returns_ownership
pub const lsp_document_symbols -> fn (uri: *byte) *J::JsonValue {
  let arr: *J::JsonValue = J::json_array();

  let mod: *AST::ModuleNode = doc_module(lsp_document_find(uri));
  if (mod == cast<*AST::ModuleNode>(0)) return arr;

  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];

    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
      J::json_array_push(arr, make_symbol(fd.name, SK_FUNCTION, bn.line, bn.col));
    } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      J::json_array_push(arr, make_symbol(sd.name, SK_STRUCT, bn.line, bn.col));
    } elif (bn.kind == AST::NodeType::STMT_ENUM) {
      let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
      J::json_array_push(arr, make_symbol(ed.name, SK_ENUM, bn.line, bn.col));
    } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
      // The parser always emits STMT_VAR_DECL for both `let` and `const` —
      // is_mutable is what actually distinguishes them (STMT_CONST_DECL
      // exists as a NodeType but the parser never produces it; kept here
      // in case that changes).
      let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
      let kind: int = SK_CONSTANT;
      if (vd.is_mutable == 1) { kind = SK_VARIABLE; }
      J::json_array_push(arr, make_symbol(vd.name, kind, bn.line, bn.col));
    }
  }

  return arr;
}

// ============================================================================
// Hover
// ============================================================================
//
// No scope/symbol info survives typecheck (Scope lives and dies inside
// TC::typecheck), and declaration AST nodes only carry a single (line, col)
// rather than a span — so this doesn't do real scope-aware resolution.
// Instead: pull the identifier word out of the live text buffer at the
// requested position, then look that name up as a top-level declaration —
// first in the document's own module, then as a *public* declaration in
// each resolved dependency. Good enough for "what is this function/struct/
// enum/const", not for locals or shadowed names.

const StrBuf -> struct {
  data: *byte,
  len:  int,
  cap:  int,
};

const sb_init -> fn () StrBuf {
  let cap: int = 128;
  return StrBuf { data: cast<*byte>(alloc(cap)), len: 0, cap: cap };
}

const sb_ensure -> fn (b: *StrBuf, extra: int) void {
  if (b.len + extra + 1 <= b.cap) return;
  let old_cap: int = b.cap;
  let new_cap: int = old_cap * 2;
  loop (new_cap < b.len + extra + 1) { new_cap = new_cap * 2; }
  b.data = cast<*byte>(MEM::realloc(cast<*void>(b.data), old_cap, new_cap));
  b.cap = new_cap;
}

const sb_str -> fn (b: *StrBuf, s: *byte) void {
  let n: int = STR::strlen(s);
  sb_ensure(b, n);
  MEM::memcpy(cast<*void>(cast<int>(b.data) + b.len), cast<*void>(s), n);
  b.len = b.len + n;
}

#returns_ownership
const sb_finish -> fn (b: *StrBuf) *byte {
  sb_ensure(b, 0);
  b.data[b.len] = cast<byte>(0);
  return b.data;
}

const is_ident_char -> fn (c: byte) bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Extracts the identifier touching (line, character) in `text` — LSP
// positions are 0-indexed lines with a UTF-16-code-unit character offset,
// same convention used elsewhere in this file.
#returns_ownership
const word_at_position -> fn (text: *byte, line: int, character: int) *byte {
  let len: int = STR::strlen(text);

  let cur_line: int = 0;
  let line_start: int = 0;
  let i: int = 0;
  loop (i < len && cur_line < line) {
    if (text[i] == '\n') { cur_line = cur_line + 1; line_start = i + 1; }
    i = i + 1;
  }
  if (cur_line != line) return cast<*byte>(0);

  let line_end: int = line_start;
  loop (line_end < len && text[line_end] != '\n') { line_end = line_end + 1; }

  let col: int = line_start + character;
  if (col > line_end) { col = line_end; }
  if (col < line_start) { col = line_start; }

  // If the cursor sits right after a word (not inside/before one), step
  // back one so we land on the word instead of whatever follows it.
  let s: int = col;
  if (s > line_start) {
    let at_word_char: bool = s < line_end && is_ident_char(text[s]);
    if (at_word_char == false && is_ident_char(text[s - 1])) { s = s - 1; }
  }
  loop (s > line_start && is_ident_char(text[s - 1])) { s = s - 1; }

  let e: int = s;
  loop (e < line_end && is_ident_char(text[e])) { e = e + 1; }

  if (e <= s) return cast<*byte>(0);

  let wlen: int = e - s;
  let word: *byte = cast<*byte>(alloc(wlen + 1));
  MEM::memcpy(cast<*void>(word), cast<*void>(cast<int>(text) + s), wlen);
  word[wlen] = cast<byte>(0);
  return word;
}

#returns_ownership
const format_func_signature -> fn (fd: *AST::FuncDeclNode) *byte {
  let b: StrBuf = sb_init();
  sb_str(&b, "fn ");
  sb_str(&b, fd.name);
  sb_str(&b, "(");
  loop [i: int = 0](i < fd.param_count) : (++i) {
    if (i > 0) { sb_str(&b, ", "); }
    sb_str(&b, fd.param_names[i]);
    sb_str(&b, ": ");
    let t: *byte = TYPE::type_to_string(fd.param_types[i]);
    sb_str(&b, t);
    free(t);
  }
  sb_str(&b, ") ");
  let rt: *byte = TYPE::type_to_string(fd.return_type);
  sb_str(&b, rt);
  free(rt);
  return sb_finish(&b);
}

#returns_ownership
const format_struct_signature -> fn (sd: *AST::StructDeclNode) *byte {
  let b: StrBuf = sb_init();
  sb_str(&b, "struct ");
  sb_str(&b, sd.name);
  sb_str(&b, " { ");

  let field_count: int = 0;
  loop [i: int = 0](i < sd.public_count) : (++i) {
    let f: *AST::AstNode = sd.public_members[i];
    if (f.kind == AST::NodeType::STMT_FIELD_DECL) {
      let fld: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(f);
      if (fld.function == cast<*AST::AstNode>(0)) { // plain data field, not a method
        if (field_count > 0) { sb_str(&b, ", "); }
        sb_str(&b, fld.name);
        sb_str(&b, ": ");
        let t: *byte = TYPE::type_to_string(fld.type_node);
        sb_str(&b, t);
        free(t);
        field_count = field_count + 1;
      }
    }
  }
  sb_str(&b, " }");
  return sb_finish(&b);
}

#returns_ownership
const format_enum_signature -> fn (ed: *AST::EnumDeclNode) *byte {
  let b: StrBuf = sb_init();
  sb_str(&b, "enum ");
  sb_str(&b, ed.name);
  sb_str(&b, " { ");
  loop [i: int = 0](i < ed.member_count) : (++i) {
    if (i > 0) { sb_str(&b, ", "); }
    sb_str(&b, ed.members[i]);
  }
  sb_str(&b, " }");
  return sb_finish(&b);
}

#returns_ownership
const format_var_signature -> fn (vd: *AST::VarDeclNode) *byte {
  let b: StrBuf = sb_init();
  if (vd.is_mutable == 1) { sb_str(&b, "let "); } else { sb_str(&b, "const "); }
  sb_str(&b, vd.name);
  if (vd.var_type != cast<*AST::AstNode>(0)) {
    sb_str(&b, ": ");
    let t: *byte = TYPE::type_to_string(vd.var_type);
    sb_str(&b, t);
    free(t);
  }
  return sb_finish(&b);
}

// ── Locals & parameters ──────────────────────────────────────────────────────
//
// Top-level declarations don't carry span info, but at the top level of a
// module they're non-overlapping and in source order — so "which function
// contains line L" can still be answered reasonably well as "the last
// top-level function starting at or before L", without needing a real end
// position. Once inside that function, a plain recursive statement walk
// finds `let`/`const` locals (and loop init-bindings, which the parser
// already represents as ordinary var-decl nodes) well enough for hover and
// go-to-definition — not real lexical scoping (no shadowing precision), but
// right in the common case.

const find_enclosing_function -> fn (mod: *AST::ModuleNode, one_indexed_line: int) *AST::FuncDeclNode {
  let best: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(0);
  let best_line: int = -1;

  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      if (bn.line <= one_indexed_line && bn.line > best_line) {
        best = cast<*AST::FuncDeclNode>(bn);
        best_line = bn.line;
      }
    }
  }

  return best;
}

// Recursively searches `stmt` for a `let`/`const` declaration named `name`,
// returning the VarDeclNode (as a plain AstNode) or null.
const search_stmt_for_local_decl -> fn (stmt: *AST::AstNode, name: *byte) *AST::AstNode {
  if (stmt == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);

  if (stmt.kind == AST::NodeType::STMT_VAR_DECL || stmt.kind == AST::NodeType::STMT_CONST_DECL) {
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(stmt);
    if (STR::strcmp(vd.name, name) == 0) return stmt;
    return cast<*AST::AstNode>(0);
  }

  if (stmt.kind == AST::NodeType::STMT_BLOCK) {
    let blk: *AST::BlockNode = cast<*AST::BlockNode>(stmt);
    loop [i: int = 0](i < blk.stmt_count) : (++i) {
      let hit: *AST::AstNode = search_stmt_for_local_decl(blk.statements[i], name);
      if (hit != cast<*AST::AstNode>(0)) return hit;
    }
    return cast<*AST::AstNode>(0);
  }

  if (stmt.kind == AST::NodeType::STMT_IF) {
    let n: *AST::IfStmtNode = cast<*AST::IfStmtNode>(stmt);
    let hit: *AST::AstNode = search_stmt_for_local_decl(n.then_stmt, name);
    if (hit != cast<*AST::AstNode>(0)) return hit;
    loop [i: int = 0](i < n.elif_count) : (++i) {
      hit = search_stmt_for_local_decl(n.elif_stmts[i], name);
      if (hit != cast<*AST::AstNode>(0)) return hit;
    }
    return search_stmt_for_local_decl(n.else_stmt, name);
  }

  if (stmt.kind == AST::NodeType::STMT_LOOP) {
    let n: *AST::LoopStmtNode = cast<*AST::LoopStmtNode>(stmt);
    loop [i: int = 0](i < n.init_count) : (++i) {
      let hit: *AST::AstNode = search_stmt_for_local_decl(n.initializer[i], name);
      if (hit != cast<*AST::AstNode>(0)) return hit;
    }
    return search_stmt_for_local_decl(n.body, name);
  }

  if (stmt.kind == AST::NodeType::STMT_SWITCH) {
    let n: *AST::SwitchNode = cast<*AST::SwitchNode>(stmt);
    loop [i: int = 0](i < n.case_count) : (++i) {
      let c: *AST::CaseNode = cast<*AST::CaseNode>(n.cases[i]);
      let hit: *AST::AstNode = search_stmt_for_local_decl(c.body, name);
      if (hit != cast<*AST::AstNode>(0)) return hit;
    }
    if (n.default_case != cast<*AST::AstNode>(0)) {
      let d: *AST::DefaultNode = cast<*AST::DefaultNode>(n.default_case);
      return search_stmt_for_local_decl(d.body, name);
    }
    return cast<*AST::AstNode>(0);
  }

  if (stmt.kind == AST::NodeType::STMT_DEFER) {
    let n: *AST::DeferNode = cast<*AST::DeferNode>(stmt);
    return search_stmt_for_local_decl(n.statement, name);
  }

  return cast<*AST::AstNode>(0);
}

const LocalThing -> struct {
  found:     bool,
  is_param:  bool,
  line:      int,
  col:       int,
  name_len:  int,
  type_node: *AST::AstNode, // null is a valid "no annotation" case, not "not found"
};

const find_local_thing -> fn (mod: *AST::ModuleNode, one_indexed_line: int, name: *byte) LocalThing {
  let miss: LocalThing = LocalThing {
    found: false, is_param: false, line: 0, col: 0, name_len: 0,
    type_node: cast<*AST::AstNode>(0),
  };

  let fd: *AST::FuncDeclNode = find_enclosing_function(mod, one_indexed_line);
  if (fd == cast<*AST::FuncDeclNode>(0)) return miss;

  loop [i: int = 0](i < fd.param_count) : (++i) {
    if (STR::strcmp(fd.param_names[i], name) == 0) {
      // Parameters have no position of their own — anchored at the
      // function's own line/col, same caveat as everything else here.
      let fn_node: *AST::AstNode = cast<*AST::AstNode>(fd);
      return LocalThing {
        found: true, is_param: true, line: fn_node.line, col: fn_node.col,
        name_len: STR::strlen(fd.param_names[i]), type_node: fd.param_types[i],
      };
    }
  }

  let decl: *AST::AstNode = search_stmt_for_local_decl(fd.body, name);
  if (decl != cast<*AST::AstNode>(0)) {
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(decl);
    return LocalThing {
      found: true, is_param: false, line: decl.line, col: decl.col,
      name_len: STR::strlen(vd.name), type_node: vd.var_type,
    };
  }

  return miss;
}

#returns_ownership
const format_local_hover -> fn (name: *byte, thing: LocalThing) *byte {
  let b: StrBuf = sb_init();
  if (thing.is_param) { sb_str(&b, "(parameter) "); } else { sb_str(&b, "let "); }
  sb_str(&b, name);
  if (thing.type_node != cast<*AST::AstNode>(0)) {
    sb_str(&b, ": ");
    let t: *byte = TYPE::type_to_string(thing.type_node);
    sb_str(&b, t);
    free(t);
  }
  return sb_finish(&b);
}

#returns_ownership
const find_in_module -> fn (mod: *AST::ModuleNode, name: *byte, public_only: bool) *byte {
  if (mod == cast<*AST::ModuleNode>(0)) return cast<*byte>(0);

  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];

    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
      if (STR::strcmp(fd.name, name) == 0 && (public_only == false || fd.is_public == 1)) {
        return format_func_signature(fd);
      }
    } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      if (STR::strcmp(sd.name, name) == 0 && (public_only == false || sd.is_public == 1)) {
        return format_struct_signature(sd);
      }
    } elif (bn.kind == AST::NodeType::STMT_ENUM) {
      let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
      if (STR::strcmp(ed.name, name) == 0 && (public_only == false || ed.is_public == 1)) {
        return format_enum_signature(ed);
      }
    } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
      let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
      if (STR::strcmp(vd.name, name) == 0 && (public_only == false || vd.is_public == 1)) {
        return format_var_signature(vd);
      }
    }
  }

  return cast<*byte>(0);
}

#returns_ownership
const resolve_symbol_signature -> fn (doc: *LSPDocument, name: *byte, zero_indexed_line: int) *byte {
  if (doc == cast<*LSPDocument>(0) || doc.ast == cast<*AST::AstNode>(0)) return cast<*byte>(0);

  let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(doc.ast);
  if (prog.module_count <= 0) return cast<*byte>(0);

  let own_mod: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[0]);

  // Locals/parameters shadow top-level names and only make sense within
  // the document's own file — check them before anything else.
  let local: LocalThing = find_local_thing(own_mod, zero_indexed_line + 1, name);
  if (local.found) return format_local_hover(name, local);

  let own: *byte = find_in_module(own_mod, name, false);
  if (own != cast<*byte>(0)) return own;

  loop [i: int = 1](i < prog.module_count) : (++i) {
    let dep: *byte = find_in_module(cast<*AST::ModuleNode>(prog.modules[i]), name, true);
    if (dep != cast<*byte>(0)) return dep;
  }

  return cast<*byte>(0);
}

// Returns a formatted signature string for the declaration named at
// (line, character) in `uri`'s current buffer, or null if there's no
// document, no word at that position, or no matching declaration.
#returns_ownership
pub const lsp_hover -> fn (uri: *byte, line: int, character: int) *byte {
  let doc: *LSPDocument = lsp_document_find(uri);
  if (doc == cast<*LSPDocument>(0)) return cast<*byte>(0);

  let word: *byte = word_at_position(doc.text, line, character);
  if (word == cast<*byte>(0)) return cast<*byte>(0);

  let sig: *byte = resolve_symbol_signature(doc, word, line);
  free(word);
  return sig;
}

// ============================================================================
// Go to Definition
// ============================================================================
//
// Same word-at-cursor + same-file-then-dependencies resolution as hover,
// just returning a Location (uri + range) instead of formatted text.

const DefHit -> struct {
  found:    bool,
  line:     int,
  col:      int,
  name_len: int,
};

const find_definition_in_module -> fn (mod: *AST::ModuleNode, name: *byte, public_only: bool) DefHit {
  let miss: DefHit = DefHit { found: false, line: 0, col: 0, name_len: 0 };
  if (mod == cast<*AST::ModuleNode>(0)) return miss;

  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    let decl_name: *byte = cast<*byte>(0);
    let is_pub: bool = false;

    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
      decl_name = fd.name; is_pub = fd.is_public == 1;
    } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      decl_name = sd.name; is_pub = sd.is_public == 1;
    } elif (bn.kind == AST::NodeType::STMT_ENUM) {
      let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
      decl_name = ed.name; is_pub = ed.is_public == 1;
    } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
      let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
      decl_name = vd.name; is_pub = vd.is_public == 1;
    }

    if (decl_name != cast<*byte>(0) && STR::strcmp(decl_name, name) == 0 && (public_only == false || is_pub)) {
      return DefHit { found: true, line: bn.line, col: bn.col, name_len: STR::strlen(decl_name) };
    }
  }

  return miss;
}

#returns_ownership
const path_to_uri -> fn (path: *byte) *byte {
  let prefix: *byte = "file://";
  let total: int = STR::strlen(prefix) + STR::strlen(path) + 1;
  let out: *byte = cast<*byte>(alloc(total));
  STR::cat(out, prefix, path);
  return out;
}

#returns_ownership
const make_location_json -> fn (uri: *byte, line: int, col: int, name_len: int) *J::JsonValue {
  // line is 1-indexed; col is already 0-indexed (see diagnostics_array's note).
  let start_line: int = 0;
  if (line > 0) { start_line = line - 1; }
  let start_col: int = col;
  if (start_col < 0) { start_col = 0; }
  let end_col: int = start_col + name_len;

  let range: *J::JsonValue = J::json_object();
  J::json_object_set(range, "start", make_position(start_line, start_col));
  J::json_object_set(range, "end", make_position(start_line, end_col));

  let loc: *J::JsonValue = J::json_object();
  J::json_object_set(loc, "uri", J::json_string(uri));
  J::json_object_set(loc, "range", range);
  return loc;
}

// Returns a Location for the declaration named at (line, character) in
// `uri`'s current buffer, or null if there's no match.
#returns_ownership
pub const lsp_definition -> fn (uri: *byte, line: int, character: int) *J::JsonValue {
  let doc: *LSPDocument = lsp_document_find(uri);
  if (doc == cast<*LSPDocument>(0) || doc.ast == cast<*AST::AstNode>(0)) return cast<*J::JsonValue>(0);

  let word: *byte = word_at_position(doc.text, line, character);
  if (word == cast<*byte>(0)) return cast<*J::JsonValue>(0);

  let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(doc.ast);
  if (prog.module_count <= 0) { free(word); return cast<*J::JsonValue>(0); }

  let own_mod: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[0]);

  let local: LocalThing = find_local_thing(own_mod, line + 1, word);
  if (local.found) {
    free(word);
    return make_location_json(doc.uri, local.line, local.col, local.name_len);
  }

  let own_hit: DefHit = find_definition_in_module(own_mod, word, false);
  if (own_hit.found) {
    free(word);
    return make_location_json(doc.uri, own_hit.line, own_hit.col, own_hit.name_len);
  }

  loop [i: int = 1](i < prog.module_count) : (++i) {
    let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[i]);
    let hit: DefHit = find_definition_in_module(mod, word, true);
    if (hit.found) {
      free(word);
      let target_uri: *byte = path_to_uri(mod.file_path);
      let result: *J::JsonValue = make_location_json(target_uri, hit.line, hit.col, hit.name_len);
      free(target_uri);
      return result;
    }
  }

  free(word);
  return cast<*J::JsonValue>(0);
}

// ============================================================================
// Completion
// ============================================================================
//
// Not context-aware (doesn't distinguish "after a '.'" from "at statement
// start", etc.) — offers keywords, everything visible at the top level
// (own file + public declarations from every resolved dependency), and
// locals/parameters in whichever function encloses the cursor. A client's
// own fuzzy-filtering does the rest.

const CK_FUNCTION: int = 3;
const CK_VARIABLE: int = 6;
const CK_ENUM:      int = 13;
const CK_KEYWORD:   int = 14;
const CK_CONSTANT:  int = 21;
const CK_STRUCT:    int = 22;
const CK_ENUM_MEMBER: int = 20;

const KEYWORD_COUNT: int = 29;
const KEYWORDS: [*byte; 29] = [
  "let", "const", "pub", "fn", "struct", "enum", "if", "elif", "else",
  "loop", "switch", "return", "break", "continue", "defer", "cast",
  "sizeof", "output", "outputln", "true", "false", "null",
  "int", "uint", "float", "double", "bool", "byte", "void"
];

#returns_ownership
const make_completion_item -> fn (label: *byte, kind: int, detail: *byte) *J::JsonValue {
  let item: *J::JsonValue = J::json_object();
  J::json_object_set(item, "label", J::json_string(label));
  J::json_object_set(item, "kind", J::json_int(kind));
  if (detail != cast<*byte>(0)) {
    J::json_object_set(item, "detail", J::json_string(detail));
  }
  return item;
}

// ── Snippets ─────────────────────────────────────────────────────────────────
//
// Tab-stop templates for the shapes of code that show up constantly in
// real Luma (`${1:...}` placeholders, `$0` for where the cursor lands
// last) — mirrors the old C LSP's completion snippet table, minus its
// `fn<T>`/`struct<T>` generic-syntax entries, since this grammar doesn't
// have generics (no TYPE_PARAMETER production anywhere in the parser).
// Every snippet here is real, verified syntax — lifted from or checked
// against actual working code in this repo (e.g. #dll_import's exact
// shape from std/io.lx, @link's from parser/stmt.lx's link_stmt).

const CK_SNIPPET: int = 15;

const SnippetDef -> struct { label: *byte, snippet: *byte, detail: *byte, filter: *byte };

// The block below adds patterns pulled from grepping this actual codebase
// for what's repeated constantly, not just generic language shapes —
// e.g. the AST-node-kind dispatch `if (x.kind == ...) { let n: *T =
// cast<*T>(x); ... }` shows up ~190 times across src/, the null-guard
// early-return ~95 times, `alloc(sizeof<T>)` node construction ~70 times.
const SNIPPET_COUNT: int = 42;
const SNIPPETS: [SnippetDef; 42] = [
  SnippetDef { label: "const fn", snippet: "const ${1:name} -> fn (${2:params}) ${3:Type} {\n\t$0\n}", detail: "Function declaration", filter: "const fn" },
  SnippetDef { label: "pub const fn", snippet: "pub const ${1:name} -> fn (${2:params}) ${3:Type} {\n\t$0\n}", detail: "Public function declaration", filter: "pub const fn" },
  SnippetDef { label: "const struct", snippet: "const ${1:Name} -> struct {\n\t${2:field}: ${3:Type},$0\n};", detail: "Struct definition", filter: "const struct" },
  SnippetDef { label: "pub const struct", snippet: "pub const ${1:Name} -> struct {\n\t${2:field}: ${3:Type},$0\n};", detail: "Public struct definition", filter: "pub const struct" },
  SnippetDef { label: "const enum", snippet: "const ${1:Name} -> enum {\n\t${2:Variant},$0\n};", detail: "Enum definition", filter: "const enum" },
  SnippetDef { label: "pub const enum", snippet: "pub const ${1:Name} -> enum {\n\t${2:Variant},$0\n};", detail: "Public enum definition", filter: "pub const enum" },
  SnippetDef { label: "const var", snippet: "const ${1:name}: ${2:Type} = ${3:value};$0", detail: "Top-level constant", filter: "const" },
  SnippetDef { label: "let", snippet: "let ${1:name}: ${2:Type} = ${3:value};$0", detail: "Variable declaration", filter: "let" },
  SnippetDef { label: "if", snippet: "if (${1:condition}) {\n\t$0\n}", detail: "If statement", filter: "if" },
  SnippetDef { label: "if else", snippet: "if (${1:condition}) {\n\t${2}\n} else {\n\t$0\n}", detail: "If-else statement", filter: "if else" },
  SnippetDef { label: "elif", snippet: "elif (${1:condition}) {\n\t$0\n}", detail: "Elif clause", filter: "elif" },
  SnippetDef { label: "switch", snippet: "switch (${1:value}) {\n\t${2:case} -> {\n\t\t$0\n\t}\n}", detail: "Switch statement", filter: "switch" },
  SnippetDef { label: "switch default", snippet: "switch (${1:value}) {\n\t${2:case} -> {\n\t\t$3\n\t}\n\t_ -> {\n\t\t$0\n\t}\n}", detail: "Switch with default case", filter: "switch default" },
  SnippetDef { label: "loop", snippet: "loop (1) {\n\t$0\n}", detail: "Infinite loop", filter: "loop" },
  SnippetDef { label: "loop while", snippet: "loop (${1:condition}) {\n\t$0\n}", detail: "While-style loop", filter: "loop while" },
  SnippetDef { label: "loop for", snippet: "loop [${1:i}: int = 0](${1:i} < ${2:10}) : (++${1:i}) {\n\t$0\n}", detail: "For-style loop", filter: "loop for" },
  SnippetDef { label: "defer", snippet: "defer ${1:statement};$0", detail: "Defer statement", filter: "defer" },
  SnippetDef { label: "defer block", snippet: "defer {\n\t${1:cleanup()};$0\n}", detail: "Defer block", filter: "defer block" },
  SnippetDef { label: "return", snippet: "return ${1:value};$0", detail: "Return statement", filter: "return" },
  SnippetDef { label: "main", snippet: "const main -> fn (argc: int, argv: **byte) int {\n\t$0\n\treturn 0;\n}", detail: "Main function", filter: "main" },
  SnippetDef { label: "outputln", snippet: "outputln(${1:message});$0", detail: "Output with newline", filter: "outputln" },
  SnippetDef { label: "output", snippet: "output(${1:message});$0", detail: "Output without newline", filter: "output" },
  SnippetDef { label: "system", snippet: "system(\"${1:command}\");$0", detail: "Execute a system command", filter: "system" },
  SnippetDef { label: "cast", snippet: "cast<${1:Type}>(${2:value})$0", detail: "Type cast", filter: "cast" },
  SnippetDef { label: "sizeof", snippet: "sizeof<${1:Type}>$0", detail: "Size of type", filter: "sizeof" },
  SnippetDef { label: "alloc defer", snippet: "let ${1:ptr}: ${2:*Type} = cast<${2:*Type}>(alloc(${3:size}));\ndefer free(${1:ptr});$0", detail: "Allocate with defer cleanup", filter: "alloc" },
  SnippetDef { label: "@module", snippet: "@module \"${1:name}\"$0", detail: "Module declaration", filter: "@module" },
  SnippetDef { label: "@use", snippet: "@use \"${1:module}\" as ${2:alias}$0", detail: "Import a module", filter: "@use" },
  SnippetDef { label: "@os", snippet: "@os {\n\t\"${1:linux}\" -> { $0 }\n\t_ -> {  }\n}", detail: "Platform-conditional block", filter: "@os" },
  SnippetDef { label: "@link", snippet: "@link(\"${1:lib.so}\")$0", detail: "Link a shared library", filter: "@link" },
  SnippetDef { label: "struct method", snippet: "${1:name} -> fn (${2:params}) ${3:Type} {\n\t$0\n}", detail: "Method inside a struct body", filter: "method fn" },
  SnippetDef { label: "#returns_ownership", snippet: "#returns_ownership\nconst ${1:name} -> fn (${2:params}) ${3:*Type} {\n\t$0\n}", detail: "Function that returns an owned pointer", filter: "#returns_ownership" },
  SnippetDef { label: "#dll_import", snippet: "#dll_import(\"${1:kernel32.dll}\", callconv: \"${2:stdcall}\")\npub const ${3:name} -> fn (${4:params}) ${5:Type};$0", detail: "Per-function DLL import (Windows)", filter: "#dll_import" },
  SnippetDef { label: "null guard", snippet: "if (${1:x} == cast<*${2:Type}>(0)) return ${3:cast<*${2:Type}>(0)};$0", detail: "Early-return on a null pointer (~95x across src/)", filter: "if null return guard" },
  SnippetDef { label: "kind dispatch", snippet: "if (${1:node}.kind == ${2:AST::NodeType::KIND}) {\n\tlet ${3:n}: *${4:Type} = cast<*${4:Type}>(${1:node});\n\t$0\n}", detail: "AST node-kind check + cast (~190x across src/)", filter: "if kind cast dispatch" },
  SnippetDef { label: "kind dispatch elif", snippet: "elif (${1:node}.kind == ${2:AST::NodeType::KIND}) {\n\tlet ${3:n}: *${4:Type} = cast<*${4:Type}>(${1:node});\n\t$0\n}", detail: "Additional arm for a node-kind dispatch chain", filter: "elif kind cast dispatch" },
  SnippetDef { label: "alloc struct", snippet: "let ${1:node}: *${2:Type} = cast<*${2:Type}>(alloc(sizeof<${2:Type}>));$0", detail: "Heap-allocate one struct (~70x across src/)", filter: "alloc sizeof struct" },
  SnippetDef { label: "vector iterate", snippet: "loop [${1:i}: int = 0](${1:i} < ${2:vec}.size) : (++${1:i}) {\n\tlet ${3:item}: *${4:Type} = cast<*${4:Type}>(${2:vec}.get(${1:i}));\n\t$0\n}", detail: "Walk a std_vector's elements by index", filter: "loop vector get cast iterate" },
  SnippetDef { label: "push_back", snippet: "${1:vec}.push_back(cast<*void>(&${2:item}));$0", detail: "Append a value onto a std_vector (~60x across src/)", filter: "push_back vector" },
  SnippetDef { label: "vector create defer", snippet: "let ${1:vec}: VEC::Vector = VEC::create_vector(sizeof<${2:Type}>);\ndefer VEC::free_vector(&${1:vec});$0", detail: "New vector with matching cleanup", filter: "vector create_vector defer free" },
  SnippetDef { label: "doc comment", snippet: "/// $0", detail: "Item doc comment", filter: "/// doc comment" },
  SnippetDef { label: "module doc header", snippet: "//! ${1:One-line summary.}\n//!\n//! $0", detail: "Module-level doc header (top of file)", filter: "//! module doc header" },
];

#returns_ownership
const make_snippet_item -> fn (def: SnippetDef) *J::JsonValue {
  let item: *J::JsonValue = J::json_object();
  J::json_object_set(item, "label", J::json_string(def.label));
  J::json_object_set(item, "kind", J::json_int(CK_SNIPPET));
  J::json_object_set(item, "insertText", J::json_string(def.snippet));
  J::json_object_set(item, "insertTextFormat", J::json_int(2)); // Snippet
  J::json_object_set(item, "detail", J::json_string(def.detail));
  J::json_object_set(item, "filterText", J::json_string(def.filter));
  // Real symbols/keywords should outrank template snippets in the list.
  J::json_object_set(item, "sortText", J::json_string("zzz_snippet"));
  return item;
}

// ── `alias::name` import completions ────────────────────────────────────────
//
// collect_module_completions (below) already lists a resolved dependency's
// *public* symbols under their own bare name — good the moment a symbol
// name itself is being typed. This adds the same symbols again, labeled
// and inserted as `alias::name`, for the (very common, given this
// codebase's own style) case of having just typed the module alias and
// wanting to see what hangs off it.

#returns_ownership
const make_prefixed_completion_item -> fn (alias: *byte, name: *byte, kind: int) *J::JsonValue {
  let b: StrBuf = sb_init();
  sb_str(&b, alias);
  sb_str(&b, "::");
  sb_str(&b, name);
  let label: *byte = sb_finish(&b);

  let item: *J::JsonValue = J::json_object();
  J::json_object_set(item, "label", J::json_string(label));
  J::json_object_set(item, "kind", J::json_int(kind));
  J::json_object_set(item, "insertText", J::json_string(label));
  J::json_object_set(item, "filterText", J::json_string(label));
  free(label);
  return item;
}

const collect_prefixed_import_completions -> fn (arr: *J::JsonValue, mod: *AST::ModuleNode, prog: *AST::ProgramNode) void {
  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind != AST::NodeType::PREPROCESSOR_USE) continue;

    let u: *AST::UseNode = cast<*AST::UseNode>(bn);
    let target: *AST::ModuleNode = resolve_use_alias(mod, prog, u.alias);
    if (target == cast<*AST::ModuleNode>(0)) continue;

    let tn: int = target.body_count;
    loop [j: int = 0](j < tn) : (++j) {
      let tbn: *AST::AstNode = target.body[j];
      if (tbn.kind == AST::NodeType::STMT_FUNCTION) {
        let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(tbn);
        if (fd.is_public == 1) J::json_array_push(arr, make_prefixed_completion_item(u.alias, fd.name, CK_FUNCTION));
      } elif (tbn.kind == AST::NodeType::STMT_STRUCT) {
        let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(tbn);
        if (sd.is_public == 1) J::json_array_push(arr, make_prefixed_completion_item(u.alias, sd.name, CK_STRUCT));
      } elif (tbn.kind == AST::NodeType::STMT_ENUM) {
        let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(tbn);
        if (ed.is_public == 1) J::json_array_push(arr, make_prefixed_completion_item(u.alias, ed.name, CK_ENUM));
      } elif (tbn.kind == AST::NodeType::STMT_VAR_DECL || tbn.kind == AST::NodeType::STMT_CONST_DECL) {
        let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(tbn);
        if (vd.is_public == 1) {
          let kind: int = CK_CONSTANT;
          if (vd.is_mutable == 1) { kind = CK_VARIABLE; }
          J::json_array_push(arr, make_prefixed_completion_item(u.alias, vd.name, kind));
        }
      }
    }
  }
}

const collect_module_completions -> fn (arr: *J::JsonValue, mod: *AST::ModuleNode, public_only: bool) void {
  if (mod == cast<*AST::ModuleNode>(0)) return;

  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];

    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
      if (public_only == false || fd.is_public == 1) {
        J::json_array_push(arr, make_completion_item(fd.name, CK_FUNCTION, cast<*byte>(0)));
      }
    } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      if (public_only == false || sd.is_public == 1) {
        J::json_array_push(arr, make_completion_item(sd.name, CK_STRUCT, cast<*byte>(0)));
      }
    } elif (bn.kind == AST::NodeType::STMT_ENUM) {
      let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
      if (public_only == false || ed.is_public == 1) {
        J::json_array_push(arr, make_completion_item(ed.name, CK_ENUM, cast<*byte>(0)));
        loop [j: int = 0](j < ed.member_count) : (++j) {
          J::json_array_push(arr, make_completion_item(ed.members[j], CK_ENUM_MEMBER, ed.name));
        }
      }
    } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
      let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
      if (public_only == false || vd.is_public == 1) {
        let kind: int = CK_CONSTANT;
        if (vd.is_mutable == 1) { kind = CK_VARIABLE; }
        J::json_array_push(arr, make_completion_item(vd.name, kind, cast<*byte>(0)));
      }
    }
  }
}

// Same shape as search_stmt_for_local_decl, but collects every local
// instead of stopping at the first name match.
const collect_locals_completions -> fn (arr: *J::JsonValue, stmt: *AST::AstNode) void {
  if (stmt == cast<*AST::AstNode>(0)) return;

  if (stmt.kind == AST::NodeType::STMT_VAR_DECL || stmt.kind == AST::NodeType::STMT_CONST_DECL) {
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(stmt);
    let kind: int = CK_CONSTANT;
    if (vd.is_mutable == 1) { kind = CK_VARIABLE; }
    J::json_array_push(arr, make_completion_item(vd.name, kind, cast<*byte>(0)));
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_BLOCK) {
    let blk: *AST::BlockNode = cast<*AST::BlockNode>(stmt);
    loop [i: int = 0](i < blk.stmt_count) : (++i) { collect_locals_completions(arr, blk.statements[i]); }
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_IF) {
    let n: *AST::IfStmtNode = cast<*AST::IfStmtNode>(stmt);
    collect_locals_completions(arr, n.then_stmt);
    loop [i: int = 0](i < n.elif_count) : (++i) { collect_locals_completions(arr, n.elif_stmts[i]); }
    collect_locals_completions(arr, n.else_stmt);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_LOOP) {
    let n: *AST::LoopStmtNode = cast<*AST::LoopStmtNode>(stmt);
    loop [i: int = 0](i < n.init_count) : (++i) { collect_locals_completions(arr, n.initializer[i]); }
    collect_locals_completions(arr, n.body);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_SWITCH) {
    let n: *AST::SwitchNode = cast<*AST::SwitchNode>(stmt);
    loop [i: int = 0](i < n.case_count) : (++i) {
      let c: *AST::CaseNode = cast<*AST::CaseNode>(n.cases[i]);
      collect_locals_completions(arr, c.body);
    }
    if (n.default_case != cast<*AST::AstNode>(0)) {
      let d: *AST::DefaultNode = cast<*AST::DefaultNode>(n.default_case);
      collect_locals_completions(arr, d.body);
    }
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_DEFER) {
    let n: *AST::DeferNode = cast<*AST::DeferNode>(stmt);
    collect_locals_completions(arr, n.statement);
    return;
  }
}

#returns_ownership
pub const lsp_completions -> fn (uri: *byte, line: int, character: int) *J::JsonValue {
  let arr: *J::JsonValue = J::json_array();

  loop [i: int = 0](i < KEYWORD_COUNT) : (++i) {
    J::json_array_push(arr, make_completion_item(KEYWORDS[i], CK_KEYWORD, cast<*byte>(0)));
  }

  loop [i: int = 0](i < SNIPPET_COUNT) : (++i) {
    J::json_array_push(arr, make_snippet_item(SNIPPETS[i]));
  }

  let doc: *LSPDocument = lsp_document_find(uri);
  if (doc == cast<*LSPDocument>(0) || doc.ast == cast<*AST::AstNode>(0)) return arr;

  let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(doc.ast);
  if (prog.module_count <= 0) return arr;

  let own_mod: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[0]);
  collect_module_completions(arr, own_mod, false);

  loop [i: int = 1](i < prog.module_count) : (++i) {
    collect_module_completions(arr, cast<*AST::ModuleNode>(prog.modules[i]), true);
  }

  collect_prefixed_import_completions(arr, own_mod, prog);

  let fd: *AST::FuncDeclNode = find_enclosing_function(own_mod, line + 1);
  if (fd != cast<*AST::FuncDeclNode>(0)) {
    loop [i: int = 0](i < fd.param_count) : (++i) {
      J::json_array_push(arr, make_completion_item(fd.param_names[i], CK_VARIABLE, cast<*byte>(0)));
    }
    collect_locals_completions(arr, fd.body);
  }

  return arr;
}

// ============================================================================
// Semantic Tokens (highlighting)
// ============================================================================
//
// Two passes, merged — same shape as the old C LSP's lsp_semantic_tokens.c:
//
//   1. AST pass (walk_module_decl_for_tokens / walk_stmt_for_tokens /
//      walk_expr_for_tokens / emit_member_token below): precise,
//      scope-aware classification for the identifiers the AST walk
//      actually reaches — parameter / local / self / function / struct /
//      enum / namespace-qualified member / struct field or method access.
//   2. Raw lexical pass (classify_raw_token, in lsp_semantic_tokens
//      itself): walks the module's actual token stream (mod.tokens —
//      already retained from parsing, see ModuleNode) and classifies
//      *everything* by lexical shape alone — keywords, types, strings,
//      numbers, operators, booleans, and identifiers the AST pass didn't
//      already resolve (declaration sites, struct field names, anything
//      the AST walk doesn't reach). This is what gives every token *some*
//      color instead of only the subset the AST walk happens to visit.
//
// The merge (see lsp_semantic_tokens) walks both in position order and
// prefers the AST pass's answer wherever it has one for that exact
// (line, col); the raw pass only fills gaps.

const TT_NAMESPACE:      int = 0;
const TT_TYPE:            int = 1;
const TT_TYPE_PARAMETER:  int = 2;
const TT_FUNCTION:        int = 3;
const TT_METHOD:          int = 4;
const TT_PROPERTY:        int = 5;
const TT_VARIABLE:        int = 6;
const TT_PARAMETER:       int = 7;
const TT_KEYWORD:         int = 8;
const TT_MODIFIER:        int = 9;
const TT_COMMENT:         int = 10;
const TT_STRING:          int = 11;
const TT_NUMBER:          int = 12;
const TT_OPERATOR:        int = 13;
const TT_STRUCT:          int = 14;
const TT_ENUM:            int = 15;
const TT_ENUM_MEMBER:     int = 16;

const MOD_DECLARATION: int = 1;
const MOD_DEFINITION:  int = 2;
const MOD_READONLY:    int = 4;
const MOD_STATIC:      int = 8;
const MOD_DEFAULT_LIB: int = 16;

// The live text buffer being walked for the current lsp_semantic_tokens
// call — needed by find_member_position below to recover a `::`/`.`
// member name's own position (MemberNode doesn't carry one; see its note).
// Set once at the top of lsp_semantic_tokens; safe as a global since
// requests are handled one at a time.
let g_sem_text: *byte = cast<*byte>(0);

// True while walk_field_for_tokens is walking a struct *method*'s body.
// `self` inside a method is never a declared AST parameter — it's added
// straight into the typecheck-time scope (see stmt.lx's typecheck_impl,
// `scope_add_symbol(mscope, "self", ...)`), so it's otherwise invisible to
// this file's param/local lookups and would get no token at all despite
// being one of the most common identifiers in method bodies.
let g_sem_in_method: bool = false;

// True while walking an *uninstantiated generic* body — a generic struct
// template's methods (`struct<K, V> { ... }`, including methods that use the
// inherited params by name without redeclaring them) or a top-level
// `fn<T>` template. Typecheck never runs over those bodies (stmt.lx only
// checks them per concrete instantiation via tc_generics' clone+queue), so
// their AstNode.resolved_type is uninitialized garbage, not null — see the
// note on emit_member_token, which is the one walker that must dereference
// it. resolved_type-based classification is skipped entirely while this
// flag is set; the raw lexical pass still gives those identifiers a color.
// Safe as a global since requests are handled one at a time.
let g_sem_in_template: bool = false;

const SemToken -> struct {
  line:     int,
  col:      int,
  length:   int,
  type_idx: int,
  mods:     int,
};

const push_token -> fn (tokens: *VEC::Vector, line: int, col: int, length: int, type_idx: int, mods: int) void {
  if (length <= 0) return;
  let t: SemToken = SemToken { line: line, col: col, length: length, type_idx: type_idx, mods: mods };
  tokens.push_back(cast<*void>(&t));
}

// Simple insertion sort — semantic tokens must be emitted in position
// order for the delta-encoding below to produce non-negative deltas.
const sort_tokens -> fn (tokens: *VEC::Vector) void {
  let arr: *SemToken = cast<*SemToken>(tokens.data);
  let n: int = tokens.size;
  loop [i: int = 1](i < n) : (++i) {
    let key: SemToken = arr[i];
    let j: int = i - 1;
    loop (j >= 0 && (arr[j].line > key.line || (arr[j].line == key.line && arr[j].col > key.col))) {
      arr[j + 1] = arr[j];
      j = j - 1;
    }
    arr[j + 1] = key;
  }
}

const lookup_public_kind -> fn (mod: *AST::ModuleNode, name: *byte) int {
  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
      if (fd.is_public == 1 && STR::strcmp(fd.name, name) == 0) return TT_FUNCTION;
    } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      if (sd.is_public == 1 && STR::strcmp(sd.name, name) == 0) return TT_STRUCT;
    } elif (bn.kind == AST::NodeType::STMT_ENUM) {
      let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
      if (ed.is_public == 1 && STR::strcmp(ed.name, name) == 0) return TT_ENUM;
    } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
      let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
      if (vd.is_public == 1 && STR::strcmp(vd.name, name) == 0) return TT_VARIABLE;
    }
  }
  return -1;
}

// Converts a declaration-style position (1-indexed line, 0-indexed col —
// the convention every *AstNode here uses) into a byte offset into `text`.
const line_col_to_offset -> fn (text: *byte, one_indexed_line: int, col: int) int {
  let len: int = STR::strlen(text);
  let cur_line: int = 1;
  let i: int = 0;
  loop (i < len && cur_line < one_indexed_line) {
    if (text[i] == '\n') { cur_line = cur_line + 1; }
    i = i + 1;
  }
  let offset: int = i + col;
  if (offset > len) { offset = len; }
  return offset;
}

const MemberPos -> struct {
  found: bool,
  line:  int,
  col:   int,
};

// A MemberNode's own (line, col) is where the `.`/`::` operator token sits,
// not the member name that follows it — there's no field for that (see
// MemberNode's definition). Recover it by scanning forward in the live
// text buffer past the operator and any whitespace, then confirming what's
// there actually reads as `member` — if the buffer has since drifted from
// what was parsed (edit mid-keystroke), this bails out rather than guessing.
const find_member_position -> fn (text: *byte, dot_line: int, dot_col: int, is_compiletime: int, member: *byte) MemberPos {
  let miss: MemberPos = MemberPos { found: false, line: 0, col: 0 };
  let len: int = STR::strlen(text);

  let op_len: int = 1;
  if (is_compiletime == 1) { op_len = 2; }

  let off: int = line_col_to_offset(text, dot_line, dot_col) + op_len;
  let line: int = dot_line;
  let col: int = dot_col + op_len;

  loop (off < len && (text[off] == ' ' || text[off] == '\t' || text[off] == '\r' || text[off] == '\n')) {
    if (text[off] == '\n') { line = line + 1; col = 0; } else { col = col + 1; }
    off = off + 1;
  }

  let mlen: int = STR::strlen(member);
  if (off + mlen > len) return miss;
  loop [k: int = 0](k < mlen) : (++k) {
    if (text[off + k] != member[k]) return miss;
  }

  return MemberPos { found: true, line: line, col: col };
}

// Resolves a `@use "..." as ALIAS` alias declared in `mod` back to the
// matching ModuleNode already resolved into `prog`, or null if `alias`
// isn't actually an import alias (e.g. it's an enum/struct name instead —
// `NodeType::PROGRAM` within the module that declares NodeType itself).
const resolve_use_alias -> fn (mod: *AST::ModuleNode, prog: *AST::ProgramNode, alias: *byte) *AST::ModuleNode {
  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::PREPROCESSOR_USE) {
      let u: *AST::UseNode = cast<*AST::UseNode>(bn);
      if (STR::strcmp(u.alias, alias) == 0) {
        loop [d: int = 0](d < prog.module_count) : (++d) {
          let dm: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[d]);
          if (STR::strcmp(dm.name, u.module_name) == 0) return dm;
        }
        return cast<*AST::ModuleNode>(0);
      }
    }
  }
  return cast<*AST::ModuleNode>(0);
}

// Unwraps pointer/array wrappers to find the underlying named type — e.g.
// both `*Counter` and `[Counter; 4]` resolve to "Counter". Null for
// anything that doesn't bottom out at a named (TYPE_BASIC) type.
const resolve_type_name -> fn (t: *AST::AstNode) *byte {
  if (t == cast<*AST::AstNode>(0)) return cast<*byte>(0);
  if (t.kind == AST::NodeType::TYPE_POINTER) {
    let n: *AST::PointerTypeNode = cast<*AST::PointerTypeNode>(t);
    return resolve_type_name(n.pointee_type);
  }
  if (t.kind == AST::NodeType::TYPE_ARRAY) {
    let n: *AST::ArrayTypeNode = cast<*AST::ArrayTypeNode>(t);
    return resolve_type_name(n.element_type);
  }
  if (t.kind == AST::NodeType::TYPE_BASIC) {
    let n: *AST::BasicTypeNode = cast<*AST::BasicTypeNode>(t);
    return n.name;
  }
  return cast<*byte>(0);
}

// Finds a struct declaration named `name` — first among `mod`'s own
// top-level declarations (any visibility, since it's the doc's own file),
// then among each resolved dependency module's *public* declarations.
// Same precedence hover/go-to-definition use elsewhere in this file.
const find_struct_decl -> fn (mod: *AST::ModuleNode, prog: *AST::ProgramNode, name: *byte) *AST::StructDeclNode {
  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      if (STR::strcmp(sd.name, name) == 0) return sd;
    }
  }
  loop [d: int = 1](d < prog.module_count) : (++d) {
    let dm: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[d]);
    let dn: int = dm.body_count;
    loop [i: int = 0](i < dn) : (++i) {
      let bn: *AST::AstNode = dm.body[i];
      if (bn.kind == AST::NodeType::STMT_STRUCT) {
        let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
        if (sd.is_public == 1 && STR::strcmp(sd.name, name) == 0) return sd;
      }
    }
  }
  return cast<*AST::StructDeclNode>(0);
}

// Looks a member name up among a struct's fields (data or method — see
// walk_field_for_tokens's note on how methods are represented). Checks
// public members before private; there's no encapsulation enforcement
// here, just a search order.
const find_field_in_struct -> fn (sd: *AST::StructDeclNode, name: *byte) *AST::FieldDeclNode {
  loop [i: int = 0](i < sd.public_count) : (++i) {
    let f: *AST::AstNode = sd.public_members[i];
    if (f.kind == AST::NodeType::STMT_FIELD_DECL) {
      let fld: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(f);
      if (STR::strcmp(fld.name, name) == 0) return fld;
    }
  }
  loop [i: int = 0](i < sd.private_count) : (++i) {
    let f: *AST::AstNode = sd.private_members[i];
    if (f.kind == AST::NodeType::STMT_FIELD_DECL) {
      let fld: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(f);
      if (STR::strcmp(fld.name, name) == 0) return fld;
    }
  }
  return cast<*AST::FieldDeclNode>(0);
}

// Classifies and tokenizes the *member* half of a `object::member` or
// `object.member` access — the half nothing previously tokenized at all
// (MemberNode has no position of its own for it; see find_member_position).
// Two mutually exclusive ways to classify `member`, matching tc_member's
// own split in typechecker/expr.lx (see the note on `n.is_compiletime`
// below — this isn't just a style choice, it's load-bearing):
//   1. is_compiletime (`::`) — `object` is a bare identifier resolving to
//      an `@use` alias: a module-qualified call/type like `STR::strlen`,
//      `AST::NodeType`.
//   2. Otherwise (`.`) — `object`'s own typechecked static type (chains
//      work too — `a.b.c` resolves `a.b`'s type same as any other
//      expression) names a known struct, and `member` is one of its
//      fields/methods.
// These can't be tried as a fallback chain: tc_member only ever calls
// typecheck_expression(n.object, ...) — which is what populates
// AstNode.resolved_type — on the `.` (runtime) path. For `::`, `object`
// is inspected directly by kind and never independently typechecked, so
// its resolved_type is left as whatever garbage was already sitting in
// that allocation — not null, garbage — and dereferencing it segfaults.
// Concretely: `AST::NodeType::PROGRAM` has an inner MemberNode
// (`AST::NodeType`) whose resolved_type was never touched. Plain
// enum-member/struct-static access (`object` resolves to a type name, not
// a module or a value) still isn't covered either way — no token type for
// that in the legend, and no scope info to disambiguate it cheaply.
const emit_member_token -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, prog: *AST::ProgramNode, member_node: *AST::AstNode, n: *AST::MemberNode) void {
  if (n.object == cast<*AST::AstNode>(0) || g_sem_text == cast<*byte>(0)) return;

  let kind: int = -1;

  if (n.is_compiletime == 1) {
    if (n.object.kind == AST::NodeType::EXPR_IDENTIFIER) {
      let alias_id: *AST::IdentifierNode = cast<*AST::IdentifierNode>(n.object);
      let target: *AST::ModuleNode = resolve_use_alias(mod, prog, alias_id.name);
      if (target != cast<*AST::ModuleNode>(0)) { kind = lookup_public_kind(target, n.member); }
    }
  } elif (g_sem_in_template == false) {
    let type_name: *byte = resolve_type_name(n.object.resolved_type);
    if (type_name != cast<*byte>(0)) {
      let sd: *AST::StructDeclNode = find_struct_decl(mod, prog, type_name);
      if (sd != cast<*AST::StructDeclNode>(0)) {
        let fld: *AST::FieldDeclNode = find_field_in_struct(sd, n.member);
        if (fld != cast<*AST::FieldDeclNode>(0)) {
          if (fld.function != cast<*AST::AstNode>(0)) { kind = TT_FUNCTION; } else { kind = TT_PROPERTY; }
        }
      }
    }
  }

  if (kind < 0) return;

  let pos: MemberPos = find_member_position(g_sem_text, member_node.line, member_node.col, n.is_compiletime, n.member);
  if (pos.found == false) return;

  push_token(tokens, pos.line, pos.col, STR::strlen(n.member), kind, 0);
}

const emit_ident_token -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, fd: *AST::FuncDeclNode, id: *AST::IdentifierNode, prog: *AST::ProgramNode) void {
  let node: *AST::AstNode = cast<*AST::AstNode>(id);
  let name: *byte = id.name;

  if (fd != cast<*AST::FuncDeclNode>(0)) {
    loop [i: int = 0](i < fd.param_count) : (++i) {
      if (STR::strcmp(fd.param_names[i], name) == 0) {
        push_token(tokens, node.line, node.col, STR::strlen(name), TT_PARAMETER, 0);
        return;
      }
    }
    // `self` is an implicit receiver (see g_sem_in_method's note) — there's
    // no declaration node to match against, so it needs its own check
    // ahead of the local-decl search below (which would never find it).
    if (g_sem_in_method && STR::strcmp(name, "self") == 0) {
      push_token(tokens, node.line, node.col, STR::strlen(name), TT_VARIABLE, MOD_READONLY);
      return;
    }
    let decl: *AST::AstNode = search_stmt_for_local_decl(fd.body, name);
    if (decl != cast<*AST::AstNode>(0)) {
      let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(decl);
      let mods: int = 0;
      if (vd.is_mutable == 0) { mods = MOD_READONLY; }
      push_token(tokens, node.line, node.col, STR::strlen(name), TT_VARIABLE, mods);
      return;
    }
  }

  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::STMT_FUNCTION) {
      let f2: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
      if (STR::strcmp(f2.name, name) == 0) { push_token(tokens, node.line, node.col, STR::strlen(name), TT_FUNCTION, 0); return; }
    } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
      let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
      if (STR::strcmp(sd.name, name) == 0) { push_token(tokens, node.line, node.col, STR::strlen(name), TT_STRUCT, 0); return; }
    } elif (bn.kind == AST::NodeType::STMT_ENUM) {
      let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
      if (STR::strcmp(ed.name, name) == 0) { push_token(tokens, node.line, node.col, STR::strlen(name), TT_ENUM, 0); return; }
    } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
      let vd2: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
      if (STR::strcmp(vd2.name, name) == 0) {
        let mods: int = 0;
        if (vd2.is_mutable == 0) { mods = MOD_READONLY; }
        push_token(tokens, node.line, node.col, STR::strlen(name), TT_VARIABLE, mods);
        return;
      }
    }
  }

  loop [d: int = 1](d < prog.module_count) : (++d) {
    let kind: int = lookup_public_kind(cast<*AST::ModuleNode>(prog.modules[d]), name);
    if (kind >= 0) {
      push_token(tokens, node.line, node.col, STR::strlen(name), kind, 0);
      return;
    }
  }
}

// Type annotations (`let p: Point`, a parameter's `: T`, a field's `: T`,
// a return type, `cast<T>`, `sizeof<T>`) are a completely separate node
// family (TYPE_BASIC/TYPE_POINTER/...) from expressions, so walking
// expressions alone never reaches them. Unlike declaration names, a
// TYPE_BASIC leaf *does* carry the real position of the type name token
// itself (make_basic_type is always given the actual token's line/col),
// so this is pixel-accurate, same as expression identifiers.
const walk_type_for_tokens -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, prog: *AST::ProgramNode, t: *AST::AstNode) void {
  if (t == cast<*AST::AstNode>(0)) return;

  if (t.kind == AST::NodeType::TYPE_POINTER) {
    let n: *AST::PointerTypeNode = cast<*AST::PointerTypeNode>(t);
    walk_type_for_tokens(tokens, mod, prog, n.pointee_type);
    return;
  }
  if (t.kind == AST::NodeType::TYPE_ARRAY) {
    let n: *AST::ArrayTypeNode = cast<*AST::ArrayTypeNode>(t);
    walk_type_for_tokens(tokens, mod, prog, n.element_type);
    return;
  }
  if (t.kind == AST::NodeType::TYPE_FUNCTION) {
    let n: *AST::FuncTypeNode = cast<*AST::FuncTypeNode>(t);
    loop [i: int = 0](i < n.param_count) : (++i) { walk_type_for_tokens(tokens, mod, prog, n.param_types[i]); }
    walk_type_for_tokens(tokens, mod, prog, n.return_type);
    return;
  }
  if (t.kind == AST::NodeType::TYPE_BASIC) {
    let n: *AST::BasicTypeNode = cast<*AST::BasicTypeNode>(t);

    let mn: int = mod.body_count;
    loop [i: int = 0](i < mn) : (++i) {
      let bn: *AST::AstNode = mod.body[i];
      if (bn.kind == AST::NodeType::STMT_STRUCT) {
        let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
        if (STR::strcmp(sd.name, n.name) == 0) { push_token(tokens, t.line, t.col, STR::strlen(n.name), TT_STRUCT, 0); return; }
      } elif (bn.kind == AST::NodeType::STMT_ENUM) {
        let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(bn);
        if (STR::strcmp(ed.name, n.name) == 0) { push_token(tokens, t.line, t.col, STR::strlen(n.name), TT_ENUM, 0); return; }
      }
    }

    loop [d: int = 1](d < prog.module_count) : (++d) {
      let kind: int = lookup_public_kind(cast<*AST::ModuleNode>(prog.modules[d]), n.name);
      if (kind == TT_STRUCT || kind == TT_ENUM) { push_token(tokens, t.line, t.col, STR::strlen(n.name), kind, 0); return; }
    }
    return;
  }
  // TYPE_RESOLUTION doesn't appear here: by the time typecheck has run,
  // doc.ast's types are already normalized to bare TYPE_BASIC (see
  // tc_type.lx's resolve_type_ref) — nothing further to resolve.
}

const walk_expr_for_tokens -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, fd: *AST::FuncDeclNode, prog: *AST::ProgramNode, expr: *AST::AstNode) void {
  if (expr == cast<*AST::AstNode>(0)) return;

  if (expr.kind == AST::NodeType::EXPR_IDENTIFIER) {
    emit_ident_token(tokens, mod, fd, cast<*AST::IdentifierNode>(expr), prog);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_BINARY || expr.kind == AST::NodeType::EXPR_RANGE) {
    let n: *AST::BinaryNode = cast<*AST::BinaryNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.left);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.right);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_UNARY  || expr.kind == AST::NodeType::EXPR_DEREF ||
      expr.kind == AST::NodeType::EXPR_ADDR   || expr.kind == AST::NodeType::EXPR_GROUPING ||
      expr.kind == AST::NodeType::EXPR_SYSTEM) {
    let n: *AST::UnaryNode = cast<*AST::UnaryNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.operand);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_CALL) {
    let n: *AST::CallNode = cast<*AST::CallNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.callee);
    loop [i: int = 0](i < n.arg_count) : (++i) { walk_expr_for_tokens(tokens, mod, fd, prog, n.args[i]); }
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_ASSIGNMENT) {
    let n: *AST::AssignNode = cast<*AST::AssignNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.target);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.value);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_TERNARY) {
    let n: *AST::TernaryNode = cast<*AST::TernaryNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.condition);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.then_expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.else_expr);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_MEMBER) {
    let n: *AST::MemberNode = cast<*AST::MemberNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.object);
    emit_member_token(tokens, mod, prog, expr, n);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_INDEX) {
    let n: *AST::IndexNode = cast<*AST::IndexNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.object);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.index);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_ARRAY) {
    let n: *AST::ArrayNode = cast<*AST::ArrayNode>(expr);
    loop [i: int = 0](i < n.element_count) : (++i) { walk_expr_for_tokens(tokens, mod, fd, prog, n.elements[i]); }
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_CAST || expr.kind == AST::NodeType::EXPR_INPUT) {
    let n: *AST::CastNode = cast<*AST::CastNode>(expr);
    walk_type_for_tokens(tokens, mod, prog, n.type_node);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.castee);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_ALLOC) {
    let n: *AST::AllocNode = cast<*AST::AllocNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.size);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_FREE) {
    let n: *AST::FreeNode = cast<*AST::FreeNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.ptr);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_MEMCPY) {
    let n: *AST::MemcpyNode = cast<*AST::MemcpyNode>(expr);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.to);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.from);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.size);
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_SIZEOF) {
    let n: *AST::SizeofNode = cast<*AST::SizeofNode>(expr);
    if (n.is_type == 1) {
      walk_type_for_tokens(tokens, mod, prog, n.object);
    } else {
      walk_expr_for_tokens(tokens, mod, fd, prog, n.object);
    }
    return;
  }
  if (expr.kind == AST::NodeType::EXPR_STRUCT) {
    let n: *AST::StructExprNode = cast<*AST::StructExprNode>(expr);
    loop [i: int = 0](i < n.field_count) : (++i) { walk_expr_for_tokens(tokens, mod, fd, prog, n.field_vals[i]); }
    return;
  }
  // EXPR_LITERAL, EXPR_SYSCALL: leaves, nothing further to classify.
}

// A struct field is either plain data (just a type to walk) or a method —
// `name -> fn (...) T { ... }` declared inline in the struct body, stored
// as the same FieldDeclNode with `function` set (see format_struct_signature's
// note). Methods have their own params/return type/body just like a
// top-level function, so they need the same treatment lsp_semantic_tokens
// already gives STMT_FUNCTION — otherwise every local/parameter reference
// inside a method silently gets no token at all.
const walk_field_for_tokens -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, prog: *AST::ProgramNode, fld: *AST::AstNode) void {
  if (fld == cast<*AST::AstNode>(0) || fld.kind != AST::NodeType::STMT_FIELD_DECL) return;
  let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(fld);

  if (f.function != cast<*AST::AstNode>(0)) {
    let mfd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(f.function);
    loop [p: int = 0](p < mfd.param_count) : (++p) {
      walk_type_for_tokens(tokens, mod, prog, mfd.param_types[p]);
    }
    walk_type_for_tokens(tokens, mod, prog, mfd.return_type);
    g_sem_in_method = true;
    walk_stmt_for_tokens(tokens, mod, mfd, prog, mfd.body);
    g_sem_in_method = false;
    return;
  }

  walk_type_for_tokens(tokens, mod, prog, f.type_node);
}

// Mirrors typecheck's own arm selection for `@os {}` (resolve_os_body in
// typechecker/stmt.lx) exactly — matching platform arm, else the `_ ->`
// default, else nothing. This has to match, not just "walk every arm":
// only the arm typecheck actually picked for CURRENT_OS had
// typecheck_expression run over it, which is what populates
// AstNode.resolved_type. Any other arm's nodes carry whatever garbage was
// already in that allocation — not null, garbage — and emit_member_token's
// type-based lookup segfaults the moment it dereferences one. Walking only
// the selected arm keeps everything this file ever inspects trustworthy.
const resolve_os_body_for_tokens -> fn (n: *AST::OsNode) *AST::AstNode {
  loop [i: int = 0](n.platforms[i] != cast<*byte>(0)) : (++i) {
    if (STR::strcmp(n.platforms[i], CURRENT_OS) == 0) return n.bodies[i];
  }
  if (n.has_default == 1) return n.default_body;
  return cast<*AST::AstNode>(0);
}

const walk_stmt_for_tokens -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, fd: *AST::FuncDeclNode, prog: *AST::ProgramNode, stmt: *AST::AstNode) void {
  if (stmt == cast<*AST::AstNode>(0)) return;

  if (stmt.kind == AST::NodeType::STMT_VAR_DECL || stmt.kind == AST::NodeType::STMT_CONST_DECL) {
    // No token for the declaration site itself: stmt.line/col anchors at
    // the `let`/`const` keyword, not the name, so it would highlight the
    // wrong span (e.g. "let re" instead of "result"). Usages still get
    // pixel-accurate tokens via their own EXPR_IDENTIFIER position.
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(stmt);
    walk_type_for_tokens(tokens, mod, prog, vd.var_type);
    walk_expr_for_tokens(tokens, mod, fd, prog, vd.initializer);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_EXPRESSION) {
    let n: *AST::ExprStmtNode = cast<*AST::ExprStmtNode>(stmt);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.expression);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_RETURN) {
    let n: *AST::ReturnStmtNode = cast<*AST::ReturnStmtNode>(stmt);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.value);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_BLOCK) {
    let blk: *AST::BlockNode = cast<*AST::BlockNode>(stmt);
    loop [i: int = 0](i < blk.stmt_count) : (++i) { walk_stmt_for_tokens(tokens, mod, fd, prog, blk.statements[i]); }
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_IF) {
    let n: *AST::IfStmtNode = cast<*AST::IfStmtNode>(stmt);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.condition);
    walk_stmt_for_tokens(tokens, mod, fd, prog, n.then_stmt);
    loop [i: int = 0](i < n.elif_count) : (++i) { walk_stmt_for_tokens(tokens, mod, fd, prog, n.elif_stmts[i]); }
    walk_stmt_for_tokens(tokens, mod, fd, prog, n.else_stmt);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_LOOP) {
    let n: *AST::LoopStmtNode = cast<*AST::LoopStmtNode>(stmt);
    loop [i: int = 0](i < n.init_count) : (++i) { walk_stmt_for_tokens(tokens, mod, fd, prog, n.initializer[i]); }
    walk_expr_for_tokens(tokens, mod, fd, prog, n.condition);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.optional);
    walk_stmt_for_tokens(tokens, mod, fd, prog, n.body);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_SWITCH) {
    let n: *AST::SwitchNode = cast<*AST::SwitchNode>(stmt);
    walk_expr_for_tokens(tokens, mod, fd, prog, n.condition);
    loop [i: int = 0](i < n.case_count) : (++i) {
      let c: *AST::CaseNode = cast<*AST::CaseNode>(n.cases[i]);
      loop [j: int = 0](j < c.value_count) : (++j) { walk_expr_for_tokens(tokens, mod, fd, prog, c.values[j]); }
      walk_stmt_for_tokens(tokens, mod, fd, prog, c.body);
    }
    if (n.default_case != cast<*AST::AstNode>(0)) {
      let d: *AST::DefaultNode = cast<*AST::DefaultNode>(n.default_case);
      walk_stmt_for_tokens(tokens, mod, fd, prog, d.body);
    }
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_DEFER) {
    let n: *AST::DeferNode = cast<*AST::DeferNode>(stmt);
    walk_stmt_for_tokens(tokens, mod, fd, prog, n.statement);
    return;
  }
  if (stmt.kind == AST::NodeType::STMT_PRINT) {
    // `output`/`outputln` — easy to miss since it's not a plain
    // STMT_EXPRESSION wrapping a call, it's its own statement kind.
    let n: *AST::PrintStmtNode = cast<*AST::PrintStmtNode>(stmt);
    loop [i: int = 0](i < n.expr_count) : (++i) { walk_expr_for_tokens(tokens, mod, fd, prog, n.expressions[i]); }
    return;
  }
  if (stmt.kind == AST::NodeType::PREPROCESSOR_OS) {
    // `@os {}` is also legal *inside* a function body (std/io.lx's syscall
    // wrappers) — here the selected arm's block holds ordinary statements,
    // unlike the module-scope case (see walk_module_decl_for_tokens), so
    // this just recurses through the normal statement walker. Only the
    // arm typecheck actually picked, though — see resolve_os_body_for_
    // tokens's note.
    let n: *AST::OsNode = cast<*AST::OsNode>(stmt);
    walk_stmt_for_tokens(tokens, mod, fd, prog, resolve_os_body_for_tokens(n));
    return;
  }
}

// Handles one top-level-shaped declaration for lsp_semantic_tokens — pulled
// out of the main loop below so PREPROCESSOR_OS can recurse into it. `@os {
// "linux" -> { ... } }` is legal directly at module scope (see e.g. this
// file's own STD_DIR just above), and every arm's body is a parsed
// STMT_BLOCK holding ordinary top-level declarations, not statements — so
// it needs this module-decl dispatch, not walk_stmt_for_tokens (which is
// for *inside* a function body, where `@os {}` is also legal but holds
// regular statements instead; see its own PREPROCESSOR_OS case).
const walk_module_decl_for_tokens -> fn (tokens: *VEC::Vector, mod: *AST::ModuleNode, prog: *AST::ProgramNode, bn: *AST::AstNode) void {
  if (bn == cast<*AST::AstNode>(0)) return;

  if (bn.kind == AST::NodeType::STMT_FUNCTION) {
    let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(bn);
    loop [p: int = 0](p < fd.param_count) : (++p) {
      walk_type_for_tokens(tokens, mod, prog, fd.param_types[p]);
    }
    walk_type_for_tokens(tokens, mod, prog, fd.return_type);
    let saved: bool = g_sem_in_template;
    if (fd.type_param_count > 0) { g_sem_in_template = true; }
    walk_stmt_for_tokens(tokens, mod, fd, prog, fd.body);
    g_sem_in_template = saved;
  } elif (bn.kind == AST::NodeType::STMT_STRUCT) {
    let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(bn);
    let saved: bool = g_sem_in_template;
    if (sd.type_param_count > 0) { g_sem_in_template = true; }
    loop [f: int = 0](f < sd.public_count) : (++f) {
      walk_field_for_tokens(tokens, mod, prog, sd.public_members[f]);
    }
    loop [f: int = 0](f < sd.private_count) : (++f) {
      walk_field_for_tokens(tokens, mod, prog, sd.private_members[f]);
    }
    g_sem_in_template = saved;
  } elif (bn.kind == AST::NodeType::STMT_VAR_DECL || bn.kind == AST::NodeType::STMT_CONST_DECL) {
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(bn);
    walk_type_for_tokens(tokens, mod, prog, vd.var_type);
    walk_expr_for_tokens(tokens, mod, cast<*AST::FuncDeclNode>(0), prog, vd.initializer);
  } elif (bn.kind == AST::NodeType::PREPROCESSOR_OS) {
    // Only the arm typecheck actually selected for CURRENT_OS — see
    // resolve_os_body_for_tokens's note — and recurse its statements back
    // through this same dispatch, since at module scope they're
    // declarations, not statements.
    let n: *AST::OsNode = cast<*AST::OsNode>(bn);
    let body: *AST::AstNode = resolve_os_body_for_tokens(n);
    if (body != cast<*AST::AstNode>(0) && body.kind == AST::NodeType::STMT_BLOCK) {
      let blk: *AST::BlockNode = cast<*AST::BlockNode>(body);
      loop [j: int = 0](j < blk.stmt_count) : (++j) {
        walk_module_decl_for_tokens(tokens, mod, prog, blk.statements[j]);
      }
    }
  }
}

// ── Raw lexical pass ─────────────────────────────────────────────────────────
//
// See the "Semantic Tokens" header above: this classifies a token purely by
// its lexer kind (plus a little surrounding context for identifiers), no
// AST needed — the fallback layer that gives every token *some* color.

const TokenClass -> struct { type_idx: int, mods: int };

// Token.val points into the source buffer and isn't null-terminated (its
// length is the separate `len` field) — a *byte string constant is, so an
// equality check needs both the length and the bytes to match.
const token_text_equals -> fn (tok: TOK::Token, s: *byte) bool {
  if (STR::strlen(s) != tok.len) return false;
  return STR::strncmp(tok.val, s, tok.len) == 0;
}

const is_use_alias -> fn (mod: *AST::ModuleNode, tok: TOK::Token) bool {
  let n: int = mod.body_count;
  loop [i: int = 0](i < n) : (++i) {
    let bn: *AST::AstNode = mod.body[i];
    if (bn.kind == AST::NodeType::PREPROCESSOR_USE) {
      let u: *AST::UseNode = cast<*AST::UseNode>(bn);
      if (token_text_equals(tok, u.alias)) return true;
    }
  }
  return false;
}

// Classifies a TOK_IDENTIFIER the AST pass didn't already resolve. Tried in
// order: `@use` alias (namespace) — ` -> fn/struct/enum` immediately after
// it (Luma's decl arrow puts the name *before* the keyword, unlike most
// languages: `name -> fn (...)`/`name -> struct {...}` — this has to come
// before the plain `let`/`const` check below, since `pub const Name ->
// struct` would otherwise match that first and misclassify every
// top-level fn/struct/enum name as a plain readonly variable) — `let`/
// `const` immediately before it (a declaration site: locals never get an
// AST token for their own name, see walk_stmt_for_tokens's note, and
// neither do top-level decl names) — then the same blunt heuristic the
// old C LSP used as its final fallback: capitalized → type, followed by
// `(` → function, followed by `::` → namespace, else → variable.
const classify_raw_identifier -> fn (mod: *AST::ModuleNode, toks: *TOK::Token, count: int, idx: int) TokenClass {
  let tok: TOK::Token = toks[idx];

  if (is_use_alias(mod, tok)) return TokenClass { type_idx: TT_NAMESPACE, mods: 0 };

  if (idx + 2 < count && toks[idx + 1].kind == TOK::LumaTokenType::TOK_RIGHT_ARROW) {
    let after: TOK::Token = toks[idx + 2];
    if (after.kind == TOK::LumaTokenType::TOK_FN) {
      return TokenClass { type_idx: TT_FUNCTION, mods: MOD_DECLARATION };
    }
    if (after.kind == TOK::LumaTokenType::TOK_STRUCT) {
      return TokenClass { type_idx: TT_STRUCT, mods: MOD_DECLARATION + MOD_DEFINITION };
    }
    if (after.kind == TOK::LumaTokenType::TOK_ENUM) {
      return TokenClass { type_idx: TT_ENUM, mods: MOD_DECLARATION + MOD_DEFINITION };
    }
  }

  if (idx > 0) {
    let prev: TOK::Token = toks[idx - 1];
    if (prev.kind == TOK::LumaTokenType::TOK_VAR) {
      return TokenClass { type_idx: TT_VARIABLE, mods: MOD_DECLARATION };
    }
    if (prev.kind == TOK::LumaTokenType::TOK_CONST) {
      let m: int = MOD_DECLARATION;
      return TokenClass { type_idx: TT_VARIABLE, mods: m + MOD_READONLY };
    }
  }

  if (tok.val[0] >= 'A' && tok.val[0] <= 'Z') return TokenClass { type_idx: TT_TYPE, mods: 0 };

  if (idx + 1 < count) {
    let nxt: TOK::Token = toks[idx + 1];
    if (nxt.kind == TOK::LumaTokenType::TOK_LPAREN) return TokenClass { type_idx: TT_FUNCTION, mods: 0 };
    if (nxt.kind == TOK::LumaTokenType::TOK_RESOLVE) return TokenClass { type_idx: TT_NAMESPACE, mods: 0 };
  }

  return TokenClass { type_idx: TT_VARIABLE, mods: 0 };
}

// Mirrors the old C LSP's classify_token switch, adapted to this lexer's
// actual token kinds (see lexer_tokens.lx) — including that its lexer
// strips comments/whitespace before they ever become tokens (see
// lexer.lx's skip_whitespace/next_token), so TOK_COMMENT et al. are dead
// cases here, kept only so the legend and this switch stay obviously
// paired. `output`/`outputln` have no dedicated token kind in this lexer
// (they're plain TOK_IDENTIFIER, recognized by name only where they're
// actually called — see typechecker/expr.lx's tc_call) — the identifier
// fallback's "followed by `(`" rule classifies them as functions anyway.
const classify_raw_token -> fn (mod: *AST::ModuleNode, toks: *TOK::Token, count: int, idx: int) TokenClass {
  let none: TokenClass = TokenClass { type_idx: -1, mods: 0 };
  let tok: TOK::Token = toks[idx];
  let k: int = tok.kind;

  if (k == TOK::LumaTokenType::TOK_EOF || k == TOK::LumaTokenType::TOK_ERROR ||
      k == TOK::LumaTokenType::TOK_WHITESPACE || k == TOK::LumaTokenType::TOK_LPAREN ||
      k == TOK::LumaTokenType::TOK_RPAREN || k == TOK::LumaTokenType::TOK_LBRACE ||
      k == TOK::LumaTokenType::TOK_RBRACE || k == TOK::LumaTokenType::TOK_LBRACKET ||
      k == TOK::LumaTokenType::TOK_RBRACKET || k == TOK::LumaTokenType::TOK_SEMI ||
      k == TOK::LumaTokenType::TOK_COMMA || k == TOK::LumaTokenType::TOK_AT ||
      k == TOK::LumaTokenType::TOK_COLON || k == TOK::LumaTokenType::TOK_QUESTION ||
      k == TOK::LumaTokenType::TOK_BANG || k == TOK::LumaTokenType::TOK_SYMBOL) {
    return none;
  }

  if (k == TOK::LumaTokenType::TOK_COMMENT || k == TOK::LumaTokenType::TOK_DOC_COMMENT ||
      k == TOK::LumaTokenType::TOK_MODULE_DOC || k == TOK::LumaTokenType::TOK_DOCUMENT) {
    return TokenClass { type_idx: TT_COMMENT, mods: 0 };
  }

  if (k == TOK::LumaTokenType::TOK_STRING || k == TOK::LumaTokenType::TOK_CHAR_LITERAL) {
    return TokenClass { type_idx: TT_STRING, mods: 0 };
  }

  if (k == TOK::LumaTokenType::TOK_NUMBER || k == TOK::LumaTokenType::TOK_NUM_FLOAT) {
    return TokenClass { type_idx: TT_NUMBER, mods: 0 };
  }

  if (k == TOK::LumaTokenType::TOK_INT || k == TOK::LumaTokenType::TOK_DOUBLE ||
      k == TOK::LumaTokenType::TOK_UINT || k == TOK::LumaTokenType::TOK_FLOAT ||
      k == TOK::LumaTokenType::TOK_BOOL || k == TOK::LumaTokenType::TOK_VOID ||
      k == TOK::LumaTokenType::TOK_CHAR) {
    return TokenClass { type_idx: TT_TYPE, mods: MOD_DEFAULT_LIB };
  }

  if (k == TOK::LumaTokenType::TOK_IF || k == TOK::LumaTokenType::TOK_ELIF ||
      k == TOK::LumaTokenType::TOK_ELSE || k == TOK::LumaTokenType::TOK_LOOP ||
      k == TOK::LumaTokenType::TOK_RETURN || k == TOK::LumaTokenType::TOK_BREAK ||
      k == TOK::LumaTokenType::TOK_CONTINUE || k == TOK::LumaTokenType::TOK_SWITCH ||
      k == TOK::LumaTokenType::TOK_DEFER || k == TOK::LumaTokenType::TOK_IN) {
    return TokenClass { type_idx: TT_KEYWORD, mods: 0 };
  }

  if (k == TOK::LumaTokenType::TOK_VAR || k == TOK::LumaTokenType::TOK_CONST ||
      k == TOK::LumaTokenType::TOK_PUBLIC || k == TOK::LumaTokenType::TOK_PRIVATE ||
      k == TOK::LumaTokenType::TOK_IMPL) {
    return TokenClass { type_idx: TT_KEYWORD, mods: MOD_STATIC };
  }

  if (k == TOK::LumaTokenType::TOK_FN || k == TOK::LumaTokenType::TOK_STRUCT ||
      k == TOK::LumaTokenType::TOK_ENUM) {
    return TokenClass { type_idx: TT_KEYWORD, mods: 0 };
  }

  if (k == TOK::LumaTokenType::TOK_MODULE || k == TOK::LumaTokenType::TOK_USE ||
      k == TOK::LumaTokenType::TOK_OS || k == TOK::LumaTokenType::TOK_LINK ||
      k == TOK::LumaTokenType::TOK_IMPORT || k == TOK::LumaTokenType::TOK_AS ||
      k == TOK::LumaTokenType::TOK_MOD) {
    return TokenClass { type_idx: TT_KEYWORD, mods: MOD_STATIC };
  }

  if (k == TOK::LumaTokenType::TOK_ALLOC || k == TOK::LumaTokenType::TOK_FREE ||
      k == TOK::LumaTokenType::TOK_SYSTEM || k == TOK::LumaTokenType::TOK_SYSCALL ||
      k == TOK::LumaTokenType::TOK_CAST || k == TOK::LumaTokenType::TOK_SIZE_OF ||
      k == TOK::LumaTokenType::TOK_INPUT) {
    return TokenClass { type_idx: TT_FUNCTION, mods: MOD_DEFAULT_LIB };
  }

  if (k == TOK::LumaTokenType::TOK_TRUE || k == TOK::LumaTokenType::TOK_FALSE) {
    let m: int = MOD_READONLY;
    return TokenClass { type_idx: TT_ENUM_MEMBER, mods: m + MOD_DEFAULT_LIB };
  }

  if (k == TOK::LumaTokenType::TOK_RETURNS_OWNERSHIP || k == TOK::LumaTokenType::TOK_TAKES_OWNERSHIP ||
      k == TOK::LumaTokenType::TOK_DLL_IMPORT || k == TOK::LumaTokenType::TOK_LIB_IMPORT) {
    return TokenClass { type_idx: TT_MODIFIER, mods: MOD_DEFAULT_LIB };
  }

  if (k == TOK::LumaTokenType::TOK_EQUAL || k == TOK::LumaTokenType::TOK_PLUS ||
      k == TOK::LumaTokenType::TOK_MINUS || k == TOK::LumaTokenType::TOK_STAR ||
      k == TOK::LumaTokenType::TOK_SLASH || k == TOK::LumaTokenType::TOK_MODL ||
      k == TOK::LumaTokenType::TOK_LT || k == TOK::LumaTokenType::TOK_GT ||
      k == TOK::LumaTokenType::TOK_LE || k == TOK::LumaTokenType::TOK_GE ||
      k == TOK::LumaTokenType::TOK_EQEQ || k == TOK::LumaTokenType::TOK_NEQ ||
      k == TOK::LumaTokenType::TOK_AMP || k == TOK::LumaTokenType::TOK_PIPE ||
      k == TOK::LumaTokenType::TOK_CARET || k == TOK::LumaTokenType::TOK_TILDE ||
      k == TOK::LumaTokenType::TOK_AND || k == TOK::LumaTokenType::TOK_OR ||
      k == TOK::LumaTokenType::TOK_PLUSPLUS || k == TOK::LumaTokenType::TOK_MINUSMINUS ||
      k == TOK::LumaTokenType::TOK_SHIFT_LEFT || k == TOK::LumaTokenType::TOK_SHIFT_RIGHT ||
      k == TOK::LumaTokenType::TOK_RANGE || k == TOK::LumaTokenType::TOK_ELLIPSIS ||
      k == TOK::LumaTokenType::TOK_RIGHT_ARROW || k == TOK::LumaTokenType::TOK_LEFT_ARROW ||
      k == TOK::LumaTokenType::TOK_DOT || k == TOK::LumaTokenType::TOK_RESOLVE) {
    return TokenClass { type_idx: TT_OPERATOR, mods: 0 };
  }

  if (k == TOK::LumaTokenType::TOK_KEYWORD) { return TokenClass { type_idx: TT_KEYWORD, mods: 0 }; }

  if (k == TOK::LumaTokenType::TOK_IDENTIFIER) { return classify_raw_identifier(mod, toks, count, idx); }

  return none;
}

#returns_ownership
pub const lsp_semantic_tokens -> fn (uri: *byte) *J::JsonValue {
  let result: *J::JsonValue = J::json_object();
  let data: *J::JsonValue = J::json_array();

  let doc: *LSPDocument = lsp_document_find(uri);
  if (doc != cast<*LSPDocument>(0) && doc.ast != cast<*AST::AstNode>(0)) {
    let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(doc.ast);
    if (prog.module_count > 0) {
      let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(prog.modules[0]);
      let tokens: VEC::Vector = VEC::create_vector(sizeof<SemToken>);
      g_sem_text = doc.text;

      let n: int = mod.body_count;
      loop [i: int = 0](i < n) : (++i) {
        walk_module_decl_for_tokens(&tokens, mod, prog, mod.body[i]);
      }

      sort_tokens(&tokens);

      // Merge the precise AST-pass tokens with the raw lexical pass over
      // the module's actual token stream (mod.tokens — retained from
      // parsing, see ModuleNode) — see this section's header comment.
      // Both sequences are already in position order (the AST list by the
      // sort just above; the raw stream inherently, since the lexer emits
      // it left-to-right), so a single two-pointer walk merges them: at
      // each raw token's position, prefer the AST pass's classification if
      // it has one there, otherwise classify the raw token lexically.
      let final_tokens: VEC::Vector = VEC::create_vector(sizeof<SemToken>);
      let ast_arr: *SemToken = cast<*SemToken>(tokens.data);
      let ast_count: int = tokens.size;
      let ai: int = 0;

      let raw_toks: *TOK::Token = mod.tokens;
      let raw_count: int = mod.token_count;

      loop [ti: int = 0](ti < raw_count) : (++ti) {
        let tok: TOK::Token = raw_toks[ti];

        loop (ai < ast_count && (ast_arr[ai].line < tok.line ||
              (ast_arr[ai].line == tok.line && ast_arr[ai].col < tok.col))) {
          ai = ai + 1;
        }

        if (ai < ast_count && ast_arr[ai].line == tok.line && ast_arr[ai].col == tok.col) {
          push_token(&final_tokens, ast_arr[ai].line, ast_arr[ai].col, ast_arr[ai].length, ast_arr[ai].type_idx, ast_arr[ai].mods);
          ai = ai + 1;
        } else {
          let cls: TokenClass = classify_raw_token(mod, raw_toks, raw_count, ti);
          if (cls.type_idx >= 0) {
            // TOK_STRING's `len`/`val` exclude the surrounding quotes (see
            // lexer.lx) — extend the span to cover them so the whole
            // literal highlights, not just its inner text.
            let length: int = tok.len;
            if (tok.kind == TOK::LumaTokenType::TOK_STRING) { length = tok.len + 2; }
            push_token(&final_tokens, tok.line, tok.col, length, cls.type_idx, cls.mods);
          }
        }
      }

      VEC::free_vector(&tokens);

      let arr: *SemToken = cast<*SemToken>(final_tokens.data);
      let count: int = final_tokens.size;
      let prev_line: int = 0;
      let prev_col: int = 0;
      loop [i: int = 0](i < count) : (++i) {
        let t: SemToken = arr[i];
        // line is 1-indexed; col is already 0-indexed (see diagnostics_array's note).
        let line0: int = 0;
        if (t.line > 0) { line0 = t.line - 1; }
        let col0: int = t.col;
        if (col0 < 0) { col0 = 0; }

        let delta_line: int = line0 - prev_line;
        let delta_col: int = col0;
        if (delta_line == 0) { delta_col = col0 - prev_col; }

        J::json_array_push(data, J::json_int(delta_line));
        J::json_array_push(data, J::json_int(delta_col));
        J::json_array_push(data, J::json_int(t.length));
        J::json_array_push(data, J::json_int(t.type_idx));
        J::json_array_push(data, J::json_int(t.mods));

        prev_line = line0;
        prev_col = col0;
      }

      VEC::free_vector(&final_tokens);
      g_sem_text = cast<*byte>(0);
    }
  }

  J::json_object_set(result, "data", data);
  return result;
}
