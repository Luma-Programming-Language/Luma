//! JSON-RPC-over-stdio transport for the Luma language server.
//!
//! Frames messages the way LSP requires: `Content-Length: N\r\n\r\n` followed
//! by exactly N bytes of UTF-8 JSON. Reading and writing go through raw
//! std_io::local_read/local_write calls rather than buffered stdio, since
//! the message loop needs to read exactly N bytes and nothing more. POSIX
//! uses descriptors; Windows uses standard handles.

@module "lsp_transport"

@use "std_io"      as IO
@use "std_memory"  as MEM
@use "std_cstring" as STR
@use "json"        as J

const stdin_handle -> fn () i64 {
  @os {
    "linux"     -> { return 0; }
    "macos"     -> { return 0; }
    "windows64" -> { return IO::GetStdHandle(IO::STD_INPUT_HANDLE); }
  }
}

const stdout_handle -> fn () i64 {
  @os {
    "linux"     -> { return 1; }
    "macos"     -> { return 1; }
    "windows64" -> { return IO::GetStdHandle(IO::STD_OUTPUT_HANDLE); }
  }
}

/// Reads a single raw byte from standard input.
///
/// # Returns
/// -1 on EOF or read error.
const read_byte -> fn () i64 {
  let c: byte;
  let n: i64 = IO::local_read(stdin_handle(), cast<*void>(&c), 1);
  if (n <= 0) return -1;
  return cast<i64>(c);
}

/// Reads one full Content-Length-framed JSON-RPC message from stdin.
///
/// # Returns
/// A heap-allocated, NUL-terminated JSON body, or null on EOF or a bad header.
// Reads one full JSON-RPC message from stdin. Returns a heap-owned,
// NUL-terminated JSON body, or null on EOF / a malformed header.
#returns_ownership
pub const read_message -> fn () *byte {
  let content_length: i64 = -1;

  loop (1) {
    let cap: i64 = 256;
    let line: *byte = cast<*byte>(alloc(cap));
    let len: i64 = 0;

    loop (1) {
      let c: i64 = read_byte();
      if (c < 0) { free(line); return cast<*byte>(0); }
      if (c == cast<i64>('\n')) break;
      if (len + 1 >= cap) {
        let old_cap: i64 = cap;
        cap = cap * 2;
        line = cast<*byte>(MEM::realloc(cast<*void>(line), old_cap, cap));
      }
      line[len] = cast<byte>(c);
      len = len + 1;
    }

    if (len > 0 && line[len - 1] == '\r') { len = len - 1; }
    line[len] = cast<byte>(0);

    if (len == 0) { free(line); break; } // blank line — end of headers

    let prefix: *byte = "Content-Length:";
    let plen: i64 = STR::strlen(prefix);
    if (len >= plen) {
      let matches: bool = true;
      loop [i: i64 = 0](i < plen) : (++i) {
        if (line[i] != prefix[i]) { matches = false; break; }
      }
      if (matches) {
        let j: i64 = plen;
        loop (j < len && line[j] == ' ') { j = j + 1; }
        let val: i64 = 0;
        loop (j < len && line[j] >= '0' && line[j] <= '9') {
          val = val * 10 + (cast<i64>(line[j]) - cast<i64>('0'));
          j = j + 1;
        }
        content_length = val;
      }
    }

    free(line);
  }

  if (content_length <= 0) return cast<*byte>(0);

  let body: *byte = cast<*byte>(alloc(content_length + 1));
  let got: i64 = 0;
  loop (got < content_length) {
    let n: i64 = IO::local_read(
      stdin_handle(),
      cast<*void>(cast<i64>(body) + got),
      content_length - got
    );
    if (n <= 0) { free(body); return cast<*byte>(0); }
    got = got + n;
  }
  body[content_length] = cast<byte>(0);
  return body;
}

/// Writes a Content-Length-framed message to stdout.
// Writes one Content-Length-framed message to stdout.
pub const send_raw -> fn (body: *byte) void {
  if (body == cast<*byte>(0)) return;

  let len: i64 = STR::strlen(body);
  let len_str: *byte = STR::from_int(len);

  let prefix: *byte = "Content-Length: ";
  let suffix: *byte = "\r\n\r\n";
  let total: i64 = STR::strlen(prefix) + STR::strlen(len_str) + STR::strlen(suffix);

  let header: *byte = cast<*byte>(alloc(total + 1));
  STR::cat(header, prefix, len_str);
  STR::cat(header, header, suffix);

  IO::local_write(stdout_handle(), cast<*void>(header), STR::strlen(header));
  IO::local_write(stdout_handle(), cast<*void>(body), len);

  free(header);
  free(len_str);
}

/// Sends a JSON-RPC response carrying `result` for the request `id`.
pub const send_response -> fn (id: i64, result: *J::JsonValue) void {
  let msg: *J::JsonValue = J::json_object();
  J::json_object_set(msg, "jsonrpc", J::json_string("2.0"));
  J::json_object_set(msg, "id", J::json_int(id));
  J::json_object_set(msg, "result", result);

  let s: *byte = J::json_stringify(msg);
  send_raw(s);
  free(s);
  J::json_free(msg);
}

/// Sends a JSON-RPC notification with the given `method` and `params`.
pub const send_notification -> fn (method: *byte, params: *J::JsonValue) void {
  let msg: *J::JsonValue = J::json_object();
  J::json_object_set(msg, "jsonrpc", J::json_string("2.0"));
  J::json_object_set(msg, "method", J::json_string(method));
  J::json_object_set(msg, "params", params);

  let s: *byte = J::json_stringify(msg);
  send_raw(s);
  free(s);
  J::json_free(msg);
}

/// Sends a JSON-RPC error response with `code` and `message` for `id`.
pub const send_error -> fn (id: i64, code: i64, message: *byte) void {
  let err: *J::JsonValue = J::json_object();
  J::json_object_set(err, "code", J::json_int(code));
  J::json_object_set(err, "message", J::json_string(message));

  let msg: *J::JsonValue = J::json_object();
  J::json_object_set(msg, "jsonrpc", J::json_string("2.0"));
  J::json_object_set(msg, "id", J::json_int(id));
  J::json_object_set(msg, "error", err);

  let s: *byte = J::json_stringify(msg);
  send_raw(s);
  free(s);
  J::json_free(msg);
}
