@module "parser_expr"

@use "std_cstring" as STRING
@use "std_memory" as MEM
@use "std_vector" as VEC

@use "parser_type"  as PTYPE
@use "lexer_tokens" as TOK
@use "ast_expr"     as EAST
@use "parser"       as PARS
@use "ast"          as AST
@use "error"        as ERR

// String/char literal token text is raw source bytes (the lexer does not
// interpret `\n`/`\t`/etc. — see src/lexer/lexer.lx's '"'/'\'' cases). Resolve
// escapes here, once, when building the literal AST node.
const unescape_char -> fn (c: byte) byte {
  if (c == 'n')  return cast<byte>(10);
  if (c == 't')  return cast<byte>(9);
  if (c == 'r')  return cast<byte>(13);
  if (c == '0')  return cast<byte>(0);
  if (c == '\\') return cast<byte>(92);
  if (c == '\'') return cast<byte>(39);
  if (c == '"')  return cast<byte>(34);
  return c; // unknown escape — pass the character through as-is
}

const hex_digit_val -> fn (c: byte) int {
  if (c >= '0' && c <= '9') return cast<int>(c) - cast<int>('0');
  if (c >= 'a' && c <= 'f') return cast<int>(c) - cast<int>('a') + 10;
  if (c >= 'A' && c <= 'F') return cast<int>(c) - cast<int>('A') + 10;
  return -1;
}

#returns_ownership
const unescape_str -> fn (s: *byte) *byte {
  let len: int = STRING::strlen(s);
  let out: *byte = cast<*byte>(alloc(len + 1));
  let oi: int = 0;
  let i: int = 0;
  loop (i < len) {
    if (s[i] == '\\') {
      if (i + 1 < len) {
        // `\xHH` — a two-hex-digit byte escape (used throughout error.lx's
        // ANSI color codes, e.g. "\x1b[31m").
        let is_hex_escape: bool = false;
        if (s[i + 1] == 'x') {
          if (i + 3 < len) {
            let h1: int = hex_digit_val(s[i + 2]);
            let h2: int = hex_digit_val(s[i + 3]);
            if (h1 >= 0 && h2 >= 0) {
              out[oi] = cast<byte>(h1 * 16 + h2);
              oi = oi + 1;
              i = i + 4;
              is_hex_escape = true;
            }
          }
        }
        if (is_hex_escape == false) {
          out[oi] = unescape_char(s[i + 1]);
          oi = oi + 1;
          i = i + 2;
        }
      } else {
        out[oi] = s[i];
        oi = oi + 1;
        i = i + 1;
      }
    } else {
      out[oi] = s[i];
      oi = oi + 1;
      i = i + 1;
    }
  }
  out[oi] = cast<byte>(0);
  return out;
}

#returns_ownership const enstruct -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode;
#returns_ownership const binary   -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode;
#returns_ownership const try_generic_instantiation -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode;
#returns_ownership const call     -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode;
#returns_ownership const assign   -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode;
#returns_ownership const prefix   -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode;
#returns_ownership const primary  -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const unary    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const group    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const array    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const index    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const deref    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const addr     -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const _alloc   -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const _free    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const _cast    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const _input   -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const _system  -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const syscall  -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const _sizeof  -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const estruct  -> fn (p: *PARS::Parser) *AST::AstNode;

#returns_ownership
const nud -> fn (p: *PARS::Parser) *AST::AstNode { 
  switch using TOK::LumaTokenType (p.current().kind) {
    TOK_NUMBER,     TOK_NUM_FLOAT, TOK_STRING, TOK_CHAR_LITERAL, 
    TOK_IDENTIFIER, TOK_TRUE,      TOK_FALSE
      -> return primary(p);
    TOK_MINUS, TOK_PLUS,     TOK_BANG,
    TOK_TILDE, TOK_PLUSPLUS, TOK_MINUSMINUS
      -> return unary(p);
    TOK_LPAREN   -> return group(p);
    TOK_LBRACKET -> return array(p);
    TOK_LBRACE   -> return estruct(p);
    TOK_STAR     -> return deref(p);
    TOK_AMP      -> return addr(p);
    TOK_ALLOC    -> return _alloc(p);
    TOK_FREE     -> return _free(p);
    TOK_CAST     -> return _cast(p);
    TOK_INPUT    -> return _input(p);
    TOK_SYSTEM   -> return _system(p);
    TOK_SYSCALL  -> return syscall(p);
    TOK_SIZE_OF  -> return _sizeof(p);
    _ -> {
      p.error("Syntax Error", "Expected an expression.");
      p.advance();
      return cast<*AST::AstNode>(0);
    }
  }
}

#returns_ownership
const led -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode {
  switch using TOK::LumaTokenType (p.current().kind) {
    TOK_LT -> {
      let generic: *AST::AstNode = try_generic_instantiation(p, left, bp);
      if (generic != cast<*AST::AstNode>(0)) return generic;
      return binary(p, left, bp);
    }
    TOK_PLUS,  TOK_MINUS, TOK_STAR, TOK_SLASH, TOK_MODL,       TOK_EQEQ,
    TOK_NEQ,   TOK_LE,    TOK_GT,   TOK_GE,    TOK_AMP,        TOK_PIPE,  
    TOK_CARET, TOK_AND,   TOK_OR,   TOK_RANGE, TOK_SHIFT_LEFT, TOK_SHIFT_RIGHT
      -> return binary(p, left, bp);
    TOK_DOT, TOK_RESOLVE, TOK_PLUSPLUS, TOK_MINUSMINUS, TOK_LBRACKET 
      -> return prefix(p, left, bp);
    TOK_LBRACE -> return enstruct(p, left, bp);
    TOK_LPAREN -> return call(p, left, bp);
    TOK_EQUAL  -> return assign(p, left, bp);
    _ -> {
      p.advance();
      return left;
    }
  }
}

// Speculatively tries `left '<' Type (',' Type)* '>' (` — a generic call,
// e.g. `add<int>(1, 2)` — or `left '<' Type (',' Type)* '>' {` — the
// optional explicit generic struct literal, e.g. `Box<int> { value: 42 }`.
// `p.current().kind` is already TOK_LT (checked by led's caller). Only a
// bare identifier can plausibly be a generic template name, so anything
// else (a member access, a call result, ...) isn't even attempted.
//
// On success returns the built CallNode/StructExprNode with its type_args
// attached. On failure (this wasn't that shape after all — most commonly
// just an ordinary `a < b` comparison) rolls the parser back to exactly
// where it started via Parser.save/restore, so the caller can fall through
// to parsing `<` as plain less-than with no trace of the attempt left
// behind (no partial AST, no recorded errors, no moved token position).
#returns_ownership
const try_generic_instantiation -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode {
  if (left.kind != AST::NodeType::EXPR_IDENTIFIER) return cast<*AST::AstNode>(0);

  let sp: PARS::Savepoint = p.save();
  let err_before: int = ERR::error_get_count();
  let targs: VEC::Vector = PTYPE::parse_type_arg_list(p);

  // parse_type_arg_list's own p.consume() calls always advance even when
  // the expected token isn't there (see Parser.consume in parser.lx) — so
  // landing on '(' or '{' right afterward isn't on its own proof this was
  // real `<Type,...>` syntax: e.g. `off < len && (text[off] ...)` parses
  // `len` as a fine-looking type, then chokes on '&&' where '>' should be,
  // *consumes it anyway*, and would otherwise land right on the '(' that
  // starts the next, unrelated group — a false match. An error recorded
  // during the attempt is the real signal that this wasn't it.
  let ok: bool = ERR::error_get_count() == err_before;

  // call()/enstruct() only ever return NULL or a node of exactly that
  // kind (EXPR_CALL/EXPR_STRUCT respectively — see their own
  // constructors) — no separate kind check needed, and one less
  // (statically-unprovable-but-actually-dead) path for the leak analyzer
  // to worry doesn't free `node`.
  if (ok && p.current().kind == TOK::LumaTokenType::TOK_LPAREN) {
    let node: *AST::AstNode = call(p, left, bp);
    if (node != cast<*AST::AstNode>(0)) {
      let cn: *AST::CallNode = cast<*AST::CallNode>(node);
      cn.type_arg_count = targs.size;
      cn.type_args = PARS::vec_to_node_array(&targs);
      VEC::free_vector(&targs);
      return node;
    }
  } elif (ok && p.current().kind == TOK::LumaTokenType::TOK_LBRACE) {
    let node: *AST::AstNode = enstruct(p, left, bp);
    if (node != cast<*AST::AstNode>(0)) {
      let sn: *AST::StructExprNode = cast<*AST::StructExprNode>(node);
      sn.type_arg_count = targs.size;
      sn.type_args = PARS::vec_to_node_array(&targs);
      VEC::free_vector(&targs);
      return node;
    }
  }

  // Not a generic instantiation after all — undo everything.
  loop [i: int = 0](i < targs.size) : (i++) {
    AST::free_node(cast<**AST::AstNode>(targs.data)[i]);
  }
  VEC::free_vector(&targs);
  p.restore(sp);
  return cast<*AST::AstNode>(0);
}

#returns_ownership
pub const parse_expr -> fn (p: *PARS::Parser, bp: int) *AST::AstNode {
  let left: *AST::AstNode = nud(p);

  if (left == cast<*AST::AstNode>(0)) 
      return cast<*AST::AstNode>(0);

  loop (p.has_tokens() && (PARS::get_bp(p.current().kind) > bp)) {
    let c_bp: int = PARS::get_bp(p.current().kind);
    left = led(p, left, c_bp);

    if (left == cast<*AST::AstNode>(0)) 
      return cast<*AST::AstNode>(0);
  }

  return left;
}

#returns_ownership 
const enstruct -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;

  let struct_name: *byte = cast<*byte>(0);
  let struct_alias: *byte = cast<*byte>(0);

  if (left.kind == AST::NodeType::EXPR_IDENTIFIER) {
    let d: *AST::IdentifierNode = cast<*AST::IdentifierNode>(left);
    let len: int = STRING::strlen(d.name);
    struct_name = cast<*byte>(alloc(len + 1));
    MEM::memcpy(cast<*void>(struct_name), cast<*void>(d.name), len);
    struct_name[len] = '\0';
  } elif (left.kind == AST::NodeType::EXPR_MEMBER) {
    let d: *AST::MemberNode = cast<*AST::MemberNode>(left);
    let len: int = STRING::strlen(d.member);
    struct_name = cast<*byte>(alloc(len + 1));
    MEM::memcpy(cast<*void>(struct_name), cast<*void>(d.member), len);
    struct_name[len] = '\0';

    // `ALIAS::StructName { ... }` — keep the alias so the typechecker can
    // tell a qualified reference apart from a bare one (bare is only valid
    // for locally-declared structs; see tc_expr.lx's tc_struct_expr).
    let d_object: *AST::AstNode = d.object;
    let d_object_kind: int = d_object.kind;
    if (d_object_kind == AST::NodeType::EXPR_IDENTIFIER) {
      let aobj: *AST::IdentifierNode = cast<*AST::IdentifierNode>(d_object);
      let alen: int = STRING::strlen(aobj.name);
      struct_alias = cast<*byte>(alloc(alen + 1));
      MEM::memcpy(cast<*void>(struct_alias), cast<*void>(aobj.name), alen);
      struct_alias[alen] = '\0';
    }
  } else {
    p.error("Syntax Error", "Expected identifier before '{' for named struct.");
    return cast<*AST::AstNode>(0);
  }

  p.consume(TOK::LumaTokenType::TOK_LBRACE, "Expected '{' for struct expression.");

  let field_names:  VEC::Vector = VEC::create_vector(sizeof<*byte>);
  let field_values: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);

  loop (p.has_tokens() && p.current().kind != TOK::LumaTokenType::TOK_RBRACE) {
    if (p.current().kind != TOK::LumaTokenType::TOK_IDENTIFIER) {
      p.error("Syntax Error", "Expected field name in struct expression.");
      VEC::free_vector(&field_names);
      VEC::free_vector(&field_values);
      return cast<*AST::AstNode>(0);
    }

    let field_name: *byte = p.get_name();
    p.advance();

    p.consume(TOK::LumaTokenType::TOK_COLON, "Expected ':' after field name.");

    let field_value: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_LOWEST);
    if (field_value == cast<*AST::AstNode>(0)) {
      p.error("Syntax Error", "Expected expression for field value.");
      VEC::free_vector(&field_names);
      VEC::free_vector(&field_values);
      return cast<*AST::AstNode>(0);
    }

    field_names.push_back(cast<*void>(&field_name));
    field_values.push_back(cast<*void>(&field_value));

    if (p.current().kind == TOK::LumaTokenType::TOK_COMMA) {
      p.advance();
    } elif (p.current().kind != TOK::LumaTokenType::TOK_RBRACE) {
      p.error("Syntax Error", "Expected ',' or '}' after field value.");
      VEC::free_vector(&field_names);
      VEC::free_vector(&field_values);
      return cast<*AST::AstNode>(0);
    }
  }

  p.consume(TOK::LumaTokenType::TOK_RBRACE, "Expected '}' to close struct expression.");

  let node: *AST::AstNode = EAST::make_struct_expr(
    struct_name,
    struct_alias,
    PARS::vec_to_byte_array(&field_names),
    PARS::vec_to_node_array(&field_values),
    field_names.size,
    line, col
  );
  VEC::free_vector(&field_names);
  VEC::free_vector(&field_values);
  return node;
}

#returns_ownership 
const binary -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;
  let op:   int = PARS::search_binop_map(p.current().kind);
  p.advance();

  let right: *AST::AstNode = parse_expr(p, bp);
  if (right == cast<*AST::AstNode>(0)) {
    p.error("Syntax Error", "Expected expression after binary operator.");
    return cast<*AST::AstNode>(0);
  }

  return EAST::make_binary(op, left, right, line, col); 
}

#returns_ownership 
const call -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;

  let args: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);

  p.consume(TOK::LumaTokenType::TOK_LPAREN, "Expected '(' for function call.");

  loop (p.current().kind != TOK::LumaTokenType::TOK_RPAREN) {
    let arg: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_LOWEST);
    if (arg == cast<*AST::AstNode>(0)) {
      p.error("Syntax Error", "Expected expression inside function call.");
      VEC::free_vector(&args);
      return cast<*AST::AstNode>(0);
    }
    args.push_back(cast<*void>(&arg));

    if (p.current().kind == TOK::LumaTokenType::TOK_COMMA)
      p.advance();
  }
  p.consume(TOK::LumaTokenType::TOK_RPAREN, "Expected ')' to close a function call.");
  
  let node: *AST::AstNode = EAST::make_call(left, PARS::vec_to_node_array(&args), args.size, line, col);
  VEC::free_vector(&args);
  return node;
}

#returns_ownership 
const assign -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;

  p.consume(TOK::LumaTokenType::TOK_EQUAL, "Expected '=' for assignment.");

  let value: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_ASSIGN);
  if (value == cast<*AST::AstNode>(0)) {
    p.error("Assignment Error", "Failed to parse assignment value.");
    return cast<*AST::AstNode>(0);
  }

  return EAST::make_assign(left, value, line, col); 
}

#returns_ownership 
const prefix -> fn (p: *PARS::Parser, left: *AST::AstNode, bp: int) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;
  let kind: int = p.current().kind;

  // Array index: left[expr]
  if (kind == TOK::LumaTokenType::TOK_LBRACKET) {
    p.advance();
    let idx: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_LOWEST);
    if (idx == cast<*AST::AstNode>(0)) {
      p.error("Syntax Error", "Expected expression inside index.");
      return cast<*AST::AstNode>(0);
    }
    p.consume(TOK::LumaTokenType::TOK_RBRACKET, "Expected ']' to close index expression.");
    return EAST::make_index(left, idx, line, col);
  }

  // Member access: left.member or left::member
  if (kind == TOK::LumaTokenType::TOK_DOT || kind == TOK::LumaTokenType::TOK_RESOLVE) {
    let is_compiletime: int = 0;
    if (kind == TOK::LumaTokenType::TOK_RESOLVE) is_compiletime = 1;
    p.advance();

    if (p.current().kind != TOK::LumaTokenType::TOK_IDENTIFIER) {
      p.error("Syntax Error", "Expected identifier after '.' or '::' for member access.");
      return cast<*AST::AstNode>(0);
    }

    let member: *byte = p.get_name();
    p.advance();
    return EAST::make_member(left, member, is_compiletime, line, col);
  }

  // Postfix ++ / --
  if (kind == TOK::LumaTokenType::TOK_PLUSPLUS || kind == TOK::LumaTokenType::TOK_MINUSMINUS) {
    let op: int = AST::UnaryType::UNOP_POST_INC;
    if (kind == TOK::LumaTokenType::TOK_MINUSMINUS) op = AST::UnaryType::UNOP_POST_DEC;
    p.advance();
    return EAST::make_unary(op, left, line, col);
  }

  p.error("Syntax Error", "Unexpected token for prefix expression.");
  return cast<*AST::AstNode>(0);
}

#returns_ownership 
const primary -> fn (p: *PARS::Parser) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;
  let kind: int = p.current().kind;
  let lit_type: int = PARS::search_literal_map(kind);
  
  if (lit_type == AST::LiteralType::LITERAL_INT) {
    let val: *byte = p.get_name();
    let int_val: int = STRING::atio(val);
    free(val);
    p.advance();
    return EAST::make_literal_int(int_val, line, col);
  }
  
  if (lit_type == AST::LiteralType::LITERAL_FLOAT) {
    let val: *byte = p.get_name();
    let float_val: int = STRING::atio(val);
    free(val);
    p.advance();
    return EAST::make_literal_float(float_val, line, col);
  }
  
  if (lit_type == AST::LiteralType::LITERAL_STRING) {
    let val: *byte = p.get_name();
    let unescaped: *byte = unescape_str(val);
    free(val);
    p.advance();
    return EAST::make_literal_string(unescaped, line, col);
  }
  
  if (lit_type == AST::LiteralType::LITERAL_CHAR) {
    let val: *byte = p.get_name();
    // Token text includes the opening quote: val[0]=='\'', val[1] is either
    // the literal char or (for an escape like '\n') a backslash.
    let char_val: byte = val[1];
    if (val[1] == '\\') char_val = unescape_char(val[2]);
    free(val);
    p.advance();
    return EAST::make_literal_char(char_val, line, col);
  }
  
  if (lit_type == AST::LiteralType::LITERAL_BOOL) {
    let val: *byte = p.get_name();
    let bool_val: int = 0;
    if (STRING::strcmp(val, "true") == 0) bool_val = 1;
    free(val);
    p.advance();
    return EAST::make_literal_bool(bool_val, line, col);
  }

  if (lit_type == AST::LiteralType::LITERAL_IDENT) {
    let val: *byte = p.get_name();
    p.advance();
    return EAST::make_identifier(val, line, col);
  }

  return cast<*AST::AstNode>(0);
}

#returns_ownership 
const unary -> fn (p: *PARS::Parser) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;
  let op:   int = PARS::search_unop_map(p.current().kind);
  p.advance();

  let operand: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_UNARY);
  if (operand == cast<*AST::AstNode>(0)) {
    p.error("Syntax Error", "Expected expression after unary operator."); 
    return cast<*AST::AstNode>(0);
  }

  return EAST::make_unary(op, operand, line, col); 
}

#returns_ownership 
const group -> fn (p: *PARS::Parser) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;

  p.consume(TOK::LumaTokenType::TOK_LPAREN, "Expected '(' for grouping.");
  let expr: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_LOWEST);
  p.consume(TOK::LumaTokenType::TOK_RPAREN, "Expected ')' to close grouping.");
  return EAST::make_grouping(expr, line, col);
}

#returns_ownership 
const array -> fn (p: *PARS::Parser) *AST::AstNode { 
  let line: int = p.current().line;
  let col:  int = p.current().col;

  let elements: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);

  p.consume(TOK::LumaTokenType::TOK_LBRACKET, "Expected '[' for array expression.");

  loop (p.current().kind != TOK::LumaTokenType::TOK_RBRACKET) {
    let element: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_LOWEST);
    if (element == cast<*AST::AstNode>(0)) {
      p.error("Syntax Error", "Expected expression inside array.");
      VEC::free_vector(&elements);
      return cast<*AST::AstNode>(0);
    }
    elements.push_back(cast<*void>(&element));

    if (p.current().kind == TOK::LumaTokenType::TOK_COMMA)
      p.advance();
  }
  p.consume(TOK::LumaTokenType::TOK_RBRACKET, "Expected ']' to close array expression.");

  let node: *AST::AstNode = EAST::make_array(PARS::vec_to_node_array(&elements), elements.size, 0, line, col);
  VEC::free_vector(&elements);
  return node;
}

#returns_ownership 
const deref -> fn (p: *PARS::Parser) *AST::AstNode {
  p.advance();
  let line: int = p.current().line;
  let col:  int = p.current().col;
  let object: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_UNARY);
  return EAST::make_deref(object, line, col);
}

#returns_ownership 
const addr -> fn (p: *PARS::Parser) *AST::AstNode { 
  p.advance();
  let line: int = p.current().line;
  let col:  int = p.current().col;
  let object: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_LOWEST);
  return EAST::make_addr(object, line, col);
}

#returns_ownership 
const _alloc -> fn (p: *PARS::Parser) *AST::AstNode { 
  p.advance(); // consume alloc
  let line: int = p.current().line;
  let col:  int = p.current().col;

  p.consume(TOK::LumaTokenType::TOK_LPAREN, "Expected '(' before size for alloc.");
  let size: *AST::AstNode = parse_expr(p, PARS::BindingPower::BP_NONE);
  p.consume(TOK::LumaTokenType::TOK_RPAREN, "Expected ')' after size for alloc.");

  return EAST::make_alloc(size, line, col);
}

