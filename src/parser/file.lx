@module "parser_file"

@use "std_cstring" as STRING
@use "std_memory"  as MEM
@use "std_vector" as VEC
@use "std_io"     as IO

@use "lexer_tokens" as TOK
@use "lexer"        as LEXER
@use "commands"     as COMD
@use "error"        as ERR
@use "ast"          as AST
@use "ast_module"   as MAST

@use "parser"       as PARS
@use "parse_stmt"   as PSTMT

// Route the "could not read file" failure through the error system like
// every other diagnostic (it used to be a bare stdout print). `message` is
// stashed in the queued ErrorInformation for error_report() and never freed
// — #takes_ownership lets the static analyzer treat passing the allocated
// buffer here the same as an explicit free(), the error.lx standard.
#takes_ownership
const report_read_error -> fn (path: *byte, message: *byte) void {
  let err: ERR::ErrorInformation = ERR::ErrorInformation {
    error_type:   "IO Error",
    file_path:    path,
    message:      message,
    line:         0,
    col:          0,
    line_text:    cast<*byte>(0),
    token_length: 0,
    label:        cast<*byte>(0),
    note:         cast<*byte>(0),
    help:         cast<*byte>(0),
  };
  ERR::error_add(err);
  ERR::error_report();
}

// The lexer records lexical errors as it scans (unknown directive,
// unterminated string/char, invalid character) but can't report them itself
// — it has no file path yet and no finished token table to render the
// source line from. Once the full token scan is done, re-issue each one as
// a proper error.lx diagnostic.
const post_lex_errors -> fn (lexer: *TOK::Lexer, tks: *TOK::Token, tok_count: i64, file_path: *byte) void {
  loop [i: i64 = 0](i < lexer.error_count) : (++i) {
    let e: TOK::LexError = lexer.errors[i];
    let error_type: *byte = "Syntax Error";
    let message: *byte = cast<*byte>(0);
    let label: *byte = cast<*byte>(0);
    let help: *byte = cast<*byte>(0);
    let dynamic_message: *byte = cast<*byte>(0);
    let known: i64 = 1;

    if (e.kind == TOK::LEX_ERR_UNKNOWN_DIRECTIVE) {
      message = "unknown directive";
      label = "unknown directive";
      help = "known directives are @module, @use, @os, @link, #returns_ownership, #takes_ownership, #dll_import and #lib_import.";
    } elif (e.kind == TOK::LEX_ERR_UNTERMINATED_STRING) {
      message = "unterminated string literal";
      label = "unterminated string literal";
      help = "string literals must end with a closing \" on the same line.";
    } elif (e.kind == TOK::LEX_ERR_EMPTY_CHAR) {
      message = "empty character literal";
      label = "empty character literal";
      help = "use exactly one character or an escape, e.g. 'x' or '\\n'.";
    } elif (e.kind == TOK::LEX_ERR_BAD_CHAR) {
      message = "character literal must contain exactly one character";
      label = "character literal";
      help = "use a string literal, e.g. \"ab\", for more than one character.";
    } elif (e.kind == TOK::LEX_ERR_INVALID_CHARACTER) {
      // Name the offending character — "invalid character '$'" instead of a
      // bare "invalid character" (the reconstructed source line can't show
      // it: the character never became a token). Skip naming if the char
      // would break the message (a quote, a backslash) or isn't printable.
      let printable: bool = (e.bad >= 32 && e.bad < 127 && e.bad != '\'' && e.bad != '\\');
      if (printable == true) {
        let prefix: *byte = "invalid character '";
        let plen: i64 = STRING::strlen(prefix);
        let buf: *byte = cast<*byte>(alloc(plen + 3));
        MEM::memcpy(cast<*void>(buf), cast<*void>(prefix), plen);
        buf[plen] = e.bad;
        buf[plen + 1] = '\'';
        buf[plen + 2] = '\0';
        dynamic_message = buf;
        message = buf;
      } else {
        message = "invalid character";
      }
      label = "invalid character";
      help = "this character is not part of the Luma language.";
    } else {
      known = 0;
    }
    if (known == 0) continue;

    let err: ERR::ErrorInformation = ERR::ErrorInformation {
      error_type:   error_type,
      file_path:    file_path,
      message:      message,
      line:         e.line,
      col:          e.col,
      line_text:    ERR::generate_line(tks, tok_count, e.line),
      token_length: e.len,
      label:        label,
      help:         help,
      note:         cast<*byte>(0),
    };
    if (dynamic_message != cast<*byte>(0)) {
      ERR::error_add_msg(dynamic_message, err);
    } else {
      ERR::error_add(err);
    }
  }
}

#takes_ownership
const fail -> fn (
  tokens: *VEC::Vector,
  stmts: *VEC::Vector,
  src: *byte,
  p: *PARS::Parser
) *AST::AstNode {
  if (stmts != cast<*VEC::Vector>(0)) { VEC::free_vector(stmts); }
  if (tokens != cast<*VEC::Vector>(0)) { VEC::free_vector(tokens); }
  if (src != cast<*byte>(0)) { free(src); }
  if (p != cast<*PARS::Parser>(0)) { PARS::Parser::free_parser(p); }

  return cast<*AST::AstNode>(0);
}

#takes_ownership
const fail_early -> fn (src: *byte) *AST::AstNode {
  if (src != cast<*byte>(0)) { free(src); }
  return cast<*AST::AstNode>(0);
}

#returns_ownership
pub const parse_file -> fn (path: *byte) *AST::AstNode {
  let resolved: *byte = COMD::resolve_path(path);
  let src: *byte = IO::read_file(resolved);

  if (resolved != path) { free(resolved); }
  if (src == cast<*byte>(0)) {
    let prefix: *byte = "could not read file: ";
    let plen: i64 = STRING::strlen(prefix);
    let plen2: i64 = STRING::strlen(path);
    let message: *byte = cast<*byte>(alloc(plen + plen2 + 1));
    MEM::memcpy(cast<*void>(message), cast<*void>(prefix), plen);
    MEM::memcpy(cast<*void>(cast<i64>(message) + plen), cast<*void>(path), plen2);
    message[plen + plen2] = '\0';
    report_read_error(path, message);
    return cast<*AST::AstNode>(0);
  }

  let tokens: VEC::Vector = VEC::create_vector(sizeof<TOK::Token>);
  let lexer: TOK::Lexer = TOK::Lexer::make(src);

  loop (lexer.is_end() == 0) {
    let tok: TOK::Token = LEXER::next_token(&lexer);
    tokens.push_back(cast<*void>(&tok));
  }

  let tks: *TOK::Token = cast<*TOK::Token>(tokens.data);
  let p: *PARS::Parser = PARS::Parser::create_parser(tks, tokens.size, path);

  // Lexer-detected problems become real diagnostics now that the token
  // table (and file path) exist; any of them fails the parse.
  post_lex_errors(&lexer, tks, tokens.size, path);
  if (lexer.had_error == 1) { p.had_error = 1; }

  // `//!` module doc comments at the very top of the file attach to the
  // module node (surfaced by the LSP when hovering the module name).
  let doc_comment: *byte = PSTMT::consume_doc_comments(p);

  let line: i64 = p.current().line;
  let col:  i64 = p.current().col;

  if (p.current().kind != TOK::LumaTokenType::TOK_MODULE) {
    p.error("Parser Error", "Expected @module at the start of a file.");
    ERR::error_report();
    if (doc_comment != cast<*byte>(0)) free(doc_comment);
    return fail(&tokens, cast<*VEC::Vector>(0), src, p);
  }
  p.advance();

  if (p.current().kind != TOK::LumaTokenType::TOK_IDENTIFIER &&
      p.current().kind != TOK::LumaTokenType::TOK_STRING) {
    p.error("Parser Error", "Expected module name after @module.");
    ERR::error_report();
    if (doc_comment != cast<*byte>(0)) free(doc_comment);
    return fail(&tokens, cast<*VEC::Vector>(0), src, p);
  }

  let module_name: *byte = p.get_name();
  p.advance();

  let stmts: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);

  loop [i: i64 = 0](p.has_tokens()) : (i++) {
    let stmt: *AST::AstNode = PSTMT::parse_stmt(p);
    if (stmt != cast<*AST::AstNode>(0)) {
      stmts.push_back(cast<*void>(&stmt));
    }
  }

  let module_node: *AST::AstNode = MAST::make_module(
    module_name, doc_comment, path,
    PARS::vec_to_node_array(&stmts), stmts.size,
    line, col,
    src, tks, tokens.size
  );

  if (p.had_error == 1) {
    ERR::error_report();
    AST::free_node(module_node);
    return fail(cast<*VEC::Vector>(0), &stmts, cast<*byte>(0), p);
  }

  VEC::free_vector(&stmts);
  PARS::Parser::free_parser(p);

  return module_node;
}
