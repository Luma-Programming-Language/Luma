@module "parser_type"

@use "std_cstring" as STRING
@use "std_vector" as VEC

@use "lexer_tokens" as TOK
@use "ast_expr"     as EAST
@use "ast_type"     as TAST
@use "parser"       as PARS
@use "ast"          as AST

#returns_ownership const pointer_type    -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const array_type      -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const resolution_type -> fn (p: *PARS::Parser) *AST::AstNode;
#returns_ownership const function_type   -> fn (p: *PARS::Parser) *AST::AstNode;

#returns_ownership
const tnud -> fn (p: *PARS::Parser) *AST::AstNode {
  let line: i64 = p.current().line;
  let col:  i64 = p.current().col;
  let kind: i64 = p.current().kind;

  switch using TOK::LumaTokenType (kind) {
    TOK_I8      -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_I16     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_I32     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_I64     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_U8      -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_U16     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_U32     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_U64     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_F32     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_F64     -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_BOOL    -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_VOID    -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_CHAR    -> { let name: *byte = p.get_name(); p.advance(); return TAST::make_basic_type(name, line, col); }
    TOK_STAR       -> { p.advance(); return pointer_type(p);    }
    TOK_LBRACKET   -> { p.advance(); return array_type(p);      }
    TOK_FN         -> { p.advance(); return function_type(p);   }
    TOK_IDENTIFIER -> { return resolution_type(p);              }
    _ -> { return cast<*AST::AstNode>(0); }
  }
}

#returns_ownership
pub const parse_type -> fn (p: *PARS::Parser) *AST::AstNode {
  let kind: i64 = p.current().kind;

  switch using TOK::LumaTokenType (kind) {
    TOK_I8, TOK_I16, TOK_I32, TOK_I64,
    TOK_U8, TOK_U16, TOK_U32, TOK_U64,
    TOK_F32, TOK_F64,
    TOK_BOOL, TOK_VOID, TOK_CHAR, TOK_IDENTIFIER, 
    TOK_STAR, TOK_LBRACKET, TOK_FN -> {
      return tnud(p);
    }

    _ -> return cast<*AST::AstNode>(0);
  }
}

#returns_ownership
const array_type -> fn (p: *PARS::Parser) *AST::AstNode {

  let line: i64 = p.current().line;
  let col:  i64 = p.current().col;

  let element_type: *AST::AstNode = parse_type(p);
  if (element_type == cast<*AST::AstNode>(0)) {
    p.error("TypeError", "Expected type after '[' in array type.");
    return cast<*AST::AstNode>(0);
  }

  if (p.current().kind != TOK::LumaTokenType::TOK_SEMI) {
    p.error("TypeError", "Array types must declare a size, expected ';' after element type.");
    return cast<*AST::AstNode>(0);
  }
  p.consume(TOK::LumaTokenType::TOK_SEMI, "Expected ';' after array element type.");

  let size: *AST::AstNode = cast<*AST::AstNode>(0);
  switch using AST::LiteralType (PARS::search_literal_map(p.current().kind)) {
    LITERAL_INT -> {
      let val: *byte = p.get_name();
      let int_val: i64 = STRING::atio(val);
      free(val);
      p.advance();
      size = EAST::make_literal_int(int_val, line, col);
    }
    LITERAL_IDENT -> {
      let val: *byte = p.get_name();
      p.advance();
      size = EAST::make_identifier(val, line, col);
    }
  }

  p.consume(TOK::LumaTokenType::TOK_RBRACKET, "Expected ']' to close array type.");

  return TAST::make_array_type(element_type, size, line, col); 
  return cast<*AST::AstNode>(0);
}

#returns_ownership
const pointer_type -> fn (p: *PARS::Parser) *AST::AstNode {
  let line: i64 = p.current().line;
  let col:  i64 = p.current().col;

  let pointee: *AST::AstNode = parse_type(p);
  if (pointee == cast<*AST::AstNode>(0)) {
    p.error("TypeError", "Expected type after '*' in pointer type.");
    return cast<*AST::AstNode>(0);
  }

  return TAST::make_pointer_type(pointee, line, col);
}

// Parses `<Type (',' Type)*>` — the explicit type-argument list of a generic
// type reference (`Box<i64>`), function call (`add<i64>(...)`), or struct
// literal (`Box<i64> { ... }`). Caller has already confirmed the current
// token is '<'. Type position (this function's own callers in this file)
// needs no ambiguity handling: `parse_type` is a separate grammar from
// expressions, so there's no competing '<' operator to confuse it with —
// only the expression-position callers in parser_expr.lx (generic calls and
// struct literals) need the speculative try/rollback dance around *this*.
#returns_ownership
pub const parse_type_arg_list -> fn (p: *PARS::Parser) VEC::Vector {
  let args: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);
  p.consume(TOK::LumaTokenType::TOK_LT, "Expected '<' to start type argument list.");

  if (p.current().kind != TOK::LumaTokenType::TOK_GT) {
    loop (p.has_tokens()) {
      let t: *AST::AstNode = parse_type(p);
      if (t == cast<*AST::AstNode>(0)) {
        p.error("TypeError", "Expected type in type argument list.");
        break;
      }
      args.push_back(cast<*void>(&t));
      if (p.current().kind == TOK::LumaTokenType::TOK_COMMA) { p.advance(); } else { break; }
    }
  }

  p.consume(TOK::LumaTokenType::TOK_GT, "Expected '>' to close type argument list.");
  return args;
}

#returns_ownership
const resolution_type -> fn (p: *PARS::Parser) *AST::AstNode {
  let line: i64 = p.current().line;
  let col:  i64 = p.current().col;

  let first_name: *byte = p.get_name();
  p.advance();

  // Simple identifier type — no resolution operator
  if (p.current().kind != TOK::LumaTokenType::TOK_RESOLVE) {
    let node: *AST::AstNode = TAST::make_basic_type(first_name, line, col);
    // Generic type reference, e.g. `Box<i64>` / `Pair<i64, *byte>` — a fixed
    // grammar slot, unlike the same '<' at an expression call site (see
    // parser_expr.lx), so no ambiguity/backtracking needed here.
    if (p.current().kind == TOK::LumaTokenType::TOK_LT) {
      let targs: VEC::Vector = parse_type_arg_list(p);
      let bn: *AST::BasicTypeNode = cast<*AST::BasicTypeNode>(node);
      bn.type_arg_count = targs.size;
      bn.type_args = PARS::vec_to_node_array(&targs);
    }
    return node;
  }

  // namespace::Type or namespace::sub::Type
  let parts: VEC::Vector = VEC::create_vector(sizeof<*byte>);
  parts.push_back(cast<*void>(&first_name));

  loop (p.current().kind == TOK::LumaTokenType::TOK_RESOLVE) {
    p.advance(); // consume ::

    if (p.current().kind != TOK::LumaTokenType::TOK_IDENTIFIER) {
      p.error("SyntaxError", "Expected identifier after '::'.");
      VEC::free_vector(&parts);
      return cast<*AST::AstNode>(0);
    }

    let part: *byte = p.get_name();
    p.advance();
    parts.push_back(cast<*void>(&part));
  }

  let node: *AST::AstNode = TAST::make_resolution_type(
    PARS::vec_to_byte_array(&parts), parts.size, line, col
  );
  VEC::free_vector(&parts);

  // Qualified generic type reference — `Alias::Box<i64>` / `A::B::Box<i64>`.
  // The type args apply to the resolved *last* component; like the bare
  // `Box<i64>` case above, type position is its own grammar (no competing
  // '<' operator), so no ambiguity/backtracking needed.
  if (p.current().kind == TOK::LumaTokenType::TOK_LT) {
    let targs: VEC::Vector = parse_type_arg_list(p);
    let rn: *AST::ResolutionNode = cast<*AST::ResolutionNode>(node);
    rn.type_arg_count = targs.size;
    rn.type_args = PARS::vec_to_node_array(&targs);
  }

  return node;
}

#returns_ownership 
const function_type   -> fn (p: *PARS::Parser) *AST::AstNode {
  let line: i64 = p.current().line;
  let col:  i64 = p.current().col;

  p.consume(TOK::LumaTokenType::TOK_LPAREN, "Expected '(' to start function parameter list.");

  let param_types: VEC::Vector = VEC::create_vector(sizeof<*AST::AstNode>);

  if (p.current().kind != TOK::LumaTokenType::TOK_RPAREN) {
    loop (p.has_tokens()) {
      let param_type: *AST::AstNode = tnud(p);
      if (param_type == cast<*AST::AstNode>(0)) {
        p.error("TypeError", "Expected type in function parameter list.");
        VEC::free_vector(&param_types);
        return cast<*AST::AstNode>(0);
      }

      param_types.push_back(cast<*void>(&param_type));

      if (p.current().kind == TOK::LumaTokenType::TOK_COMMA) {
        p.advance();
      } else {
        break;
      }
    }
  }

  p.consume(TOK::LumaTokenType::TOK_RPAREN, "Expected ')' to close function parameter list.");

  let return_type: *AST::AstNode = tnud(p);
  if (return_type == cast<*AST::AstNode>(0)) {
    p.error("TypeError", "Expected return type after function parameter list.");
    VEC::free_vector(&param_types);
    return cast<*AST::AstNode>(0);
  }

  let node: *AST::AstNode = TAST::make_func_type(
    PARS::vec_to_node_array(&param_types), param_types.size, return_type, line, col
  );
  VEC::free_vector(&param_types);
  return node;
}
