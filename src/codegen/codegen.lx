@module "codegen"

@use "std_cstring" as STR
@use "std_vector"  as VEC
@use "std_libc"    as LIBC

@use "ast"       as AST
@use "constants" as CONST
@use "tc_type"   as TCT
@use "tc_core"   as TCCORE
@use "cg_core"   as CG
@use "cg_type"   as CGT
@use "cg_expr"   as CGE
@use "cg_stmt"   as CGS

// libc/libm names already given correct prototypes by the preamble's own
// `#include`s. A program that also `@use "std_libc"`s one of these must not
// get a second, conflicting prototype generated from its Luma signature.
//
// A real fixed-size array, not a hand-tracked `alloc` buffer: adding a name
// here without bumping KNOWN_LIBC_NAME_COUNT is now a compile error ("excess
// elements in array initializer"), not the silent heap overflow this used to
// be (was sized for 60 with 61 entries already listed, found while adding
// usleep as the 62nd — see git history).
//
// The `66` below and KNOWN_LIBC_NAME_COUNT must match by hand: a Luma
// module-level `const` compiles to a real C global (with an initializer),
// not a true compile-time constant expression, so C itself refuses to use
// one to size another *file-scope* array ("variably modified ... at file
// scope" — confirmed by trying it here). Named sizes only work for a
// *local* array, where C allows a runtime-sized VLA.
const KNOWN_LIBC_NAME_COUNT: int = 66;
const known_libc_names: [*byte; 66] = [
  "printf", "puts", "putchar", "getchar", "fflush",
  "fopen", "fclose", "fread", "fwrite", "fgets", "fputs", "feof", "ferror",
  "rewind", "fseek", "ftell", "remove", "rename", "tmpfile",
  "malloc", "calloc", "realloc", "exit", "abort", "abs",
  "atoi", "atof", "atol", "rand", "srand", "getenv", "qsort", "bsearch",
  "time", "clock", "difftime",
  "strlen", "strcpy", "strncpy", "strcat", "strncat", "strcmp", "strncmp",
  "strchr", "strrchr", "strstr", "strtok",
  "memset", "memcpy", "memmove", "memcmp",
  "sqrt", "pow", "floor", "ceil", "fabs", "fmod", "log", "exp", "sin", "cos",
  "usleep", "execv", "fork", "strerror", "access",
];

const is_known_libc_name -> fn (name: *byte) bool {
  loop [i: int = 0](i < KNOWN_LIBC_NAME_COUNT) : (++i) {
    if (STR::strcmp(known_libc_names[i], name) == 0) return true;
  }
  return false;
}

const IOWRITE -> fn (out: *void, s: *byte) void {
  LIBC::fputs(s, out);
}

// Backs `input<T>(prompt)` (see cg_expr's EXPR_INPUT codegen, which picks
// one of these by T). Each prints `prompt` (if non-empty) before reading,
// so callers get the same "print then read" shape regardless of T.
//
// Every one of these is built on __luma_read_byte, a single raw one-byte
// read — deliberately never stdio's buffered getchar()/fgets(). Those
// buffer far ahead of what's actually consumed, so a byte sitting in
// stdio's private buffer becomes invisible to anything reading the fd
// directly; mixing the two lets one input<T> call silently steal bytes
// meant for the next. std/terminal.lx also depends on a *plain* read(2)
// specifically for its raw/non-canonical stty polling (e.g. `stty min 0
// time 0`), where a read() returning 0 bytes must come back as "nothing
// available", not latch stdio's stream into permanent EOF the way a 0-byte
// read does when seen through getchar(). Routing every input<T> through
// the same primitive keeps a program that mixes input<byte> with
// input<int>/input<*byte>/etc. reading bytes in the order they arrived,
// rather than racing two different buffers over the same fd.
// Windows has no raw-mode terminal story here (std/win32.lx's console API
// is a separate path), so it just falls back to getchar() there.
const write_input_helpers -> fn (out: *void, is_windows: bool) void {
  if (is_windows) {
    IOWRITE(out, "static int __luma_read_byte(void) {\n");
    IOWRITE(out, "  int __c = getchar();\n");
    IOWRITE(out, "  return __c == EOF ? -1 : __c;\n");
    IOWRITE(out, "}\n");
  } else {
    IOWRITE(out, "static int __luma_read_byte(void) {\n");
    IOWRITE(out, "  unsigned char __c;\n");
    IOWRITE(out, "  return read(0, &__c, 1) == 1 ? (int)__c : -1;\n");
    IOWRITE(out, "}\n");
  }
  IOWRITE(out, "static char* __luma_input_line(void) {\n");
  IOWRITE(out, "  size_t __cap = 128, __len = 0;\n");
  IOWRITE(out, "  char* __out = (char*)malloc(__cap);\n");
  IOWRITE(out, "  char* __grown;\n");
  IOWRITE(out, "  if (__out == NULL) return NULL;\n");
  IOWRITE(out, "  for (;;) {\n");
  IOWRITE(out, "    int __c = __luma_read_byte();\n");
  IOWRITE(out, "    if (__c < 0 || __c == '\\n') break;\n");
  IOWRITE(out, "    if (__len + 1 >= __cap) {\n");
  IOWRITE(out, "      __cap *= 2;\n");
  IOWRITE(out, "      __grown = (char*)realloc(__out, __cap);\n");
  IOWRITE(out, "      if (__grown == NULL) { free(__out); return NULL; }\n");
  IOWRITE(out, "      __out = __grown;\n");
  IOWRITE(out, "    }\n");
  IOWRITE(out, "    __out[__len++] = (char)__c;\n");
  IOWRITE(out, "  }\n");
  IOWRITE(out, "  __out[__len] = '\\0';\n");
  IOWRITE(out, "  return __out;\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static void __luma_input_prompt(const char* p) {\n");
  IOWRITE(out, "  if (p != NULL && p[0] != '\\0') { fputs(p, stdout); fflush(stdout); }\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static long long __luma_input_int(const char* p) {\n");
  IOWRITE(out, "  __luma_input_prompt(p);\n");
  IOWRITE(out, "  char* __l = __luma_input_line();\n");
  IOWRITE(out, "  long long __v = (__l != NULL) ? atoll(__l) : 0;\n");
  IOWRITE(out, "  free(__l);\n");
  IOWRITE(out, "  return __v;\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static unsigned long long __luma_input_uint(const char* p) {\n");
  IOWRITE(out, "  __luma_input_prompt(p);\n");
  IOWRITE(out, "  char* __l = __luma_input_line();\n");
  IOWRITE(out, "  unsigned long long __v = (__l != NULL) ? strtoull(__l, NULL, 10) : 0;\n");
  IOWRITE(out, "  free(__l);\n");
  IOWRITE(out, "  return __v;\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static double __luma_input_double(const char* p) {\n");
  IOWRITE(out, "  __luma_input_prompt(p);\n");
  IOWRITE(out, "  char* __l = __luma_input_line();\n");
  IOWRITE(out, "  double __v = (__l != NULL) ? atof(__l) : 0.0;\n");
  IOWRITE(out, "  free(__l);\n");
  IOWRITE(out, "  return __v;\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static float __luma_input_float(const char* p) {\n");
  IOWRITE(out, "  return (float)__luma_input_double(p);\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static bool __luma_input_bool(const char* p) {\n");
  IOWRITE(out, "  __luma_input_prompt(p);\n");
  IOWRITE(out, "  char* __l = __luma_input_line();\n");
  IOWRITE(out, "  bool __v = (__l != NULL) && (__l[0]=='t'||__l[0]=='T'||__l[0]=='y'||__l[0]=='Y'||__l[0]=='1');\n");
  IOWRITE(out, "  free(__l);\n");
  IOWRITE(out, "  return __v;\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static char* __luma_input_string(const char* p) {\n");
  IOWRITE(out, "  __luma_input_prompt(p);\n");
  IOWRITE(out, "  return __luma_input_line();\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "static char __luma_input_byte(const char* p) {\n");
  IOWRITE(out, "  __luma_input_prompt(p);\n");
  IOWRITE(out, "  int __c = __luma_read_byte();\n");
  IOWRITE(out, "  return __c < 0 ? 0 : (char)__c;\n");
  IOWRITE(out, "}\n");
  IOWRITE(out, "\n");
}

const write_preamble -> fn (out: *void, os: *byte) void {
  // Must come before ANY system header: glibc gates syscall()'s prototype
  // in <unistd.h> behind _GNU_SOURCE (or _DEFAULT_SOURCE, depending on
  // version) — without it, whether syscall() is visible at all is purely
  // a function of the host's default feature-test-macro configuration.
  // That's environment-dependent in practice, not just in theory: it
  // compiled fine as-is on one machine and failed with "implicit
  // declaration of function 'syscall'" on another (Arch) with the exact
  // same source. Windows has no glibc/syscall() at all, so this is
  // harmless-but-pointless there rather than defining it conditionally.
  IOWRITE(out, "#define _GNU_SOURCE\n");
  IOWRITE(out, "#include <stdio.h>\n");
  IOWRITE(out, "#include <stdlib.h>\n");
  IOWRITE(out, "#include <string.h>\n");
  IOWRITE(out, "#include <stdbool.h>\n");
  IOWRITE(out, "#include <math.h>\n");
  IOWRITE(out, "#include <time.h>\n");

  // <unistd.h> exists on Linux and macOS (both POSIX); Windows has no real
  // equivalent (MinGW's shim doesn't cover what std_sys needs there —
  // Windows code goes through std_win32's own Win32 API declarations
  // instead, not this preamble).
  //
  // <sys/syscall.h> — declares SYS_* numbers for glibc's syscall(); it's a
  // Linux-only header. It doesn't exist on macOS (syscall() itself is
  // still declared via <unistd.h> there, just Apple-deprecated for
  // anything beyond a small allowlist — see std/sys.lx's own platform
  // note) and obviously not on Windows. Only pull it in for an actual
  // Linux target so __syscall__ compiles at all cross-target.
  let is_windows: bool = os != cast<*byte>(0) &&
    (STR::strcmp(os, "windows64") == 0 || STR::strcmp(os, "windows32") == 0);
  if (!is_windows) IOWRITE(out, "#include <unistd.h>\n");
  if (os == cast<*byte>(0) || STR::strcmp(os, "linux") == 0) {
    IOWRITE(out, "#include <sys/syscall.h>\n");
  }
  IOWRITE(out, "\n");
  IOWRITE(out, "typedef struct { long long lo; long long hi; } __luma_range_t;\n\n");

  write_input_helpers(out, is_windows);
}

// ─── Pass A: registries ──────────────────────────────────────────────────────

const register_method -> fn (ctx: *CG::CodegenContext, module_name: *byte, struct_name: *byte, member: *AST::AstNode) void {
  if (member == cast<*AST::AstNode>(0)) return;
  if (member.kind != AST::NodeType::STMT_FIELD_DECL) return;
  let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(member);
  if (f.is_embedded == 1) return;
  if (f.function == cast<*AST::AstNode>(0)) return;

  let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(f.function);
  let fi: CG::FuncInfo = CG::FuncInfo {
    name: fd.name, module_name: module_name, decl: fd,
    is_extern: fd.body == cast<*AST::AstNode>(0), is_main: false, owner: struct_name,
    is_static: f.is_static == 1,
  };
  let v: *VEC::Vector = &ctx.funcs;
  v.push_back(cast<*void>(&fi));
}

const register_decl -> fn (ctx: *CG::CodegenContext, os: *byte, module_name: *byte, decl: *AST::AstNode) void {
  if (decl == cast<*AST::AstNode>(0)) return;
  let k: int = decl.kind;

  if (k == AST::NodeType::PREPROCESSOR_OS) {
    let body: *AST::AstNode = CG::resolve_os_for(decl, os);
    if (body != cast<*AST::AstNode>(0)) {
      if (body.kind == AST::NodeType::STMT_BLOCK) {
        let blk: *AST::BlockNode = cast<*AST::BlockNode>(body);
        let i: int = 0;
        loop (i < blk.stmt_count) {
          register_decl(ctx, os, module_name, blk.statements[i]);
          i = i + 1;
        }
      }
    }
    return;
  }

  if (k == AST::NodeType::STMT_STRUCT) {
    let sd: *AST::StructDeclNode = cast<*AST::StructDeclNode>(decl);

    // A generic template (`struct<T>`) itself is never codegen'd — only its
    // concrete instantiations are, and those arrive separately as
    // TCCORE-generated decls (see run_pass_a), already with
    // type_param_count == 0. Registering the raw template here too would
    // emit its still-placeholder `T` field types verbatim.
    if (sd.type_param_count > 0) return;

    let si: CG::StructInfo = CG::StructInfo { name: sd.name, module_name: module_name, decl: sd, defined: false, in_progress: false };
    let sv: *VEC::Vector = &ctx.structs;
    sv.push_back(cast<*void>(&si));

    let i: int = 0;
    loop (i < sd.public_count) { register_method(ctx, module_name, sd.name, sd.public_members[i]); i = i + 1; }
    let j: int = 0;
    loop (j < sd.private_count) { register_method(ctx, module_name, sd.name, sd.private_members[j]); j = j + 1; }
    return;
  }

  if (k == AST::NodeType::STMT_ENUM) {
    let ed: *AST::EnumDeclNode = cast<*AST::EnumDeclNode>(decl);
    let ei: CG::EnumInfo = CG::EnumInfo { name: ed.name, module_name: module_name, decl: ed };
    let ev: *VEC::Vector = &ctx.enums;
    ev.push_back(cast<*void>(&ei));
    return;
  }

  if (k == AST::NodeType::STMT_FUNCTION) {
    let fd: *AST::FuncDeclNode = cast<*AST::FuncDeclNode>(decl);

    // A generic template (`fn<T>`) itself is never codegen'd — only its
    // concrete instantiations are, and those arrive separately as
    // TCCORE-generated decls (see run_pass_a), already with
    // type_param_count == 0. Registering the raw template here too would
    // emit its still-placeholder `T` param/return types verbatim.
    if (fd.type_param_count > 0) return;

    let is_main: bool = STR::strcmp(fd.name, "main") == 0;
    let has_body: bool = fd.body != cast<*AST::AstNode>(0);

    // A forward declaration (`fn (...) T;`, no body) followed later by the
    // real definition is a common pattern here (mutual recursion). Both are
    // separate STMT_FUNCTION nodes with the same name — update the existing
    // entry in place instead of registering a second, conflicting one.
    let existing: *CG::FuncInfo = CG::find_func_in_module(ctx, module_name, fd.name);
    if (existing != cast<*CG::FuncInfo>(0)) {
      if (has_body) {
        existing.decl = fd;
        existing.is_extern = false;
      }
      return;
    }

    let fi: CG::FuncInfo = CG::FuncInfo {
      name: fd.name, module_name: module_name, decl: fd,
      is_extern: has_body == false, is_main: is_main, owner: cast<*byte>(0),
      is_static: false,
    };
    let fv: *VEC::Vector = &ctx.funcs;
    fv.push_back(cast<*void>(&fi));
    return;
  }

  if (k == AST::NodeType::STMT_VAR_DECL || k == AST::NodeType::STMT_CONST_DECL) {
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(decl);
    let gi: CG::GlobalInfo = CG::GlobalInfo { name: vd.name, module_name: module_name, decl: vd };
    let gv: *VEC::Vector = &ctx.globals;
    gv.push_back(cast<*void>(&gi));
    return;
  }

  if (k == AST::NodeType::PREPROCESSOR_USE) {
    let un: *AST::UseNode = cast<*AST::UseNode>(decl);
    let ua: CG::UseAlias = CG::UseAlias { owner_module: module_name, alias: un.alias, target_module: un.module_name };
    let uv: *VEC::Vector = &ctx.use_aliases;
    uv.push_back(cast<*void>(&ua));
    return;
  }
}

const run_pass_a -> fn (ctx: *CG::CodegenContext, prog: *AST::ProgramNode, os: *byte) void {
  let i: int = 0;
  loop (i < prog.module_count) {
    let mnode: *AST::AstNode = prog.modules[i];
    if (mnode.kind == AST::NodeType::PREPROCESSOR_MODULE) {
      let mod: *AST::ModuleNode = cast<*AST::ModuleNode>(mnode);
      let j: int = 0;
      loop (j < mod.body_count) {
        register_decl(ctx, os, mod.name, mod.body[j]);
        j = j + 1;
      }
    }
    i = i + 1;
  }

  // Generic instantiations (`add<int>`, ...) synthesized during typecheck
  // — see tc_generics — aren't part of any ModuleNode.body (that array is
  // fixed-size from parse time), so they don't show up in the walk above.
  // Register them the same way; everything downstream (prototype/body
  // emission) is driven off ctx.funcs, so nothing else needs to change.
  let gi: int = 0;
  loop (gi < TCCORE::generated_decl_count()) {
    let gd: *TCCORE::GeneratedDecl = TCCORE::generated_decl_at(gi);
    register_decl(ctx, os, gd.module_name, gd.decl);
    gi = gi + 1;
  }
}

// ─── Pass B: emission ────────────────────────────────────────────────────────

const emit_enums -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf) void {
  let v: *VEC::Vector = &ctx.enums;
  let n: int = v.size;
  let i: int = 0;
  loop (i < n) {
    let e: *CG::EnumInfo = cast<*CG::EnumInfo>(v.get(i));
    let cname: *byte = CG::c_name_for_enum(e);
    CG::buf_str(buf, "typedef enum { ");
    let ed: *AST::EnumDeclNode = e.decl;
    let j: int = 0;
    loop (j < ed.member_count) {
      if (j > 0) CG::buf_str(buf, ", ");
      let mname: *byte = CG::c_name_for_enum_member(e, ed.members[j]);
      CG::buf_str(buf, mname);
      free(mname);
      j = j + 1;
    }
    CG::buf_str(buf, " } ");
    CG::buf_str(buf, cname);
    CG::buf_str(buf, ";\n");
    free(cname);
    i = i + 1;
  }
  CG::buf_str(buf, "\n");
}

const emit_struct_typedefs -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf) void {
  let v: *VEC::Vector = &ctx.structs;
  let n: int = v.size;
  let i: int = 0;
  loop (i < n) {
    let s: *CG::StructInfo = cast<*CG::StructInfo>(v.get(i));
    let cname: *byte = CG::c_name_for_struct(s);
    CG::buf_str(buf, "typedef struct ");
    CG::buf_str(buf, cname);
    CG::buf_str(buf, " ");
    CG::buf_str(buf, cname);
    CG::buf_str(buf, ";\n");
    free(cname);
    i = i + 1;
  }
  CG::buf_str(buf, "\n");
}

const emit_struct_body -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, s: *CG::StructInfo) void {
  if (s.defined) return;
  if (s.in_progress) return; // cycle guard — shouldn't happen for valid programs
  s.in_progress = true;

  let sd: *AST::StructDeclNode = s.decl;
  let groups: int = 0;
  loop (groups < 2) {
    let members: **AST::AstNode = sd.public_members;
    let count: int = sd.public_count;
    if (groups == 1) { members = sd.private_members; count = sd.private_count; }
    let i: int = 0;
    loop (i < count) {
      let m: *AST::AstNode = members[i];
      if (m != cast<*AST::AstNode>(0)) {
        if (m.kind == AST::NodeType::STMT_FIELD_DECL) {
          let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(m);
          if (f.function == cast<*AST::AstNode>(0)) {
            if (f.type_node != cast<*AST::AstNode>(0)) {
              if (TCT::is_nominal_type(f.type_node)) {
                let dep: *CG::StructInfo = CG::find_struct(ctx, TCT::basic_name(f.type_node));
                if (dep != cast<*CG::StructInfo>(0)) emit_struct_body(ctx, buf, dep);
              }
            }
          }
        }
      }
      i = i + 1;
    }
    groups = groups + 1;
  }

  let cname: *byte = CG::c_name_for_struct(s);
  CG::buf_str(buf, "struct ");
  CG::buf_str(buf, cname);
  CG::buf_str(buf, " {\n");
  free(cname);

  groups = 0;
  loop (groups < 2) {
    let members: **AST::AstNode = sd.public_members;
    let count: int = sd.public_count;
    if (groups == 1) { members = sd.private_members; count = sd.private_count; }
    let i: int = 0;
    loop (i < count) {
      let m: *AST::AstNode = members[i];
      if (m != cast<*AST::AstNode>(0)) {
        if (m.kind == AST::NodeType::STMT_FIELD_DECL) {
          let f: *AST::FieldDeclNode = cast<*AST::FieldDeclNode>(m);
          if (f.function == cast<*AST::AstNode>(0)) {
            CG::buf_str(buf, "  ");
            CGT::emit_value_declarator(ctx, buf, f.type_node, f.name);
            CG::buf_str(buf, ";\n");
          }
        }
      }
      i = i + 1;
    }
    groups = groups + 1;
  }

  CG::buf_str(buf, "};\n\n");
  s.defined = true;
  s.in_progress = false;
}

const emit_all_struct_bodies -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf) void {
  let v: *VEC::Vector = &ctx.structs;
  let n: int = v.size;
  let i: int = 0;
  loop (i < n) {
    emit_struct_body(ctx, buf, cast<*CG::StructInfo>(v.get(i)));
    i = i + 1;
  }
}

const emit_func_prototype -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, f: *CG::FuncInfo) void {
  let fd: *AST::FuncDeclNode = f.decl;
  if (f.is_extern) { if (is_known_libc_name(f.name)) return; }

  // Needed before emitting param types below: a named array-bound in a
  // param type (e.g. `args: [T; SOME_CONST]`) resolves SOME_CONST as a
  // same-module global (see emit_array_size in cg_type), and this loops
  // over every function across every module in one pass — left unset
  // (or stale from whichever function/global was processed last), that
  // lookup missed and silently fell back to the bare Luma name, which
  // isn't a real C symbol: `undeclared identifier` in the prototype only
  // (the definition below already sets this correctly at its own start).
  ctx.current_module = f.module_name;

  // `main`'s signature is fixed by the C runtime (`int main(int, char**)`),
  // not by Luma's declared param types (`argc: int` maps to `long long`
  // everywhere else, but crt0 calls main with real 32-bit `int`s).
  if (f.is_main) {
    CG::buf_str(buf, "int main(int argc, char **argv);\n");
    return;
  }

  let cname: *byte = cast<*byte>(0);
  if (f.owner != cast<*byte>(0)) { cname = CG::c_name_for_method(f); } else { cname = CG::c_name_for_func(f); }

  let sig: *CG::Buf = CG::buf_init();
  CG::buf_str(sig, cname);
  CG::buf_str(sig, "(");
  let has_self: bool = f.owner != cast<*byte>(0) && f.is_static == false;
  if (has_self) {
    let s: *CG::StructInfo = CG::find_struct(ctx, f.owner);
    let sname: *byte = CG::c_name_for_struct(s);
    CG::buf_str(sig, sname);
    CG::buf_str(sig, " *self");
    free(sname);
  }
  let i: int = 0;
  loop (i < fd.param_count) {
    if (has_self || i > 0) CG::buf_str(sig, ", ");
    let pb: *CG::Buf = CG::buf_init();
    CGT::emit_value_declarator(ctx, pb, fd.param_types[i], fd.param_names[i]);
    let ps: *byte = CG::buf_finish(pb);
    CG::buf_str(sig, ps);
    free(ps);
    i = i + 1;
  }
  if (fd.param_count == 0 && has_self == false) CG::buf_str(sig, "void");
  CG::buf_str(sig, ")");
  let sig_str: *byte = CG::buf_finish(sig);

  CGT::emit_value_declarator(ctx, buf, fd.return_type, sig_str);
  CG::buf_str(buf, ";\n");
  free(sig_str);
  free(cname);
}

const emit_all_prototypes -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf) void {
  let v: *VEC::Vector = &ctx.funcs;
  let n: int = v.size;
  let i: int = 0;
  loop (i < n) {
    emit_func_prototype(ctx, buf, cast<*CG::FuncInfo>(v.get(i)));
    i = i + 1;
  }
  CG::buf_str(buf, "\n");
}

const emit_globals -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf) void {
  let v: *VEC::Vector = &ctx.globals;
  let n: int = v.size;
  let i: int = 0;
  loop (i < n) {
    let g: *CG::GlobalInfo = cast<*CG::GlobalInfo>(v.get(i));
    let vd: *AST::VarDeclNode = g.decl;
    ctx.current_module = g.module_name;
    let t: *AST::AstNode = vd.var_type;
    if (t == cast<*AST::AstNode>(0)) {
      let init: *AST::AstNode = vd.initializer;
      if (init != cast<*AST::AstNode>(0)) { t = init.resolved_type; }
    }
    let cname: *byte = CG::mangle2(g.module_name, g.name);
    CGT::emit_value_declarator(ctx, buf, t, cname);
    free(cname);
    if (vd.initializer != cast<*AST::AstNode>(0)) {
      CG::buf_str(buf, " = ");
      CGE::gen_expr(ctx, buf, vd.initializer);
    }
    CG::buf_str(buf, ";\n");
    i = i + 1;
  }
  CG::buf_str(buf, "\n");
}

const emit_func_body -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, f: *CG::FuncInfo) void {
  if (f.is_extern) return;
  let fd: *AST::FuncDeclNode = f.decl;
  if (fd.body == cast<*AST::AstNode>(0)) return;

  ctx.current_module = f.module_name;
  ctx.current_return_type = fd.return_type;
  ctx.current_struct_owner = f.owner;
  let dv: *VEC::Vector = &ctx.defer_stack;
  dv.size = 0;
  let lv: *VEC::Vector = &ctx.locals;
  lv.size = 0;

  // See emit_func_prototype: main's C signature is fixed by the runtime —
  // always `(int, char**)`, regardless of how many params the Luma
  // declaration actually names. Declare under fixed internal C names and
  // bind only as many of them to Luma-visible names as were declared, so
  // the definition's signature always matches the prototype (a
  // `pub const main -> fn () int` — 0 declared params — used to emit
  // `int main(void)` here, conflicting with the prototype's 2-arg form).
  if (f.is_main) {
    CG::buf_str(buf, "int main(int __luma_argc, char **__luma_argv) ");
    if (fd.param_count >= 1) CG::local_bind_as(ctx, fd.param_names[0], "__luma_argc");
    if (fd.param_count >= 2) CG::local_bind_as(ctx, fd.param_names[1], "__luma_argv");
    CGS::gen_stmt(ctx, buf, fd.body);
    CG::buf_str(buf, "\n");
    return;
  }

  let cname: *byte = cast<*byte>(0);
  if (f.owner != cast<*byte>(0)) { cname = CG::c_name_for_method(f); } else { cname = CG::c_name_for_func(f); }

  let sig: *CG::Buf = CG::buf_init();
  CG::buf_str(sig, cname);
  CG::buf_str(sig, "(");
  let has_self: bool = f.owner != cast<*byte>(0) && f.is_static == false;
  if (has_self) {
    CG::local_bind_as(ctx, "self", "self");
    let s: *CG::StructInfo = CG::find_struct(ctx, f.owner);
    let sname: *byte = CG::c_name_for_struct(s);
    CG::buf_str(sig, sname);
    CG::buf_str(sig, " *self");
    free(sname);
  }
  let i: int = 0;
  loop (i < fd.param_count) {
    if (has_self || i > 0) CG::buf_str(sig, ", ");
    CG::local_bind_as(ctx, fd.param_names[i], fd.param_names[i]);
    let pb: *CG::Buf = CG::buf_init();
    CGT::emit_value_declarator(ctx, pb, fd.param_types[i], fd.param_names[i]);
    let ps: *byte = CG::buf_finish(pb);
    CG::buf_str(sig, ps);
    free(ps);
    i = i + 1;
  }
  if (fd.param_count == 0 && has_self == false) CG::buf_str(sig, "void");
  CG::buf_str(sig, ")");
  let sig_str: *byte = CG::buf_finish(sig);

  CGT::emit_value_declarator(ctx, buf, fd.return_type, sig_str);
  CG::buf_str(buf, " ");
  free(sig_str);
  free(cname);

  CGS::gen_stmt(ctx, buf, fd.body);
  CG::buf_str(buf, "\n");
}

const emit_all_func_bodies -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf) void {
  let v: *VEC::Vector = &ctx.funcs;
  let n: int = v.size;
  let i: int = 0;
  loop (i < n) { // main last (cosmetic — prototypes make ordering unnecessary)
    let f: *CG::FuncInfo = cast<*CG::FuncInfo>(v.get(i));
    if (f.is_main == false) emit_func_body(ctx, buf, f);
    i = i + 1;
  }
  i = 0;
  loop (i < n) {
    let f: *CG::FuncInfo = cast<*CG::FuncInfo>(v.get(i));
    if (f.is_main) emit_func_body(ctx, buf, f);
    i = i + 1;
  }
}

const basename_of -> fn (path: *byte) *byte {
  let len: int = STR::strlen(path);
  let i: int = len - 1;
  loop (i >= 0) {
    if (path[i] == '/') return cast<*byte>(cast<int>(path) + i + 1);
    i = i - 1;
  }
  return path;
}

// Which C compiler invocation to prefix the generated-C build command with.
// Only routes through a cross-compiler when `-t`/`--target-os` was actually
// given on this invocation — i.e. a genuine cross-compile. Without that
// check, a Windows-native build of luma (itself cross-compiled from Linux,
// so its own auto-detected `os` is permanently "windows64") would go
// looking for a cross-compiler on every single ordinary native build it
// ever does, since `os` alone can't tell "genuinely cross-compiling" apart
// from "this just happens to match the host". A plain native build always
// uses the host's own `cc` — no new dependency for the common case.
//
// Windows: mingw-w64 (x86_64-w64-mingw32-gcc / i686-w64-mingw32-gcc) is a
// real GNU cross-compiler — a normal package, not a separate language or
// build system, and it's what std_win32.lx's kernel32 imports are built
// against.
//
// macOS: there's no equivalent cross-compiler available as a plain package
// (only osxcross, which needs Apple's actual SDK extracted from a real
// Xcode install — not something to depend on here). A -t macos build on a
// non-macOS host without -c/--no-compile will still get to this branch,
// still emit correctly macOS-flavored C, and then fail here at the actual
// compile/link step — loudly, with whatever error the host's own `cc`
// gives it, not silently. -c/--no-compile is the supported way to cross
// this gap: emit the C on any host, then hand it to an actual macOS
// machine's own `cc` to link.
const target_cc_prefix -> fn (os: *byte, target_explicit: bool) *byte {
  if (!target_explicit || os == cast<*byte>(0)) return "cc -w ";
  if (STR::strcmp(os, "windows64") == 0) return "x86_64-w64-mingw32-gcc -w ";
  if (STR::strcmp(os, "windows32") == 0) return "i686-w64-mingw32-gcc -w ";
  return "cc -w ";
}

#returns_ownership
const target_output_name -> fn (name: *byte, os: *byte) *byte {
  let is_windows: bool = os != cast<*byte>(0) &&
    (STR::strcmp(os, "windows64") == 0 || STR::strcmp(os, "windows32") == 0);
  if (!is_windows) return STR::dup(name);

  let nlen: int = STR::strlen(name);
  if (nlen >= 4 && STR::strcmp(cast<*byte>(cast<int>(name) + nlen - 4), ".exe") == 0) {
    return STR::dup(name);
  }

  let out: *byte = cast<*byte>(alloc(nlen + 5));
  return STR::cat(out, name, ".exe");
}

// Transpiles `program` to C and writes it to output/<name>.c. This is the
// fast half of what used to be one opaque codegen_generate call — ~0.2s
// even for this compiler's own ~40-file, ~14,500-line self-build. Split
// out from the compile step below (which dominates real build time, often
// by 20x or more) so a caller can report on the two separately instead of
// lumping them under one "Codegen" label that's actually almost entirely
// waiting on an external `cc` invocation.
//
// Returns the .c path (caller owns it — must free) on success, or NULL.
#returns_ownership
pub const codegen_transpile -> fn (program: *AST::AstNode, config: CONST::LumaBuildConfig) *byte {
  if (program == cast<*AST::AstNode>(0)) return cast<*byte>(0);
  if (program.kind != AST::NodeType::PROGRAM) return cast<*byte>(0);

  // e.g. `-name test` -> `output/test.c`, for `-save` to keep.
  let mkdir_rc: int = system("mkdir -p output");
  let pb: *CG::Buf = CG::buf_init();
  CG::buf_str(pb, "output/");
  CG::buf_str(pb, basename_of(config.name));
  CG::buf_str(pb, ".c");
  let c_path: *byte = CG::buf_finish(pb);

  let out: *void = LIBC::fopen(c_path, "w");
  if (out == cast<*void>(0)) { free(c_path); return cast<*byte>(0); }

  let ctx: *CG::CodegenContext = CG::ctx_init(out);
  ctx.os = config.os;
  let prog: *AST::ProgramNode = cast<*AST::ProgramNode>(program);
  run_pass_a(ctx, prog, config.os);

  let buf: *CG::Buf = CG::buf_init();
  write_preamble(out, config.os);
  emit_enums(ctx, buf);
  emit_struct_typedefs(ctx, buf);
  emit_all_struct_bodies(ctx, buf);
  // Prototypes before globals: a global's initializer legitimately
  // references a function *by name as a value* (a function-pointer struct
  // field, e.g. `Commands { name: "echo", execute: echo }`) — that needs
  // the function already declared. (Tried the opposite order for a
  // narrower case — a global used as a function *parameter's* array-bound,
  // e.g. `args: [T; SOME_CONST]` — but that broke this real, already-used
  // pattern instead: test/valid/struct_function_pointer_field.lx. A
  // same-module global still can't be used as an array-bound in a
  // *prototype* specifically, only in a function's own definition, where
  // per-function emission has already set ctx.current_module — narrow
  // enough, and currently unused elsewhere in either codebase, that it's
  // not worth a proper two-pass (forward-declare everything, then define)
  // to also cover it.)
  emit_all_prototypes(ctx, buf);
  emit_globals(ctx, buf);
  emit_all_func_bodies(ctx, buf);

  let src: *byte = CG::buf_finish(buf);
  IOWRITE(out, src);
  free(src);
  LIBC::fclose(out);

  return c_path;
}

// Compiles/links the C at `c_path` (as produced by codegen_transpile)
// according to `config` — this is the slow half, an opaque call out to a
// real C compiler (cc, mingw-w64-gcc, ...). Frees `c_path` itself either
// way (kept on disk if config.save, removed otherwise), matching the
// ownership codegen_transpile hands off.
#takes_ownership
pub const codegen_compile -> fn (c_path: *byte, config: CONST::LumaBuildConfig) bool {
  let out_name: *byte = target_output_name(config.name, config.os);

  let cmd: *CG::Buf = CG::buf_init();
  CG::buf_str(cmd, target_cc_prefix(config.os, config.target_explicit));
  if (config.debug) CG::buf_str(cmd, "-g ");
  if (config.opt_level > 0) { CG::buf_str(cmd, "-O"); CG::buf_int(cmd, config.opt_level); CG::buf_str(cmd, " "); }
  CG::buf_str(cmd, c_path);
  CG::buf_str(cmd, " -lm -o ");
  CG::buf_str(cmd, out_name);

  let cmd_str: *byte = CG::buf_finish(cmd);
  free(out_name);

  let rc: int = system(cmd_str);
  free(cmd_str);

  if (config.save) {
    output("Saved generated C source to '", c_path, "'\n");
  } else {
    LIBC::remove(c_path);
  }

  free(c_path);

  return rc == 0;
}

// A codegen_generate() convenience wrapper (transpile+compile as one call)
// used to live here. Dropped rather than kept: nothing calls it anymore
// (main.lx needs the two phases separate to report on them individually —
// see there), and its exact shape — free() in one branch, a function call
// consuming the same pointer in the other, both unreachable from each
// other — tripped a real static-analyzer false positive (flagged as
// "used after being freed" regardless of which branch actually ran).
// Known, not yet fixed; tracked as a real analyzer gap, not routed around
// silently by keeping dead code alive just to dodge it.
