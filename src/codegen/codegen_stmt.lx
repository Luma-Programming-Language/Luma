@module "cg_stmt"

@use "std_vector"  as VEC

@use "ast"      as AST
@use "tc_type"  as TCT
@use "cg_core"  as CG
@use "cg_type"  as CGT
@use "cg_expr"  as CGE

pub const gen_stmt -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void;

// Declared type if present, else inferred from the initializer's
// resolved_type (the typechecker doesn't store this anywhere else codegen
// can read it).
const var_decl_type -> fn (ctx: *CG::CodegenContext, n: *AST::VarDeclNode) *AST::AstNode {
  if (n.var_type != cast<*AST::AstNode>(0)) return n.var_type;
  let init: *AST::AstNode = n.initializer;
  if (init != cast<*AST::AstNode>(0)) {
    let t: *AST::AstNode = init.resolved_type;
    return t;
  }
  return cast<*AST::AstNode>(0);
}

const gen_local_var_decl -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  let n: *AST::VarDeclNode = cast<*AST::VarDeclNode>(stmt);
  let t: *AST::AstNode = var_decl_type(ctx, n);

  // Luma allows re-`let`-ing a name (shadows, doesn't reassign): emit the
  // initializer using the *previous* binding before registering the new
  // one, so `let x = x + 1;` reads the old value.
  let init_str: *byte = cast<*byte>(0);
  if (n.initializer != cast<*AST::AstNode>(0)) {
    let init_buf: *CG::Buf = CG::buf_init();
    // `let arr: [T; N] = [a, b, c];` needs a bare brace-list, not a
    // compound literal (see gen_array_literal).
    let is_direct_array_init: bool = false;
    if (t != cast<*AST::AstNode>(0)) {
      if (TCT::is_array_type(t)) {
        let init_node: *AST::AstNode = n.initializer;
        let init_kind: int = init_node.kind;
        if (init_kind == AST::NodeType::EXPR_ARRAY) { is_direct_array_init = true; }
      }
    }
    if (is_direct_array_init) {
      CGE::gen_array_literal(ctx, init_buf, n.initializer, false);
    } else {
      CGE::gen_expr(ctx, init_buf, n.initializer);
    }
    init_str = CG::buf_finish(init_buf);
  }

  let c_name: *byte = CG::local_declare(ctx, n.name);
  CGT::emit_declarator(ctx, buf, t, c_name);
  if (init_str != cast<*byte>(0)) {
    CG::buf_str(buf, " = ");
    CG::buf_str(buf, init_str);
    free(init_str);
  }
  CG::buf_str(buf, ";\n");
}

// ─── defer bookkeeping ───────────────────────────────────────────────────────

const push_defer -> fn (ctx: *CG::CodegenContext, stmt: *AST::AstNode) void {
  let n: *AST::DeferNode = cast<*AST::DeferNode>(stmt);
  let target: *AST::AstNode = n.statement;
  let v: *VEC::Vector = &ctx.defer_stack;
  v.push_back(cast<*void>(&target));
}

const defer_at -> fn (ctx: *CG::CodegenContext, i: int) *AST::AstNode {
  let v: *VEC::Vector = &ctx.defer_stack;
  return cast<**AST::AstNode>(v.data)[i];
}

// Emits (in LIFO order) every deferred statement pushed since `from_len`.
const flush_defers_from -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, from_len: int) void {
  let v: *VEC::Vector = &ctx.defer_stack;
  let i: int = v.size - 1;
  loop (i >= from_len) {
    gen_stmt(ctx, buf, defer_at(ctx, i));
    i = i - 1;
  }
}

// ─── return / block (defer flush points) ────────────────────────────────────

const gen_return -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  let n: *AST::ReturnStmtNode = cast<*AST::ReturnStmtNode>(stmt);
  let v: *VEC::Vector = &ctx.defer_stack;
  let pending: int = v.size;

  if (pending == 0) {
    if (n.value == cast<*AST::AstNode>(0)) { CG::buf_str(buf, "return;\n"); return; }
    CG::buf_str(buf, "return (");
    CGE::gen_expr(ctx, buf, n.value);
    CG::buf_str(buf, ");\n");
    return;
  }

  CG::buf_str(buf, "{\n");
  if (n.value != cast<*AST::AstNode>(0)) {
    CGT::emit_declarator(ctx, buf, ctx.current_return_type, "__retval");
    CG::buf_str(buf, " = (");
    CGE::gen_expr(ctx, buf, n.value);
    CG::buf_str(buf, ");\n");
  }
  flush_defers_from(ctx, buf, 0);
  if (n.value != cast<*AST::AstNode>(0)) { CG::buf_str(buf, "return __retval;\n"); }
  else { CG::buf_str(buf, "return;\n"); }
  CG::buf_str(buf, "}\n");
}

const gen_block -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  let n: *AST::BlockNode = cast<*AST::BlockNode>(stmt);
  let v: *VEC::Vector = &ctx.defer_stack;
  let start_len: int = v.size;
  let lv: *VEC::Vector = &ctx.locals;
  let locals_start: int = lv.size;

  CG::buf_str(buf, "{\n");
  let i: int = 0;
  loop (i < n.stmt_count) {
    gen_stmt(ctx, buf, n.statements[i]);
    i = i + 1;
  }
  flush_defers_from(ctx, buf, start_len);
  v.size = start_len;
  lv.size = locals_start;
  CG::buf_str(buf, "}\n");
}

// ─── if / loop / switch ──────────────────────────────────────────────────────

const gen_if -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  let n: *AST::IfStmtNode = cast<*AST::IfStmtNode>(stmt);
  CG::buf_str(buf, "if (");
  CGE::gen_expr(ctx, buf, n.condition);
  CG::buf_str(buf, ") ");
  gen_stmt(ctx, buf, n.then_stmt);

  let i: int = 0;
  loop (i < n.elif_count) {
    CG::buf_str(buf, "else if (");
    // elif branches are nested IfStmtNodes; pull condition/body directly
    // rather than re-dispatching through gen_stmt (which would re-print "if").
    let en: *AST::IfStmtNode = cast<*AST::IfStmtNode>(n.elif_stmts[i]);
    CGE::gen_expr(ctx, buf, en.condition);
    CG::buf_str(buf, ") ");
    gen_stmt(ctx, buf, en.then_stmt);
    i = i + 1;
  }

  if (n.else_stmt != cast<*AST::AstNode>(0)) {
    CG::buf_str(buf, "else ");
    gen_stmt(ctx, buf, n.else_stmt);
  }
}

const gen_loop -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  let n: *AST::LoopStmtNode = cast<*AST::LoopStmtNode>(stmt);
  let lv: *VEC::Vector = &ctx.locals;
  let locals_start: int = lv.size;

  CG::buf_str(buf, "for (");

  let i: int = 0;
  loop (i < n.init_count) {
    if (i > 0) CG::buf_str(buf, ", ");
    let vd: *AST::VarDeclNode = cast<*AST::VarDeclNode>(n.initializer[i]);
    let t: *AST::AstNode = var_decl_type(ctx, vd);
    let c_name: *byte = CG::local_declare(ctx, vd.name);
    CGT::emit_declarator(ctx, buf, t, c_name);
    if (vd.initializer != cast<*AST::AstNode>(0)) {
      CG::buf_str(buf, " = ");
      CGE::gen_expr(ctx, buf, vd.initializer);
    }
    i = i + 1;
  }
  CG::buf_str(buf, "; ");
  if (n.condition != cast<*AST::AstNode>(0)) { CGE::gen_expr(ctx, buf, n.condition); } else { CG::buf_str(buf, "1"); }
  CG::buf_str(buf, "; ");
  if (n.optional != cast<*AST::AstNode>(0)) CGE::gen_expr(ctx, buf, n.optional);
  CG::buf_str(buf, ") ");
  gen_stmt(ctx, buf, n.body);

  lv.size = locals_start; // init var(s) scoped to the whole for(...), including the body
}

const gen_switch -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  let n: *AST::SwitchNode = cast<*AST::SwitchNode>(stmt);
  CG::buf_str(buf, "switch (");
  CGE::gen_expr(ctx, buf, n.condition);
  CG::buf_str(buf, ") {\n");

  let i: int = 0;
  loop (i < n.case_count) {
    let cn: *AST::CaseNode = cast<*AST::CaseNode>(n.cases[i]);
    let j: int = 0;
    loop (j < cn.value_count) {
      CG::buf_str(buf, "case ");
      CGE::gen_expr(ctx, buf, cn.values[j]);
      CG::buf_str(buf, ": ");
      j = j + 1;
    }
    gen_stmt(ctx, buf, cn.body);
    CG::buf_str(buf, "break;\n");
    i = i + 1;
  }

  if (n.default_case != cast<*AST::AstNode>(0)) {
    let dn: *AST::DefaultNode = cast<*AST::DefaultNode>(n.default_case);
    CG::buf_str(buf, "default: ");
    gen_stmt(ctx, buf, dn.body);
    CG::buf_str(buf, "break;\n");
  }

  CG::buf_str(buf, "}\n");
}

// ─── top-level statement dispatcher ──────────────────────────────────────────

pub const gen_stmt -> fn (ctx: *CG::CodegenContext, buf: *CG::Buf, stmt: *AST::AstNode) void {
  if (stmt == cast<*AST::AstNode>(0)) return;
  let k: int = stmt.kind;

  if (k == AST::NodeType::STMT_VAR_DECL)   { gen_local_var_decl(ctx, buf, stmt); return; }
  if (k == AST::NodeType::STMT_CONST_DECL) { gen_local_var_decl(ctx, buf, stmt); return; }

  if (k == AST::NodeType::STMT_EXPRESSION) {
    let n: *AST::ExprStmtNode = cast<*AST::ExprStmtNode>(stmt);
    CGE::gen_expr(ctx, buf, n.expression);
    CG::buf_str(buf, ";\n");
    return;
  }

  if (k == AST::NodeType::STMT_IF)     { gen_if(ctx, buf, stmt);     return; }
  if (k == AST::NodeType::STMT_LOOP)   { gen_loop(ctx, buf, stmt);   return; }
  if (k == AST::NodeType::STMT_SWITCH) { gen_switch(ctx, buf, stmt); return; }
  if (k == AST::NodeType::STMT_RETURN) { gen_return(ctx, buf, stmt); return; }
  if (k == AST::NodeType::STMT_BLOCK)  { gen_block(ctx, buf, stmt);  return; }
  if (k == AST::NodeType::STMT_DEFER)  { push_defer(ctx, stmt);      return; }

  if (k == AST::NodeType::STMT_BREAK_CONTINUE) {
    let n: *AST::BreakContinueNode = cast<*AST::BreakContinueNode>(stmt);
    if (n.is_continue == 1) { CG::buf_str(buf, "continue;\n"); } else { CG::buf_str(buf, "break;\n"); }
    return;
  }

  // `@os {}` used as a statement (e.g. std/io.lx's syscall wrappers) —
  // transparent like a typechecker's handling in stmt.lx: the matched
  // arm's statements are emitted directly, not wrapped in a C block, so a
  // `let`/`const` inside it stays visible to code after it in the same C
  // function scope.
  if (k == AST::NodeType::PREPROCESSOR_OS) {
    let body: *AST::AstNode = CG::resolve_os_for(stmt, ctx.os);
    if (body == cast<*AST::AstNode>(0)) return;
    if (body.kind != AST::NodeType::STMT_BLOCK) { gen_stmt(ctx, buf, body); return; }

    let blk: *AST::BlockNode = cast<*AST::BlockNode>(body);
    let i: int = 0;
    loop (i < blk.stmt_count) {
      gen_stmt(ctx, buf, blk.statements[i]);
      i = i + 1;
    }
    return;
  }

  // STMT_FUNCTION/STRUCT/ENUM nested in a function body: no-op (not part of
  // the language's supported surface today; the typechecker doesn't
  // register them at nested scope either).
}
