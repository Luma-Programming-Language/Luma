//! Core code-generation support shared by the C backend.
//!
//! Growable output-buffer helpers, C identifier mangling, and the registrar
//! and lookup infrastructure (CodegenContext and its struct/enum/func/global
//! registries) that the type/expr/stmt codegen passes build on.

@module "cg_core"

@use "std_vector"  as VEC
@use "std_cstring" as STR
@use "std_memory"  as MEM
@use "ast"         as AST

// ─── Growable byte buffer ────────────────────────────────────────────────────

/// Growable byte buffer used to assemble emitted C output before it is
/// flushed to the generated file.
pub const Buf -> struct {
  data: *byte,
  len:  i64,
  cap:  i64,
};

/// Allocates and returns a new buffer with a 4096-byte initial capacity.
#returns_ownership
pub const buf_init -> fn () *Buf {
  let b: *Buf = cast<*Buf>(alloc(sizeof<Buf>));
  b.cap  = 4096;
  b.data = cast<*byte>(alloc(b.cap));
  b.len  = 0;
  return b;
}

/// Ensures `b` can hold `b.len + extra + 1` bytes, growing (doubling) the
/// underlying allocation as needed.
const buf_ensure -> fn (b: *Buf, extra: i64) void {
  if (b.len + extra + 1 <= b.cap) return;
  let ncap: i64 = b.cap * 2;
  loop (ncap < b.len + extra + 1) { ncap = ncap * 2; }
  let nd: *byte = cast<*byte>(alloc(ncap));
  MEM::memcpy(cast<*void>(nd), cast<*void>(b.data), b.len);
  free(b.data);
  b.data = nd;  // ownership transferred to b.data — do not also free(nd) here,
                // that would immediately dangle the buffer it just took over
  b.cap  = ncap;
}

/// Appends the null-terminated string `s` to `b` (returning early if `s` is null).
pub const buf_str -> fn (b: *Buf, s: *byte) void {
  if (s == cast<*byte>(0)) return;
  let n: i64 = STR::strlen(s);
  buf_ensure(b, n);
  MEM::memcpy(cast<*void>(cast<i64>(b.data) + b.len), cast<*void>(s), n);
  b.len = b.len + n;
}

/// Appends the first `n` bytes of `s` to `b`.
pub const buf_nstr -> fn (b: *Buf, s: *byte, n: i64) void {
  buf_ensure(b, n);
  MEM::memcpy(cast<*void>(cast<i64>(b.data) + b.len), cast<*void>(s), n);
  b.len = b.len + n;
}

/// Appends the single byte `c` to `b`.
pub const buf_char -> fn (b: *Buf, c: byte) void {
  buf_ensure(b, 1);
  b.data[b.len] = c;
  b.len = b.len + 1;
}

/// Appends the decimal representation of the integer `v` to `b`.
pub const buf_int -> fn (b: *Buf, v: i64) void {
  let s: *byte = STR::from_int(v);
  buf_str(b, s);
  free(s);
}

/// Returns the last byte in `b`, or 0 if the buffer is empty.
pub const buf_last_char -> fn (b: *Buf) byte {
  if (b.len == 0) return cast<byte>(0);
  return b.data[b.len - 1];
}

/// Null-terminates `b`'s contents, returns them, and frees the buffer
/// itself; caller owns the returned string.
#returns_ownership
pub const buf_finish -> fn (b: *Buf) *byte {
  buf_ensure(b, 0);
  b.data[b.len] = '\0';
  let out: *byte = b.data;
  free(b);
  return out;
}

/// Returns a heap-allocated copy of the null-terminated string `s`.
#returns_ownership
pub const dup_str -> fn (s: *byte) *byte {
  let n: i64 = STR::strlen(s);
  let d: *byte = cast<*byte>(alloc(n + 1));
  MEM::memcpy(cast<*void>(d), cast<*void>(s), n);
  d[n] = '\0';
  return d;
}

/// Returns a heap-allocated string combining `a` followed by `b`.
#returns_ownership
pub const strcat2 -> fn (a: *byte, b: *byte) *byte {
  let la: i64 = STR::strlen(a);
  let lb: i64 = STR::strlen(b);
  let s: *byte = cast<*byte>(alloc(la + lb + 1));
  MEM::memcpy(cast<*void>(s), cast<*void>(a), la);
  MEM::memcpy(cast<*void>(cast<i64>(s) + la), cast<*void>(b), lb);
  s[la + lb] = '\0';
  return s;
}

// `module__name` mangling. Caller owns the returned string.
/// Mangles `a` and `b` into an `a__b` C identifier — the `module__name`
/// symbol-naming scheme. Caller owns the result.
#returns_ownership
pub const mangle2 -> fn (a: *byte, b: *byte) *byte {
  let la: i64 = STR::strlen(a);
  let lb: i64 = STR::strlen(b);
  let s: *byte = cast<*byte>(alloc(la + lb + 3));
  MEM::memcpy(cast<*void>(s), cast<*void>(a), la);
  s[la] = '_'; s[la + 1] = '_';
  MEM::memcpy(cast<*void>(cast<i64>(s) + la + 2), cast<*void>(b), lb);
  s[la + lb + 2] = '\0';
  return s;
}

// `module__Struct_method` mangling.
/// Mangles `a`, `b`, and `c` into an `a__b_c` C identifier — the
/// `module__Struct_method` symbol-naming scheme. Caller owns the result.
#returns_ownership
pub const mangle3 -> fn (a: *byte, b: *byte, c: *byte) *byte {
  let ab: *byte = mangle2(a, b);
  let la: i64 = STR::strlen(ab);
  let lc: i64 = STR::strlen(c);
  let s: *byte = cast<*byte>(alloc(la + lc + 2));
  MEM::memcpy(cast<*void>(s), cast<*void>(ab), la);
  s[la] = '_';
  MEM::memcpy(cast<*void>(cast<i64>(s) + la + 1), cast<*void>(c), lc);
  s[la + lc + 1] = '\0';
  free(ab);
  return s;
}

// ─── Registries built directly from the AST (Pass A) ────────────────────────
// Structural questions (field lists, method lists, embedding chains) are
// re-derived straight from the StructDeclNode/EnumDeclNode/FuncDeclNode AST
// rather than reusing the typechecker's scope tree. Plain expression typing
// still relies on the typechecker's `AstNode.resolved_type` annotations.

/// Registrar entry for a struct: its name, owning module, AST decl node, and
/// emission state (whether its C body has been emitted / is mid-emission).
pub const StructInfo -> struct {
  name:        *byte,
  module_name: *byte,
  decl:        *AST::StructDeclNode,
  defined:     bool,    // has its full C body been emitted yet?
  in_progress: bool,    // cycle guard while topologically emitting
};

/// Registrar entry for an enum: its name, owning module, and AST decl node.
pub const EnumInfo -> struct {
  name:        *byte,
  module_name: *byte,
  decl:        *AST::EnumDeclNode,
};

/// Registrar entry for a function or method: name, owning module, AST decl
/// node, and the flags (extern/main/owner/static) that drive its emission.
pub const FuncInfo -> struct {
  name:        *byte,
  module_name: *byte,
  decl:        *AST::FuncDeclNode,
  is_extern:   bool,    // body-less (FFI) => keep the bare C name
  is_main:     bool,
  owner:       *byte,   // struct name if this is a method, else null
  is_static:   bool,    // method with no implicit `self` (called as Type::name(...))
};

/// Registrar entry for a module-level global variable and its AST decl node.
pub const GlobalInfo -> struct {
  name:        *byte,
  module_name: *byte,
  decl:        *AST::VarDeclNode,
};

// Records a module's `@use "target" as alias` so `ALIAS::symbol` inside
// that module can be mapped back to the real owning module.
/// Maps an alias used inside one module to the real module it points at.
pub const UseAlias -> struct {
  owner_module:  *byte,
  alias:         *byte,
  target_module: *byte,
};

// Luma allows re-`let`-ing the same name within one block (shadowing); C
// doesn't allow redeclaring a name in the same block scope, so each local is
// tracked here and uniquified on collision. Pushed on declaration, truncated
// back on the enclosing block's exit (see codegen_stmt.lx's gen_block/gen_loop).
/// A live local or parameter: Luma source name bound to the C identifier
/// actually emitted (uniquified with a suffix on shadowing collisions).
pub const LocalBinding -> struct {
  name:   *byte, // Luma source name
  c_name: *byte, // emitted C identifier (may equal `name`)
};

/// Per-compilation state threaded through all codegen: the output FILE*,
/// the registries above, and the active function's bookkeeping (live locals,
/// pending defers, current module/return type/struct owner, label counter).
pub const CodegenContext -> struct {
  out:            *void,   // FILE*
  structs:        VEC::Vector,  // of StructInfo
  enums:          VEC::Vector,  // of EnumInfo
  funcs:          VEC::Vector,  // of FuncInfo
  globals:        VEC::Vector,  // of GlobalInfo
  use_aliases:    VEC::Vector,  // of UseAlias
  locals:         VEC::Vector,  // of LocalBinding — current function's live locals/params
  current_module: *byte,
  current_return_type: *AST::AstNode, // return type of the function body being emitted
  // Struct name owning the method body currently being emitted, else null.
  // Lets `Embedded.method(...)` (explicit base-method dispatch, bypassing
  // an override) find `self`'s embedded sub-object of that type.
  current_struct_owner: *byte,
  label_counter:  i64,
  os:             *byte, // target platform (config.os) — resolves `@os {}` arms

  // Pending `defer` statements for the function being emitted, most-recent
  // last. Flushed (LIFO) inline at each `return` and at each block's normal
  // fall-through exit — see codegen_stmt.lx's gen_return/gen_block.
  defer_stack:    VEC::Vector,  // of *AstNode
};

/// Allocates a `CodegenContext` writing to `out`, with empty registries and
/// defaulted bookkeeping fields.
#returns_ownership
pub const ctx_init -> fn (out: *void) *CodegenContext {
  let c: *CodegenContext = cast<*CodegenContext>(alloc(sizeof<CodegenContext>));
  c.out            = out;
  c.structs        = VEC::create_vector(sizeof<StructInfo>);
  c.enums          = VEC::create_vector(sizeof<EnumInfo>);
  c.funcs          = VEC::create_vector(sizeof<FuncInfo>);
  c.globals        = VEC::create_vector(sizeof<GlobalInfo>);
  c.use_aliases    = VEC::create_vector(sizeof<UseAlias>);
  c.locals         = VEC::create_vector(sizeof<LocalBinding>);
  c.current_module = "";
  c.current_return_type = cast<*AST::AstNode>(0);
  c.current_struct_owner = cast<*byte>(0);
  c.label_counter  = 0;
  c.os             = cast<*byte>(0);
  c.defer_stack    = VEC::create_vector(sizeof<*AST::AstNode>);
  return c;
}

/// Returns the `StructInfo` registered under `name`, or null.
pub const find_struct -> fn (ctx: *CodegenContext, name: *byte) *StructInfo {
  let v: *VEC::Vector = &ctx.structs;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let s: *StructInfo = cast<*StructInfo>(v.get(i));
    if (STR::strcmp(s.name, name) == 0) return s;
    i = i + 1;
  }
  return cast<*StructInfo>(0);
}

/// Returns the `EnumInfo` registered under `name`, or null.
pub const find_enum -> fn (ctx: *CodegenContext, name: *byte) *EnumInfo {
  let v: *VEC::Vector = &ctx.enums;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let e: *EnumInfo = cast<*EnumInfo>(v.get(i));
    if (STR::strcmp(e.name, name) == 0) return e;
    i = i + 1;
  }
  return cast<*EnumInfo>(0);
}

/// Returns the first non-method `FuncInfo` registered under `name` (any
/// module), or null.
pub const find_func -> fn (ctx: *CodegenContext, name: *byte) *FuncInfo {
  let v: *VEC::Vector = &ctx.funcs;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let f: *FuncInfo = cast<*FuncInfo>(v.get(i));
    if (f.owner == cast<*byte>(0)) {
      if (STR::strcmp(f.name, name) == 0) return f;
    }
    i = i + 1;
  }
  return cast<*FuncInfo>(0);
}

/// Returns the method `FuncInfo` defined as `method_name` on `struct_name`,
/// or null.
pub const find_method -> fn (ctx: *CodegenContext, struct_name: *byte, method_name: *byte) *FuncInfo {
  let v: *VEC::Vector = &ctx.funcs;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let f: *FuncInfo = cast<*FuncInfo>(v.get(i));
    if (f.owner != cast<*byte>(0)) {
      if (STR::strcmp(f.owner, struct_name) == 0 && STR::strcmp(f.name, method_name) == 0) return f;
    }
    i = i + 1;
  }
  return cast<*FuncInfo>(0);
}

// Static-method fallback for generic struct templates: the caller writes
// `HashMap::new(...)`, but the registered concrete method's owner is the
// mangled concrete name (`main__HashMap__int___byte`). Match any registered
// method whose owner embeds `struct_name` followed by `__` (the mangling
// separator) and whose method name matches.
/// Static-method fallback for concrete generic templates: returns the method
/// named `method_name` whose registered owner embeds `struct_name` followed
/// by the `__` mangling separator, or null.
pub const find_method_owner_containing -> fn (ctx: *CodegenContext, struct_name: *byte, method_name: *byte) *FuncInfo {
  let v: *VEC::Vector = &ctx.funcs;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let f: *FuncInfo = cast<*FuncInfo>(v.get(i));
    if (f.owner != cast<*byte>(0) && STR::strcmp(f.name, method_name) == 0) {
      let len: i64 = STR::strlen(struct_name);
      let olen: i64 = STR::strlen(f.owner);
      let k: i64 = 0;
      loop (k + len < olen) {
        if (STR::strncmp(&f.owner[k], struct_name, len) == 0) {
          if (f.owner[k + len] == '_' && f.owner[k + len + 1] == '_') return f;
        }
        k = k + 1;
      }
    }
    i = i + 1;
  }
  return cast<*FuncInfo>(0);
}

/// Returns the non-method `FuncInfo` for `name` inside `module_name`, or null.
pub const find_func_in_module -> fn (ctx: *CodegenContext, module_name: *byte, name: *byte) *FuncInfo {
  let v: *VEC::Vector = &ctx.funcs;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let f: *FuncInfo = cast<*FuncInfo>(v.get(i));
    if (f.owner == cast<*byte>(0)) {
      if (STR::strcmp(f.module_name, module_name) == 0 && STR::strcmp(f.name, name) == 0) return f;
    }
    i = i + 1;
  }
  return cast<*FuncInfo>(0);
}

/// Returns the `GlobalInfo` for `name` inside `module_name`, or null.
pub const find_global_in_module -> fn (ctx: *CodegenContext, module_name: *byte, name: *byte) *GlobalInfo {
  let v: *VEC::Vector = &ctx.globals;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let g: *GlobalInfo = cast<*GlobalInfo>(v.get(i));
    if (STR::strcmp(g.module_name, module_name) == 0 && STR::strcmp(g.name, name) == 0) return g;
    i = i + 1;
  }
  return cast<*GlobalInfo>(0);
}

// Resolves `alias` used inside `owner_module` to the real module name it
// points at, or null if it isn't a known module alias there.
/// Resolves `alias` used inside `owner_module` to the real module name it
/// points at, or null.
pub const resolve_alias -> fn (ctx: *CodegenContext, owner_module: *byte, alias: *byte) *byte {
  let v: *VEC::Vector = &ctx.use_aliases;
  let n: i64 = v.size;
  let i: i64 = 0;
  loop (i < n) {
    let u: *UseAlias = cast<*UseAlias>(v.get(i));
    if (STR::strcmp(u.owner_module, owner_module) == 0 && STR::strcmp(u.alias, alias) == 0) return u.target_module;
    i = i + 1;
  }
  return cast<*byte>(0);
}

/// Returns the C name to emit for `f`: "main" for main, the bare name for
/// body-less extern functions, otherwise a `module__name` mangle.
/// Caller owns the result.
#returns_ownership
pub const c_name_for_func -> fn (f: *FuncInfo) *byte {
  if (f.is_main) return dup_str("main");
  if (f.is_extern) return dup_str(f.name);
  return mangle2(f.module_name, f.name);
}

/// Returns the `module__Struct__method` C name for method `f`.
/// Caller owns the result.
#returns_ownership
pub const c_name_for_method -> fn (f: *FuncInfo) *byte {
  return mangle3(f.module_name, f.owner, f.name);
}

/// Returns the `module__name` C name for struct `s`. Caller owns the result.
#returns_ownership
pub const c_name_for_struct -> fn (s: *StructInfo) *byte {
  return mangle2(s.module_name, s.name);
}

/// Returns the `module__name` C name for enum `e`. Caller owns the result.
#returns_ownership
pub const c_name_for_enum -> fn (e: *EnumInfo) *byte {
  return mangle2(e.module_name, e.name);
}

/// Returns the `module__Enum__member` C name for enum member `member`.
/// Caller owns the result.
#returns_ownership
pub const c_name_for_enum_member -> fn (e: *EnumInfo, member: *byte) *byte {
  return mangle3(e.module_name, e.name, member);
}

/// Resolves an `@os {}` node to the body for `os`: the matching platform
/// arm, the default body if present, or null.
pub const resolve_os_for -> fn (node: *AST::AstNode, os: *byte) *AST::AstNode {
  if (node == cast<*AST::AstNode>(0)) return cast<*AST::AstNode>(0);
  let n: *AST::OsNode = cast<*AST::OsNode>(node);
  if (os != cast<*byte>(0)) {
    let i: i64 = 0;
    loop (n.platforms[i] != cast<*byte>(0)) {
      if (STR::strcmp(n.platforms[i], os) == 0) return n.bodies[i];
      i = i + 1;
    }
  }
  if (n.has_default == 1) return n.default_body;
  return cast<*AST::AstNode>(0);
}

/// Returns the next value of the context-wide label/identifier counter.
pub const next_label -> fn (ctx: *CodegenContext) i64 {
  ctx.label_counter = ctx.label_counter + 1;
  return ctx.label_counter;
}

/// Returns the emitted C name for the innermost live local/param named
/// `name` (newest binding first), or null.
pub const local_lookup -> fn (ctx: *CodegenContext, name: *byte) *byte {
  let v: *VEC::Vector = &ctx.locals;
  let i: i64 = v.size - 1;
  loop (i >= 0) {
    let b: *LocalBinding = cast<*LocalBinding>(v.get(i));
    if (STR::strcmp(b.name, name) == 0) return b.c_name;
    i = i - 1;
  }
  return cast<*byte>(0);
}

/// Registers a live local binding mapping Luma `name` to C name `c_name`.
pub const local_bind_as -> fn (ctx: *CodegenContext, name: *byte, c_name: *byte) void {
  let b: LocalBinding = LocalBinding { name: name, c_name: c_name };
  let v: *VEC::Vector = &ctx.locals;
  v.push_back(cast<*void>(&b));
}

/// Registers `name` as a live local and returns its C name, uniquifying it
/// with a numeric suffix if already bound (shadowing). Caller owns the result.
#returns_ownership
pub const local_declare -> fn (ctx: *CodegenContext, name: *byte) *byte {
  let c_name: *byte = cast<*byte>(0);
  if (local_lookup(ctx, name) == cast<*byte>(0)) {
    c_name = dup_str(name);
  } else {
    let n: i64 = next_label(ctx);
    let suffix: *byte = STR::from_int(n);
    c_name = mangle2(name, suffix);
    free(suffix);
  }
  local_bind_as(ctx, name, c_name);
  return c_name;
}
