@module "commands"

@use "std_cstring" as STRING
@use "std_memory" as MEM
@use "std_args"   as ARGS
@use "std_io"     as IO
@use "std_libc"   as LIBC

@use "constants"  as CONST

pub const print_commands -> fn () void {
  output("===================================================\n");
  output("            Luma Compiler  ", CONST::Luma_Compiler_version, "                  \n");
  output("===================================================\n");
  output("   Usage: luma <file> [options]                    \n");
  output("===================================================\n");
  output("\n");

  output("  Info\n");
  output("  ================================================\n");
  output("  -h,  --help          Show this help message\n");
  output("  -v,  --version       Show version information\n");
  output("  -lc, --license       Show license information\n");
  output("\n");

  output("  Build\n");
  output("  ================================================\n");
  output("  -name <name>         Set output binary name\n");
  output("  -l, -link <files>    Link additional source files\n");
  output("  -save                Save intermediate IR files\n");
  output("  -clean               Clean build artifacts\n");
  output("  -t, --target <os>    Set target platform (linux, macos, windows)\n");
  output("                       Default: auto-detected host system\n");
  output("  -c, --no-compile     Emit the transpiled C and stop (implies -save)\n");
  output("\n");

  output("  Optimization\n");
  output("  ================================================\n");
  output("  -O0                  No optimization\n");
  output("  -O1                  Basic optimization\n");
  output("  -O2                  Moderate optimization (default)\n");
  output("  -O3                  Aggressive optimization\n");
  output("\n");

  output("  Debug / Dev\n");
  output("  ================================================\n");
  output("  -debug               Enable debug mode\n");
  output("  --no-sanitize        Disable memory sanitization\n");
  output("  --no-anim            Disable the compiling bar animation\n");
  output("  -lsp, --lsp          Run as language server\n");
  output("\n");
}

pub const print_license -> fn () void {
  output("Luma Compiler - ", CONST::Luma_Compiler_version, "\n");
  output("Copyright (c) 2026 Luma Team\n");
  output("Licensed under the MIT License\n");
}

pub const match_command -> fn (cmd: *byte, usr_cmd: [*byte; 10], count: int) int {
  loop [i: int = 0](i < count) : (++i) {
    if (STRING::strcmp(usr_cmd[i], cmd) == 0) return 1;
  }
  return 0;
}

pub const parse_args -> fn (args: *ARGS::Args, build_config: *CONST::LumaBuildConfig) int {
  if (args.is_empty() == 1) { 
    print_commands(); 
    return CONST::LumaErrorCode::NO_FILES_ERROR; 
  }

  @os {
    "linux"     -> { build_config.os = "linux";     }
    "macos"     -> { build_config.os = "macos";     }
    "windows32" -> { build_config.os = "windows32"; }
    "windows64" -> { build_config.os = "windows64"; }
    _ -> { build_config.os = "unknown"; }
  }

  let first: *byte = args.get(0);
  if (match_command(first, ["-v", "--version"], 2) == 1) { 
    output("Luma Compiler ", CONST::Luma_Compiler_version, "\n");
    return 1;
  } elif (match_command(first, ["-h", "--help"], 2) == 1) { 
    print_commands(); 
    return 1;
  } elif (match_command(first, ["-l", "--license"], 2) == 1) {
    print_license();
    return 1;
  } elif (match_command(first, ["-lsp", "--lsp"], 2) == 1) {
    build_config.lsp_mode = true;
    return 0;
  }

  loop [i: int = 1](i < args.len()) : (++i) {
    let arg: *byte = args.get(i);
    if (match_command(arg, ["-l", "--link"], 2) == 1) {
      let j: int = i + 1;

      loop (j < args.len()) : (++j) {
        let next: *byte = args.get(j);

        if (next[0] == '-') break;

        build_config.link_files.push_back(cast<*void>(&next));
        build_config.file_count = build_config.file_count + 1;
      }

      i = j - 1;
    } elif (match_command(arg, ["-name"], 1) == 1) {
      if (i + 1 >= args.len()) {
        output("Error: Missing output name after -name\n");
        return 1;
      }

      build_config.name = args.get(i + 1);
      i = i + 1;
    } elif (match_command(arg, ["-O0", "-O1", "-O2", "-O3"], 4) == 1) { 
      build_config.opt_level = cast<int>(cast<int>(arg[2]) - cast<int>('0'));
    } elif (match_command(arg, ["--no-sanitize"], 1) == 1) {
      build_config.check_mem = false; // disable the static analyzer
    } elif (match_command(arg, ["--no-anim"], 1) == 1) {
      build_config.anim = false; // disable the compiling bar animation
    } elif (match_command(arg, ["-save"], 1) == 1) {
      build_config.save = true; // keep the generated intermediate (.c) file
    } elif (match_command(arg, ["--target-os", "-t"], 2) == 1) {
      build_config.os = args.get(++i);
      build_config.target_explicit = true;
    } elif (match_command(arg, ["-debug"], 1) == 1) {
      build_config.debug = true;
    } elif (match_command(arg, ["-c", "--no-compile"], 2) == 1) {
      build_config.no_compile = true;
      build_config.save = true; // no point emitting C you then don't keep
    }
  }

  return 0;
}

@os {
  "linux" -> { const SYS_STD_PREFIX: *byte = "/usr/local/lib/luma/"; }
  "macos" -> { const SYS_STD_PREFIX: *byte = "/usr/local/lib/luma/"; }
  "windows32" -> { const SYS_STD_PREFIX: *byte = "C:\\Program Files\\luma\\"; }
  "windows64" -> { const SYS_STD_PREFIX: *byte = "C:\\Program Files\\luma\\"; }
}

// install.sh/install.bat's non-root install writes to ~/.luma/ (or
// %USERPROFILE%\.luma\ on Windows) — this is the env var and path-join
// piece resolve_path needs to actually find that install, which it
// couldn't before: it only ever knew about SYS_STD_PREFIX, so a non-root
// install produced a `luma` that couldn't find its own std lib unless you
// ran it from a directory with a local std/ or passed explicit -l paths.
@os {
  "linux"     -> { const HOME_ENV_VAR: *byte = "HOME"; const USER_STD_SUFFIX: *byte = "/.luma/"; }
  "macos"     -> { const HOME_ENV_VAR: *byte = "HOME"; const USER_STD_SUFFIX: *byte = "/.luma/"; }
  "windows32" -> { const HOME_ENV_VAR: *byte = "USERPROFILE"; const USER_STD_SUFFIX: *byte = "\\.luma\\"; }
  "windows64" -> { const HOME_ENV_VAR: *byte = "USERPROFILE"; const USER_STD_SUFFIX: *byte = "\\.luma\\"; }
}

// Returns an allocated "$HOME/.luma/" (or NULL if HOME/USERPROFILE isn't
// set in the environment at all).
#returns_ownership
const build_user_prefix -> fn () *byte {
  let home: *byte = LIBC::getenv(HOME_ENV_VAR);
  if (home == cast<*byte>(0)) return cast<*byte>(0);

  let home_len:   int = STRING::strlen(home);
  let suffix_len: int = STRING::strlen(USER_STD_SUFFIX);
  let out: *byte = cast<*byte>(alloc(home_len + suffix_len + 1));
  return STRING::cat(out, home, USER_STD_SUFFIX);
}

// Three tiers, in order: `path` exactly as given (relative to cwd, or
// absolute) — then a non-root install under $HOME/.luma/ — then the
// system-wide install under SYS_STD_PREFIX. The given path deliberately
// wins over both installed locations: it used to be the other way around
// (system prefix tried first), so a locally-edited source file (e.g. a
// repo checkout's own std/) was silently shadowed by whatever happened to
// be installed system-wide — same relative path, different (possibly
// stale) content, no error, no indication the local edit was never
// actually used.
#returns_ownership
pub const resolve_path -> fn (path: *byte) *byte {
  let direct_fd: int = IO::local_open_read(path);
  if (IO::local_is_error(direct_fd) == false) {
    IO::local_close(direct_fd);
    return path;
  }

  let path_len: int = STRING::strlen(path);

  let user_prefix: *byte = build_user_prefix();
  if (user_prefix != cast<*byte>(0)) {
    let uprefix_len: int = STRING::strlen(user_prefix);
    let user_path: *byte = cast<*byte>(alloc(uprefix_len + path_len + 1));
    MEM::memcpy(cast<*void>(user_path), cast<*void>(user_prefix), uprefix_len);
    MEM::memcpy(cast<*void>(cast<int>(user_path) + uprefix_len), cast<*void>(path), path_len);
    user_path[uprefix_len + path_len] = '\0';
    free(user_prefix);

    let ufd: int = IO::local_open_read(user_path);
    if (IO::local_is_error(ufd) == false) {
      IO::local_close(ufd);
      return user_path;
    }
    free(user_path);
  }

  let prefix_len: int = STRING::strlen(SYS_STD_PREFIX);

  let std_path: *byte = cast<*byte>(alloc(prefix_len + path_len + 1));
  MEM::memcpy(cast<*void>(std_path), cast<*void>(SYS_STD_PREFIX), prefix_len);
  MEM::memcpy(cast<*void>(cast<int>(std_path) + prefix_len), cast<*void>(path), path_len);
  std_path[prefix_len + path_len] = '\0';

  let fd: int = IO::local_open_read(std_path);
  if (IO::local_is_error(fd)) {
    free(std_path);
    return path;
  }

  IO::local_close(fd);
  return std_path;
}
