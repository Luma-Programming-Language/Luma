@module "main"

const Point -> struct {
pub:
  x: int,
  y: int,

  move -> fn (dx: int, dy: int) void {
    self.x = self.x + dx;
    self.y = self.y + dy;
  },
};

pub const main -> fn (argc: int, argv: **byte) int {
    let p: Point = Point { x: 1, y: 2 };
    p.move(3, 4);
    output(p.x, ", ", p.y, "\n");
    return 0;
}
