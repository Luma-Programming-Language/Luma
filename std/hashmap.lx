@module "std_hashmap"

/// Open-addressing hash map with linear probing and tombstones.
///
/// `HashMap<K, V>` is a generic hash map: the caller supplies the hash and
/// equality functions, so it works with any key type, not just strings.
///
/// # Example
/// ```luma
/// let map: *HashMap<i64, i64> = HashMap::new<i64, i64>(hash_int, int_equals);
/// defer map._free();
/// map.insert(0, 123);
/// output(map.get(0));  // 123
/// ```

const EntryState -> enum { Empty, Occupied, Deleted };

/// A single slot in the backing array.
///
/// Tracks the per-key state: empty, occupied, or deleted (tombstone).
const Entry -> struct<K, V> {
  key:   K,
  value: V,
  state: EntryState,
};

/// Generic hash map with caller-supplied hash and equality functions.
///
/// Allocates on the heap; the caller owns the map and must release it
/// with `_free`.
pub const HashMap -> struct<K, V> {
priv:
  entries: *Entry<K, V>,
  tombstones: u64,
  cap:        u64,
  len:        u64,

  hash:   fn (K)    u64,
  equals: fn (K, K) bool,

pub:
  /// Creates an empty `HashMap` with the given hash and equality functions.
  ///
  /// The returned map owns its backing array and must be released with `_free`.
  ///
  /// # Parameters
  /// * `hash` - Function computing a `u64` hash for a key
  /// * `equals` - Function testing whether two keys are equal
  ///
  /// # Returns
  /// A newly allocated, empty `HashMap<K, V>` with an initial capacity of 8.
  ///
  /// # Example
  /// ```luma
  /// let map: *HashMap<i64, i64> = HashMap::new<i64, i64>(hash_int, int_equals);
  /// defer map._free();
  /// map.insert(0, 123);
  /// ```
  #returns_ownership
  static new -> fn<K, V> (
    hash:   fn (K)    u64,
    equals: fn (K, K) bool
  ) *HashMap<K, V> {
    let map: *HashMap<K, V> = cast<*HashMap<K, V>>(
      alloc(sizeof<HashMap<K, V>>)
    );

    map.tombstones = 0;
    map.cap = 8;
    map.len = 0;

    map.hash = hash;
    map.equals = equals;

    map.entries = cast<*Entry<K, V>>(
      alloc(sizeof<Entry<K, V>> * map.cap)
    );

    loop [i: u64 = 0](i < map.cap) : (++i) {
      let entry: *Entry<K, V> = &map.entries[i];
      entry.state = EntryState::Empty;
    }

    return map;
  },

  /// Frees the backing array and the map itself.
  ///
  /// The map must have been created with `new` and must not be used afterwards.
  #takes_ownership
  _free -> fn () void {
    free(self.entries);
    free(self);
  },

  /// Inserts `value` under `key`, growing the table if it becomes too full.
  ///
  /// If `key` already exists, its stored value is overwritten.
  ///
  /// # Parameters
  /// * `key` - Key to insert or update
  /// * `value` - Value to store
  ///
  /// # Returns
  /// `true` if a new key was inserted, `false` if an existing key was overwritten.
  insert -> fn (key: K, value: V) bool {
    if ((self.len + self.tombstones) * 100 / self.cap >= 70)
      self.resize(self.cap * 2);

    let index: u64 = self.hash(key) % self.cap;

    loop {
      let entry: *Entry<K, V> = &self.entries[index];

      switch using EntryState (entry.state) {
        Empty -> {
          entry.key = key;
          entry.value = value;
          entry.state = EntryState::Occupied;

          self.len = self.len + 1;
          return true;
        }
        Deleted -> {
          entry.key = key;
          entry.value = value;
          entry.state = EntryState::Occupied;

          self.len = self.len + 1;
          self.tombstones = self.tombstones - 1;

          return true;
        }
        Occupied -> {
          if (self.equals(entry.key, key)) {
            entry.value = value;
            return false;
          }
        }
      }

      index = (index + 1) % self.cap;
    }

    return false;
  },

  /// Returns the value stored under `key`.
  ///
  /// # Parameters
  /// * `key` - Key to look up
  ///
  /// # Returns
  /// The stored value, or a zero value if `key` is not present.
  get -> fn (key: K) V {
    let index: u64 = self.hash(key) % self.cap;

    loop {
      let entry: *Entry<K, V> = &self.entries[index];

      if (entry.state == EntryState::Empty)
        return cast<V>(0);

      if (entry.state == EntryState::Occupied) {
        if (self.equals(entry.key, key)) return entry.value;
      }

      index = (index + 1) % self.cap;
    }
  },

  /// Returns the bucket index that `key` hashes to in the current table.
  ///
  /// # Parameters
  /// * `key` - Key whose bucket is queried
  ///
  /// # Returns
  /// `hash(key) % capacity`.
  get_hash -> fn (key: K) u64 { return self.hash(key) % self.cap; },

  /// Checks whether `key` is present in the map.
  ///
  /// # Parameters
  /// * `key` - Key to test for membership
  ///
  /// # Returns
  /// `true` if `key` exists, `false` otherwise.
  contains -> fn (key: K) bool {
    let index: u64 = self.hash(key) % self.cap;

    loop {
      let entry: *Entry<K, V> = &self.entries[index];

      switch using EntryState (entry.state) {
        Empty -> return false;
        Occupied -> {
          if (self.equals(entry.key, key))
            return true;
        }
      }

      index = (index + 1) % self.cap;
    }
  },

  /// Removes `key` from the map, marking its slot as a tombstone.
  ///
  /// # Parameters
  /// * `key` - Key to remove
  ///
  /// # Returns
  /// The removed value, or a zero value if `key` was not present.
  remove -> fn (key: K) V {
    let index: u64 = self.hash(key) % self.cap;

    loop {
      let entry: *Entry<K, V> = &self.entries[index];

      switch using EntryState (entry.state) {
        Empty -> return cast<V>(0);
        Occupied -> {
          if (self.equals(entry.key, key)) {
            let value: V = entry.value;

            entry.state = EntryState::Deleted;

            self.len = self.len - 1;
            self.tombstones = self.tombstones + 1;

            return value;
          }
        }
      }

      index = (index + 1) % self.cap;
    }
  },

  /// Number of live entries currently stored.
  size -> fn () u64 { return self.len; },

  /// Total number of slots in the backing array.
  capacity -> fn () u64 { return self.cap; },

  /// Grows the table to `size` slots, rehashing every live entry.
  resize -> fn (size: u64) void {
    if (size <= self.cap) return;

    let new_entries: *Entry<K, V> = cast<*Entry<K, V>>(
      alloc(sizeof<Entry<K, V>> * size)
    );

    loop [i: u64 = 0](i < size) : (++i) {
      let slot: *Entry<K, V> = &new_entries[i];
      slot.state = EntryState::Empty;
    }

    loop [i: u64 = 0](i < self.cap) : (++i) {
      let entry: *Entry<K, V> = &self.entries[i];

      if (entry.state != EntryState::Occupied) continue;

      let index: u64 = self.hash(entry.key) % size;

      loop {
        let slot: *Entry<K, V> = &new_entries[index];

        if (slot.state == EntryState::Empty) {
          slot.key = entry.key;
          slot.value = entry.value;
          slot.state = EntryState::Occupied;
          break;
        }

        index = (index + 1) % size;
      }
    }

    free(self.entries);
    self.entries = new_entries;
    self.cap = size;
    self.tombstones = 0;
  },
};
