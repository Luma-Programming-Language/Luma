pub const SDL_GL_ExtensionSupported -> fn (extension: *byte) bool;
pub const SDL_GL_ResetAttributes    -> fn () void;
pub const SDL_GL_SetAttribute       -> fn (attr: i64, value: i64) bool;
pub const SDL_GL_GetAttribute       -> fn (attr: i64, value: *i64) bool;
pub const SDL_GL_CreateContext      -> fn (window: *void) *void;
pub const SDL_GL_MakeCurrent        -> fn (window: *void, context: *void) bool;
pub const SDL_GL_GetCurrentWindow   -> fn () *void;
pub const SDL_GL_GetCurrentContext  -> fn () *void;
pub const SDL_GL_SetSwapInterval    -> fn (interval: i64) bool;
pub const SDL_GL_GetSwapInterval    -> fn (interval: *i64) bool;
pub const SDL_GL_SwapWindow         -> fn (window: *void) bool;
pub const SDL_GL_DestroyContext     -> fn (context: *void) bool;

// --- Window management -------------------------------------------------------
pub const SDL_ShowWindow        -> fn (window: *void) bool;
pub const SDL_HideWindow        -> fn (window: *void) bool;
pub const SDL_RaiseWindow       -> fn (window: *void) bool;
pub const SDL_MaximizeWindow    -> fn (window: *void) bool;
pub const SDL_MinimizeWindow    -> fn (window: *void) bool;
pub const SDL_RestoreWindow     -> fn (window: *void) bool;
pub const SDL_SetWindowFullscreen -> fn (window: *void, fullscreen: i64) bool;
pub const SDL_SetWindowSize     -> fn (window: *void, w: i64, h: i64) bool;
pub const SDL_GetWindowPosition -> fn (window: *void, x: *i64, y: *i64) bool;
pub const SDL_GetWindowFlags    -> fn (window: *void) i64;
pub const SDL_GetWindowTitle    -> fn (window: *void) *byte;
pub const SDL_GetWindowID       -> fn (window: *void) i64;
pub const SDL_SetWindowAlwaysOnTop -> fn (window: *void, on_top: i64) bool;
pub const SDL_SetWindowOpacity  -> fn (window: *void, opacity: f32) bool;

// --- Renderer extras ---------------------------------------------------------
pub const SDL_GetRenderer     -> fn (window: *void) *void;
pub const SDL_GetRendererName -> fn (renderer: *void) *byte;
pub const SDL_RenderTexture   -> fn (renderer: *void, texture: *void, srcrect: *void, dstrect: *void) bool;
pub const SDL_RenderTextureRotated -> fn (renderer: *void, texture: *void, srcrect: *void, dstrect: *void, angle: f64, center: *void, flip: i64) bool;
pub const SDL_SetRenderScale  -> fn (renderer: *void, scale_x: f32, scale_y: f32) bool;
pub const SDL_GetRenderScale  -> fn (renderer: *void, scale_x: *f32, scale_y: *f32) bool;
pub const SDL_SetRenderLogicalPresentation -> fn (renderer: *void, w: i64, h: i64, mode: i64) bool;
pub const SDL_GetRenderOutputSize -> fn (renderer: *void, w: *i64, h: *i64) bool;
pub const SDL_GetCurrentRenderOutputSize -> fn (renderer: *void, w: *i64, h: *i64) bool;
pub const SDL_RenderReadPixels -> fn (renderer: *void, rect: *void) *void;
pub const SDL_CreateTexture    -> fn (renderer: *void, format: i64, access: i64, w: i64, h: i64) *void;
pub const SDL_DestroyTexture   -> fn (texture: *void) void;
pub const SDL_GetTextureSize   -> fn (texture: *void, w: *f32, h: *f32) bool;
pub const SDL_SetRenderDrawColorFloat -> fn (renderer: *void, r: f32, g: f32, b: f32, a: f32) bool;

// --- Event queue extras ------------------------------------------------------
pub const SDL_PumpEvents        -> fn () void;
pub const SDL_WaitEvent         -> fn (event: *void) bool;
pub const SDL_WaitEventTimeout  -> fn (event: *void, timeout_ms: i64) bool;
pub const SDL_PushEvent         -> fn (event: *void) bool;
pub const SDL_FlushEvent        -> fn (type: i64) void;

// --- Input extras ------------------------------------------------------------
pub const SDL_SetKeyboardFocus  -> fn (window: *void) bool;
pub const SDL_GetGlobalMouseState -> fn (x: *f32, y: *f32) i64;

// --- Timing extras -----------------------------------------------------------
pub const SDL_GetTicksNS             -> fn () i64;
pub const SDL_GetPerformanceCounter  -> fn () i64;
pub const SDL_GetPerformanceFrequency -> fn () i64;

// --- Subsystem lifecycle extras ----------------------------------------------
pub const SDL_InitSubSystem -> fn (flags: i64) bool;
pub const SDL_QuitSubSystem -> fn (flags: i64) void;
pub const SDL_ClearError    -> fn () void;

// ============================================================================
// SDL_WINDOWPOS_CENTERED equivalent for SDL3
// Use SDL_SetWindowPosition after creation. This constant asks SDL to centre.
// ============================================================================

pub const SDL_WINDOWPOS_CENTERED: i64 = 805240832;

// ============================================================================
// Event helpers  (layout unchanged from SDL2)
// ============================================================================

pub const event_type -> fn (buf: *byte) i64 {
    let b0: i64 = cast<i64>(buf[0]);
    let b1: i64 = cast<i64>(buf[1]);
    let b2: i64 = cast<i64>(buf[2]);
    let b3: i64 = cast<i64>(buf[3]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

pub const key_scancode -> fn (buf: *byte) i64 {
    let b0: i64 = cast<i64>(buf[16]);
    let b1: i64 = cast<i64>(buf[17]);
    let b2: i64 = cast<i64>(buf[18]);
    let b3: i64 = cast<i64>(buf[19]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

pub const key_down -> fn (state: *byte, scancode: i64) bool {
    return state[scancode] != cast<byte>(0);
}
