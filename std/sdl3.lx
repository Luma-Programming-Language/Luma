@module "std_sdl3"

@os {
    "linux"   -> { @link("libSDL3.so") }
    "macos"   -> { @link("libSDL3.dylib") }
}

// ============================================================================
// INIT FLAGS
// ============================================================================

pub const SDL_INIT_AUDIO:    i64 = 0x10;
pub const SDL_INIT_VIDEO:    i64 = 0x20;
pub const SDL_INIT_JOYSTICK: i64 = 0x200;
pub const SDL_INIT_HAPTIC:   i64 = 0x1000;
pub const SDL_INIT_GAMEPAD:  i64 = 0x2000;
pub const SDL_INIT_EVENTS:   i64 = 0x4000;
pub const SDL_INIT_SENSOR:   i64 = 0x8000;
pub const SDL_INIT_CAMERA:   i64 = 0x10000;

// ============================================================================
// WINDOW FLAGS
// Windows are shown by default in SDL3 — SDL_WINDOW_SHOWN no longer exists.
// ============================================================================

pub const SDL_WINDOW_FULLSCREEN:          i64 = 0x001;
pub const SDL_WINDOW_OPENGL:              i64 = 0x002;
pub const SDL_WINDOW_OCCLUDED:            i64 = 0x004;
pub const SDL_WINDOW_HIDDEN:              i64 = 0x008;
pub const SDL_WINDOW_BORDERLESS:          i64 = 0x010;
pub const SDL_WINDOW_RESIZABLE:           i64 = 0x020;
pub const SDL_WINDOW_MINIMIZED:           i64 = 0x040;
pub const SDL_WINDOW_MAXIMIZED:           i64 = 0x080;
pub const SDL_WINDOW_MOUSE_GRABBED:       i64 = 0x100;
pub const SDL_WINDOW_INPUT_FOCUS:         i64 = 0x200;
pub const SDL_WINDOW_MOUSE_FOCUS:         i64 = 0x400;
pub const SDL_WINDOW_HIGH_PIXEL_DENSITY:  i64 = 0x2000;
pub const SDL_WINDOW_ALWAYS_ON_TOP:       i64 = 0x10000;
pub const SDL_WINDOW_VULKAN:              i64 = 0x10000000;
pub const SDL_WINDOW_METAL:               i64 = 0x20000000;
pub const SDL_WINDOW_TRANSPARENT:         i64 = 0x40000000;

// ============================================================================
// EVENT TYPES  (SDL_EVENT_* from the SDL3 3.4.x headers)
// ============================================================================

pub const SDL_EVENT_QUIT:          i64 = 0x100;   // 256
pub const SDL_EVENT_KEY_DOWN:      i64 = 0x300;   // 768
pub const SDL_EVENT_KEY_UP:        i64 = 0x301;   // 769
pub const SDL_EVENT_TEXT_INPUT:    i64 = 0x303;   // 771
pub const SDL_EVENT_MOUSE_MOTION:  i64 = 0x400;   // 1024
pub const SDL_EVENT_MOUSE_BUTTON_DOWN: i64 = 0x401;
pub const SDL_EVENT_MOUSE_BUTTON_UP:   i64 = 0x402;
pub const SDL_EVENT_MOUSE_WHEEL:       i64 = 0x403;

// SDL_WindowEventID: 0x202 is SDL_EVENT_WINDOW_SHOWN.
pub const SDL_EVENT_WINDOW_SHOWN:             i64 = 0x202;
pub const SDL_EVENT_WINDOW_HIDDEN:            i64 = 0x203;
pub const SDL_EVENT_WINDOW_EXPOSED:           i64 = 0x204;
pub const SDL_EVENT_WINDOW_MOVED:             i64 = 0x205;
pub const SDL_EVENT_WINDOW_RESIZED:           i64 = 0x206;   // 518 (data1,data2 = w,h)
pub const SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED: i64 = 0x207;  // 519
pub const SDL_EVENT_WINDOW_MINIMIZED:         i64 = 0x209;
pub const SDL_EVENT_WINDOW_MAXIMIZED:         i64 = 0x20A;
pub const SDL_EVENT_WINDOW_RESTORED:          i64 = 0x20B;
pub const SDL_EVENT_WINDOW_MOUSE_ENTER:       i64 = 0x20C;
pub const SDL_EVENT_WINDOW_MOUSE_LEAVE:       i64 = 0x20D;
pub const SDL_EVENT_WINDOW_CLOSE_REQUESTED:   i64 = 0x210;

// ============================================================================
// SCANCODES  (same as SDL2)
// ============================================================================

pub const SDL_SCANCODE_A:      i64 = 4;
pub const SDL_SCANCODE_D:      i64 = 7;
pub const SDL_SCANCODE_S:      i64 = 22;
pub const SDL_SCANCODE_W:      i64 = 26;
pub const SDL_SCANCODE_SPACE:  i64 = 44;
pub const SDL_SCANCODE_ESCAPE: i64 = 41;
pub const SDL_SCANCODE_LEFT:   i64 = 80;
pub const SDL_SCANCODE_RIGHT:  i64 = 79;
pub const SDL_SCANCODE_UP:     i64 = 82;
pub const SDL_SCANCODE_DOWN:   i64 = 81;

// ============================================================================
// GL CONTEXT ATTRIBUTES  (SDL_GLAttr enum from the SDL3 headers)
// ============================================================================

pub const SDL_GL_RED_SIZE:                 i64 = 0;
pub const SDL_GL_GREEN_SIZE:               i64 = 1;
pub const SDL_GL_BLUE_SIZE:                i64 = 2;
pub const SDL_GL_ALPHA_SIZE:               i64 = 3;
pub const SDL_GL_BUFFER_SIZE:              i64 = 4;
pub const SDL_GL_DOUBLEBUFFER:             i64 = 5;
pub const SDL_GL_DEPTH_SIZE:               i64 = 6;
pub const SDL_GL_STENCIL_SIZE:             i64 = 7;
pub const SDL_GL_ACCUM_RED_SIZE:           i64 = 8;
pub const SDL_GL_ACCUM_GREEN_SIZE:         i64 = 9;
pub const SDL_GL_ACCUM_BLUE_SIZE:          i64 = 10;
pub const SDL_GL_ACCUM_ALPHA_SIZE:         i64 = 11;
pub const SDL_GL_STEREO:                   i64 = 12;
pub const SDL_GL_MULTISAMPLEBUFFERS:       i64 = 13;
pub const SDL_GL_MULTISAMPLESAMPLES:       i64 = 14;
pub const SDL_GL_ACCELERATED_VISUAL:       i64 = 15;
pub const SDL_GL_RETAINED_BACKING:         i64 = 16;
pub const SDL_GL_CONTEXT_MAJOR_VERSION:    i64 = 17;
pub const SDL_GL_CONTEXT_MINOR_VERSION:    i64 = 18;
pub const SDL_GL_CONTEXT_FLAGS:            i64 = 19;
pub const SDL_GL_CONTEXT_PROFILE_MASK:     i64 = 20;
pub const SDL_GL_SHARE_WITH_CURRENT_CONTEXT: i64 = 21;
pub const SDL_GL_FRAMEBUFFER_SRGB_CAPABLE: i64 = 22;
pub const SDL_GL_CONTEXT_RELEASE_BEHAVIOR: i64 = 23;
pub const SDL_GL_CONTEXT_RESET_NOTIFICATION: i64 = 24;
pub const SDL_GL_CONTEXT_NO_ERROR:         i64 = 25;
pub const SDL_GL_FLOATBUFFERS:             i64 = 26;
pub const SDL_GL_EGL_PLATFORM:             i64 = 27;

// SDL_GLProfile values for SDL_GL_CONTEXT_PROFILE_MASK
pub const SDL_GL_CONTEXT_PROFILE_CORE:          i64 = 0x0001;
pub const SDL_GL_CONTEXT_PROFILE_COMPATIBILITY: i64 = 0x0002;
pub const SDL_GL_CONTEXT_PROFILE_ES:            i64 = 0x0004;

// SDL_GLContextFlag values for SDL_GL_CONTEXT_FLAGS
pub const SDL_GL_CONTEXT_DEBUG_FLAG:               i64 = 0x0001;
pub const SDL_GL_CONTEXT_FORWARD_COMPATIBLE_FLAG:  i64 = 0x0002;
pub const SDL_GL_CONTEXT_ROBUST_ACCESS_FLAG:       i64 = 0x0004;
pub const SDL_GL_CONTEXT_RESET_ISOLATION_FLAG:     i64 = 0x0008;

pub const SDL_FRect -> struct {
    x: f32,
    y: f32,
    w: f32,
    h: f32,
};

pub const make_rect -> fn (x: f32, y: f32, w: f32, h: f32) SDL_FRect {
    return SDL_FRect { x: x, y: y, w: w, h: h };
}

// ============================================================================
// FUNCTION IMPORTS
// ============================================================================

@os {
    "linux" -> {
        // Lifecycle
        pub const SDL_Init          -> fn (flags: i64) bool;
        pub const SDL_Quit          -> fn () void;
        pub const SDL_GetError      -> fn () *byte;

        // Window
        pub const SDL_CreateWindow      -> fn (title: *byte, w: i64, h: i64, flags: i64) *void;
        pub const SDL_DestroyWindow     -> fn (window: *void) void;
        pub const SDL_SetWindowPosition -> fn (window: *void, x: i64, y: i64) i64;
        pub const SDL_GetWindowSize     -> fn (window: *void, w: *i64, h: *i64) void;
        pub const SDL_SetWindowTitle    -> fn (window: *void, title: *byte) void;

        // Renderer
        pub const SDL_CreateRenderer  -> fn (window: *void, name: *byte) *void;
        pub const SDL_DestroyRenderer -> fn (renderer: *void) void;
        pub const SDL_SetRenderVSync  -> fn (renderer: *void, vsync: i64) i64;

        // Draw state
        pub const SDL_SetRenderDrawColor     -> fn (renderer: *void, r: i64, g: i64, b: i64, a: i64) i64;
        pub const SDL_SetRenderDrawBlendMode -> fn (renderer: *void, mode: i64) i64;

        // Frame
        pub const SDL_RenderClear   -> fn (renderer: *void) i64;
        pub const SDL_RenderPresent -> fn (renderer: *void) i64;

        // Primitives
        pub const SDL_RenderFillRect -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderRect     -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderLine     -> fn (renderer: *void, x1: f64, y1: f64, x2: f64, y2: f64) i64;
        pub const SDL_RenderPoint    -> fn (renderer: *void, x: f64, y: f64) i64;

        // Events
        pub const SDL_PollEvent -> fn (event: *void) i64;

        // Input
        pub const SDL_GetKeyboardState -> fn (numkeys: *i64) *bool;
        pub const SDL_GetMouseState    -> fn (x: *f32, y: *f32) i64;

        // Timing
        pub const SDL_GetTicks -> fn () i64;
        pub const SDL_Delay    -> fn (ms: i64) void;
    }
    "macos" -> {
        // Lifecycle
        pub const SDL_Init          -> fn (flags: i64) bool;
        pub const SDL_Quit          -> fn () void;
        pub const SDL_GetError      -> fn () *byte;

        // Window
        pub const SDL_CreateWindow      -> fn (title: *byte, w: i64, h: i64, flags: i64) *void;
        pub const SDL_DestroyWindow     -> fn (window: *void) void;
        pub const SDL_SetWindowPosition -> fn (window: *void, x: i64, y: i64) i64;
        pub const SDL_GetWindowSize     -> fn (window: *void, w: *i64, h: *i64) void;
        pub const SDL_SetWindowTitle    -> fn (window: *void, title: *byte) void;

        // Renderer
        pub const SDL_CreateRenderer  -> fn (window: *void, name: *byte) *void;
        pub const SDL_DestroyRenderer -> fn (renderer: *void) void;
        pub const SDL_SetRenderVSync  -> fn (renderer: *void, vsync: i64) i64;

        // Draw state
        pub const SDL_SetRenderDrawColor     -> fn (renderer: *void, r: i64, g: i64, b: i64, a: i64) i64;
        pub const SDL_SetRenderDrawBlendMode -> fn (renderer: *void, mode: i64) i64;

        // Frame
        pub const SDL_RenderClear   -> fn (renderer: *void) i64;
        pub const SDL_RenderPresent -> fn (renderer: *void) i64;

        // Primitives
        pub const SDL_RenderFillRect -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderRect     -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderLine     -> fn (renderer: *void, x1: f64, y1: f64, x2: f64, y2: f64) i64;
        pub const SDL_RenderPoint    -> fn (renderer: *void, x: f64, y: f64) i64;

        // Events
        pub const SDL_PollEvent -> fn (event: *void) i64;

        // Input
        pub const SDL_GetKeyboardState -> fn (numkeys: *i64) *bool;
        pub const SDL_GetMouseState    -> fn (x: *f32, y: *f32) i64;

        // Timing
        pub const SDL_GetTicks -> fn () i64;
        pub const SDL_Delay    -> fn (ms: i64) void;
    }
}

// ============================================================================
// ADDITIONAL API  (identical across all platforms — declared once)
// ============================================================================

// --- OpenGL (SDL_GL_* from SDL_video.h, SDL3 signatures) --------------------
pub const SDL_GL_LoadLibrary        -> fn (path: *byte) bool;
