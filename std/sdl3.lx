@module "std_sdl3"

@os {
    "linux"   -> { @link("libSDL3.so") }
    "macos"   -> { @link("libSDL3.dylib") }
}

// ============================================================================
// INIT FLAGS
// ============================================================================

pub const SDL_INIT_VIDEO:  i64 = 32;
pub const SDL_INIT_AUDIO:  i64 = 16;
pub const SDL_INIT_EVENTS: i64 = 16384;

// ============================================================================
// WINDOW FLAGS
// Windows are shown by default in SDL3 — SDL_WINDOW_SHOWN no longer exists.
// ============================================================================

pub const SDL_WINDOW_FULLSCREEN:  i64 = 1;
pub const SDL_WINDOW_HIDDEN:      i64 = 8;
pub const SDL_WINDOW_BORDERLESS:  i64 = 16;
pub const SDL_WINDOW_RESIZABLE:   i64 = 32;
pub const SDL_WINDOW_MINIMIZED:   i64 = 64;
pub const SDL_WINDOW_MAXIMIZED:   i64 = 128;

// ============================================================================
// EVENT TYPES  (values unchanged from SDL2, names changed to SDL_EVENT_*)
// ============================================================================

pub const SDL_EVENT_QUIT:          i64 = 256;   // 0x100
pub const SDL_EVENT_KEY_DOWN:      i64 = 768;   // 0x300
pub const SDL_EVENT_KEY_UP:        i64 = 769;   // 0x301
pub const SDL_EVENT_MOUSE_MOTION:  i64 = 1024;  // 0x400
pub const SDL_EVENT_MOUSE_BUTTON_DOWN: i64 = 1025;
pub const SDL_EVENT_MOUSE_BUTTON_UP:   i64 = 1026;
pub const SDL_EVENT_WINDOW_RESIZED:    i64 = 2053;

// ============================================================================
// SCANCODES  (same as SDL2)
// ============================================================================

pub const SDL_SCANCODE_A:      i64 = 4;
pub const SDL_SCANCODE_D:      i64 = 7;
pub const SDL_SCANCODE_S:      i64 = 22;
pub const SDL_SCANCODE_W:      i64 = 26;
pub const SDL_SCANCODE_SPACE:  i64 = 44;
pub const SDL_SCANCODE_ESCAPE: i64 = 41;
pub const SDL_SCANCODE_LEFT:   i64 = 80;
pub const SDL_SCANCODE_RIGHT:  i64 = 79;
pub const SDL_SCANCODE_UP:     i64 = 82;
pub const SDL_SCANCODE_DOWN:   i64 = 81;

pub const SDL_FRect -> struct {
    x: f32,
    y: f32,
    w: f32,
    h: f32,
};

pub const make_rect -> fn (x: f32, y: f32, w: f32, h: f32) SDL_FRect {
    return SDL_FRect { x: x, y: y, w: w, h: h };
}

// ============================================================================
// FUNCTION IMPORTS
// ============================================================================

@os {
    "linux" -> {
        // Lifecycle
        pub const SDL_Init          -> fn (flags: i64) bool;
        pub const SDL_Quit          -> fn () void;
        pub const SDL_GetError      -> fn () *byte;

        // Window
        pub const SDL_CreateWindow      -> fn (title: *byte, w: i64, h: i64, flags: i64) *void;
        pub const SDL_DestroyWindow     -> fn (window: *void) void;
        pub const SDL_SetWindowPosition -> fn (window: *void, x: i64, y: i64) i64;
        pub const SDL_GetWindowSize     -> fn (window: *void, w: *i64, h: *i64) void;
        pub const SDL_SetWindowTitle    -> fn (window: *void, title: *byte) void;

        // Renderer
        pub const SDL_CreateRenderer  -> fn (window: *void, name: *byte) *void;
        pub const SDL_DestroyRenderer -> fn (renderer: *void) void;
        pub const SDL_SetRenderVSync  -> fn (renderer: *void, vsync: i64) i64;

        // Draw state
        pub const SDL_SetRenderDrawColor     -> fn (renderer: *void, r: i64, g: i64, b: i64, a: i64) i64;
        pub const SDL_SetRenderDrawBlendMode -> fn (renderer: *void, mode: i64) i64;

        // Frame
        pub const SDL_RenderClear   -> fn (renderer: *void) i64;
        pub const SDL_RenderPresent -> fn (renderer: *void) i64;

        // Primitives
        pub const SDL_RenderFillRect -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderRect     -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderLine     -> fn (renderer: *void, x1: f64, y1: f64, x2: f64, y2: f64) i64;
        pub const SDL_RenderPoint    -> fn (renderer: *void, x: f64, y: f64) i64;

        // Events
        pub const SDL_PollEvent -> fn (event: *void) i64;

        // Input
        pub const SDL_GetKeyboardState -> fn (numkeys: *i64) *bool;
        pub const SDL_GetMouseState    -> fn (x: *f64, y: *f64) i64;

        // Timing
        pub const SDL_GetTicks -> fn () i64;
        pub const SDL_Delay    -> fn (ms: i64) void;
    }
    "macos" -> {
        // Lifecycle
        pub const SDL_Init          -> fn (flags: i64) bool;
        pub const SDL_Quit          -> fn () void;
        pub const SDL_GetError      -> fn () *byte;

        // Window
        pub const SDL_CreateWindow      -> fn (title: *byte, w: i64, h: i64, flags: i64) *void;
        pub const SDL_DestroyWindow     -> fn (window: *void) void;
        pub const SDL_SetWindowPosition -> fn (window: *void, x: i64, y: i64) i64;
        pub const SDL_GetWindowSize     -> fn (window: *void, w: *i64, h: *i64) void;
        pub const SDL_SetWindowTitle    -> fn (window: *void, title: *byte) void;

        // Renderer
        pub const SDL_CreateRenderer  -> fn (window: *void, name: *byte) *void;
        pub const SDL_DestroyRenderer -> fn (renderer: *void) void;
        pub const SDL_SetRenderVSync  -> fn (renderer: *void, vsync: i64) i64;

        // Draw state
        pub const SDL_SetRenderDrawColor     -> fn (renderer: *void, r: i64, g: i64, b: i64, a: i64) i64;
        pub const SDL_SetRenderDrawBlendMode -> fn (renderer: *void, mode: i64) i64;

        // Frame
        pub const SDL_RenderClear   -> fn (renderer: *void) i64;
        pub const SDL_RenderPresent -> fn (renderer: *void) i64;

        // Primitives
        pub const SDL_RenderFillRect -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderRect     -> fn (renderer: *void, rect: *void) i64;
        pub const SDL_RenderLine     -> fn (renderer: *void, x1: f64, y1: f64, x2: f64, y2: f64) i64;
        pub const SDL_RenderPoint    -> fn (renderer: *void, x: f64, y: f64) i64;

        // Events
        pub const SDL_PollEvent -> fn (event: *void) i64;

        // Input
        pub const SDL_GetKeyboardState -> fn (numkeys: *i64) *byte;
        pub const SDL_GetMouseState    -> fn (x: *f64, y: *f64) i64;

        // Timing
        pub const SDL_GetTicks -> fn () i64;
        pub const SDL_Delay    -> fn (ms: i64) void;
    }
}

// ============================================================================
// SDL_WINDOWPOS_CENTERED equivalent for SDL3
// Use SDL_SetWindowPosition after creation. This constant asks SDL to centre.
// ============================================================================

pub const SDL_WINDOWPOS_CENTERED: i64 = 805240832;

// ============================================================================
// Event helpers  (layout unchanged from SDL2)
// ============================================================================

pub const event_type -> fn (buf: *byte) i64 {
    let b0: i64 = cast<i64>(buf[0]);
    let b1: i64 = cast<i64>(buf[1]);
    let b2: i64 = cast<i64>(buf[2]);
    let b3: i64 = cast<i64>(buf[3]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

pub const key_scancode -> fn (buf: *byte) i64 {
    let b0: i64 = cast<i64>(buf[16]);
    let b1: i64 = cast<i64>(buf[17]);
    let b2: i64 = cast<i64>(buf[18]);
    let b3: i64 = cast<i64>(buf[19]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

pub const key_down -> fn (state: *byte, scancode: i64) bool {
    return state[scancode] != cast<byte>(0);
}
