//! std_win32.lx - Windows Win32 API Interface
//!
//! PLATFORM: Windows x86_64 only
//!
//! Provides direct access to kernel32.dll and other core Win32 APIs.
//! This is the Windows equivalent of std_sys — use @os blocks to select
//! between std_sys (POSIX) and std_win32 (Windows) in cross-platform code.

@module "std_win32"

// ============================================================================
// HANDLE CONSTANTS
// ============================================================================

pub const INVALID_HANDLE_VALUE: i64 = -1;

pub const STD_INPUT_HANDLE: i64  = -10;
pub const STD_OUTPUT_HANDLE: i64 = -11;
pub const STD_ERROR_HANDLE: i64  = -12;

// ============================================================================
// FILE ACCESS FLAGS
// ============================================================================

pub const GENERIC_READ: i64    = 2147483648; // 0x80000000
pub const GENERIC_WRITE: i64   = 1073741824; // 0x40000000
pub const GENERIC_EXECUTE: i64 = 536870912;  // 0x20000000
pub const GENERIC_ALL: i64     = 268435456;  // 0x10000000

// ============================================================================
// FILE SHARE FLAGS
// ============================================================================

pub const FILE_SHARE_NONE: i64   = 0;
pub const FILE_SHARE_READ: i64   = 1;
pub const FILE_SHARE_WRITE: i64  = 2;
pub const FILE_SHARE_DELETE: i64 = 4;

// ============================================================================
// FILE CREATION DISPOSITION
// ============================================================================

pub const CREATE_NEW: i64        = 1;
pub const CREATE_ALWAYS: i64     = 2;
pub const OPEN_EXISTING: i64     = 3;
pub const OPEN_ALWAYS: i64       = 4;
pub const TRUNCATE_EXISTING: i64 = 5;

// ============================================================================
// FILE ATTRIBUTE FLAGS
// ============================================================================

pub const FILE_ATTRIBUTE_READONLY: i64  = 1;
pub const FILE_ATTRIBUTE_HIDDEN: i64    = 2;
pub const FILE_ATTRIBUTE_SYSTEM: i64    = 4;
pub const FILE_ATTRIBUTE_DIRECTORY: i64 = 16;
pub const FILE_ATTRIBUTE_NORMAL: i64    = 128;

// ============================================================================
// FILE SEEK (SetFilePointer whence)
// ============================================================================

pub const FILE_BEGIN: i64   = 0;
pub const FILE_CURRENT: i64 = 1;
pub const FILE_END: i64     = 2;

// ============================================================================
// PROCESS / EXIT
// ============================================================================

pub const STILL_ACTIVE: i64 = 259;

// ============================================================================
// MEMORY PROTECTION FLAGS (VirtualAlloc)
// ============================================================================

pub const PAGE_NOACCESS: i64          = 1;
pub const PAGE_READONLY: i64          = 2;
pub const PAGE_READWRITE: i64         = 4;
pub const PAGE_EXECUTE: i64           = 16;
pub const PAGE_EXECUTE_READ: i64      = 32;
pub const PAGE_EXECUTE_READWRITE: i64 = 64;

// ============================================================================
// VIRTUAL ALLOC TYPE FLAGS
// ============================================================================

pub const MEM_COMMIT: i64  = 4096;   // 0x1000
pub const MEM_RESERVE: i64 = 8192;   // 0x2000
pub const MEM_RELEASE: i64 = 32768;  // 0x8000

// ============================================================================
// SIGNAL / CONSOLE CONSTANTS
// ============================================================================

pub const CTRL_C_EVENT: i64     = 0;
pub const CTRL_BREAK_EVENT: i64 = 1;

// ============================================================================
// KERNEL32 IMPORTS — File I/O
// ============================================================================

#dll_import("kernel32.dll", callconv: "stdcall")
pub const CreateFileA -> fn (
    lpFileName: *byte,
    dwDesiredAccess: i64,
    dwShareMode: i64,
    lpSecurityAttributes: *void,
    dwCreationDisposition: i64,
    dwFlagsAndAttributes: i64,
    hTemplateFile: i64
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const ReadFile -> fn (
    hFile: i64,
    lpBuffer: *void,
    nNumberOfBytesToRead: i64,
    lpNumberOfBytesRead: *i64,
    lpOverlapped: *void
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const WriteFile -> fn (
    hFile: i64,
    lpBuffer: *void,
    nNumberOfBytesToWrite: i64,
    lpNumberOfBytesWritten: *i64,
    lpOverlapped: *void
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const CloseHandle -> fn (hObject: i64) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetFileSizeEx -> fn (hFile: i64, lpFileSize: *i64) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const SetFilePointerEx -> fn (
    hFile: i64,
    liDistanceToMove: i64,
    lpNewFilePointer: *i64,
    dwMoveMethod: i64
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const DeleteFileA -> fn (lpFileName: *byte) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const MoveFileA -> fn (lpExistingFileName: *byte, lpNewFileName: *byte) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const CopyFileA -> fn (
    lpExistingFileName: *byte,
    lpNewFileName: *byte,
    bFailIfExists: i64
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const CreateDirectoryA -> fn (
    lpPathName: *byte,
    lpSecurityAttributes: *void
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const RemoveDirectoryA -> fn (lpPathName: *byte) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetCurrentDirectoryA -> fn (
    nBufferLength: i64,
    lpBuffer: *byte
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const SetCurrentDirectoryA -> fn (lpPathName: *byte) i64;

// ============================================================================
// KERNEL32 IMPORTS — Console / Stdio
// ============================================================================

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetStdHandle -> fn (nStdHandle: i64) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const SetStdHandle -> fn (nStdHandle: i64, hHandle: i64) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const SetConsoleOutputCP -> fn (wCodePageID: i64) i64;

// ============================================================================
// KERNEL32 IMPORTS — Process
// ============================================================================

#dll_import("kernel32.dll", callconv: "stdcall")
pub const ExitProcess -> fn (uExitCode: i64) void;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetCurrentProcessId -> fn () i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const OpenProcess -> fn (
    dwDesiredAccess: i64,
    bInheritHandle: i64,
    dwProcessId: i64
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const TerminateProcess -> fn (hProcess: i64, uExitCode: i64) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetExitCodeProcess -> fn (hProcess: i64, lpExitCode: *i64) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const CreateProcessA -> fn (
    lpApplicationName: *byte,
    lpCommandLine: *byte,
    lpProcessAttributes: *void,
    lpThreadAttributes: *void,
    bInheritHandles: i64,
    dwCreationFlags: i64,
    lpEnvironment: *void,
    lpCurrentDirectory: *byte,
    lpStartupInfo: *void,
    lpProcessInformation: *void
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const WaitForSingleObject -> fn (hHandle: i64, dwMilliseconds: i64) i64;

// ============================================================================
// KERNEL32 IMPORTS — Memory
// ============================================================================

#dll_import("kernel32.dll", callconv: "stdcall")
pub const VirtualAlloc -> fn (
    lpAddress: *void,
    dwSize: i64,
    flAllocationType: i64,
    flProtect: i64
) *void;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const VirtualFree -> fn (
    lpAddress: *void,
    dwSize: i64,
    dwFreeType: i64
) i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetProcessHeap -> fn () i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const HeapAlloc -> fn (hHeap: i64, dwFlags: i64, dwBytes: i64) *void;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const HeapFree -> fn (hHeap: i64, dwFlags: i64, lpMem: *void) i64;

// ============================================================================
// KERNEL32 IMPORTS — Error handling
// ============================================================================

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetLastError -> fn () i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const SetLastError -> fn (dwErrCode: i64) void;

// ============================================================================
// KERNEL32 IMPORTS — Time
// ============================================================================

#dll_import("kernel32.dll", callconv: "stdcall")
pub const GetTickCount64 -> fn () i64;

#dll_import("kernel32.dll", callconv: "stdcall")
pub const Sleep -> fn (dwMilliseconds: i64) void;

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

/// Returns true if a handle is invalid.
pub const is_invalid_handle -> fn (handle: i64) bool {
    return handle == INVALID_HANDLE_VALUE;
}

/// Returns true if a Win32 boolean return value indicates failure (0 = failed).
pub const win32_failed -> fn (result: i64) bool {
    return result == 0;
}

/// Write a null-terminated string to a handle. Returns bytes written.
pub const write_str -> fn (handle: i64, s: *byte) i64 {
    let len: i64 = 0;
    loop (s[len] != cast<byte>(0)) : (++len) {}
    let written: i64 = 0;
    WriteFile(handle, cast<*void>(s), len, &written, cast<*void>(0));
    return written;
}

/// Write a null-terminated string to stderr.
pub const eprint -> fn (s: *byte) i64 {
    let handle: i64 = GetStdHandle(STD_ERROR_HANDLE);
    return write_str(handle, s);
}

/// Write a null-terminated string to stdout.
pub const print_str -> fn (s: *byte) i64 {
    let handle: i64 = GetStdHandle(STD_OUTPUT_HANDLE);
    return write_str(handle, s);
}

/// Open a file for reading. Returns a handle or INVALID_HANDLE_VALUE.
pub const open_read -> fn (path: *byte) i64 {
    return CreateFileA(
        path, GENERIC_READ, FILE_SHARE_READ,
        cast<*void>(0), OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0
    );
}

/// Open a file for writing (creates or truncates). Returns a handle or INVALID_HANDLE_VALUE.
pub const open_write -> fn (path: *byte) i64 {
    return CreateFileA(
        path, GENERIC_WRITE, FILE_SHARE_READ,
        cast<*void>(0), CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0
    );
}

/// Open a file for reading and writing. Returns a handle or INVALID_HANDLE_VALUE.
pub const open_rdwr -> fn (path: *byte) i64 {
    return CreateFileA(
        path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ,
        cast<*void>(0), OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0
    );
}

/// Get the size of an open file. Returns -1 on error.
pub const file_size -> fn (handle: i64) i64 {
    let size: i64 = 0;
    let ok: i64 = GetFileSizeEx(handle, &size);
    if (ok == 0) { return -1; }
    return size;
}
