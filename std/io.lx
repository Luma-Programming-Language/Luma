//! Input/Output operations module
//!
//! PLATFORM: Linux x86_64, macOS x86_64/ARM64, and Windows x86_64

@module "std_io"

// ============================================================================
// PLATFORM: Syscall numbers (POSIX only)
// ============================================================================

@os {
    "linux" -> {
        const SYS_READ: i64  = 0;
        const SYS_WRITE: i64 = 1;
        const SYS_OPEN: i64  = 2;
        const SYS_CLOSE: i64 = 3;
        const O_RDONLY: i64  = 0;
        const O_RDWR: i64    = 2;
        const STDOUT: i64    = 1;
        const STDERR: i64    = 2;
    }
    "macos" -> {
        const SYS_READ: i64  = 3;
        const SYS_WRITE: i64 = 4;
        const SYS_OPEN: i64  = 5;
        const SYS_CLOSE: i64 = 6;
        const O_RDONLY: i64  = 0;
        const O_RDWR: i64    = 2;
        const STDOUT: i64    = 1;
        const STDERR: i64    = 2;
    }
    "windows64" -> {
        const GENERIC_READ: i64        = 2147483648; // 0x80000000
        const GENERIC_WRITE: i64       = 1073741824; // 0x40000000
        const FILE_SHARE_READ: i64     = 1;
        const OPEN_EXISTING: i64       = 3;
        const INVALID_HANDLE_VALUE: i64 = -1;
        const STD_OUTPUT_HANDLE: i64   = -11;
        const STD_ERROR_HANDLE: i64    = -12;
        const STD_INPUT_HANDLE: i64    = -10;

        #dll_import("kernel32.dll", callconv: "stdcall")
        pub const WriteFile -> fn (
            hFile: i64,
            lpBuffer: *void,
            nNumberOfBytesToWrite: i64,
            lpNumberOfBytesWritten: *i64,
            lpOverlapped: *void
        ) i64;

        #dll_import("kernel32.dll", callconv: "stdcall")
        pub const ReadFile -> fn (
            hFile: i64,
            lpBuffer: *void,
            nNumberOfBytesToRead: i64,
            lpNumberOfBytesRead: *i64,
            lpOverlapped: *void
        ) i64;

        #dll_import("kernel32.dll", callconv: "stdcall")
        pub const CreateFileA -> fn (
            lpFileName: *byte,
            dwDesiredAccess: i64,
            dwShareMode: i64,
            lpSecurityAttributes: *void,
            dwCreationDisposition: i64,
            dwFlagsAndAttributes: i64,
            hTemplateFile: i64
        ) i64;

        #dll_import("kernel32.dll", callconv: "stdcall")
        pub const CloseHandle -> fn (hObject: i64) i64;

        #dll_import("kernel32.dll", callconv: "stdcall")
        pub const GetStdHandle -> fn (nStdHandle: i64) i64;

        #dll_import("kernel32.dll", callconv: "stdcall")
        pub const SetStdHandle -> fn (nStdHandle: i64, hHandle: i64) i64;
    }
}

// ============================================================================
// Memory helpers (all platforms)
// ============================================================================

const local_memcpy -> fn (dest: *void, src: *void, n: i64) *void {
    let d: *byte = cast<*byte>(dest);
    let s: *byte = cast<*byte>(src);
    loop [i: i64 = 0](i < n) : (++i) {
        d[i] = s[i];
    }
    return dest;
}

#returns_ownership
const local_realloc -> fn (ptr: *void, old_size: i64, new_size: i64) *void {
    if (ptr == cast<*void>(0)) {
        return alloc(new_size);
    }
    let new_ptr: *void = alloc(new_size);
    local_memcpy(new_ptr, ptr, old_size);
    free(ptr);
    return new_ptr;
}

// ============================================================================
// Low-level I/O — platform-specific
// ============================================================================

pub const local_write -> fn (fd: i64, buf: *void, count: i64) i64 {
    @os {
        "linux"   -> { return __syscall__(SYS_WRITE, fd, cast<i64>(buf), count); }
        "macos"   -> { return __syscall__(SYS_WRITE, fd, cast<i64>(buf), count); }
        "windows64" -> {
            let written: i64 = 0;
            WriteFile(fd, buf, count, &written, cast<*void>(0));
            return written;
        }
    }
}

pub const local_read -> fn (fd: i64, buf: *void, count: i64) i64 {
    @os {
        "linux"   -> { return __syscall__(SYS_READ, fd, cast<i64>(buf), count); }
        "macos"   -> { return __syscall__(SYS_READ, fd, cast<i64>(buf), count); }
        "windows64" -> {
            let bytes_read: i64 = 0;
            let ok: i64 = ReadFile(fd, buf, count, &bytes_read, cast<*void>(0));
            if (ok == 0) { return INVALID_HANDLE_VALUE; }
            return bytes_read;
        }
    }
}

pub const local_open_read -> fn (path: *byte) i64 {
    @os {
        "linux"   -> { return __syscall__(SYS_OPEN, cast<i64>(path), O_RDONLY, 0); }
        "macos"   -> { return __syscall__(SYS_OPEN, cast<i64>(path), O_RDONLY, 0); }
        "windows64" -> {
            return CreateFileA(
                path, GENERIC_READ, FILE_SHARE_READ,
                cast<*void>(0), OPEN_EXISTING, 128, 0
            );
        }
    }
}

const local_open_write -> fn (path: *byte) i64 {
    @os {
        "linux"   -> { return __syscall__(SYS_OPEN, cast<i64>(path), O_RDWR, 0); }
        "macos"   -> { return __syscall__(SYS_OPEN, cast<i64>(path), O_RDWR, 0); }
        "windows64" -> {
            return CreateFileA(
                path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ,
                cast<*void>(0), OPEN_EXISTING, 128, 0
            );
        }
    }
}

pub const local_open_create -> fn (path: *byte) i64 {
    @os {
        "linux"   -> { return __syscall__(SYS_OPEN, cast<i64>(path), 577, 420); }
        "macos"   -> { return __syscall__(SYS_OPEN, cast<i64>(path), 577, 420); }
        "windows64" -> {
            return CreateFileA(
                path, GENERIC_WRITE, 0,
                cast<*void>(0), 2, 128, 0
            );
        }
    }
}

pub const local_close -> fn (fd: i64) i64 {
    @os {
        "linux"   -> { return __syscall__(SYS_CLOSE, fd); }
        "macos"   -> { return __syscall__(SYS_CLOSE, fd); }
        "windows64" -> { return CloseHandle(fd); }
    }
}

pub const local_is_error -> fn (result: i64) bool {
    @os {
        "linux"   -> { return result < 0 && result >= -4095; }
        "macos"   -> { return result < 0 && result >= -4095; }
        "windows64" -> { return result == INVALID_HANDLE_VALUE; }
    }
}

const local_write_str -> fn (fd: i64, s: *byte) i64 {
    let len: i64 = 0;
    loop (s[len] != cast<byte>(0)) : (++len) {}
    return local_write(fd, cast<*void>(s), len);
}

const local_eprint -> fn (s: *byte) i64 {
    @os {
        "linux"   -> { return local_write_str(STDERR, s); }
        "macos"   -> { return local_write_str(STDERR, s); }
        "windows64" -> {
            let handle: i64 = GetStdHandle(STD_ERROR_HANDLE);
            return local_write_str(handle, s);
        }
    }
}

pub const write_binary -> fn (path: *byte, data: *void, size: i64) i64 {
    let fd: i64 = local_open_write(path);
    if (local_is_error(fd)) {
        local_eprint("Error: Could not open file for binary write\n");
        return -1;
    }
    let written: i64 = local_write(fd, data, size);
    local_close(fd);
    return written;
}

pub const read_binary -> fn (path: *byte, data: *void, size: i64) i64 {
    let fd: i64 = local_open_read(path);
    if (local_is_error(fd)) {
        local_eprint("Error: Could not open file for binary read\n");
        return -1;
    }
    let bytes_read: i64 = local_read(fd, data, size);
    local_close(fd);
    return bytes_read;
}

const INITIAL_BUFFER_SIZE: i64  = 4096;
const BUFFER_GROWTH_FACTOR: i64 = 2;
const ARG_INT: i64   = 0;
const ARG_STR: i64   = 1;
const ARG_BYTE: i64  = 2;
const ARG_FLOAT: i64 = 3;

pub const FormatArg -> struct {
    tag: i64,
    str_ptr: *byte,
    int_val: i64,
    byte_val: byte
};

pub const NULL_FORMAT_ARG: FormatArg = FormatArg {
    tag: -1,
    str_ptr: cast<*byte>(0),
    int_val: 0,
    byte_val: '\0'
};

pub const str_arg -> fn (arg: *byte) FormatArg {
    return FormatArg { tag: ARG_STR, str_ptr: arg, int_val: 0, byte_val: '\0' };
}

pub const int_arg -> fn (arg: i64) FormatArg {
    return FormatArg { tag: ARG_INT, str_ptr: "", int_val: arg, byte_val: '\0' };
}

pub const byte_arg -> fn (arg: byte) FormatArg {
    return FormatArg { tag: ARG_BYTE, str_ptr: "", int_val: 0, byte_val: arg };
}

#returns_ownership
const from_int -> fn (n: i64) *byte {
    if (n == 0) {
        let s: *byte = cast<*byte>(alloc(2 * sizeof<byte>));
        s[0] = '0';
        s[1] = cast<byte>(0);
        return s;
    }

    let negative: i64 = 0;
    if (n < 0) {
        negative = 1;
        n = -n;
    }

    let buffer: [byte; 20];
    let i: i64 = 0;

    loop (n != 0) {
        let digit: i64 = n % 10;
        buffer[i] = cast<byte>(digit + cast<i64>('0'));
        n = n / 10;
        i = i + 1;
    }

    if (negative == 1) {
        buffer[i] = '-';
        i = i + 1;
    }

    let s: *byte = cast<*byte>(alloc((i + 1) * sizeof<byte>));
    loop [j: i64 = 0](j < i) : (j = j + 1) {
        s[j] = buffer[i - j - 1];
    }
    s[i] = cast<byte>(0);
    return s;
}

// print()/print_err()'s arg-count cap. Named here so the bound checks below
// can't silently drift from each other or from what the two functions
// actually mean by "too many args" — but the array-type positions in their
// signatures below still have to repeat this as the literal 256: a
// module-level global can't size a function parameter's array in its
// *prototype* (only in the function's own definition, where per-function
// codegen already has the right module context — narrow, cross-file
// declaration-order limitation, not worth a bigger codegen rework for).
const MAX_FORMAT_ARGS: i64 = 256;

pub const print -> fn (s: *byte, args: [FormatArg; 256]) i64 { // see MAX_FORMAT_ARGS above
    let buffer: [byte; 1024];
    let buf_index: i64 = 0;
    let arg_index: i64 = 0;

    let i: i64 = 0;
    loop (s[i] != '\0') {
        if (s[i] == '%' && arg_index < MAX_FORMAT_ARGS) {
            let next: byte = s[i + 1];
            let arg: FormatArg = args[arg_index];

            switch (next) {
                'd' -> {
                    if (arg.tag == ARG_INT) {
                        let num_str: *byte = from_int(arg.int_val);
                        loop [j: i64 = 0](num_str[j] != '\0') : (++j) {
                            buffer[buf_index] = num_str[j];
                            buf_index = buf_index + 1;
                        }
                        arg_index = arg_index + 1;
                        i = i + 2;
                        free(num_str);
                        continue;
                    }
                }
                'c' -> {
                    if (arg.tag == ARG_BYTE) {
                        buffer[buf_index] = arg.byte_val;
                        buf_index = buf_index + 1;
                        arg_index = arg_index + 1;
                        i = i + 2;
                        continue;
                    }
                }
                's' -> {
                    if (arg.tag == ARG_STR) {
                        let str_ptr: *byte = arg.str_ptr;
                        loop [j: i64 = 0](str_ptr[j] != '\0') : (++j) {
                            buffer[buf_index] = str_ptr[j];
                            buf_index = buf_index + 1;
                        }
                        arg_index = arg_index + 1;
                        i = i + 2;
                        continue;
                    }
                }
            }
        }

        buffer[buf_index] = s[i];
        buf_index = buf_index + 1;
        i = i + 1;
    }

    @os {
        "linux"   -> { return local_write(STDOUT, cast<*void>(&buffer), buf_index); }
        "macos"   -> { return local_write(STDOUT, cast<*void>(&buffer), buf_index); }
        "windows64" -> {
            let handle: i64 = GetStdHandle(STD_OUTPUT_HANDLE);
            return local_write(handle, cast<*void>(&buffer), buf_index);
        }
    }
}

pub const print_err -> fn (s: *byte, args: [i64; 256]) i64 { // see MAX_FORMAT_ARGS above
    let buffer: *byte = cast<*byte>(alloc(MAX_FORMAT_ARGS * sizeof<byte>));
    let buf_index: i64 = 0;
    let arg_index: i64 = 0;
    defer { free(buffer); }

    loop [i: i64 = 0](s[i] != '\0') : (++i) {
        if (s[i] == '%' && s[i + 1] == 'd' && arg_index < MAX_FORMAT_ARGS) {
            let num_str: *byte = from_int(args[arg_index]);
            defer { free(num_str); }
            loop [j: i64 = 0](num_str[j] != '\0') : (++j) {
                buffer[buf_index] = num_str[j];
                buf_index = buf_index + 1;
            }
            arg_index = arg_index + 1;
            i = i + 1;
        } else {
            buffer[buf_index] = s[i];
            buf_index = buf_index + 1;
        }
    }
    buffer[buf_index] = '\0';
    return local_eprint(buffer);
}

#returns_ownership
pub const read_file -> fn (path: *byte) *byte {
    let fd: i64 = local_open_read(path);

    if (local_is_error(fd)) {
        local_eprint("Error: File does not exist, can not read from file\n");
        return cast<*byte>(0);
    }

    let buffer_size: i64 = INITIAL_BUFFER_SIZE;
    let buffer: *byte = cast<*byte>(alloc(buffer_size * sizeof<byte>));
    if (buffer == cast<*byte>(0)) {
        local_eprint("Error: Failed to allocate initial buffer\n");
        local_close(fd);
        return cast<*byte>(0);
    }

    let total_read: i64 = 0;
    let bytes_read: i64 = 0;

    loop {
        let read_size: i64 = buffer_size - total_read - 1;
        bytes_read = local_read(fd, cast<*void>(cast<i64>(buffer) + total_read), read_size);

        if (local_is_error(bytes_read)) {
            local_eprint("Error: Failed to read from file\n");
            local_close(fd);
            free(buffer);
            return cast<*byte>(0);
        }

        if (bytes_read == 0) {
            break;
        }

        total_read = total_read + bytes_read;

        if (total_read >= buffer_size - 1) {
            let new_size: i64 = buffer_size * BUFFER_GROWTH_FACTOR;
            let new_buffer: *byte = cast<*byte>(local_realloc(cast<*void>(buffer), buffer_size, new_size));

            if (new_buffer == cast<*byte>(0)) {
                local_eprint("Error: Failed to grow buffer\n");
                local_close(fd);
                free(buffer);
                return cast<*byte>(0);
            }

            buffer = new_buffer;
            buffer_size = new_size;
        }
    }

    buffer[total_read] = cast<byte>(0);

    if (total_read < buffer_size - 1) {
        let final_buffer: *byte = cast<*byte>(alloc((total_read + 3) * sizeof<byte>));
        if (final_buffer != cast<*byte>(0)) {
            local_memcpy(cast<*void>(final_buffer), cast<*void>(buffer), total_read + 1);
            final_buffer[total_read + 1] = cast<byte>(0);
            final_buffer[total_read + 2] = cast<byte>(0);
            free(buffer);
            buffer = final_buffer;
        }
        buffer[total_read]     = cast<byte>(0);
        buffer[total_read + 1] = cast<byte>(0);
        buffer[total_read + 2] = cast<byte>(0);
    }

    local_close(fd);
    return buffer;
}

pub const write_buffer_to_file -> fn (path: *byte, buffer: *byte) i64 {
    let fd: i64 = local_open_write(path);

    if (local_is_error(fd)) {
        local_eprint("Error: File does not exist, can not write to file.\n");
        return -1;
    }

    let length: i64 = 0;
    loop (buffer[length] != '\0') {
        length = length + 1;
    }

    if (length <= 0) {
        local_eprint("Error: buffer size <= 0.\n");
        local_close(fd);
        return -1;
    }

    let written: i64 = local_write(fd, cast<*void>(buffer), length);
    local_close(fd);
    return written;
}