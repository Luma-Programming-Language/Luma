@module "main"

@use "std_hashmap" as HMAP

/* 
  const sort -> fn<@cmp<T>> ( // Means that there is something to compare on T, and that T must have some sort of compareson
    value: [T; 256], 
    sort: fn (T, T) bool
  ) void;
*/

const hash_int -> fn (value: i64) u64 {
  let x: u64 = cast<u64>(value);

  x = (x ^ (x >> 30)) * 13787848793156543929;
  x = (x ^ (x >> 27)) * 10723151780598845931;
  x = (x ^ (x >> 31));

  return x;
}

const int_equals -> fn (a: i64, b: i64) bool { return a == b; }

pub const main -> fn () i64 {
  let map: *HMAP::HashMap<i64, i64> = 
    HMAP::HashMap::new<i64, i64>(hash_int, int_equals);
  defer map._free();

  map.insert(0, 123);

  output(map.get(0));

  return 0;
}
