@module "main"

@use "vector" as VEC

const int_equals -> fn (a: i64, b: i64) bool { return a == b; }

const main -> fn () i32 {
    let v: VEC::Vector<i64> = VEC::Vector<i64>::create(2);

    outputln("=== Create ===");
    outputln("size: ", v.size);
    outputln("cap:  ", v.cap);

    outputln("\n=== Push ===");

    v.push_back(10);
    v.push_back(20);

    outputln("size: ", v.size);
    outputln("cap:  ", v.cap);

    // This should trigger 2 -> 4 growth.
    v.push_back(30);

    outputln("size: ", v.size);
    outputln("cap:  ", v.cap);

    outputln("v[0]: ", *v.get(0));
    outputln("v[1]: ", *v.get(1));
    outputln("v[2]: ", *v.get(2));


    outputln("\n=== Insert ===");

    // [10, 20, 30]
    v.insert(15, 1);

    // Should now be:
    // [10, 15, 20, 30]

    outputln("v[0]: ", *v.get(0));
    outputln("v[1]: ", *v.get(1));
    outputln("v[2]: ", *v.get(2));
    outputln("v[3]: ", *v.get(3));


    outputln("\n=== Pop ===");

    let out: i64 = 0;

    if (v.pop_back(&out)) {
        outputln("popped: ", out);
    }

    // Should now be:
    // [10, 15, 20]

    outputln("size: ", v.size);
    outputln("v[0]: ", *v.get(0));
    outputln("v[1]: ", *v.get(1));
    outputln("v[2]: ", *v.get(2));


    outputln("\n=== Bounds ===");

    if (v.get(-1) == cast<*i64>(0)) {
        outputln("negative index correctly rejected");
    }

    if (v.get(v.size) == cast<*i64>(0)) {
        outputln("out-of-bounds index correctly rejected");
    }


    outputln("\n=== Free ===");

    v._free();

    outputln("size after free: ", v.size);
    outputln("cap after free:  ", v.cap);

    return 0;
}
