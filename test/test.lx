@module "main"

@use "std_hashmap" as HMAP

/* 
  const sort -> fn<@cmp<T>> ( // Means that there is something to compare on T, and that T must have some sort of compareson
    value: [T; 256], 
    sort: fn (T, T) bool
  ) void;
*/

const hash_int -> fn (value: int) uint {
  let x: uint = cast<uint>(value);

  x = (x ^ (x >> 30)) * 13787848793156543929;
  x = (x ^ (x >> 27)) * 10723151780598845931;
  x = (x ^ (x >> 31));

  return x;
}

const int_equals -> fn (a: int, b: int) bool { return a == b; }

pub const main -> fn () int {
  let map: *HMAP::HashMap<int, int> = 
    HMAP::HashMap::new<int, int>(hash_int, int_equals);
  defer map._free();

  map.insert(0, 123);

  output(map.get(0));

  return 0;
}
