// error-type: Type Mismatch
@module "main"

// Enum type identity is per-instantiation: the `State<i64>` value on the
// right is a different nominal type (`State__int`) than the `State<*byte>`
// variable on the left (`State___byte`), so the assignment is a type
// mismatch — the phantom/type-tag argument is part of the enum's identity.

const State -> enum<T> {
  Idle,
  Busy,
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  let a: State<i64> = State<i64>::Idle;
  let b: State<*byte> = a;
  return 0;
}