// error-type: Generics Error
@module "main"

// A generic struct literal/type reference must name exactly as many type
// arguments as the template declares.

const Box -> struct<T> {
  value: T,
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  let b: Box<i64, bool> = Box<i64, bool> { value: 42 };
  outputln(b.value);
  return 0;
}