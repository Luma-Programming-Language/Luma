// error-type: Generics Error
@module "main"

// A generic enum reference must name exactly as many type arguments as the
// template declares.

const State -> enum<T> {
  Idle,
  Running,
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  let s: State<i64, bool> = State<i64, bool>::Idle;
  if (s == State<i64, bool>::Idle) return 0;
  return 1;
}