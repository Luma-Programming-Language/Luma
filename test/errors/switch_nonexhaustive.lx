// error-type: Non-Exhaustive Switch
@module "main"

const Color -> enum { Red, Green, Blue };

pub const main -> fn (argc: i64, argv: **byte) i64 {
    let c: Color = Color::Red;
    switch (c) {
        Color::Red -> { output("r\n"); }
        Color::Green -> { output("g\n"); }
    }
    return 0;
}
