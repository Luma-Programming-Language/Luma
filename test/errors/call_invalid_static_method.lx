// error-type: Call Error
@module "main"

// `Foo::does_not_exist(...)` — an unknown static method on a registered
// struct template. Used to compile to `/* unresolved qualified call */ 0`
// with exit 0; now it's reported as a call error before codegen.

const Foo -> struct<T> {
  data: T,

  static make -> fn (x: i64) Foo<T> {
    return Foo<T> { data: x };
  },
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  let x: i64 = Foo::does_not_exist<i64>(3);
  return x;
}