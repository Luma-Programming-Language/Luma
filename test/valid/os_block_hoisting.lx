@module "main"

@os {
  "linux"   -> { const GREETING: *byte = "hello linux";   }
  "macos"   -> { const GREETING: *byte = "hello macos";   }
  "windows32" -> { const GREETING: *byte = "hello windows"; }
  "windows64" -> { const GREETING: *byte = "hello windows"; }
}

pub const main -> fn (argc: int, argv: **byte) int {
    output(GREETING, "\n");
    return 0;
}
