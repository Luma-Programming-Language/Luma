@module "main"

// A generic enum as a field type — both through a generic struct whose type
// parameter is the enum's phantom tag (`state: State<T>` substituted with T
// == i64) and with the enum given a *nested* concrete generic type argument
// (`State<Entry<i64, i64>>`, where `Entry<i64, i64>` is itself a generic
// struct instantiation — the phantom type arg is any concrete type). Both
// paths resolve to ordinary mangled nominal types during struct/field
// typechecking. See docs/docs.md's Generics section.

const Entry -> struct<K, V> {
  key: K,
  val: V,
};

const State -> enum<T> {
  Idle,
  Running,
  Done,
};

const Wrapper -> struct<T> {
  state: State<T>,
};

const Job -> struct {
  id: i64,
  state: State<Entry<i64, i64>>,
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  // `State<T>` in Wrapper's field is substituted with the caller's `i64`.
  let w: Wrapper<i64> = Wrapper<i64> { state: State<i64>::Idle };
  if (w.state != State<i64>::Idle) return 1;

  let e: Entry<i64, i64> = Entry<i64, i64> { key: 7, val: 9 };

  // `State<Entry<i64, i64>>` — a generic enum with a generic-struct
  // instantiation as its phantom/type-tag argument.
  let j: Job = Job {
    id: 1,
    state: State<Entry<i64, i64>>::Running,
  };

  if (j.state != State<Entry<i64, i64>>::Running) return 1;
  return 0;
}