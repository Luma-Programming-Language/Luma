@module "main"

const Point -> struct {
pub:
  x: i64,
  y: i64,

  move -> fn (dx: i64, dy: i64) void {
    self.x = self.x + dx;
    self.y = self.y + dy;
  },
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
    let p: Point = Point { x: 1, y: 2 };
    p.move(3, 4);
    output(p.x, ", ", p.y, "\n");
    return 0;
}
