@module "main"

// Regression test for generic methods on a *plain* (non-generic) struct —
// `make -> fn<T> (...) T`, where the method owns its own type parameters
// (unlike generics_struct_methods.lx, where the method rides the struct's
// `K, V` template). Before this fix, `register_field` resolved the method's
// `T` return type against the module scope (unresolved → "unknown type
// name"), calls were never instantiated as fn templates, and codegen emitted
// the raw template spilling `T` into the generated C.

const Thing -> struct {
  x: i64,

  static make -> fn<T> (kind: i64, line: i64) T {
    return cast<T>(0);
  },
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  // Each distinct concrete instantiation must be codegen'd under its own
  // mangled name (Thing::make<*Thing>, Thing::make<i64>, ...) with the
  // return type substituted — exactly like AstNode::make in ast.lx.
  let a: *Thing = Thing::make<*Thing>(1, 2);
  if (a != cast<*Thing>(0)) return 1;

  let c: i64 = Thing::make<i64>(1, 2);
  if (c != 0) return 2;

  let d: **byte = Thing::make<**byte>(1, 2);
  if (d != cast<**byte>(0)) return 3;

  return 0;
}