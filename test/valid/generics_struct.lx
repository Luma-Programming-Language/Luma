@module "main"

// Regression test for generic structs (`struct<T, U>`) — same
// monomorphization story as generic functions: a concrete struct decl
// (main__Entry__int__int, main__Map__int__int, ...) is synthesized by
// tc_generics for each distinct type-argument list, typechecked through the
// tc.lx drain, and codegen'd via tc_core's generated-decl registry. Generic
// fields (`*Entry<K, V>`) resolve through placeholder substitution. See
// docs/docs.md's Generics section.

const Entry -> struct<K, V> {
  key: K,
  val: V,
};

const Map -> struct<K, V> {
  size: i64,
  first: *Entry<K, V>,
};

pub const main -> fn (argc: i64, argv: **byte) i64 {
  let e: Entry<i64, i64> = Entry<i64, i64> { key: 7, val: 9 };

  // Concrete struct whose field type is itself a concrete struct
  // instantiation (the `*Entry<K,V>` field, after substitution).
  let m: Map<i64, i64> = Map<i64, i64> { size: 1, first: &e };

  if (e.key != 7 || e.val != 9) return 1;
  if (m.size != 1) return 1;
  if (m.first.key != 7) return 1;

  outputln(m.first.val);

  return 0;
}